@page "/system"
@inject VaultSession Session
@inject BrowserStorage Storage
@inject NavigationManager Navigation

<PageTitle>System // Stellar Vault</PageTitle>

@if (!Session.IsUnlocked)
{
    <section class="terminal-panel centered-message">
        <h1>DATABASE LOCKED</h1>
        <a class="pixel-button primary" href="/">RETURN TO ACCESS TERMINAL</a>
    </section>
}
else
{
    <section class="system-page">
        <header class="page-command-header">
            <div>
                <div class="panel-kicker">DIAGNOSTICS // SESSION STATE</div>
                <h1>SYSTEM STATUS</h1>
                <p class="page-subtitle">Network parameters and linked account-chain information.</p>
            </div>
            <button class="pixel-button compact danger" type="button" @onclick="LockAsync">LOCK</button>
        </header>

        <div class="system-grid">
            <section class="terminal-panel system-card">
                <div class="panel-kicker">NETWORK</div>
                <h2>@Session.Network?.Name</h2>
                <dl class="system-list">
                    <dt>HORIZON</dt>
                    <dd class="break-value">@Session.Network?.HorizonUrl</dd>
                    <dt>PASSPHRASE</dt>
                    <dd class="break-value">@Session.Network?.Passphrase</dd>
                    <dt>BASE FEE</dt>
                    <dd>@Session.Network?.BaseFeeStroops STROOPS / OP</dd>
                    <dt>BASE RESERVE</dt>
                    <dd>@BaseReserveDisplay NATIVE / SUBENTRY</dd>
                    <dt>NODE LIMIT</dt>
                    <dd>@Session.Network?.NodeDataEntryLimit DATA ENTRIES</dd>
                    <dt>CHILD FUNDING</dt>
                    <dd>@Session.Network?.ChildStartingBalance NATIVE // AUTO</dd>
                </dl>
                <p class="security-copy">
                    Child funding is transferred to a root-controlled node so it can satisfy account and data-entry reserve requirements.
                    It is not a network fee. The node limit determines how much capacity is pre-funded in each node.
                </p>
            </section>

            <section class="terminal-panel system-card">
                <div class="panel-kicker">ROOT AUTHORITY</div>
                <h2>DATABASE KEYPAIR</h2>
                <div class="root-address">
                    <code>@Session.RootAccountId</code>
                    <button class="mini-button" type="button" @onclick="CopyRootAsync">COPY</button>
                </div>
                <p class="security-copy">
                    The secret seed exists only in the active WebAssembly memory. Locking or refreshing the app destroys this session reference.
                </p>
            </section>
        </div>

        <section class="terminal-panel chain-panel">
            <header class="panel-heading">
                <div>
                    <div class="panel-kicker">ACCOUNT LINK MAP</div>
                    <h2>CHAIN NODES</h2>
                </div>
                <span class="step-led">@(Session.Snapshot?.Nodes.Count ?? 0)</span>
            </header>

            <div class="chain-list">
                @if (Session.Snapshot?.Nodes.Count > 0)
                {
                    @foreach (var node in Session.Snapshot.Nodes)
                    {
                        <div class="chain-node">
                            <span class="node-number">@node.Position.ToString("D2", CultureInfo.InvariantCulture)</span>
                            <div>
                                <strong>@Short(node.AccountId)</strong>
                                <small>@node.Data.Count DATA // @node.SubentryCount SUBENTRIES</small>
                            </div>
                            <span class="node-link-state">@(node.NextAccountId is null ? "TAIL" : "LINK")</span>
                        </div>
                    }
                }
                else
                {
                    <p>No chain snapshot is loaded.</p>
                }
            </div>
        </section>

        <section class="terminal-panel danger-zone">
            <div>
                <div class="panel-kicker">SECURITY COMMAND</div>
                <h2>LOCK DATABASE</h2>
                <p>Clears the active root keypair, decrypted records, and encryption key from this application session.</p>
            </div>
            <button class="pixel-button danger" type="button" @onclick="LockAsync">LOCK NOW</button>
        </section>
    </section>
}

@code {
    private string BaseReserveDisplay =>
        ((Session.Network?.BaseReserveStroops ?? 0L) / 10_000_000m)
            .ToString("0.#######", CultureInfo.InvariantCulture);

    private async Task CopyRootAsync()
    {
        if (!string.IsNullOrWhiteSpace(Session.RootAccountId))
            await Storage.CopyAsync(Session.RootAccountId);
    }

    private async Task LockAsync()
    {
        await Session.LockAsync();
        Navigation.NavigateTo("/");
    }

    private static string Short(string value) =>
        value.Length <= 26 ? value : $"{value[..13]}…{value[^9..]}";
}
