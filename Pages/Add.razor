@page "/add"
@inject IVaultOperations Session
@inject BrowserStorage Storage
@inject NavigationManager Navigation

<PageTitle>Add Record // Stellar Vault</PageTitle>

@if (!Session.IsUnlocked)
{
    <section class="terminal-panel centered-message">
        <h1>DATABASE LOCKED</h1>
        <a class="pixel-button primary" href="/">RETURN TO ACCESS TERMINAL</a>
    </section>
}
else
{
    <section class="form-page">
        <header class="page-command-header">
            <div>
                <div class="panel-kicker">WRITE OPERATION // NEW RECORD</div>
                <h1>ADD CREDENTIAL</h1>
                <p class="page-subtitle">The cost estimate opens in a dedicated approval window before anything is signed.</p>
            </div>
            <a class="pixel-button compact" href="/vault">← CANCEL</a>
        </header>

        <EditForm Model="_form" OnValidSubmit="ReviewAsync" class="terminal-panel credential-form">
            <DataAnnotationsValidator />

            <label class="terminal-label">
                <span>FOLDER</span>
                <InputSelect class="terminal-input" @bind-Value="_form.FolderId">
                    <option value="">Unfiled</option>
                    @foreach (var folder in FolderOptions)
                    {
                        <option value="@folder.Record.Id">@folder.Record.Title</option>
                    }
                </InputSelect>
            </label>
            <div class="form-section-title"><span>01</span> RECORD IDENTITY</div>

            <label class="terminal-label">
                <span>TITLE *</span>
                <InputText class="terminal-input" @bind-Value="_form.Title" autocomplete="off" placeholder="GitHub, Nexus, Server root..." />
                <ValidationMessage For="() => _form.Title" />
            </label>

            <label class="terminal-label">
                <span>USERNAME / IDENTIFIER</span>
                <InputText class="terminal-input" @bind-Value="_form.UserName" autocomplete="off" placeholder="user@example.com" />
            </label>

            <label class="terminal-label">
                <span>URL</span>
                <InputText class="terminal-input" @bind-Value="_form.Url" inputmode="url" autocomplete="off" placeholder="https://example.com" />
            </label>

            <div class="form-section-title"><span>02</span> SECRET PAYLOAD</div>

            <label class="terminal-label">
                <span>SECRET / PASSWORD *</span>
                <div class="input-with-action multi-action">
                    <InputText class="terminal-input" type="@(_showSecret ? "text" : "password")" @bind-Value="_form.Secret" autocomplete="new-password" />
                    <button type="button" class="input-action" @onclick="ToggleSecret">@(_showSecret ? "HIDE" : "SHOW")</button>
                    <button type="button" class="input-action generate" @onclick="GeneratePasswordAsync">GEN</button>
                </div>
                <ValidationMessage For="() => _form.Secret" />
            </label>

            <label class="terminal-label">
                <span>NOTES</span>
                <InputTextArea class="terminal-input terminal-textarea" @bind-Value="_form.Notes" rows="5" placeholder="Recovery details, environment, account purpose..." />
            </label>

            <label class="terminal-label">
                <span>TAGS // COMMA SEPARATED</span>
                <InputText class="terminal-input" @bind-Value="_form.Tags" autocomplete="off" placeholder="work, infrastructure, production" />
            </label>

            <div class="commit-preview">
                <span>MODE</span><strong>LOCAL ENCRYPT → CHUNK → SIGN → SUBMIT</strong>
                <span>SOURCE</span><strong>@Short(Session.RootAccountId)</strong>
                <span>NETWORK</span><strong>@Session.Network?.Name</strong>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="terminal-alert error">
                    <strong>WRITE FAILED</strong>
                    <span>@_error</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(_transactionHash))
            {
                <div class="terminal-alert success">
                    <strong>RECORD COMMITTED</strong>
                    <span class="transaction-hash">TX: @_transactionHash</span>
                </div>
            }

            <button class="pixel-button primary access-button" type="submit" disabled="@_busy">
                <span>@(_busy ? "CALCULATING..." : "REVIEW AND APPROVE")</span>
                <span>▶</span>
            </button>
        </EditForm>
    </section>

    <CostApprovalModal Open="_showApproval"
                       Estimate="_estimate"
                       Title="APPROVE NEW RECORD"
                       Message="This preview is calculated from the encrypted record size and the current account-chain state."
                       Warning="The database key will sign the listed ledger operations after approval. Network fees are spent; reserve remains controlled by the vault accounts."
                       ActionText="APPROVE AND COMMIT"
                       BusyText="COMMITTING..."
                       Busy="_busy"
                       OnConfirm="CommitAsync"
                       OnCancel="CancelApproval" />
}

@code {
    private readonly AddCredentialForm _form = new();
    [SupplyParameterFromQuery(Name = "folder")] public string? InitialFolder { get; set; }
    private IReadOnlyList<VaultRecordLocation> FolderOptions =>
        Session.Snapshot?.Records.Where(x => x.Record.IsFolder).ToArray() ?? [];
    private bool _showSecret;
    private bool _busy;
    private bool _showApproval;
    private string? _error;
    private string? _transactionHash;
    private string? _draftRecordId;
    private string? _reviewFingerprint;
    private VaultRecord? _pendingRecord;
    private VaultCostEstimate? _estimate;

    protected override void OnInitialized()
    {
        if (InitialFolder is not null && FolderOptions.Any(x => x.Record.Id == InitialFolder))
            _form.FolderId = InitialFolder;
        if (!Session.IsUnlocked)
            Navigation.NavigateTo("/");
    }

    private void ToggleSecret() => _showSecret = !_showSecret;

    private async Task GeneratePasswordAsync()
    {
        _form.Secret = await Storage.GeneratePasswordAsync(24);
        _showSecret = true;
    }

    private async Task ReviewAsync()
    {
        _busy = true;
        _error = null;
        _transactionHash = null;

        try
        {
            _draftRecordId ??= await Storage.RandomHexAsync(8);
            var now = DateTimeOffset.UtcNow;
            _pendingRecord = BuildRecord(_draftRecordId, now, now);
            _reviewFingerprint = CurrentFingerprint();
            _estimate = await Session.EstimateAddAsync(_pendingRecord);
            _showApproval = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ClearApproval();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CommitAsync()
    {
        if (_pendingRecord is null || _estimate is null)
            return;

        if (!string.Equals(_reviewFingerprint, CurrentFingerprint(), StringComparison.Ordinal))
        {
            _error = "The form changed after the estimate was created. Review the ledger cost again.";
            ClearApproval();
            return;
        }

        _busy = true;
        _error = null;
        _transactionHash = null;

        try
        {
            _transactionHash = await Session.AddAsync(_pendingRecord);
            _form.Reset();
            _showSecret = false;
            _draftRecordId = null;
            ClearApproval();
            await InvokeAsync(StateHasChanged);
            await Storage.StabilizeViewportAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelApproval() => ClearApproval();

    private void ClearApproval()
    {
        _showApproval = false;
        _pendingRecord = null;
        _estimate = null;
        _reviewFingerprint = null;
    }

    private VaultRecord BuildRecord(string id, DateTimeOffset created, DateTimeOffset updated) =>
        new()
        {
            Id = id,
            Title = _form.Title.Trim(),
            UserName = _form.UserName.Trim(),
            Secret = _form.Secret,
            Url = _form.Url.Trim(),
            Notes = _form.Notes.Trim(),
            Tags = _form.Tags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToArray(),
            FolderId = string.IsNullOrEmpty(_form.FolderId) ? null : _form.FolderId,
            CreatedUtc = created,
            UpdatedUtc = updated
        };

    private string CurrentFingerprint() =>
        string.Join("\u001f", _form.Title, _form.UserName, _form.Secret, _form.Url, _form.Notes, _form.Tags, _form.FolderId);

    private static string Short(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "N/A";
        return value.Length <= 18 ? value : $"{value[..9]}…{value[^6..]}";
    }

    private sealed class AddCredentialForm
    {
        [Required(ErrorMessage = "Title is required.")]
        public string Title { get; set; } = string.Empty;

        public string UserName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Secret is required.")]
        public string Secret { get; set; } = string.Empty;

        public string Url { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;
        public string Tags { get; set; } = string.Empty;
        public string? FolderId { get; set; }

        public void Reset()
        {
            Title = string.Empty;
            UserName = string.Empty;
            Secret = string.Empty;
            Url = string.Empty;
            Notes = string.Empty;
            Tags = string.Empty;
            FolderId = null;
        }
    }
}
