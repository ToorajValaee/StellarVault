@page "/"
@inject VaultSession Session
@inject BrowserStorage Storage
@inject NavigationManager Navigation

<PageTitle>Access Terminal // Stellar Vault</PageTitle>

<section class="access-grid">
    <div class="hero-terminal terminal-panel">
        <div class="panel-kicker">SECURE DATA LINK // READY</div>
        <h1>OPEN STELLAR<br />CHAIN DATABASE<span class="blink-cursor">_</span></h1>
        <p class="hero-copy">
            Your BIP-39 recovery phrase derives the existing index-0 root and deterministic child accounts. The seed stays in this browser session and is never saved by the app.
        </p>
        <div class="boot-log" aria-label="System capabilities">
            <span><b>[OK]</b> AES-256-GCM RECORD ENCRYPTION</span>
            <span><b>[OK]</b> 64-BYTE LEDGER CHUNK ENGINE</span>
            <span><b>[OK]</b> DETERMINISTIC HD ACCOUNT DISCOVERY</span>
            <span><b>[OK]</b> PWA OFFLINE APPLICATION SHELL</span>
        </div>
    </div>

    <form class="access-form terminal-panel" @onsubmit="OpenAsync" @onsubmit:preventDefault="true">
        <div class="panel-heading">
            <div>
                <div class="panel-kicker">STEP 01</div>
                <h2>SELECT NETWORK</h2>
            </div>
            <span class="step-led">01</span>
        </div>

        <div class="network-selector">
            <button type="button" class="network-option @TestnetClass" @onclick="SelectTestnet">
                <span class="network-symbol">T</span>
                <span><strong>TESTNET</strong><small>STELLAR TEST NETWORK</small></span>
            </button>
            <button type="button" class="network-option @PublicClass" @onclick="SelectPublic">
                <span class="network-symbol">P</span>
                <span><strong>PUBLIC</strong><small>STELLAR MAIN NETWORK</small></span>
            </button>
            <button type="button" class="network-option @CustomClass" @onclick="SelectCustom">
                <span class="network-symbol">C</span>
                <span><strong>CUSTOM</strong><small>PRIVATE / SELF-HOSTED</small></span>
            </button>
        </div>

        @if (_preset == "custom")
        {
            <div class="custom-network-fields">
                <label class="terminal-label">
                    <span>NETWORK NAME</span>
                    <input class="terminal-input" @bind="_networkName" autocomplete="off" placeholder="PRIVATE NETWORK" />
                </label>
                <label class="terminal-label">
                    <span>HORIZON URL</span>
                    <input class="terminal-input"
                           @bind="_horizonUrl"
                           @bind:event="oninput"
                           @onblur="DiscoverNetworkAsync"
                           inputmode="url"
                           autocomplete="url"
                           placeholder="https://horizon.example.com" />
                </label>

                <button class="pixel-button compact detect-network-button"
                        type="button"
                        disabled="@_discovering"
                        @onclick="DiscoverNetworkAsync">
                    @(_discovering ? "DETECTING..." : "DETECT PASSPHRASE + FEES")
                </button>

                <label class="terminal-label">
                    <span>NETWORK PASSPHRASE // AUTO-DETECTED</span>
                    <textarea class="terminal-input terminal-textarea compact"
                              @bind="_passphrase"
                              rows="2"
                              spellcheck="false"
                              placeholder="Detected from the Horizon root endpoint"></textarea>
                </label>

                @if (!string.IsNullOrWhiteSpace(_networkProbeStatus))
                {
                    <div class="terminal-alert success compact-alert">
                        <strong>HORIZON DETECTED</strong>
                        <span>@_networkProbeStatus</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_networkProbeError))
                {
                    <div class="terminal-alert warning compact-alert">
                        <strong>AUTO-DETECTION FAILED</strong>
                        <span>@_networkProbeError You can enter the values manually if only discovery endpoints are unavailable; the browser must still be able to reach Horizon.</span>
                    </div>
                }
            </div>
        }

        @if (HasMixedContentRisk)
        {
            <div class="terminal-alert warning">
                <strong>MIXED CONTENT WARNING</strong>
                <span>An HTTPS PWA cannot call an HTTP Horizon endpoint. Use HTTPS or run the app from an HTTP development address.</span>
            </div>
        }

        <details class="advanced-block">
            <summary>ADVANCED LEDGER PARAMETERS</summary>
            <p class="advanced-help">
                Most users should keep these automatic values. The node limit controls how many ManageData entries are placed on each child account.
                A higher limit creates fewer accounts. HD children receive zero XLM; the root sponsors their reserves and pays transaction fees.
            </p>
            <div class="advanced-grid">
                <label class="terminal-label">
                    <span>DATA ENTRY LIMIT / NODE</span>
                    <input class="terminal-input" type="number" min="4" max="950" @bind="NodeEntryLimit" />
                </label>
                <label class="terminal-label">
                    <span>CHILD STARTING BALANCE (ROOT-SPONSORED)</span>
                    <input class="terminal-input readonly-input" value="@ChildFundingDisplay" readonly />
                </label>
                <label class="terminal-label">
                    <span>BASE RESERVE</span>
                    <input class="terminal-input readonly-input" value="@BaseReserveEntryDisplay" readonly />
                </label>
                <label class="terminal-label">
                    <span>BASE FEE / OPERATION (STROOPS)</span>
                    <input class="terminal-input" type="number" min="1" @bind="_baseFee" />
                </label>
            </div>
        </details>

        <div class="panel-heading unlock-heading">
            <div>
                <div class="panel-kicker">STEP 02</div>
                <h2>RECOVERY PHRASE</h2>
            </div>
            <span class="step-led">02</span>
        </div>

        <label class="terminal-label secret-input-wrap">
            <span>BIP-39 RECOVERY PHRASE</span>
            <div class="input-with-action">
                <input class="terminal-input secret-seed-input"
                       type="@(_showSecret ? "text" : "password")"
                       @bind="_secret"
                       autocomplete="off"
                       autocapitalize="off"
                       spellcheck="false"
                       placeholder="12 / 15 / 18 / 21 / 24 BIP-39 words" />
                <button type="button" class="input-action" @onclick="() => _showSecret = !_showSecret">@(_showSecret ? "HIDE" : "SHOW")</button>
            </div>
        </label>

        <label class="terminal-label">
            <span>OPTIONAL BIP-39 PASSPHRASE</span>
            <input class="terminal-input" type="password" @bind="_bip39Passphrase"
                   autocomplete="off" autocapitalize="off" spellcheck="false"
                   placeholder="Leave blank if unused" />
        </label>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="terminal-alert error">
                <strong>ACCESS ERROR</strong>
                <span>@_error</span>
            </div>
        }

        <button class="pixel-button primary access-button" type="submit" disabled="@_opening">
            <span>@(_opening ? "CONNECTING..." : "OPEN DATABASE")</span>
            <span aria-hidden="true">▶</span>
        </button>

        <p class="local-only-note">// SAVED LOCALLY: NETWORK SETTINGS ONLY. RECOVERY PHRASE: MEMORY ONLY.</p>
    </form>

    <aside class="terminal-panel account-help-panel">
        <div>
            <div class="panel-kicker">PRIVATE NETWORK ACCESS</div>
            <h2>NEED AN ACCOUNT?</h2>
            <p>
                If you do not have an account on the BADJE private Stellar network, contact Tooraj Valaee and an account can be provisioned for you.
            </p>
        </div>
        <div class="account-help-actions">
            <a class="pixel-button primary compact" href="mailto:tooraj.valaee@live.com?subject=Private%20Stellar%20Network%20Account">EMAIL TOORAJ</a>
            <a class="mini-button" href="/contact">CONTACT DETAILS</a>
        </div>
    </aside>
</section>

@code {
    private const long DefaultBaseReserveStroops = 5_000_000;

    private string _preset = "testnet";
    private string _networkName = "Testnet";
    private string _horizonUrl = "https://horizon-testnet.stellar.org";
    private string _passphrase = StellarNetworkPassphrases.Testnet;
    private string _childBalance = "0";
    private int _entryLimit = 80;
    private uint _baseFee = 100u;
    private long _baseReserveStroops = DefaultBaseReserveStroops;
    private string _secret = string.Empty;
    private string _bip39Passphrase = string.Empty;
    private bool _showSecret;
    private bool _opening;
    private bool _discovering;
    private string? _error;
    private string? _networkProbeStatus;
    private string? _networkProbeError;

    private int NodeEntryLimit
    {
        get => _entryLimit;
        set
        {
            _entryLimit = Math.Clamp(value, 4, 950);
            RecalculateChildBalance();
        }
    }

    private string BaseReserveDisplay =>
        (_baseReserveStroops / 10_000_000m).ToString("0.#######", CultureInfo.InvariantCulture);

    private string ChildFundingDisplay => $"{_childBalance} NATIVE";
    private string BaseReserveEntryDisplay => $"{BaseReserveDisplay} NATIVE / ENTRY";

    private bool HasMixedContentRisk =>
        Navigation.BaseUri.StartsWith("https://", StringComparison.OrdinalIgnoreCase) &&
        _horizonUrl.Trim().StartsWith("http://", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        RecalculateChildBalance();

        if (Session.IsUnlocked)
        {
            Navigation.NavigateTo("/vault");
            return;
        }

        var saved = await Storage.LoadNetworkAsync();
        if (saved is null)
            return;

        ApplySettings(saved);
    }

    private void SelectPreset(string preset)
    {
        _preset = preset;
        _error = null;
        _networkProbeError = null;
        _networkProbeStatus = null;

        switch (preset)
        {
            case "testnet":
                _networkName = "Testnet";
                _horizonUrl = "https://horizon-testnet.stellar.org";
                _passphrase = StellarNetworkPassphrases.Testnet;
                _baseReserveStroops = DefaultBaseReserveStroops;
                _baseFee = 100u;
                break;
            case "public":
                _networkName = "Public";
                _horizonUrl = "https://horizon.stellar.org";
                _passphrase = StellarNetworkPassphrases.Public;
                _baseReserveStroops = DefaultBaseReserveStroops;
                _baseFee = 100u;
                break;
            case "custom":
                if (_networkName is "Testnet" or "Public")
                    _networkName = "Private";
                if (_horizonUrl.Contains("stellar.org", StringComparison.OrdinalIgnoreCase))
                    _horizonUrl = string.Empty;
                if (_passphrase == StellarNetworkPassphrases.Testnet ||
                    _passphrase == StellarNetworkPassphrases.Public)
                    _passphrase = string.Empty;
                break;
        }

        RecalculateChildBalance();
    }

    private string TestnetClass => _preset == "testnet" ? "selected" : string.Empty;
    private string PublicClass => _preset == "public" ? "selected" : string.Empty;
    private string CustomClass => _preset == "custom" ? "selected" : string.Empty;

    private void SelectTestnet() => SelectPreset("testnet");
    private void SelectPublic() => SelectPreset("public");
    private void SelectCustom() => SelectPreset("custom");

    private async Task DiscoverNetworkAsync()
    {
        await TryDiscoverNetworkAsync(requireSuccess: false);
    }

    private async Task<bool> TryDiscoverNetworkAsync(bool requireSuccess)
    {
        _networkProbeError = null;
        _networkProbeStatus = null;

        if (!Uri.TryCreate(_horizonUrl.Trim(), UriKind.Absolute, out var horizonUri) ||
            (horizonUri.Scheme != Uri.UriSchemeHttp && horizonUri.Scheme != Uri.UriSchemeHttps))
        {
            if (requireSuccess)
                _error = "Enter a valid Horizon URL before opening the database.";
            return false;
        }

        _discovering = true;
        try
        {
            var info = await Storage.InspectHorizonAsync(horizonUri.ToString().TrimEnd('/'));
            _passphrase = info.NetworkPassphrase;
            _baseReserveStroops = Math.Max(1L, info.BaseReserveStroops);
            _baseFee = Math.Max(1u, info.RecommendedBaseFeeStroops);
            RecalculateChildBalance();

            var version = string.IsNullOrWhiteSpace(info.HorizonVersion)
                ? string.Empty
                : $" // HORIZON {info.HorizonVersion}";
            _networkProbeStatus =
                $"PASSPHRASE LOADED // RESERVE {BaseReserveDisplay} // FEE {_baseFee} STROOPS{version}";
            return true;
        }
        catch (Exception ex)
        {
            _networkProbeError = FriendlyError(ex);
            if (requireSuccess && string.IsNullOrWhiteSpace(_passphrase))
                _error = "The network passphrase could not be detected. Enter it manually or fix Horizon connectivity.";
            return false;
        }
        finally
        {
            _discovering = false;
        }
    }

    private async Task OpenAsync()
    {
        _error = null;

        if (_preset == "custom")
            await TryDiscoverNetworkAsync(requireSuccess: true);
        else
            await TryDiscoverNetworkAsync(requireSuccess: false);

        if (!string.IsNullOrWhiteSpace(_error))
            return;

        if (string.IsNullOrWhiteSpace(_networkName) ||
            string.IsNullOrWhiteSpace(_horizonUrl) ||
            string.IsNullOrWhiteSpace(_passphrase))
        {
            _error = "Network name, Horizon URL, and network passphrase are required.";
            return;
        }

        if (!Uri.TryCreate(_horizonUrl.Trim(), UriKind.Absolute, out var horizonUri) ||
            (horizonUri.Scheme != Uri.UriSchemeHttp && horizonUri.Scheme != Uri.UriSchemeHttps))
        {
            _error = "Horizon URL must be an absolute HTTP or HTTPS address.";
            return;
        }

        if (!decimal.TryParse(_childBalance, NumberStyles.Number, CultureInfo.InvariantCulture, out var childBalance) || childBalance != 0)
        {
            _error = "V2 HD children must have a zero-XLM starting balance.";
            return;
        }

        if (_entryLimit is < 4 or > 950 || _baseFee == 0 || _baseReserveStroops <= 0)
        {
            _error = "Entry limit must be 4–950 and the detected reserve and fee must be positive.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_secret))
        {
            _error = "Enter your BIP-39 recovery phrase.";
            return;
        }

        var settings = new VaultNetworkSettings(
            _networkName.Trim(),
            horizonUri.ToString().TrimEnd('/'),
            _passphrase,
            childBalance.ToString("0.#######", CultureInfo.InvariantCulture),
            _entryLimit,
            _baseFee,
            _baseReserveStroops);

        _opening = true;
        var secretForUnlock = _secret;
        var bip39PassphraseForUnlock = _bip39Passphrase;
        _secret = string.Empty;
        _bip39Passphrase = string.Empty;
        _showSecret = false;

        try
        {
            await Session.UnlockAsync(settings, secretForUnlock, bip39PassphraseForUnlock);
            await Storage.SaveNetworkAsync(settings);
            Navigation.NavigateTo("/vault");
        }
        catch (Exception ex)
        {
            _error = FriendlyError(ex);
        }
        finally
        {
            secretForUnlock = string.Empty;
            bip39PassphraseForUnlock = string.Empty;
            _opening = false;
        }
    }

    private void RecalculateChildBalance()
    {
        // V2 child accounts start with zero XLM. The existing root sponsors reserves.
        _childBalance = "0";
    }

    private void ApplySettings(VaultNetworkSettings settings)
    {
        _networkName = settings.Name;
        _horizonUrl = settings.HorizonUrl;
        _passphrase = settings.Passphrase;
        _entryLimit = settings.NodeDataEntryLimit;
        _baseFee = settings.BaseFeeStroops == 0 ? 100u : settings.BaseFeeStroops;
        _baseReserveStroops = settings.BaseReserveStroops <= 0
            ? DefaultBaseReserveStroops
            : settings.BaseReserveStroops;
        RecalculateChildBalance();

        _preset = settings.Passphrase == StellarNetworkPassphrases.Testnet
            ? "testnet"
            : settings.Passphrase == StellarNetworkPassphrases.Public
                ? "public"
                : "custom";
    }

    private static string FriendlyError(Exception ex)
    {
        var text = ex.Message;
        if (text.Contains("404", StringComparison.OrdinalIgnoreCase) ||
            text.Contains("not found", StringComparison.OrdinalIgnoreCase))
            return "The root Stellar account does not exist on the selected network, or the Horizon URL is incorrect.";

        if (text.Contains("CORS", StringComparison.OrdinalIgnoreCase) ||
            text.Contains("Failed to fetch", StringComparison.OrdinalIgnoreCase) ||
            text.Contains("fetch", StringComparison.OrdinalIgnoreCase))
            return "The browser could not reach Horizon. Check CORS, HTTPS, the URL, and network connectivity.";

        return text;
    }
}
