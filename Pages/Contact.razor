@page "/contact"

<PageTitle>Contact // Stellar Vault</PageTitle>

<section class="contact-page">
    <header class="page-command-header">
        <div>
            <div class="panel-kicker">SUPPORT CHANNEL // BADJE.IR</div>
            <h1>CONTACT US</h1>
            <p class="page-subtitle">Private-network access, account provisioning, feedback, and project enquiries.</p>
        </div>
        <a class="pixel-button compact" href="/">← HOME</a>
    </header>

    <section class="terminal-panel contact-card">
        <div class="contact-avatar" aria-hidden="true">TV</div>
        <div>
            <div class="panel-kicker">PROJECT CONTACT</div>
            <h2>TOORAJ VALAEE</h2>
            <p>
                Stellar Vault Terminal is powered by <a class="terminal-link" href="https://badje.ir" target="_blank" rel="noopener noreferrer">BADJE.IR</a>.
                BADJE is the product brand behind this application.
            </p>
        </div>

        <dl class="system-list contact-list">
            <dt>EMAIL</dt>
            <dd><a class="terminal-link break-value" href="mailto:tooraj.valaee@live.com">tooraj.valaee@live.com</a></dd>
            <dt>BRAND</dt>
            <dd><a class="terminal-link" href="https://badje.ir" target="_blank" rel="noopener noreferrer">BADJE.IR</a></dd>
        </dl>

        <div class="terminal-alert success">
            <strong>NEED A PRIVATE-NETWORK ACCOUNT?</strong>
            <span>
                Send an email and request a Stellar account for the BADJE private network. An account can be provisioned so you can use the vault application.
            </span>
        </div>

        <a class="pixel-button primary access-button"
           href="mailto:tooraj.valaee@live.com?subject=Private%20Stellar%20Network%20Account&amp;body=Hello%20Tooraj%2C%0A%0AI%20would%20like%20an%20account%20for%20the%20BADJE%20private%20Stellar%20network.%0A%0AThank%20you.">
            <span>REQUEST AN ACCOUNT</span>
            <span aria-hidden="true">▶</span>
        </a>
    </section>
</section>
