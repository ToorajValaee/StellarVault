@inject BrowserStorage Storage
@inject VaultSession Session

@if (Item is not null)
{
    <div class="modal-backdrop" @onclick="CloseAsync">
        <section class="record-modal terminal-panel" role="dialog" aria-modal="true" aria-labelledby="record-title" @onclick:stopPropagation="true">
            <header class="modal-header">
                <div>
                    <div class="panel-kicker">RECORD // @Item.Record.Id</div>
                    <h2 id="record-title">@Item.Record.Title</h2>
                </div>
                <button class="icon-button close-button" type="button" aria-label="Close" disabled="@_busy" @onclick="CloseAsync">×</button>
            </header>

            <div class="data-field">
                <span class="field-label">USERNAME / IDENTIFIER</span>
                <div class="field-value-row">
                    <code>@DisplayOrEmpty(Item.Record.UserName)</code>
                    <button class="mini-button" type="button" @onclick="CopyUsernameAsync">COPY</button>
                </div>
            </div>

            <div class="data-field secret-field">
                <span class="field-label">SECRET</span>
                <div class="field-value-row">
                    <code class="secret-value">@(_revealed ? Item.Record.Secret : Mask(Item.Record.Secret))</code>
                    <div class="inline-actions">
                        <button class="mini-button" type="button" @onclick="ToggleReveal">@(_revealed ? "HIDE" : "REVEAL")</button>
                        <button class="mini-button" type="button" @onclick="CopySecretAsync">COPY</button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Item.Record.Url))
            {
                <div class="data-field">
                    <span class="field-label">URL</span>
                    <div class="field-value-row">
                        <a class="terminal-link text-overflow" href="@Item.Record.Url" target="_blank" rel="noopener noreferrer">@Item.Record.Url</a>
                        <button class="mini-button" type="button" @onclick="CopyUrlAsync">COPY</button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Item.Record.Notes))
            {
                <div class="data-field">
                    <span class="field-label">NOTES</span>
                    <p class="record-notes">@Item.Record.Notes</p>
                </div>
            }

            @if (Item.Record.Tags.Length > 0)
            {
                <div class="tag-row detail-tags">
                    @foreach (var tag in Item.Record.Tags)
                    {
                        <span class="pixel-tag">#@tag</span>
                    }
                </div>
            }

            <div class="record-metadata">
                <span>NODE @Short(Item.NodeAccountId)</span>
                <span>@Item.ChunkCount CHUNKS</span>
                <span>@Item.EncryptedByteLength BYTES</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_notice))
            {
                <div class="copy-notice">@_notice</div>
            }

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="terminal-alert error modal-alert">
                    <strong>OPERATION FAILED</strong>
                    <span>@_error</span>
                </div>
            }

            <div class="modal-action-row record-actions">
                <button class="pixel-button primary" type="button" disabled="@_busy" @onclick="EditAsync">EDIT RECORD</button>
                <button class="pixel-button danger" type="button" disabled="@_busy" @onclick="BeginDeleteAsync">
                    @(_busy ? "CALCULATING..." : "DELETE")
                </button>
            </div>
        </section>
    </div>

    <CostApprovalModal Open="_confirmDelete"
                       Estimate="_deleteEstimate"
                       Title="DELETE RECORD"
                       Message="The current manifest is removed first, then the encrypted chunks are cleaned from the live account state."
                       Warning="This cannot restore the record. Historical Stellar transactions may still contain the old encrypted bytes."
                       ActionText="APPROVE DELETE"
                       BusyText="DELETING..."
                       Danger="true"
                       Busy="_busy"
                       OnConfirm="DeleteAsync"
                       OnCancel="CancelDelete" />
}

@code {
    [Parameter] public VaultRecordLocation? Item { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<VaultRecordLocation> OnEdit { get; set; }
    [Parameter] public EventCallback<VaultRecordLocation> OnDelete { get; set; }

    private string? _activeItemId;
    private bool _revealed;
    private bool _confirmDelete;
    private bool _busy;
    private string? _notice;
    private string? _error;
    private VaultCostEstimate? _deleteEstimate;

    protected override void OnParametersSet()
    {
        var nextId = Item?.Record.Id;
        if (string.Equals(_activeItemId, nextId, StringComparison.Ordinal))
            return;

        _activeItemId = nextId;
        _revealed = false;
        _confirmDelete = false;
        _busy = false;
        _notice = null;
        _error = null;
        _deleteEstimate = null;
    }

    private void ToggleReveal() => _revealed = !_revealed;

    private async Task BeginDeleteAsync()
    {
        if (Item is null)
            return;

        _error = null;
        _busy = true;
        try
        {
            _deleteEstimate = await Session.EstimateDeleteAsync(Item);
            _confirmDelete = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _confirmDelete = false;
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelDelete()
    {
        if (_busy)
            return;

        _confirmDelete = false;
        _deleteEstimate = null;
        _error = null;
    }

    private Task CopyUsernameAsync() =>
        CopyAsync(Item?.Record.UserName ?? string.Empty, "USERNAME");

    private Task CopySecretAsync() =>
        CopyAsync(Item?.Record.Secret ?? string.Empty, "SECRET");

    private Task CopyUrlAsync() =>
        CopyAsync(Item?.Record.Url ?? string.Empty, "URL");

    private async Task CopyAsync(string value, string label)
    {
        if (string.IsNullOrEmpty(value))
            return;

        await Storage.CopyAsync(value);
        _notice = $"> {label} COPIED TO CLIPBOARD";
    }

    private async Task EditAsync()
    {
        if (Item is null)
            return;

        _busy = true;
        _error = null;
        try
        {
            await OnEdit.InvokeAsync(Item);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (Item is null)
            return;

        _busy = true;
        _error = null;
        try
        {
            await OnDelete.InvokeAsync(Item);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _busy = false;
        }
    }

    private Task CloseAsync()
    {
        if (_busy || _confirmDelete)
            return Task.CompletedTask;

        _revealed = false;
        _deleteEstimate = null;
        _notice = null;
        _error = null;
        return OnClose.InvokeAsync();
    }

    private static string DisplayOrEmpty(string value) =>
        string.IsNullOrWhiteSpace(value) ? "<EMPTY>" : value;

    private static string Mask(string value) =>
        new('•', Math.Clamp(value.Length, 10, 24));

    private static string Short(string value) =>
        value.Length <= 14 ? value : $"{value[..7]}…{value[^5..]}";
}
