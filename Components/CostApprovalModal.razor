@if (Open && Estimate is not null)
{
    <div class="approval-modal-backdrop" @onclick="CancelAsync">
        <section class="approval-modal terminal-panel"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="approval-title"
                 @onclick:stopPropagation="true">
            <header class="modal-header approval-modal-header">
                <div>
                    <div class="panel-kicker">SIGNED LEDGER OPERATION</div>
                    <h2 id="approval-title">@Title</h2>
                </div>
                <button class="icon-button close-button"
                        type="button"
                        aria-label="Cancel operation"
                        disabled="@Busy"
                        @onclick="CancelAsync">×</button>
            </header>

            <div class="approval-modal-scroll">
                @if (!string.IsNullOrWhiteSpace(Message))
                {
                    <p class="approval-message">@Message</p>
                }

                <CostEstimatePanel Estimate="Estimate" />

                <div class="terminal-alert @(Danger ? "error" : "warning") approval-warning">
                    <strong>@(Danger ? "DESTRUCTIVE OPERATION" : "APPROVAL REQUIRED")</strong>
                    <span>@Warning</span>
                </div>
            </div>

            <footer class="approval-modal-actions">
                <button class="pixel-button @(Danger ? "danger" : "primary")"
                        type="button"
                        disabled="@Busy"
                        @onclick="ConfirmAsync">
                    <span>@(Busy ? BusyText : ActionText)</span>
                    <span aria-hidden="true">@(Danger ? "×" : "▶")</span>
                </button>
                <button class="pixel-button compact"
                        type="button"
                        disabled="@Busy"
                        @onclick="CancelAsync">CANCEL</button>
            </footer>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public VaultCostEstimate? Estimate { get; set; }
    [Parameter] public string Title { get; set; } = "REVIEW LEDGER COST";
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string Warning { get; set; } = "Approve only after checking the fee, reserve change, and operation count.";
    [Parameter] public string ActionText { get; set; } = "APPROVE AND SUBMIT";
    [Parameter] public string BusyText { get; set; } = "SUBMITTING...";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private Task ConfirmAsync() => OnConfirm.InvokeAsync();

    private Task CancelAsync()
    {
        if (Busy)
            return Task.CompletedTask;

        return OnCancel.InvokeAsync();
    }
}
