<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Core/Models.cs" />
    <Compile Remove="Services/VaultErrorMessages.cs" />
    <Compile Remove="src/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <RazorComponent Remove="src/**/*.razor" />
    <Content Remove="src/**/*.razor" />
    <None Remove="src/**/*.razor.css" />
    <ScopedCssInput Remove="src/**/*.razor.css" />
    <Content Remove="src/**/*.razor.css" />
    <ProjectReference Include="src/StellarVault.Core/StellarVault.Core.csproj" />
    <ProjectReference Include="src/StellarVault.UI/StellarVault.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

</Project>
