ARG EDGE_SERVER_IMAGE=ghcr.io/nginx/nginx-unprivileged:stable-alpine@sha256:637c35e46af7bc0dd3d3bcf7162e004e13ab3b370fde7cd416e2ac410b5a985a
FROM ${EDGE_SERVER_IMAGE}
ARG RELEASE_REVISION=unversioned
LABEL org.opencontainers.image.revision=${RELEASE_REVISION}
COPY deploy/nginx-edge.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080 8443
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 CMD wget -q --spider http://127.0.0.1:8080/health/ready || exit 1
