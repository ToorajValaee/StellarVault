ARG SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
ARG RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0
FROM ${SDK_IMAGE} AS build
WORKDIR /src
COPY global.json ./
COPY src ./src
ARG RELEASE_REVISION=unversioned
RUN dotnet restore src/StellarVault.Api/StellarVault.Api.csproj --source https://api.nuget.org/v3/index.json
RUN dotnet publish src/StellarVault.Api/StellarVault.Api.csproj -c Release --no-restore -o /app/publish -p:DebugType=None -p:DebugSymbols=false -p:SourceRevisionId=${RELEASE_REVISION}

FROM ${RUNTIME_IMAGE} AS final
ARG RELEASE_REVISION=unversioned
ARG WORKTREE_DIGEST=unrecorded
ARG PREVIEW=true
LABEL org.opencontainers.image.revision=${RELEASE_REVISION} io.stellarvault.source-digest=${WORKTREE_DIGEST} io.stellarvault.preview=${PREVIEW}
WORKDIR /app
COPY --from=build /app/publish ./
ENV ASPNETCORE_HTTP_PORTS=8080 ASPNETCORE_ENVIRONMENT=Production DOTNET_CLI_TELEMETRY_OPTOUT=1
USER $APP_UID
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 CMD ["dotnet", "StellarVault.Api.dll", "--healthcheck"]
ENTRYPOINT ["dotnet", "StellarVault.Api.dll"]
