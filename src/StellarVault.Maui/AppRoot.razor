@using StellarVault.UI.Components
@using StellarVault.Core.Services
@inject VaultSessionManager Sessions
@inject VaultSessionWorkflow Workflow
@inject IStellarLedgerRecords Ledger
@inject VaultStorageModeGate StorageMode
@inject VaultNetworkSelection NetworkSelection
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IAsyncDisposable

<AdaptiveShell PlatformName="NATIVE PREVIEW" Subtitle="CROSS-PLATFORM VAULT">
    <section class="native-preview" aria-labelledby="native-preview-title">
        <p class="eyebrow">DEVELOPMENT BUILD</p>
        <h1 id="native-preview-title">StellarVault access</h1>
        <ManagedVaultSessionStatus />
        <section aria-label="Stellar ledger recovery" class="terminal-panel">
            <h2>STELLAR LEDGER // READ-ONLY RECOVERY</h2>
            @if (!Ledger.IsConnected)
            {
                <p>Connect with a BIP-39 mnemonic to discover existing HD-v2 ledger records. No transaction will be submitted.</p>
                <button type="button" class="session-lock" disabled="@_ledgerBusy" @onclick="CheckRuntimeAsync">Check native runtime</button>
                <label for="native-ledger-network">Network</label>
                <select id="native-ledger-network" class="vault-field" @bind="_ledgerNetwork" disabled="@_ledgerBusy">
                    <option value="testnet">Testnet</option>
                    <option value="public">Public Network</option>
                </select>
                <label for="native-ledger-mnemonic">BIP-39 mnemonic</label>
                <textarea id="native-ledger-mnemonic" class="vault-field" rows="3"
                          autocomplete="off" spellcheck="false" @bind="_ledgerMnemonic" disabled="@_ledgerBusy"></textarea>
                <button type="button" class="session-lock" disabled="@(_ledgerBusy || _runtimeReady != true || string.IsNullOrWhiteSpace(_ledgerMnemonic))"
                        @onclick="ConnectLedgerAsync">Connect and read ledger</button>
            }
            else
            {
                <p>Ledger connected. Recovered records: @_ledgerRecords.Count</p>
                <button type="button" class="session-lock" disabled="@_ledgerBusy" @onclick="RefreshLedgerAsync">Refresh records</button>
                <button type="button" class="session-lock" disabled="@_ledgerBusy" @onclick="DisconnectLedgerAsync">Disconnect ledger</button>
                @foreach (var item in _ledgerRecords)
                {
                    <p>@(item.IsFolder ? "FOLDER" : "RECORD") — @item.Title</p>
                }
            }
            @if (!string.IsNullOrEmpty(_ledgerMessage))
            {
                <p role="status" aria-live="polite">@_ledgerMessage</p>
            }
            <p class="notice">Read-only native preview: publishing, deletion and registry initialization are unavailable from this screen.</p>
        </section>
        @if (Sessions.IsUnlocked)
        {
            <VaultRecordWorkspaceView />
        }
        @if (Sessions.IsUnlocked)
        {
            <p>Active account: @Sessions.ActiveAccountId</p>
            <button type="button" class="session-lock" @onclick="LockVault">Lock vault</button>
        }
        else
        {
            <label for="vault-account">Stellar account (public G-address)</label>
            <input id="vault-account" class="vault-field" autocomplete="off" spellcheck="false"
                   @bind="_accountId" disabled="@_busy" maxlength="56" />
            <label for="vault-passphrase">Vault passphrase</label>
            <input id="vault-passphrase" class="vault-field" type="password"
                   autocomplete="off" @bind="_passphrase" disabled="@_busy" />
            <div class="vault-actions">
                <button type="button" class="session-lock" disabled="@_busy" @onclick="CreateVault">Create vault</button>
                <button type="button" class="session-lock" disabled="@_busy" @onclick="UnlockVault">Unlock vault</button>
            </div>
            <p class="notice">Authorization is not configured: these actions currently fail closed and will not create or unlock credentials.</p>
        }
        @if (!string.IsNullOrEmpty(_message))
        {
            <p role="status" aria-live="polite">@_message</p>
        }
    </section>
</AdaptiveShell>

@code {
    private sealed class RuntimeStatus
    {
        public bool Ready { get; set; }
        public bool CryptoReady { get; set; }
        public bool Bip39Ready { get; set; }
        public bool HdReady { get; set; }
        public bool LedgerReady { get; set; }
        public bool SdkReady { get; set; }
    }

    private bool? _runtimeReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // JS interop is available after the WebView's first render. Run the
        // credential-free check automatically so the UI fails closed promptly.
        await CheckRuntimeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckRuntimeAsync()
    {
        if (_ledgerBusy) return;
        _ledgerBusy = true;
        try
        {
            var status = await JS.InvokeAsync<RuntimeStatus>("stellarVaultNativeRuntime.inspect");
            _runtimeReady = status.Ready;
            _ledgerMessage = status.Ready
                ? "Stellar runtime ready. You can connect to your selected network."
                : "Runtime incomplete: " + string.Join(", ", new[]
                    {
                        status.CryptoReady ? null : "WebCrypto",
                        status.Bip39Ready ? null : "BIP-39",
                        status.HdReady ? null : "HD keys",
                        status.LedgerReady ? null : "ledger scripts",
                        status.SdkReady ? null : "Stellar SDK"
                    }.Where(x => x is not null));
        }
        catch
        {
            _runtimeReady = false;
            _ledgerMessage = "Unable to verify the WebView Stellar runtime. Ledger access is blocked.";
        }
        finally { _ledgerBusy = false; }
    }

    private string _ledgerNetwork = "testnet";
    private string _ledgerMnemonic = string.Empty;
    private bool _ledgerBusy;
    private string? _ledgerMessage;
    private IReadOnlyList<LedgerRecordItem> _ledgerRecords = [];

    private async Task ConnectLedgerAsync()
    {
        if (_ledgerBusy || Ledger.IsConnected || _runtimeReady != true) return;
        _ledgerBusy = true;
        _ledgerMessage = null;
        try
        {
            var (url, passphrase) = _ledgerNetwork switch
            {
                "testnet" => ("https://horizon-testnet.stellar.org", "Test SDF Network ; September 2015"),
                "public" => ("https://horizon.stellar.org", "Public Global Stellar Network ; September 2015"),
                _ => throw new InvalidOperationException("Unsupported network.")
            };
            await Ledger.ConnectAsync(_ledgerMnemonic, url, passphrase);
            NetworkSelection.Select(_ledgerNetwork);
            // A connected transport is not permission to write: remain local.
            StorageMode.Reset();
            _ledgerRecords = await Ledger.ReadAsync();
            _ledgerMessage = "Ledger records recovered (read-only).";
        }
        catch
        {
            StorageMode.Reset();
            _ledgerRecords = [];
            _ledgerMessage = "Ledger connection or recovery failed. Check your mnemonic, network and connection.";
            try { await Ledger.DisconnectAsync(); } catch { /* Do not mask the recovery failure. */ }
        }
        finally
        {
            _ledgerMnemonic = string.Empty;
            _ledgerBusy = false;
        }
    }

    private async Task RefreshLedgerAsync()
    {
        if (_ledgerBusy || !Ledger.IsConnected) return;
        _ledgerBusy = true;
        try
        {
            _ledgerRecords = await Ledger.ReadAsync();
            _ledgerMessage = "Ledger records refreshed.";
        }
        catch
        {
            _ledgerRecords = [];
            _ledgerMessage = "Ledger recovery failed. No records were displayed.";
        }
        finally { _ledgerBusy = false; }
    }

    private async Task DisconnectLedgerAsync()
    {
        if (_ledgerBusy) return;
        _ledgerBusy = true;
        try { await Ledger.DisconnectAsync(); }
        finally
        {
            StorageMode.Reset();
            _ledgerMnemonic = string.Empty;
            _ledgerRecords = [];
            _ledgerMessage = "Ledger disconnected.";
            _ledgerBusy = false;
        }
    }

    private string _accountId = string.Empty;
    private string _passphrase = string.Empty;
    private string? _message;
    private bool _busy;

    protected override void OnInitialized() => Sessions.StateChanged += OnSessionChanged;

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private Task CreateVault() => RunAsync(create: true);
    private Task UnlockVault() => RunAsync(create: false);

    private async Task RunAsync(bool create)
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        try
        {
            if (create) await Workflow.CreateAsync(_accountId.Trim(), _passphrase);
            else await Workflow.UnlockAsync(_accountId.Trim(), _passphrase);
            _message = "Session activated.";
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or ArgumentException or
                                     System.Security.Cryptography.CryptographicException or
                                     FileNotFoundException or InvalidOperationException or OperationCanceledException)
        {
            // Never disclose underlying credentials or intermediate cryptographic values.
            _message = ex is UnauthorizedAccessException
                ? "Account ownership verification is unavailable. Vault remains locked."
                : "Vault operation failed. Check the account and credentials.";
        }
        finally
        {
            _passphrase = string.Empty;
            _busy = false;
        }
    }

    private void LockVault()
    {
        Workflow.Lock();
        _passphrase = string.Empty;
        _message = "Vault locked.";
    }

    public async ValueTask DisposeAsync()
    {
        Sessions.StateChanged -= OnSessionChanged;
        StorageMode.Reset();
        _ledgerMnemonic = string.Empty;
        _ledgerRecords = [];
        // Closing the WebView must release any session keys retained by JS.
        if (Ledger.IsConnected)
        {
            try { await Ledger.DisconnectAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
                // The native WebView may already be gone during app shutdown.
            }
        }
    }
}
