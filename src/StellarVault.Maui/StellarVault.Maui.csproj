<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('linux'))">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>StellarVault.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>StellarVault</ApplicationTitle>
    <ApplicationId>ir.svault.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.0" />
    <ProjectReference Include="../StellarVault.Core/StellarVault.Core.csproj" />
    <ProjectReference Include="../StellarVault.UI/StellarVault.UI.csproj" />
  </ItemGroup>
  <!-- Package the existing PWA Stellar JavaScript runtime into the MAUI WebView.
       Link files from their single source to avoid protocol/version drift.
       This does not enable ledger signing until the host adapter is wired. -->
  <ItemGroup>
    <Content Include="../StellarVault.Pwa/wwwroot/js/vendor/stellar-sdk.min.js"
             Link="wwwroot/js/vendor/stellar-sdk.min.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../StellarVault.Pwa/wwwroot/js/bip39-english.js"
             Link="wwwroot/js/bip39-english.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../StellarVault.Pwa/wwwroot/js/hd-keys.js"
             Link="wwwroot/js/hd-keys.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../StellarVault.Pwa/wwwroot/js/vault-v2-mnemonic.js"
             Link="wwwroot/js/vault-v2-mnemonic.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../StellarVault.Pwa/wwwroot/js/vault-v2-network.js"
             Link="wwwroot/js/vault-v2-network.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../StellarVault.Pwa/wwwroot/js/hd-registry.js"
             Link="wwwroot/js/hd-registry.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../StellarVault.Pwa/wwwroot/js/vault-v2-chain.js"
             Link="wwwroot/js/vault-v2-chain.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../StellarVault.Pwa/wwwroot/js/ledger-compat/*.js"
             Link="wwwroot/js/ledger-compat/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <MauiIcon Include="Resources/Splash/splash.svg" Color="#07110c" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#07110c" BaseSize="256,256" />
    <MauiAsset Include="Resources/Raw/**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
