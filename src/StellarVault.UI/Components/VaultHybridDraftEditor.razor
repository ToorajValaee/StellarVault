@using VaultEngine.Stellar.Services
@inject VaultHybridDraftWorkspace Drafts
@inject VaultSessionManager Sessions
@inject VaultDeviceRetentionGate Retention
@implements IDisposable

<section class="terminal-panel sv-hybrid-panel sv-hybrid-drafts-panel" aria-label="Offline encrypted record and folder drafts">
    <div class="sv-hybrid-heading"><div class="panel-kicker">Encrypted on this device</div><h3>@(_editingScreen ? "Edit draft" : "Local drafts")</h3><p>Manage encrypted drafts before choosing when to synchronize them.</p></div>
    @if (!Retention.AllowsLocalPersistence || !Sessions.IsUnlocked)
    {
        <p role="status">Choose encrypted local storage and unlock the local vault before editing drafts.</p>
    }
    else
    {
        @if (!_editingScreen)
        {
            <div class="sv-access-actions">
                <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="NewRecord">＋ Record</button>
                <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="NewFolder">＋ Folder</button>
                <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="RefreshAsync">Refresh</button>
            </div>
        }
        else
        {
            <button type="button" class="sv-native-back pixel-button compact" disabled="@_busy" @onclick="BackToDraftList">← Back to drafts</button>
            <h3>@(_editingId is not null ? "Edit draft" : _isFolder ? "New folder" : "New record")</h3>
        }
        @if (_editingScreen)
        {
        <VaultRecordFields IsFolder="_isFolder"
                           Disabled="_busy"
                           MultilineSecret="true"
                           ExcludedId="@(_items.FirstOrDefault(x => x.MutationId == _editingId)?.EntityId)"
                           AdditionalFolders="@LocalFolderOptions"
                           @bind-Title="_title"
                           @bind-FolderId="_folderId"
                           @bind-Username="_username"
                           @bind-Url="_url"
                           @bind-Secret="_content"
                           @bind-Notes="_notes"
                           @bind-Tags="_tags"
                           @bind-ShowSecret="_showDraftSecret" />
        @if (!string.IsNullOrWhiteSpace(_folderId))
        {
            <p class="advanced-help">An unpublished folder parent blocks publication until independently confirmed.</p>
            <button type="button" class="pixel-button compact" disabled="@_busy"
                    @onclick="ClearParent">Move to vault root</button>
        }
        <button type="button" class="pixel-button primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_title) || (!_isFolder && string.IsNullOrEmpty(_content)))" @onclick="SaveAsync">Save encrypted draft</button>
        @if (_editingId is not null)
        {
            <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="DiscardAsync">Discard unsubmitted draft</button>
        }
        @if (!string.IsNullOrWhiteSpace(_status))
        {
            <p role="status" class="terminal-alert">@_status</p>
        }
        }
        else
        {
        @if (!string.IsNullOrEmpty(_status))
        {
            <p role="status" class="terminal-alert">@_status</p>
        }
        @foreach (var draft in _items)
        {
            <div class="data-field sv-hybrid-item">
                <strong>@draft.Draft.Title</strong>
                <p>@draft.Kind · @draft.State · @draft.CreatedUtc.ToLocalTime().ToString("g")</p>
                @if (!string.IsNullOrWhiteSpace(draft.Draft.FolderId))
                {
                    <p class="advanced-help">Parent folder: @draft.Draft.FolderId</p>
                }
                @if (draft.IsCorrupt)
                {
                    <p class="terminal-alert warning" role="alert">
                        The encrypted draft is invalid or damaged. It is preserved in the
                        local queue and cannot be edited or used as a folder parent.
                        Inspect the queue before attempting recovery.
                    </p>
                }
                else if (draft.State == VaultSyncState.Pending)
                {
                    <button type="button" class="pixel-button compact" disabled="@_busy"
                            @onclick="() => Open(draft)">Edit draft</button>
                }
                else
                {
                    <small>Submitted or unresolved. Cannot be edited or replayed.</small>
                }
                @if (!draft.IsCorrupt &&
                    draft.Kind == VaultMutationKind.CreateFolder &&
                    draft.State is VaultSyncState.Pending or VaultSyncState.Confirmed)
                {
                    <button type="button" class="pixel-button compact" disabled="@_busy"
                            @onclick="() => SelectParent(draft)">SET AS CURRENT PARENT</button>
                    <button type="button" class="pixel-button compact" disabled="@_busy"
                            @onclick="() => CreateChild(draft, false)">NEW RECORD IN FOLDER</button>
                    <button type="button" class="pixel-button compact" disabled="@_busy"
                            @onclick="() => CreateChild(draft, true)">NEW SUBFOLDER</button>
                    <small>Folder ID: @draft.EntityId</small>
                }
            </div>
        }
        }
    }
</section>

@code {
    private IReadOnlyList<VaultHybridDraftWorkspace.DraftItem> _items = [];
    private bool _busy;
    private string? _status, _editingId, _openedRevision;
    private long _loadedEpoch = -1;
    private string _title = "", _content = "", _username = "", _url = "",
        _notes = "", _tags = "", _folderId = "";
    private bool _isFolder;
    private bool _editingScreen;
    private bool _showDraftSecret;
    private IReadOnlyDictionary<string, string> LocalFolderOptions =>
        _items.Where(x => !x.IsCorrupt &&
            x.Kind == VaultMutationKind.CreateFolder &&
            (x.State is VaultSyncState.Pending or VaultSyncState.Confirmed))
            .GroupBy(x => x.EntityId, StringComparer.Ordinal)
            .ToDictionary(x => x.Key, x => x.First().Draft.Title + " (local draft)",
                StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        Sessions.StateChanged += OnSessionChanged;
        _ = InvokeAsync(RefreshForSessionAsync);
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(RefreshForSessionAsync);
    }

    private async Task RefreshForSessionAsync()
    {
        var epoch = Sessions.Epoch;
        if (_loadedEpoch == epoch) return;
        _loadedEpoch = epoch;
        Reset(false);
        _editingScreen = false;
        _items = [];
        if (!Sessions.IsUnlocked || !Retention.AllowsLocalPersistence)
        {
            StateHasChanged();
            return;
        }
        try
        {
            var current = await Drafts.ListAsync();
            if (Sessions.IsUnlocked && Retention.AllowsLocalPersistence &&
                Sessions.Epoch == epoch)
                _items = current;
        }
        catch (Exception)
        {
            if (Sessions.Epoch == epoch)
                _status = "Encrypted local directory unavailable. Use REFRESH DRAFTS.";
        }
        StateHasChanged();
    }

    public void Dispose() => Sessions.StateChanged -= OnSessionChanged;

    private void Reset(bool folder)
    {
        _editingId = null;
        _openedRevision = null;
        _isFolder = folder;
        _title = _content = _username = _url = _notes = _tags = _folderId = "";
        _showDraftSecret = false;
        _status = null;
    }

    private void BackToDraftList()
    {
        if (_busy) return;
        Reset(false);
        _editingScreen = false;
    }

    private void NewRecord() { Reset(false); _editingScreen = true; }
    private void NewFolder() { Reset(true); _editingScreen = true; }
    private void ClearParent() { if (!_busy) _folderId = ""; }

    private void CreateChild(VaultHybridDraftWorkspace.DraftItem parent, bool folder)
    {
        if (_busy || parent.Kind != VaultMutationKind.CreateFolder ||
            parent.State is not (VaultSyncState.Pending or VaultSyncState.Confirmed)) return;
        Reset(folder);
        _folderId = parent.EntityId;
        _editingScreen = true;
        _status = "New local child of " + parent.Draft.Title +
            ". Save it offline; publication will wait for the parent.";
    }

    private void SelectParent(VaultHybridDraftWorkspace.DraftItem item)
    {
        if (_busy || item.State is not (VaultSyncState.Pending or VaultSyncState.Confirmed) ||
            item.Kind != VaultMutationKind.CreateFolder) return;
        if (_editingId is not null && _items.Any(x => x.MutationId == _editingId &&
            x.EntityId.Equals(item.EntityId, StringComparison.OrdinalIgnoreCase)))
        {
            _status = "A folder cannot be its own parent.";
            return;
        }
        _folderId = item.EntityId;
        _status = "Local parent selected. Child stays blocked from Stellar publication until the parent is confirmed.";
    }

    private void Open(VaultHybridDraftWorkspace.DraftItem item)
    {
        if (_busy || item.State != VaultSyncState.Pending) return;
        _editingId = item.MutationId;
        _editingScreen = true;
        _openedRevision = item.PayloadSha256;
        _isFolder = item.Draft.IsFolder;
        _title = item.Draft.Title;
        _content = _isFolder ? "" : item.Draft.Content;
        _showDraftSecret = false;
        _folderId = item.Draft.FolderId ?? "";
        _username = item.Draft.UserName ?? "";
        _url = item.Draft.Url ?? "";
        _notes = item.Draft.Notes ?? "";
        _tags = string.Join(", ", item.Draft.Tags ?? []);
        _status = "Editing local-only draft. No Stellar transaction will be sent.";
    }

    private async Task RefreshAsync()
    {
        if (_busy || !Retention.AllowsLocalPersistence || !Sessions.IsUnlocked) return;
        _busy = true;
        try
        {
            var epoch = Sessions.Epoch;
            var refreshed = await Drafts.ListAsync();
            if (Sessions.Epoch != epoch || !Sessions.IsUnlocked)
                throw new InvalidOperationException("Vault session changed.");
            _items = refreshed;
            _status = "Encrypted local drafts loaded.";
        }
        catch (Exception) { _items = []; _status = "Cannot read local encrypted drafts."; }
        finally { _busy = false; }
    }

    private async Task SaveAsync()
    {
        if (_busy || !Retention.AllowsLocalPersistence || !Sessions.IsUnlocked) return;
        _busy = true;
        try
        {
            var draft = new LedgerRecordDraft(_title,
                _isFolder ? "folder" : _content,
                string.IsNullOrWhiteSpace(_folderId) ? null : _folderId,
                _tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Distinct(StringComparer.OrdinalIgnoreCase).ToArray(),
                _isFolder, _isFolder ? null : _username,
                _isFolder ? null : _url, _isFolder ? null : _notes);
            if (_editingId is null) await Drafts.CreateAsync(draft);
            else await Drafts.ReviseAsync(_editingId, draft,
                _openedRevision ?? throw new InvalidOperationException(
                    "The opened draft revision is unavailable; reopen the draft."));
            _items = await Drafts.ListAsync();
            Reset(_isFolder);
            _editingScreen = false;
            _status = "Draft saved on this device. No Stellar transaction was submitted.";
        }
        catch (Exception)
        {
            _status = "Draft could not be saved. It may have changed in another tab. Refresh and reopen before trying again; current editor contents were not submitted.";
        }
        finally { _busy = false; }
    }

    private async Task DiscardAsync()
    {
        if (_busy || _editingId is null) return;
        _busy = true;
        try
        {
            await Drafts.DiscardAsync(_editingId);
            _items = await Drafts.ListAsync();
            Reset(_isFolder);
            _editingScreen = false;
            _status = "Draft discarded.";
        }
        catch (Exception) { _status = "Cannot discard this draft; inspect its dependencies."; }
        finally { _busy = false; }
    }
}
