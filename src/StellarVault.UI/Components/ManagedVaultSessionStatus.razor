@using VaultEngine.Stellar.Services
@inject VaultSessionManager Sessions
@implements IDisposable

<section aria-label="Vault session status">
    <SecurityStatus Heading="@(Sessions.IsUnlocked ? "VAULT SESSION ACTIVE" : "VAULT LOCKED")"
                    Message="@(Sessions.IsUnlocked
                        ? "The active account session is unlocked. Record operations remain gated until verified account authorization and storage integration are complete."
                        : "No account session is unlocked. Secure wallet authorization and persistent storage are required before vault creation and unlock can be enabled.")" />
    @if (Sessions.IsUnlocked)
    {
        <p>Account: @Sessions.ActiveAccountId</p>
        <button type="button" @onclick="Lock">Lock vault</button>
    }
</section>

@code {
    protected override void OnInitialized() => Sessions.StateChanged += Changed;
    private void Changed() => _ = InvokeAsync(StateHasChanged);
    private void Lock() => Sessions.Lock();
    public void Dispose() => Sessions.StateChanged -= Changed;
}
