@using Microsoft.JSInterop
@using StellarVault.Core.Services
@inject IStellarSecretKeyLedger Ledger
@inject VaultLinkedQueueKeySession LinkedQueueKeys
@inject VaultAccountStrategyFactory AccountStrategies
@inject VaultLinkedAccountExpansion LinkedExpansion
@inject VaultLinkedRecordWritePlanner WritePlanner
@inject VaultLinkedRecoveryInspector RecoveryInspector
@inject VaultNetworkSelection NetworkSelection
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS

<section class="sv-secret-workspace sv-workspace-surface" aria-label="Secret Key linked-account vault">
    @if (!Embedded)
    {
    <header class="sv-secret-workspace-header">
        <div>
            <span class="panel-kicker">STELLAR · SECRET KEY ACCOUNT CHAIN</span>
            <h2>My vault</h2>
            <p>Independent linked accounts · @(_account?.TotalAccounts ?? 0) account(s) · Encrypted on Stellar</p>
        </div>
        <div class="sv-secret-workspace-actions">
            <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="ReloadAsync">Refresh</button>
            <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="DisconnectAsync">Lock</button>
        </div>
    </header>
    }
    @if (_account is not null && View == "records")
    {
        <div class="sv-vault-overview" aria-label="Vault contents">
            <span>@_items.Count(x => !x.IsFolder && !IsTreePart(x)) secure records &amp; files</span>
            <span aria-hidden="true">·</span>
            <span>@_account.Folders folders</span>
            <span aria-hidden="true">·</span>
            <span>Stellar connected</span>
        </div>
    }
    @if (View == "settings" || _submissionUncertain)
    {
    <div class="sv-secret-notice" role="status">
        <strong>Account architecture:</strong> Your Stellar S-key controls independently created accounts using root-key signer authorization.
        Secret Key ledger mutations are Testnet-only until independent production security review.
        Encrypted record, folder and streaming file drafts can be staged locally and published only through individual fee approvals and signed-history confirmation. Automatic synchronization and whole-tree deletion are not enabled.
    </div>
    }
    <div hidden="@(Embedded && View is not ("drafts" or "sync"))" class="sv-linked-queue-view">
        <VaultLinkedLocalQueuePanel View="@(Embedded ? View : "all")" />
    </div>
    @if (!string.IsNullOrEmpty(_status))
    {
        <p class="sv-secret-status" role="status">@_status</p>
    }
    @if (_submissionUncertain)
    {
        <p class="sv-secret-status" role="alert">A submitted transaction may be unresolved. Writes are blocked in this session. Refresh is read-only; reconcile transaction history and account/record state before starting a new session.</p>
        <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="InspectUncertainAsync">Assess unresolved transaction (read-only)</button>
        @if (_uncertainDiagnostic is not null)
        {
            <section class="sv-secret-review" aria-label="Unresolved transaction details">
                <h3>Unresolved submission — diagnostic only</h3>
                <p><strong>Operation:</strong> @_uncertainDiagnostic.Kind</p>
                <p><strong>Network:</strong> @_uncertainDiagnostic.NetworkPassphrase</p>
                <p><strong>Horizon:</strong> @_uncertainDiagnostic.HorizonUrl</p>
                <p><strong>Root:</strong> <code>@_uncertainDiagnostic.RootAccountId</code></p>
                <p><strong>Target:</strong> <code>@_uncertainDiagnostic.TargetAccountId</code></p>
                @if (_uncertainDiagnostic.RecordId is not null) { <p><strong>Record ID:</strong> <code>@_uncertainDiagnostic.RecordId</code></p> }
                <p><strong>Transaction hash:</strong> @(_uncertainDiagnostic.TransactionHash ?? "Not returned by Horizon")</p>
                @if (_recoveryFinding is not null)
                {
                    <p><strong>Current chain observation:</strong> @_recoveryFinding.Explanation</p>
                    @if (_recoveryFinding.Receipt is not null)
                    {
                        <p><strong>Historical receipt check:</strong> @_recoveryFinding.Receipt.Explanation</p>
                        @if (_recoveryFinding.Receipt.LedgerSequence is long ledgerSequence)
                        {
                            <p><strong>Reported ledger:</strong> @ledgerSequence</p>
                        }
                    }
                }
                <p>This observation is not independent proof of network inclusion, signer authorization, or record commit. Never retry from this screen.</p>
            </section>
        }
    }
    @if (_busy) { <p role="status">Verifying ledger state…</p> }
    @if (_quote is not null)
    {
        <section class="sv-secret-review" aria-label="Review Stellar transaction">
            <h3>Review before signing</h3>
            <p><strong>Action:</strong> @_quote.Kind</p>
            <p><strong>Target account:</strong> <code>@_quote.TargetAccountId</code></p>
            <p><strong>Operations:</strong> @_quote.Operations in @_quote.Transactions transaction</p>
            <p><strong>Network fee:</strong> @_quote.NetworkFeeXlm native asset</p>
            <p><strong>Peak additional reserve:</strong> @_quote.PeakReserveXlm native asset</p>
            <p><strong>Net reserve change:</strong> @_quote.NetReserveChangeXlm native asset</p>
            <p><strong>Additional funding to storage account:</strong> @_quote.FundingTopUpXlm native asset</p>
            @if (_quote.CreatesChildNode)
            {
                <p>A new independent Stellar account will be created. The root public key becomes its authorized signer; the new account's master key is disabled in the same transaction.</p>
            }
            <label class="sv-secret-approval"><input type="checkbox" @bind="_approve" disabled="@_busy" />
                I reviewed the fees, reserves and account changes and approve this specific Stellar transaction.
            </label>
            <div class="sv-secret-workspace-actions">
                <button type="button" class="pixel-button primary" disabled="@(_busy || !_approve || _submissionUncertain)" @onclick="SubmitAsync">Sign and submit to Stellar</button>
                <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="CancelQuoteAsync">Cancel</button>
            </div>
        </section>
    }
    else if (View == "records")
    {
        <div class="sv-secret-toolbar">
            <label class="search-console sv-modern-search">
                <span class="search-prefix" aria-hidden="true">⌕</span>
                <input type="search" aria-label="Search your vault" autocomplete="off"
                       @bind="_search" @bind:event="oninput"
                       placeholder="Search records, folders, and tags" />
            </label>
            <div class="sv-layout-switch" role="group" aria-label="Explorer layout">
                <button type="button" class="@(!_grid ? "selected" : "")"
                        aria-label="List view" aria-pressed="@(!_grid)"
                        @onclick="() => _grid = false">☷</button>
                <button type="button" class="@(_grid ? "selected" : "")"
                        aria-label="Grid view" aria-pressed="@_grid"
                        @onclick="() => _grid = true">▦</button>
            </div>
            @if (!Embedded)
            {
                <button type="button" class="pixel-button compact" disabled="@(_busy || !_verified || _submissionUncertain)" @onclick="NewRecord">＋ Record</button>
                <button type="button" class="pixel-button compact" disabled="@(_busy || !_verified || _submissionUncertain)" @onclick="NewFolder">＋ Folder</button>
            }
        </div>
        @if (_folderId is not null)
        {
            <button type="button" class="sv-secret-back" @onclick="GoBack">‹ Back to folder</button>
        }
        @if (!Embedded)
        {
            <div class="sv-access-actions"><details class="sv-object-actions"><summary>⋯ Vault menu</summary><div class="sv-object-menu"><VaultRecordTransferPanel Mode="import" Strategy="@VaultMutationStrategyPolicy.Linked" Records="_items" /></div></details></div>
        }
        <div class="sv-linked-explorer-layout">
        <VaultExplorerTree Folders="@_items.Where(x => x.IsFolder).ToArray()"
                           SelectedFolderId="_folderId"
                           CollapsedFolderIds="_collapsedFolders"
                           OnFolderSelected="SelectLinkedFolderFromTree"
                           OnToggleFolder="ToggleLinkedFolder" />
        <div class="sv-secret-browser sv-explorer-main @(_grid ? "tiles sv-view-grid" : "rows sv-view-list")">
            <VaultPublishedItemsView Strategy="@VaultMutationStrategyPolicy.Linked" Items="_items"
                                     FolderId="_folderId"
                                     Search="_search"
                                     SelectedItemId="_selected?.Id"
                                     CanEdit="@(_verified && !_submissionUncertain)"
                                     CanDelete="@(_verified && !_submissionUncertain)"
                                     Busy="_busy"
                                     EmptyMessage="No items found in this folder."
                                     OnOpen="SelectItem"
                                     OnEdit="EditLinkedRow"
                                     OnDelete="DeleteLinkedRowAsync" />
        </div>
        @if (_selected is not null && _editMode is null)
        {
            <VaultRecordInspector @key="_selected.Id"
                                  Embedded="true"
                                  Item="_selected"
                                  Strategy="@VaultMutationStrategyPolicy.Linked"
                                  Records="_items"
                                  FolderPath="@(string.IsNullOrEmpty(_selected.FolderId)
                                      ? "My vault" : LinkedFolderPath(_selected.FolderId))"
                                  CanEdit="@(_verified && !_submissionUncertain)"
                                  CanDelete="@(_verified && !_submissionUncertain)"
                                  FileActionLabel="Open verified file downloads"
                                  OnCopy="CopyLinkedValueAsync"
                                  OnClose="Deselect"
                                  OnEdit="EditSelected"
                                  OnDelete="DeleteSelectedAsync"
                                  OnOpenFolder="() => OpenFolder(_selected.Id)"
                                  OnVerifyFile="OpenLinkedFileDownloads" />
        }
        @if (_editMode is not null)
        {
            <section class="sv-secret-editor" aria-label="Edit encrypted record">
                <h3>@(_editMode == "create" ? (_isFolder ? "New folder" : "New record") : "Edit published item")</h3>
                <VaultRecordFields IsFolder="_isFolder"
                                   ExcludedId="_draftId"
                                   Folders="@_items.Where(x => x.IsFolder).ToArray()"
                                   @bind-Title="_title"
                                   @bind-FolderId="_draftFolderId"
                                   @bind-Username="_username"
                                   @bind-Url="_url"
                                   @bind-Secret="_content"
                                   @bind-Notes="_notes"
                                   @bind-Tags="_tags"
                                   @bind-ShowSecret="_showSecretEntry" />
                <div class="sv-secret-workspace-actions">
                    <button type="button" class="pixel-button primary" disabled="@(_busy || _submissionUncertain || string.IsNullOrWhiteSpace(_title))" @onclick="QuoteSaveAsync">Review Stellar cost</button>
                    <button type="button" class="pixel-button compact" @onclick="CloseEditor">Cancel</button>
                </div>
            </section>
        }
        </div>
    }
    @if (View == "settings")
    {
        <section class="sv-modern-settings sv-workspace-surface" aria-label="Vault settings">
            <div class="terminal-panel sv-modern-settings-section">
                <h2>Connection</h2>
                <div class="sv-modern-setting-row">
                    <div><strong>Network</strong><p>@(NetworkSelection.SelectedPreset == "public" ? "Stellar Mainnet" : NetworkSelection.SelectedPreset == "custom" ? "Custom Stellar network" : "Stellar Testnet")</p></div>
                    <span class="sv-modern-setting-status">@(Ledger.IsConnected ? "Connected" : "Not connected")</span>
                </div>
                @if (_account is not null)
                {
                    <div class="sv-modern-setting-row">
                        <div><strong>Account chain</strong><p>@_account.TotalAccounts independent linked Stellar accounts</p>
                            <p>Root address: @_account.RootAccountId</p><p>Tail address: @_account.TailAccountId</p></div>
                    </div>
                    <div class="sv-modern-setting-row">
                        <div><strong>Spendable XLM</strong><p>@_account.SpendableNative XLM</p></div>
                        <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="ReloadAsync">Refresh account</button>
                    </div>
                }
            </div>
            <div class="terminal-panel sv-modern-settings-section">
                <h2>Privacy &amp; storage</h2>
                <div class="sv-modern-setting-row">
                    <div><strong>Independent Secret Key vault</strong>
                        <p>Account-chain signer authorization, local encryption credentials, and encrypted storage namespaces are isolated from mnemonic/HD vaults.</p></div>
                </div>
                <p class="advanced-help">All network mutations require a separate transaction quote, fee review and explicit approval. Local drafts remain on this device until reviewed for publication.</p>
                <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="DisconnectAsync">Lock vault</button>
            </div>
        </section>
    }
</section>

@code {
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public string View { get; set; } = "records";
    [Parameter] public EventCallback<string> OnViewChange { get; set; }
    public Task LockFromShellAsync() => DisconnectAsync();
    public Task RefreshFromShellAsync() => ReloadAsync();
    public Task ShowAccountInfoFromShellAsync() => OnViewChange.InvokeAsync("settings");
    public void CreateRecordFromShell()
    {
        if (!_verified || _submissionUncertain || _busy)
        {
            _status = "Record creation is unavailable until this S-key account and any unresolved transactions are verified.";
            return;
        }
        NewRecord();
    }
    public void CreateFolderFromShell()
    {
        if (!_verified || _submissionUncertain || _busy)
        {
            _status = "Folder creation is unavailable until this S-key account and any unresolved transactions are verified.";
            return;
        }
        NewFolder();
    }

    private IReadOnlyList<LedgerRecordItem> _items = [];
    private LedgerAccountInfo? _account;
    private LedgerRecordItem? _selected;
    private string? _folderId, _editMode, _status;
    private string _draftFolderId = "";
    private string _search = "", _title = "", _content = "", _username = "",
        _url = "", _notes = "", _tags = "";
    private bool _busy, _grid, _isFolder, _approve, _verified, _showSecretEntry;
    private string _draftId = "";
    private VaultSecretLedgerQuote? _quote;
    private bool _capacityRolloverPending;
    private bool _submissionUncertain;
    private VaultSecretSubmissionDiagnostic? _uncertainDiagnostic;
    private VaultLinkedRecoveryFinding? _recoveryFinding;

    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync()
    {
        if (_busy || !Ledger.IsConnected) return;
        _busy = true;
        _verified = false;
        try
        {
            _items = await Ledger.ReadAsync();
            _account = await Ledger.InspectAccountInfoAsync();
            // Resolve the explicitly selected linked-account strategy; never try HD as fallback.
            var inspection = await AccountStrategies.InspectConnectedAsync(new VaultAccountRequest(
                ConnectedStellarAccountStrategy.StellarChain, NetworkSelection.Network,
                _account.RootAccountId, ConnectedStellarAccountStrategy.LinkedMode));
            if (inspection.AccountCount != _account.TotalAccounts ||
                !string.Equals(inspection.TailAddress, _account.TailAccountId, StringComparison.Ordinal))
                throw new InvalidDataException("Connected linked-account inventory changed during inspection.");
            // Lock/reopen in the same JS environment must not silently re-enable
            // writes after a network submission with an unknown outcome.
            _uncertainDiagnostic = await Ledger.InspectUncertainSubmissionAsync();
            _submissionUncertain = _uncertainDiagnostic is not null;
            _recoveryFinding = null;
            _verified = true;
            _selected = null;
            _status = _submissionUncertain
                ? "An earlier submission is unresolved. Writes remain blocked; inspect the transaction before continuing."
                : null;
        }
        catch
        {
            _submissionUncertain = true;
            _status = "Ledger recovery is incomplete or the network is unavailable. No writes are permitted until recovery succeeds.";
            _items = []; _account = null; _selected = null;
        }
        finally { _busy = false; }
    }
    private Task OpenLinkedFileDownloads() => OnViewChange.InvokeAsync("sync");
    private async Task CopyLinkedValueAsync(string? value)
    {
        if (string.IsNullOrEmpty(value)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", value); }
        catch { _status = "Clipboard is not available on this device."; }
    }

    private void Deselect() { _selected = null; }
    private void EditLinkedRow(LedgerRecordItem item)
    {
        SelectItem(item);
        EditSelected();
    }

    private Task DeleteLinkedRowAsync(LedgerRecordItem item)
    {
        SelectItem(item);
        return DeleteSelectedAsync();
    }

    private void SelectItem(LedgerRecordItem item)
    {
        _selected = item; _editMode = null;
    }
    private void OpenFolder(string id) { _folderId = id; _selected = null; }
    private readonly HashSet<string> _collapsedFolders = new(StringComparer.Ordinal);

    private void ToggleLinkedFolder(string id)
    {
        if (!_collapsedFolders.Add(id)) _collapsedFolders.Remove(id);
    }

    private void SelectLinkedFolderFromTree(string? id)
    {
        if (id is null) GoToRoot();
        else OpenFolder(id);
    }

    private void GoToRoot() { _folderId = null; _selected = null; }

    private static bool IsTreePart(LedgerRecordItem item) =>
        VaultPublishedFileClassification.IsInternalNode(item);

    private string LinkedFolderPath(string? id)
    {
        var labels = new List<string>();
        var visited = new HashSet<string>(StringComparer.Ordinal);
        while (id is not null && visited.Add(id))
        {
            var folder = _items.FirstOrDefault(x => x.IsFolder && x.Id == id);
            if (folder is null) break;
            labels.Insert(0, folder.Title);
            id = folder.FolderId;
        }
        return string.Join("/", labels);
    }

    private void GoBack()
    {
        _folderId = _items.FirstOrDefault(x => x.Id == _folderId)?.FolderId;
        _selected = null;
    }
    private void NewRecord() => BeginCreate(false);
    private void NewFolder() => BeginCreate(true);
    private void BeginCreate(bool isFolder)
    {
        if (_busy || _submissionUncertain) return;
        _editMode = "create"; _draftId = Guid.NewGuid().ToString("N")[..16];
        _isFolder = isFolder; _showSecretEntry = false;
        _draftFolderId = _folderId ?? "";
        _title = _content = _username = _url = _notes = _tags = "";
        _selected = null; _status = null;
    }
    private void EditSelected()
    {
        if (_selected is null || _busy || _submissionUncertain ||
            VaultPublishedFileClassification.IsManagedFileProtocolRecord(_selected) ||
            IsTreePart(_selected)) return;
        _editMode = "update"; _draftId = _selected.Id;
        _isFolder = _selected.IsFolder; _showSecretEntry = false;
        _title = _selected.Title;
        _draftFolderId = _selected.FolderId ?? "";
        _content = _selected.Content; _username = _selected.UserName ?? "";
        _url = _selected.Url ?? ""; _notes = _selected.Notes ?? "";
        _tags = string.Join(", ", _selected.Tags ?? []);
    }
    private void CloseEditor()
    {
        _editMode = null; _content = ""; _showSecretEntry = false;
        _draftFolderId = "";
        _title = _username = _url = _notes = _tags = "";
    }
    private LedgerRecordDraft CurrentDraft() => new(_title.Trim(),
        _isFolder ? "folder" : _content,
        string.IsNullOrWhiteSpace(_draftFolderId) ? null : _draftFolderId,
        _tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToArray(),
        _isFolder, _username, _url, _notes);
    private async Task QuoteSaveAsync()
    {
        if (_busy || _submissionUncertain || _editMode is null) return;
        _busy = true; _status = null;
        try
        {
            // The Core planner—not the UI—decides whether a new storage account
            // is needed. Keep the draft in memory until both reviews complete.
            var plan = await WritePlanner.PrepareAsync(
                _draftId, CurrentDraft(), _editMode == "create");
            _quote = plan.Quote;
            _capacityRolloverPending = plan.RequiresCapacityExpansion;
            _approve = false;
            if (plan.RequiresCapacityExpansion)
                _status = "The current account is full. Review the account creation cost; after approval, the record will be prepared for a separate save review.";
            else
                CloseEditor();
        }
        catch (Exception ex) { _status = "Unable to prepare a safe ledger transaction: " + ex.Message; }
        finally { _busy = false; }
    }
    private async Task DeleteSelectedAsync()
    {
        if (_busy || _submissionUncertain || _selected is null ||
            VaultPublishedFileClassification.IsManagedFileProtocolRecord(_selected) ||
            IsTreePart(_selected)) return;
        _busy = true; _status = null;
        try { _quote = await Ledger.QuoteDeleteAsync(_selected.Id); _approve = false; }
        catch (Exception ex) { _status = "Delete review unavailable: " + ex.Message; }
        finally { _busy = false; }
    }
    private async Task CancelQuoteAsync()
    {
        if (_quote is null || _busy) return;
        var id = _quote.QuoteId;
        var quoteKind = _quote.Kind;
        _quote = null; _approve = false;
        if (quoteKind == "expand") _capacityRolloverPending = false;
        try
        {
            if (quoteKind == "expand") await LinkedExpansion.CancelAsync(id);
            else await Ledger.CancelQuoteAsync(id);
        }
        catch { _status = "The pending review could not be cleared. Lock the vault if needed."; }
    }
    private async Task SubmitAsync()
    {
        if (_busy || _submissionUncertain || !_approve || _quote is null) return;
        _busy = true;
        var quote = _quote;
        var approved = _approve;
        _quote = null; _approve = false;
        try
        {
            var hash = quote.Kind == "expand"
                ? await LinkedExpansion.SubmitApprovedAsync(quote, approved)
                : await Ledger.SubmitApprovedAsync(quote.QuoteId);
            _status = "Stellar submission returned a transaction hash; connected state reloaded (independent historical verification still required): " + hash;
            _verified = false;
            _items = await Ledger.ReadAsync();
            _account = await Ledger.InspectAccountInfoAsync();
            var inspection = await AccountStrategies.InspectConnectedAsync(new VaultAccountRequest(
                ConnectedStellarAccountStrategy.StellarChain, NetworkSelection.Network,
                _account.RootAccountId, ConnectedStellarAccountStrategy.LinkedMode));
            if (inspection.AccountCount != _account.TotalAccounts ||
                !string.Equals(inspection.TailAddress, _account.TailAccountId, StringComparison.Ordinal))
                throw new InvalidDataException("Linked-account inventory changed during reload.");
            _verified = true;
            _selected = null;
            if (quote.Kind == "expand" && _capacityRolloverPending)
            {
                // The first approval only provisions capacity. Never auto-submit
                // the deferred record: present a new exact fee/record quote.
                _capacityRolloverPending = false;
                try
                {
                    var draft = CurrentDraft();
                    _quote = await WritePlanner.PrepareDeferredCreateAsync(_draftId, draft);
                    _approve = false;
                    CloseEditor();
                    _status = "Account capacity was added and checked. Review the separate record-save transaction before signing.";
                }
                catch (Exception ex)
                {
                    // Keep the in-memory editor draft so the user can review it again;
                    // do not assume the record was saved or submit another transaction.
                    _status = "Account expansion completed, but the record has NOT been saved. Review its save again: " + ex.Message;
                }
            }
        }
        catch (VaultLinkedExpansionPreflightException)
        {
            // Core explicitly guarantees its expansion transport was never
            // invoked for this approval. A sibling session might nonetheless
            // have an independent unresolved broadcast; inspect its marker.
            _capacityRolloverPending = false;
            _quote = null;
            _verified = false;
            try
            {
                _uncertainDiagnostic = await Ledger.InspectUncertainSubmissionAsync();
                _submissionUncertain = _uncertainDiagnostic is not null;
            }
            catch
            {
                // Missing diagnostic transport is not evidence of safety.
                _submissionUncertain = true;
                _uncertainDiagnostic = null;
            }
            _recoveryFinding = null;
            _status = _submissionUncertain
                ? "The expansion review failed before submission, but another transaction is unresolved. Reconcile before writing."
                : "No expansion transaction was submitted for this review. Refresh the ledger and request a new quote.";
        }
        catch
        {
            _capacityRolloverPending = false;
            _submissionUncertain = true;
            _uncertainDiagnostic = null;
            _recoveryFinding = null;
            _verified = false;
            _status = "The submission could not be verified. Its result may be uncertain. Refresh the ledger and reconcile before trying again.";
        }
        finally { _busy = false; }
    }
    private async Task InspectUncertainAsync()
    {
        if (_busy || !_submissionUncertain) return;
        _busy = true;
        try
        {
            _recoveryFinding = await RecoveryInspector.InspectAsync();
            _uncertainDiagnostic = _recoveryFinding.Diagnostic;
            if (_uncertainDiagnostic is null)
                _status = "No volatile submission details remain. This does NOT clear the reconciliation requirement.";
        }
        catch
        {
            _status = "The volatile diagnostic could not be read. Writes remain blocked until independently reconciled.";
        }
        finally { _busy = false; }
    }
    private async Task DisconnectAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            // The Core expansion review is scoped to this UI workspace and
            // must not remain pending after its JS signer session is locked.
            // Cancelling a quote NEVER transmits a transaction or clears an
            // already unresolved submission quarantine.
            try
            {
                // Also clears a Core-side expansion quote left behind when the
                // UI review was dropped before a network transmission.
                await LinkedExpansion.AbandonUnsubmittedAsync();
                if (_quote is { Kind: not "expand" } pending)
                    await Ledger.CancelQuoteAsync(pending.QuoteId);
            }
            catch
            {
                // Disconnect and zero the signing session regardless.
                // An abandoned quote must not be submitted after reconnect.
            }
            await LinkedQueueKeys.LockAsync();
            await Ledger.DisconnectAsync();
            _items = []; _selected = null; _quote = null;
            _content = "";
            _capacityRolloverPending = false;
            // The JavaScript transport retains unresolved scope markers in this
            // runtime; the next connection must discover them before allowing writes.
            _submissionUncertain = false;
            _uncertainDiagnostic = null;
            _recoveryFinding = null;
            Navigation.NavigateTo("/", replace: true);
        }
        finally { _busy = false; }
    }
}
