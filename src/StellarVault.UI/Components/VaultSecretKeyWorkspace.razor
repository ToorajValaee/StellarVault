@using StellarVault.Core.Services
@inject IStellarSecretKeyLedger Ledger
@inject NavigationManager Navigation

<section class="sv-secret-workspace" aria-label="Secret Key linked-account vault">
    <header class="sv-secret-workspace-header">
        <div>
            <span class="panel-kicker">STELLAR · SECRET KEY ACCOUNT CHAIN</span>
            <h2>My vault</h2>
            <p>Independent linked accounts · @(_account?.TotalAccounts ?? 0) account(s) · Encrypted on Stellar</p>
        </div>
        <div class="sv-secret-workspace-actions">
            <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="ReloadAsync">Refresh</button>
            <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="DisconnectAsync">Lock</button>
        </div>
    </header>
    @if (_account is not null)
    {
        <div class="sv-secret-stats">
            <span><strong>@_account.Records</strong> Records</span>
            <span><strong>@_account.Folders</strong> Folders</span>
            <span><strong>@_account.TotalAccounts</strong> Stellar accounts</span>
            <span><strong>@_account.SpendableNative XLM</strong> root spendable</span>
        </div>
    }
    <div class="sv-secret-notice" role="status">
        <strong>Account architecture:</strong> Your Stellar S-key controls independently created accounts using root-key signer authorization.
        Secret Key ledger mutations are Testnet-only until independent production security review.
        Files and offline draft synchronization are not yet available in this backend.
    </div>
    @if (!string.IsNullOrEmpty(_status))
    {
        <p class="sv-secret-status" role="status">@_status</p>
    }
    @if (_busy) { <p role="status">Verifying ledger state…</p> }
    @if (_quote is not null)
    {
        <section class="sv-secret-review" aria-label="Review Stellar transaction">
            <h3>Review before signing</h3>
            <p><strong>Action:</strong> @_quote.Kind</p>
            <p><strong>Target account:</strong> <code>@_quote.TargetAccountId</code></p>
            <p><strong>Operations:</strong> @_quote.Operations in @_quote.Transactions transaction</p>
            <p><strong>Network fee:</strong> @_quote.NetworkFeeXlm XLM</p>
            <p><strong>Peak additional reserve:</strong> @_quote.PeakReserveXlm XLM</p>
            <p><strong>Net reserve change:</strong> @_quote.NetReserveChangeXlm XLM</p>
            @if (_quote.CreatesChildNode)
            {
                <p>A new independent Stellar account will be created. The root public key becomes its authorized signer; the new account's master key is disabled in the same transaction.</p>
            }
            <label class="sv-secret-approval"><input type="checkbox" @bind="_approve" disabled="@_busy" />
                I reviewed the fees, reserves and account changes and approve this specific Stellar transaction.
            </label>
            <div class="sv-secret-workspace-actions">
                <button type="button" class="pixel-button primary" disabled="@(_busy || !_approve)" @onclick="SubmitAsync">Sign and submit to Stellar</button>
                <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="CancelQuoteAsync">Cancel</button>
            </div>
        </section>
    }
    else
    {
        <div class="sv-secret-toolbar">
            <label class="sv-secret-search">Search vault <input type="search" @bind="_search" @bind:event="oninput" placeholder="Search records and folders" /></label>
            <button type="button" class="pixel-button compact" @onclick="ToggleGrid">@(_grid ? "List view" : "Tile view")</button>
            <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="NewRecord">＋ Record</button>
            <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="NewFolder">＋ Folder</button>
            <button type="button" class="pixel-button compact" disabled="@_busy" @onclick="ExtendAsync">Expand account chain</button>
        </div>
        @if (_folderId is not null)
        {
            <button type="button" class="sv-secret-back" @onclick="GoBack">‹ Back to folder</button>
        }
        <div class="sv-secret-browser @(_grid ? "tiles" : "rows")">
            @foreach (var item in VisibleItems)
            {
                <button type="button" class="sv-secret-item @(_selected?.Id == item.Id ? "selected" : "")" @onclick="() => SelectItem(item)">
                    <span class="sv-secret-item-icon" aria-hidden="true">@(item.IsFolder ? "▣" : "▦")</span>
                    <span class="sv-secret-item-copy"><strong>@item.Title</strong><small>@(item.IsFolder ? "Folder" : "Encrypted record")</small></span>
                    <span class="sv-secret-more" aria-hidden="true">›</span>
                </button>
            }
            @if (!VisibleItems.Any() && !_busy)
            {
                <p class="sv-secret-empty">No items found in this folder.</p>
            }
        </div>
        @if (_selected is not null && _editMode is null)
        {
            <section class="sv-secret-details" aria-label="Selected vault item">
                <header><h3>@_selected.Title</h3><button type="button" @onclick="Deselect">×</button></header>
                <p>@(_selected.IsFolder ? "Folder" : "Encrypted record")</p>
                @if (!_selected.IsFolder)
                {
                    @if (!string.IsNullOrEmpty(_selected.UserName)) { <p><strong>Username:</strong> @_selected.UserName</p> }
                    @if (!string.IsNullOrEmpty(_selected.Url)) { <p><strong>URL:</strong> @_selected.Url</p> }
                    @if (!string.IsNullOrEmpty(_selected.Notes)) { <p><strong>Notes:</strong> @_selected.Notes</p> }
                    <div class="sv-secret-value"><strong>Secret</strong>
                        <button type="button" @onclick="ToggleReveal">@(_reveal ? "Hide" : "Reveal")</button>
                        @if (_reveal) { <pre>@_selected.Content</pre> }
                    </div>
                }
                <div class="sv-secret-workspace-actions">
                    @if (_selected.IsFolder) { <button type="button" class="pixel-button compact" @onclick="() => OpenFolder(_selected.Id)">Open folder</button> }
                    <button type="button" class="pixel-button compact" @onclick="EditSelected">Edit</button>
                    <button type="button" class="pixel-button compact" @onclick="DeleteSelectedAsync">Review delete</button>
                </div>
            </section>
        }
        @if (_editMode is not null)
        {
            <section class="sv-secret-editor" aria-label="Edit encrypted record">
                <h3>@(_editMode == "create" ? (_isFolder ? "New folder" : "New record") : "Edit published item")</h3>
                <label>Title <input maxlength="256" @bind="_title" @bind:event="oninput" /></label>
                @if (!_isFolder)
                {
                    <label>Username <input @bind="_username" @bind:event="oninput" /></label>
                    <label>URL <input type="url" @bind="_url" @bind:event="oninput" /></label>
                    <label>Secret <textarea rows="3" @bind="_content" @bind:event="oninput"></textarea></label>
                    <label>Notes <textarea rows="3" @bind="_notes" @bind:event="oninput"></textarea></label>
                    <label>Tags (comma-separated) <input @bind="_tags" @bind:event="oninput" /></label>
                }
                <div class="sv-secret-workspace-actions">
                    <button type="button" class="pixel-button primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_title))" @onclick="QuoteSaveAsync">Review Stellar cost</button>
                    <button type="button" class="pixel-button compact" @onclick="CloseEditor">Cancel</button>
                </div>
            </section>
        }
    }
</section>

@code {
    private IReadOnlyList<LedgerRecordItem> _items = [];
    private LedgerAccountInfo? _account;
    private LedgerRecordItem? _selected;
    private string? _folderId, _editMode, _status;
    private string _search = "", _title = "", _content = "", _username = "",
        _url = "", _notes = "", _tags = "";
    private bool _busy, _grid, _reveal, _isFolder, _approve;
    private string _draftId = "";
    private VaultSecretLedgerQuote? _quote;
    private IEnumerable<LedgerRecordItem> VisibleItems => _items
        .Where(x => (x.FolderId ?? "") == (_folderId ?? "") &&
            (string.IsNullOrWhiteSpace(_search) ||
            x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            (x.Tags?.Any(tag => tag.Contains(_search, StringComparison.OrdinalIgnoreCase)) ?? false)))
        .OrderByDescending(x => x.IsFolder).ThenBy(x => x.Title, StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync() => await ReloadAsync();
    private async Task ReloadAsync()
    {
        if (_busy || !Ledger.IsConnected) return;
        _busy = true;
        try
        {
            _items = await Ledger.ReadAsync();
            _account = await Ledger.InspectAccountInfoAsync();
            _selected = null; _reveal = false; _status = null;
        }
        catch
        {
            _status = "Ledger recovery is incomplete or the network is unavailable. No writes are permitted until recovery succeeds.";
            _items = [];
        }
        finally { _busy = false; }
    }
    private void ToggleGrid() => _grid = !_grid;
    private void ToggleReveal() => _reveal = !_reveal;
    private void Deselect() { _selected = null; _reveal = false; }
    private void SelectItem(LedgerRecordItem item)
    {
        _selected = item; _reveal = false; _editMode = null;
    }
    private void OpenFolder(string id) { _folderId = id; _selected = null; }
    private void GoBack()
    {
        _folderId = _items.FirstOrDefault(x => x.Id == _folderId)?.FolderId;
        _selected = null; _reveal = false;
    }
    private void NewRecord() => BeginCreate(false);
    private void NewFolder() => BeginCreate(true);
    private void BeginCreate(bool isFolder)
    {
        if (_busy) return;
        _editMode = "create"; _draftId = Guid.NewGuid().ToString("N")[..16];
        _isFolder = isFolder; _title = _content = _username = _url = _notes = _tags = "";
        _selected = null; _status = null; _reveal = false;
    }
    private void EditSelected()
    {
        if (_selected is null || _busy) return;
        _editMode = "update"; _draftId = _selected.Id;
        _isFolder = _selected.IsFolder; _title = _selected.Title;
        _content = _selected.Content; _username = _selected.UserName ?? "";
        _url = _selected.Url ?? ""; _notes = _selected.Notes ?? "";
        _tags = string.Join(", ", _selected.Tags ?? []); _reveal = false;
    }
    private void CloseEditor()
    {
        _editMode = null; _content = ""; _title = _username = _url = _notes = _tags = "";
    }
    private LedgerRecordDraft CurrentDraft() => new(_title.Trim(),
        _isFolder ? "folder" : _content, _folderId,
        _tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToArray(),
        _isFolder, _username, _url, _notes);
    private async Task QuoteSaveAsync()
    {
        if (_busy || _editMode is null) return;
        _busy = true; _status = null;
        try
        {
            var draft = CurrentDraft();
            _quote = _editMode == "create"
                ? await Ledger.QuoteCreateAsync(_draftId, draft)
                : await Ledger.QuoteUpdateAsync(_draftId, draft);
            _approve = false; CloseEditor();
        }
        catch (Exception ex) { _status = "Unable to prepare a safe ledger transaction: " + ex.Message; }
        finally { _busy = false; }
    }
    private async Task DeleteSelectedAsync()
    {
        if (_busy || _selected is null) return;
        _busy = true; _status = null;
        try { _quote = await Ledger.QuoteDeleteAsync(_selected.Id); _approve = false; }
        catch (Exception ex) { _status = "Delete review unavailable: " + ex.Message; }
        finally { _busy = false; }
    }
    private async Task ExtendAsync()
    {
        if (_busy) return;
        _busy = true; _status = null;
        try { _quote = await Ledger.QuoteExtendChainAsync(); _approve = false; }
        catch (Exception ex) { _status = "Account expansion unavailable: " + ex.Message; }
        finally { _busy = false; }
    }
    private async Task CancelQuoteAsync()
    {
        if (_quote is null || _busy) return;
        var id = _quote.QuoteId;
        _quote = null; _approve = false;
        try { await Ledger.CancelQuoteAsync(id); }
        catch { _status = "The pending review could not be cleared. Lock the vault if needed."; }
    }
    private async Task SubmitAsync()
    {
        if (_busy || !_approve || _quote is null) return;
        _busy = true;
        var quote = _quote;
        _quote = null; _approve = false;
        try
        {
            var hash = await Ledger.SubmitApprovedAsync(quote.QuoteId);
            _status = "Stellar transaction independently verified: " + hash;
            _items = await Ledger.ReadAsync();
            _account = await Ledger.InspectAccountInfoAsync();
            _selected = null; _reveal = false;
        }
        catch
        {
            _status = "The submission could not be verified. Its result may be uncertain. Refresh the ledger and reconcile before trying again.";
        }
        finally { _busy = false; }
    }
    private async Task DisconnectAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Ledger.DisconnectAsync();
            _items = []; _selected = null; _quote = null;
            _content = ""; _reveal = false;
            Navigation.NavigateTo("/", replace: true);
        }
        finally { _busy = false; }
    }
}
