    private readonly HashSet<string> _nativeCollapsedFolders = new(StringComparer.Ordinal);
    private void SelectNativeFolderFromSharedTree(string? id) =>
        OpenNativeFolder(id ?? string.Empty);
    private void ToggleNativeFolder(string id)
    {
