@using StellarVault.UI.Components
@using StellarVault.Core.Services
@using Microsoft.JSInterop
@inject VaultSessionManager Sessions
@inject VaultSessionWorkflow Workflow
@inject IStellarLedgerRecords Ledger
@inject VaultStorageModeGate StorageMode
@inject VaultDeviceRetentionGate Retention
@inject VaultNetworkSelection NetworkSelection
@inject VaultNativeForegroundLifecycle ForegroundLifecycle
@inject VaultNativeNavigationState NativeNavigation
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IVaultNativeFileAccess NativeFiles
@inject StellarLedgerUploadCoordinator UploadCoordinator
@inject IStellarUploadCheckpointStore UploadCheckpoints
@implements IAsyncDisposable

@if (_foregroundRevoked)
{
    <section class="terminal-panel" role="alert">
        <h2>NATIVE SESSION LOCKED</h2>
        <p>StellarVault left the foreground. Encryption and signing credentials are being
           cleared. If this screen remains, close and reopen the app before reconnecting.</p>
    </section>
}
else
{
    <div class="sv-native-shell native-@HostPlatform.ToLowerInvariant()">
        <header class="sv-native-topbar">
            <div class="sv-native-brand"><span class="sv-native-brandmark" aria-hidden="true">✦</span>
                <span><strong>StellarVault</strong><small>Private account vault</small></span></div>
            <div class="sv-native-session">
                <span class="sv-native-status-dot @(Ledger.IsConnected ? "connected" : "")" aria-hidden="true"></span>
                @(Ledger.IsConnected ? "Connected" : "Not connected")
            </div>
        </header>
        <nav class="sv-native-nav" aria-label="Primary navigation">
            <button type="button" class="@(_nativePage == "stellar" ? "selected" : "")"
                    aria-current="@(_nativePage == "stellar" ? "page" : null)"
                    @onclick='() => NavigateNative("stellar")'>
                <span class="sv-native-nav-icon" aria-hidden="true">⌂</span><span>Stellar</span>
            </button>
            <button type="button" class="@(_nativePage == "local" ? "selected" : "")"
                    aria-current="@(_nativePage == "local" ? "page" : null)"
                    @onclick='() => NavigateNative("local")'>
                <span class="sv-native-nav-icon" aria-hidden="true">▣</span><span>My vault</span>
            </button>
            <button type="button" class="@(_nativePage == "sync" ? "selected" : "")"
                    aria-current="@(_nativePage == "sync" ? "page" : null)"
                    @onclick='() => NavigateNative("sync")'>
                <span class="sv-native-nav-icon" aria-hidden="true">⇅</span><span>Sync</span>
            </button>
        </nav>
        <main class="sv-native-scroll" id="native-content" tabindex="-1" @key="NativeContentKey">
          <div class="sv-native-content">
            <div class="sv-native-page-heading">
                <div>
                    <h1>@(_nativePage == "stellar" ? (Ledger.IsConnected ? "My records" : "Welcome back") :
                          _nativePage == "local" ? "My vault" : "Sync")</h1>
                    @if (_nativePage == "sync") { <p>Review changes before syncing.</p> }
                </div>
                @if (Sessions.IsUnlocked && _nativePage != "stellar")
                {
                    <button type="button" class="sv-native-outline-action" @onclick="LockVault">Lock vault</button>
                }
            </div>
    <section class="native-preview sv-vault-data" aria-label="Native vault workspace">
        @if (_nativePage == "stellar")
        {
        <section aria-label="Stellar ledger recovery" class="terminal-panel">
            <div class="panel-heading"><div><h2>@(Ledger.IsConnected ? "Your Stellar vault" : "Connect your vault")</h2></div></div>
            @if (!Ledger.IsConnected)
            {
                <p>Enter your recovery phrase to access your records.</p>
                <details class="sv-native-network-settings" @key="_ledgerNetwork">
                    <summary>Network: @(_ledgerNetwork == "testnet" ? "Testnet" : _ledgerNetwork == "public" ? "Mainnet" : "Custom")</summary>
                    <div class="sv-native-network-choice" role="group" aria-label="Choose Stellar network">
                        <button type="button" class="pixel-button compact @(_ledgerNetwork == "testnet" ? "primary" : "")"
                            disabled="@(_ledgerBusy || Sessions.IsUnlocked)"
                            @onclick='() => SelectNativeNetwork("testnet")'>Testnet</button>
                        <button type="button" class="pixel-button compact @(_ledgerNetwork == "public" ? "primary" : "")"
                            disabled="@(_ledgerBusy || Sessions.IsUnlocked)"
                            @onclick='() => SelectNativeNetwork("public")'>Mainnet</button>
                    </div>
                    <p class="sv-native-subtle-status">Testnet is for trying the app. Mainnet uses real XLM.</p>
                </details>
                @if (_ledgerNetwork == "public")
                {
                    <label class="sv-native-mainnet-consent">
                        <input type="checkbox" @bind="_confirmMainnetAccess" disabled="@_ledgerBusy" />
                        I understand that Mainnet uses real funds and approved transactions may cost XLM.
                    </label>
                }
                <label class="terminal-label" for="native-ledger-mnemonic">Recovery phrase</label>
                <VaultMnemonicInput @bind-Value="_ledgerMnemonic" Disabled="@(_ledgerBusy || _runtimeReady != true)" />
                @if (_runtimeReady is null || (_runtimeReady == false && _ledgerBusy))
                { <p class="sv-native-subtle-status" role="status">Preparing your vault…</p> }

            }
            else
            {
                <p class="sv-native-summary">@_ledgerRecords.Count items · @_ledgerNetwork</p>
                @if (!string.IsNullOrWhiteSpace(_rootAccountId))
                {
                    <p>Root account: <code>@_rootAccountId</code></p>
                }
                <p class="sv-native-subtle-status">@_ledgerRecords.Count(x => x.IsFolder) folders · @_ledgerRecords.Count(x => !x.IsFolder) records</p>
                <nav class="network-selector" aria-label="Native Stellar workspace">
                    <button type="button" class="network-option @(_nativeMode == "browse" ? "active" : "")"
                            aria-pressed="@(_nativeMode == "browse")" disabled="@_ledgerBusy"
                            @onclick='() => SetNativeMode("browse")'>
                        <span class="network-symbol">S</span><span><strong>Browse</strong><small>EXPLORE</small></span>
                    </button>
                    <button type="button" class="network-option @(_nativeMode == "record" ? "active" : "")"
                            aria-pressed="@(_nativeMode == "record")" disabled="@_ledgerBusy"
                            @onclick='() => SetNativeMode("record")'>
                        <span class="network-symbol">R</span><span><strong>New record</strong><small>ON-CHAIN</small></span>
                    </button>
                    <button type="button" class="network-option @(_nativeMode == "file" ? "active" : "")"
                            aria-pressed="@(_nativeMode == "file")" disabled="@_ledgerBusy"
                            @onclick='() => SetNativeMode("file")'>
                        <span class="network-symbol">F</span><span><strong>Add file</strong><small>ON-CHAIN</small></span>
                    </button>
                </nav>
                @if (_nativeMode == "record")
                {
                                <section aria-label="Publish Stellar record" class="terminal-panel">
                    <h3>ON-CHAIN RECORD // TRANSACTION APPROVAL</h3>
                    <p class="notice">Publishing submits a paid Stellar transaction. Review the estimate before authorizing. This does not save to local storage.</p>
                    <label class="terminal-label" for="native-publish-title">RECORD TITLE</label>
                    <input id="native-publish-title" class="terminal-input" @bind="_publishTitle" @bind:event="oninput" disabled="@_ledgerBusy" maxlength="256" />
                    <label class="terminal-label" for="native-publish-content">RECORD CONTENT</label>
                    <textarea id="native-publish-content" class="terminal-input" @bind="_publishContent" @bind:event="oninput" disabled="@_ledgerBusy" rows="3"></textarea>
                    <button type="button" class="pixel-button compact" disabled="@(_ledgerBusy || string.IsNullOrWhiteSpace(_publishTitle) || string.IsNullOrWhiteSpace(_publishContent))" @onclick="EstimatePublishAsync">Review transaction cost</button>
                    @if (_publishEstimate is not null)
                    {
                        <VaultTransactionCostReview Cost="_publishEstimate" Network="@_ledgerNetwork" Title="PUBLISH RECORD" />
                        <label><input type="checkbox" @bind="_publishApproved" disabled="@_ledgerBusy" /> I approve publishing this encrypted record to @_ledgerNetwork.</label>
                        <button type="button" class="pixel-button compact" disabled="@(_ledgerBusy || !_publishApproved)" @onclick="ConfirmPublishAsync">Approve and submit to Stellar</button>
                        <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="CancelPublish">Cancel</button>
                    }
                </section>
                }
                @if (_nativeMode == "file")
                {
                                <section aria-label="Upload Stellar file" class="terminal-panel">
                    <h3>ON-CHAIN FILE // MULTIPART UPLOAD</h3>
                    <p class="notice">Each part requires a separate approved Stellar transaction. Keep the original file until all stages are confirmed. Interrupted uploads can resume by selecting the same file.</p>
                    <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="ChooseUploadFileAsync">Choose file to upload</button>
                    @if (_uploadPlan is not null)
                    {
                        <p>File: @_uploadFileName · @_uploadBytes?.Length bytes · @_uploadPlan.Entries.Count stages</p>
                        <p>Remaining stages: @_uploadRemaining</p>
                        <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="ReconcileUploadAsync">Recheck on-chain progress</button>
                        <button type="button" class="pixel-button compact" disabled="@(_ledgerBusy || _uploadNeedsReconciliation)" @onclick="ReviewUploadStageAsync">Review next transaction</button>
                        @if (_uploadCost is not null)
                        {
                            <VaultTransactionCostReview Cost="_uploadCost" Network="@_ledgerNetwork" Title="UPLOAD FILE STAGE" Stage="@_uploadStageTitle" />
                            <label><input type="checkbox" @bind="_uploadApproved" disabled="@_ledgerBusy" /> Approve this single Stellar transaction</label>
                            <button type="button" class="pixel-button compact" disabled="@(_ledgerBusy || !_uploadApproved)" @onclick="PublishUploadStageAsync">Submit approved stage</button>
                        }
                        <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="CancelUpload">Clear file from memory</button>
                    }
                    @if (!string.IsNullOrWhiteSpace(_uploadMessage))
                    {
                        <p role="status">@_uploadMessage</p>
                    }
                </section>
                }
                @if (_nativeMode == "browse")
                {
                    <div class="panel-kicker"></div>
                    <h3>Browse your vault</h3>
                    <label class="terminal-label" for="native-ledger-folder">FOLDER</label>
                <select id="native-ledger-folder" class="terminal-input" @bind="_selectedFolderId" @bind:after="ResetSelection" disabled="@_ledgerBusy">
                    <option value="">Root</option>
                    @foreach (var folder in _ledgerRecords.Where(x => x.IsFolder))
                    {
                        <option value="@folder.Id">@folder.Title</option>
                    }
                </select>
                @foreach (var item in _ledgerRecords.Where(x => (x.FolderId ?? "") == _selectedFolderId && !x.Content.StartsWith(StellarLedgerFileProtocol.ChunkPrefix, StringComparison.Ordinal)))
                {
                    <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="() => SelectRecord(item.Id)">
                        @(item.IsFolder ? "Open folder: " : StellarLedgerFileProtocol.IsFile(item) ? "View file: " : "View record: ") @item.Title
                    </button>
                }
                @if (_selectedRecord is not null && !_selectedRecord.IsFolder)
                {
                    <section aria-label="Selected ledger record">
                        <h3>@_selectedRecord.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(_selectedRecord.UserName))
                        {
                            <p>Username: @_selectedRecord.UserName</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_selectedRecord.Url))
                        {
                            <p>URL: @_selectedRecord.Url</p>
                        }
                        @if (StellarLedgerFileProtocol.IsFile(_selectedRecord))
                        {
                            <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="VerifySelectedFile">Verify file integrity</button>
                            <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="ExportSelectedFileAsync">Export verified file</button>
                            <p class="notice">Export creates an unencrypted copy outside StellarVault. Save only to a trusted location.</p>
                            @if (!string.IsNullOrEmpty(_verifiedFileMessage))
                            {
                                <p role="status">@_verifiedFileMessage</p>
                            }
                        }
                        else
                        {
                        <button type="button" class="pixel-button compact" @onclick="ToggleSecret">
                            @(_revealSecret ? "Hide secret" : "Reveal secret")
                        </button>
                        @if (_revealSecret)
                        {
                            <pre style="white-space:pre-wrap;overflow-wrap:anywhere">@_selectedRecord.Content</pre>
                        }
                        }
                    </section>
                }
                }
            }
            @if (!string.IsNullOrEmpty(_ledgerMessage))
            {
                <div class="terminal-alert warning" role="alert">
                    <span>@_ledgerMessage</span>
                    @if (_runtimeReady == false && !Ledger.IsConnected)
                    { <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="CheckRuntimeAsync">Try again</button> }
                </div>
            }
            @if (Ledger.IsConnected)
            {
                <details class="sv-native-help"><summary>About storage and transactions</summary>
                    <p>Local records stay on this device. Publishing to Stellar needs your approval and may cost XLM.</p>
                </details>
            }
        </section>
        }
        @if (_nativePage is "local" or "sync")
        {
        <section class="terminal-panel" aria-label="Local encrypted vault status">
            <h3>@(Sessions.IsUnlocked ? "Your saved items" : "Unlock local storage")</h3>
            @if (Sessions.IsUnlocked)
            {
                <p class="sv-native-subtle-status">Protected on this device</p>
                @if (_nativePage == "local")
                {
                    <nav class="sv-native-segments" aria-label="Local vault views">
                        <button type="button" class="@(_localMode == "records" ? "selected" : "")"
                                aria-pressed="@(_localMode == "records")"
                                @onclick='() => _localMode = "records"'>Device records</button>
                        <button type="button" class="@(_localMode == "drafts" ? "selected" : "")"
                                aria-pressed="@(_localMode == "drafts")"
                                @onclick='() => _localMode = "drafts"'>Offline drafts</button>
                    </nav>
                    @if (_localMode == "records")
                    {
                        <VaultRecordWorkspaceView />
                    }
                    else
                    {
                        <VaultHybridDraftEditor />
                    }
                }
                else
                {
                    <p class="sv-native-subtle-status">Only records and folders can be synced.</p>
                    <nav class="sv-native-segments" aria-label="Hybrid sync views">
                        <button type="button" class="@(_syncMode == "changes" ? "selected" : "")"
                                aria-pressed="@(_syncMode == "changes")"
                                @onclick='() => _syncMode = "changes"'>Stage changes</button>
                        <button type="button" class="@(_syncMode == "review" ? "selected" : "")"
                                aria-pressed="@(_syncMode == "review")"
                                @onclick='() => _syncMode = "review"'>Review &amp; sync</button>
                    </nav>
                    @if (_syncMode == "changes")
                    {
                        <VaultHybridRemoteChanges />
                    }
                    else
                    {
                        <VaultHybridSyncReview />
                    }
                }
            }
            else
            {
                <p>Your saved items are encrypted on this device. Choose local storage to get started.</p>
                <label class="sv-biometric-choice">
                    <input type="checkbox" @bind="_localConsent" disabled="@_busy" />
                    Save encrypted items on this device (I understand I need my own backup)
                </label>
                @if (_localConsent)
                {
                    <label class="terminal-label" for="native-local-account">Stellar account address</label>
                    <input id="native-local-account" class="terminal-input"
                           autocomplete="off" spellcheck="false" maxlength="56"
                           @bind="_accountId" disabled="@_busy" />
                    <label class="terminal-label" for="native-local-passphrase">Vault passphrase</label>
                    <input id="native-local-passphrase" class="terminal-input" type="password"
                           autocomplete="off" @bind="_passphrase" disabled="@_busy" />
                    <div class="sv-access-actions">
                        <button type="button" class="pixel-button compact"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_passphrase) || _accountId.Length != 56)"
                                @onclick="CreateVault">Create vault</button>
                        <button type="button" class="pixel-button compact"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_passphrase) || _accountId.Length != 56)"
                                @onclick="UnlockVault">Unlock vault</button>
                    </div>
                    <p class="sv-native-subtle-status">For a new vault, use at least 12 characters. Keep your passphrase safe.</p>
                }
            }
            <details class="sv-native-help"><summary>How local storage works</summary>
                <VaultStorageSecurityNotice Native="true" />
            </details>
        </section>
        @if (!string.IsNullOrEmpty(_message))
        {
            <p role="status" aria-live="polite">@_message</p>
        }
        }
    </section>
          </div>
        </main>
        <div class="sv-native-commandbar" aria-label="Quick actions">
            @if (_nativePage == "stellar")
            {
                @if (Ledger.IsConnected)
                {
                    <button type="button" class="sv-native-command primary"
                            disabled="@_ledgerBusy" @onclick="RefreshLedgerAsync">Refresh records</button>
                    <button type="button" class="sv-native-command"
                            disabled="@_ledgerBusy" @onclick="DisconnectLedgerAsync">Disconnect</button>
                }
                else
                {
                    <span class="sv-native-command-hint">@(_runtimeReady == false ? "Connection unavailable" : "Your vault")</span>
                    <button type="button" class="sv-native-command primary"
                            disabled="@(_ledgerBusy || _runtimeReady != true || string.IsNullOrWhiteSpace(_ledgerMnemonic) || (_ledgerNetwork == "public" && !_confirmMainnetAccess))"
                            @onclick="ConnectLedgerAsync">Connect Stellar</button>
                }
            }
            else if (Sessions.IsUnlocked)
            {
                @if (_nativePage == "local")
                {
                    <button type="button" class="sv-native-command primary"
                            @onclick="OpenSyncReview">Review sync queue</button>
                }
                else
                {
                    <button type="button" class="sv-native-command primary"
                            @onclick='() => NavigateNative("local")'>Open local vault</button>
                }
                <button type="button" class="sv-native-command" @onclick="LockVault">Lock</button>
            }
            else
            {
                <span class="sv-native-command-hint">Your saved items</span>
                <button type="button" class="sv-native-command primary"
                        disabled="@(_busy || !_localConsent || _accountId.Length != 56 || string.IsNullOrWhiteSpace(_passphrase))"
                        @onclick="UnlockVault">Unlock vault</button>
            }
        </div>
        <footer class="sv-native-footer">Vault content stays private until you approve a transaction.</footer>
    </div>
}

@code {
    [Parameter] public string HostPlatform { get; set; } = "Android";
    private string _nativePage = "stellar";
    private string _localMode = "records";
    private string _syncMode = "changes";
    // Recreate only the content scroller when the selected screen changes;
    // don't carry a deep scroll offset into a different native destination.
    private string NativeContentKey => _nativePage switch
    {
        "local" => "local:" + _localMode,
        "sync" => "sync:" + _syncMode,
        _ => "stellar:" + _nativeMode
    };

    private void NavigateNative(string page)
    {
        if (page is not ("stellar" or "local" or "sync")) return;
        _nativePage = page;
        NativeNavigation.SetSecondaryDestination(page != "stellar");
    }

    private void OnAndroidBackRequested()
    {
        _ = InvokeAsync(() =>
        {
            NavigateNative("stellar");
            StateHasChanged();
        });
    }
    private void OpenSyncReview()
    {
        _syncMode = "review";
        NavigateNative("sync");
    }

    private string _nativeMode = "browse";

    private void SetNativeMode(string mode)
    {
        if (_ledgerBusy || mode is not ("browse" or "record" or "file")) return;
        _nativeMode = mode;
    }

    private sealed class RuntimeStatus
    {
        public bool Ready { get; set; }
        public bool CryptoReady { get; set; }
        public bool Bip39Ready { get; set; }
        public bool HdReady { get; set; }
        public bool LedgerReady { get; set; }
        public bool SdkReady { get; set; }
    }

    private bool? _runtimeReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // JS interop is available after the WebView's first render. Run the
        // credential-free check automatically so the UI fails closed promptly.
        await CheckRuntimeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckRuntimeAsync()
    {
        if (_ledgerBusy) return;
        _ledgerBusy = true;
        try
        {
            // The native UI must render independently of the large Stellar
            // runtime. Load packaged JS only after the first Blazor render.
            await JS.InvokeVoidAsync("stellarVaultNativeRuntime.load");
            var status = await JS.InvokeAsync<RuntimeStatus>("stellarVaultNativeRuntime.inspect");
            _runtimeReady = status.Ready;
            if (!status.Ready) _ledgerMnemonic = string.Empty;
            _ledgerMessage = status.Ready ? null
                : "Unable to prepare a secure connection. Restart the app or try again.";
        }
        catch
        {
            _runtimeReady = false;
            _ledgerMnemonic = string.Empty;
            _ledgerMessage = "Unable to prepare a secure connection. Restart the app or try again.";
        }
        finally { _ledgerBusy = false; }
    }

    private bool _confirmMainnetAccess;

    private void SelectNativeNetwork(string network)
    {
        if (network is not ("testnet" or "public") || Ledger.IsConnected ||
            Sessions.IsUnlocked || _ledgerBusy) return;
        NetworkSelection.ChoosePreset(network);
        _confirmMainnetAccess = false;
        _ledgerMnemonic = string.Empty;
        _ledgerMessage = null;
    }

    private string _ledgerNetwork => NetworkSelection.SelectedPreset;
    private string _ledgerMnemonic = string.Empty;
    private bool _ledgerBusy;
    private string? _ledgerMessage;
    private IReadOnlyList<LedgerRecordItem> _ledgerRecords = [];
    private string? _rootAccountId;
    private string _selectedFolderId = string.Empty;
    private LedgerRecordItem? _selectedRecord;
    private bool _revealSecret;
    private string? _verifiedFileMessage;

    private string _publishTitle = string.Empty;
    private string _publishContent = string.Empty;
    private LedgerCostPreview? _publishEstimate;
    private bool _publishApproved;
    private string? _publishFingerprint;

    private static string PublishFingerprint(string title, string content, string network) =>
        Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
            System.Text.Encoding.UTF8.GetBytes(network + "\\0" + title + "\\0" + content)));

    private void CancelPublish()
    {
        _publishEstimate = null;
        _publishApproved = false;
        _publishFingerprint = null;
    }

    private async Task EstimatePublishAsync()
    {
        if (_ledgerBusy || !Ledger.IsConnected || string.IsNullOrWhiteSpace(_publishTitle) ||
            string.IsNullOrWhiteSpace(_publishContent)) return;
        _ledgerBusy = true;
        CancelPublish();
        try
        {
            // This gate remains local until a real user-approved publish.
            StorageMode.Select(VaultStorageMode.StellarLedger);
            var draft = new LedgerRecordDraft(_publishTitle.Trim(), _publishContent);
            _publishEstimate = await Ledger.EstimateAsync(draft);
            _publishFingerprint = PublishFingerprint(draft.Title, draft.Content, _ledgerNetwork);
            _ledgerMessage = "Review the estimated fee and reserve before approving.";
        }
        catch
        {
            CancelPublish();
            _ledgerMessage = "Transaction estimate failed. Nothing was submitted.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerBusy = false;
        }
    }

    private async Task ConfirmPublishAsync()
    {
        if (_ledgerBusy || !_publishApproved || _publishEstimate is null ||
            _publishFingerprint is null || !Ledger.IsConnected) return;
        var draft = new LedgerRecordDraft(_publishTitle.Trim(), _publishContent);
        if (_publishFingerprint != PublishFingerprint(draft.Title, draft.Content, _ledgerNetwork))
        {
            CancelPublish();
            _ledgerMessage = "Record changed since cost review. Review the transaction again.";
            return;
        }
        var approvedEstimate = _publishEstimate;
        _ledgerBusy = true;
        CancelPublish();
        try
        {
            StorageMode.Select(VaultStorageMode.StellarLedger);
            if (!await Ledger.HasRegistryAsync())
                throw new InvalidOperationException("Registry must be initialized before publishing.");
            var newCost = await Ledger.EstimateAsync(draft);
            if (newCost != approvedEstimate)
            {
                _ledgerMessage = "Network fee or reserve changed. Review the transaction cost again; nothing was submitted.";
                return;
            }
            var hash = await Ledger.PublishDetailedAsync(draft);
            hash = LedgerMutationResult.RequireConfirmed(hash).TransactionHash;
            _ledgerMessage = "Stellar transaction confirmed: " + hash;
            _publishTitle = string.Empty;
            _publishContent = string.Empty;
            // Once the receipt is confirmed, a subsequent read failure must
            // not be reported as a failed submission (which invites retries).
            try
            {
                _ledgerRecords = await Ledger.ReadAsync();
                ResetSelection();
            }
            catch
            {
                _ledgerMessage = "Transaction confirmed: " + hash +
                    ". The record list could not refresh; refresh it manually. Do not submit again.";
            }
        }
        catch
        {
            _ledgerMessage = "Publishing failed or confirmation is uncertain. Refresh the ledger before retrying to avoid duplicates.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerBusy = false;
        }
    }

    private byte[]? _uploadBytes;
    private StellarLedgerUploadPlan? _uploadPlan;
    private string? _uploadFileName;
    private string? _uploadFingerprint;
    private LedgerCostPreview? _uploadCost;
    private string? _uploadStageId;
    private string? _reviewedUploadFingerprint;
    private string? _uploadStageTitle;
    private int _uploadRemaining;
    private bool _uploadApproved;
    private bool _uploadNeedsReconciliation;
    private string? _uploadMessage;

    private void ClearUploadReview()
    {
        _uploadCost = null;
        _uploadStageId = null;
        _reviewedUploadFingerprint = null;
        _uploadStageTitle = null;
        _uploadApproved = false;
    }

    private void CancelUpload()
    {
        if (_uploadBytes is not null)
            System.Security.Cryptography.CryptographicOperations.ZeroMemory(_uploadBytes);
        _uploadBytes = null;
        _uploadPlan = null;
        _uploadFileName = null;
        _uploadFingerprint = null;
        _uploadRemaining = 0;
        _uploadNeedsReconciliation = false;
        ClearUploadReview();
    }

    private async Task ChooseUploadFileAsync()
    {
        if (_ledgerBusy || !Ledger.IsConnected || string.IsNullOrWhiteSpace(_rootAccountId)) return;
        _ledgerBusy = true;
        CancelUpload();
        _uploadMessage = null;
        try
        {
            var picked = await NativeFiles.PickAsync();
            if (picked is null) return;
            StellarLedgerFileProtocol.ValidateName(picked.FileName);
            await using var input = picked.Stream;
            using var buffer = new MemoryStream();
            var block = new byte[8192];
            try
            {
                int read;
                while ((read = await input.ReadAsync(block)) > 0)
                {
                    if (buffer.Length + read > StellarLedgerFileProtocol.MaxFileBytes)
                        throw new InvalidDataException("Selected file exceeds the supported upload bound.");
                    buffer.Write(block, 0, read);
                }
                _uploadBytes = buffer.ToArray();
            }
            finally
            {
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(block);
                // MemoryStream.ToArray creates a separate copy. Clear its
                // backing buffer on success and on interrupted reads.
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(
                    buffer.GetBuffer().AsSpan());
            }
            _uploadFileName = picked.FileName;
            var fileHash = System.Security.Cryptography.SHA256.HashData(_uploadBytes);
            var metadata = System.Text.Encoding.UTF8.GetBytes(
                _ledgerNetwork + "\\0" + _rootAccountId + "\\0" + picked.FileName + "\\0" +
                Convert.ToHexString(fileHash));
            _uploadFingerprint = Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(metadata));
            System.Security.Cryptography.CryptographicOperations.ZeroMemory(fileHash);
            System.Security.Cryptography.CryptographicOperations.ZeroMemory(metadata);

            StorageMode.Select(VaultStorageMode.StellarLedger);
            var checkpoint = await UploadCheckpoints.LoadAsync(_rootAccountId);
            if (checkpoint is not null)
            {
                checkpoint.Validate();
                if (checkpoint.Fingerprint != _uploadFingerprint)
                    throw new InvalidDataException("Another file upload is pending for this account. Re-select the original file.");
            }
            _uploadPlan = new StellarLedgerUploadPlan(picked.FileName, picked.FileName,
                "application/octet-stream", _uploadBytes, checkpointIds: checkpoint?.Ids);
            if (checkpoint is null)
                await UploadCheckpoints.SaveAsync(_rootAccountId, new StellarUploadCheckpoint(
                    StellarUploadCheckpoint.CurrentVersion, _uploadFingerprint,
                    _uploadPlan.Entries.Select(x => x.Id).ToArray(), 0));

            _uploadRemaining = (await UploadCoordinator.ReviewAsync(_uploadPlan)).Count;
            if (_uploadRemaining == 0)
            {
                // An existing manifest is not sufficient: verify its decoded
                // payload against the selected original before deleting recovery
                // metadata. This also covers a lost final transaction response.
                var snapshot = await Ledger.ReadAsync();
                var manifest = snapshot.SingleOrDefault(x => x.Id == _uploadPlan.ManifestId)
                    ?? throw new InvalidDataException("Confirmed file manifest missing.");
                var recovered = StellarLedgerFileProtocol.DecodeFile(manifest, snapshot);
                try
                {
                    if (!System.Security.Cryptography.CryptographicOperations.FixedTimeEquals(
                            recovered, _uploadBytes))
                        throw new InvalidDataException("Recovered file does not match selected content.");
                }
                finally { System.Security.Cryptography.CryptographicOperations.ZeroMemory(recovered); }
                await UploadCheckpoints.ClearAsync(_rootAccountId);
                _ledgerRecords = snapshot;
                CancelUpload();
                _uploadMessage = "Recovered file verified on Stellar. Checkpoint cleared.";
            }
            else
                _uploadMessage = "File staged. Review and approve each remaining transaction.";
        }
        catch (Exception)
        {
            CancelUpload();
            _uploadMessage = "File staging failed, or saved checkpoint does not match this file. Nothing was submitted.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerBusy = false;
        }
    }

    private async Task ReconcileUploadAsync()
    {
        if (_ledgerBusy || _uploadPlan is null || _rootAccountId is null ||
            _uploadFingerprint is null || !Ledger.IsConnected) return;
        _ledgerBusy = true;
        ClearUploadReview();
        try
        {
            StorageMode.Select(VaultStorageMode.StellarLedger);
            var remaining = await UploadCoordinator.ReviewAsync(_uploadPlan);
            _uploadRemaining = remaining.Count;
            if (_uploadRemaining == 0)
            {
                var snapshot = await Ledger.ReadAsync();
                var manifest = snapshot.SingleOrDefault(x => x.Id == _uploadPlan.ManifestId)
                    ?? throw new InvalidDataException("Confirmed file manifest missing.");
                var recovered = StellarLedgerFileProtocol.DecodeFile(manifest, snapshot);
                try
                {
                    if (_uploadBytes is null ||
                        !System.Security.Cryptography.CryptographicOperations.FixedTimeEquals(recovered, _uploadBytes))
                        throw new InvalidDataException("Recovered ledger file did not match the selected file.");
                }
                finally { System.Security.Cryptography.CryptographicOperations.ZeroMemory(recovered); }
                await UploadCheckpoints.ClearAsync(_rootAccountId);
                _ledgerRecords = snapshot;
                CancelUpload();
                _uploadMessage = "File verified against Stellar. Checkpoint cleared.";
            }
            else
            {
                var done = _uploadPlan.Entries.Count - remaining.Count;
                await UploadCheckpoints.SaveAsync(_rootAccountId,
                    new StellarUploadCheckpoint(StellarUploadCheckpoint.CurrentVersion,
                        _uploadFingerprint, _uploadPlan.Entries.Select(x => x.Id).ToArray(), done));
                _uploadNeedsReconciliation = false;
                _uploadMessage = $"Ledger reports {done} completed stages and {remaining.Count} remaining. Review before continuing.";
            }
        }
        catch
        {
            _uploadMessage = "Could not reconcile this upload. Keep your original file and checkpoint.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerBusy = false;
        }
    }

    private async Task ReviewUploadStageAsync()
    {
        if (_ledgerBusy || _uploadNeedsReconciliation || _uploadPlan is null || !Ledger.IsConnected) return;
        _ledgerBusy = true;
        ClearUploadReview();
        try
        {
            StorageMode.Select(VaultStorageMode.StellarLedger);
            var remaining = await UploadCoordinator.ReviewAsync(_uploadPlan);
            _uploadRemaining = remaining.Count;
            if (remaining.Count == 0)
            {
                _uploadMessage = "File already fully committed on Stellar.";
                return;
            }
            var next = remaining[0];
            _uploadCost = await Ledger.EstimateAsync(next.Draft, next.Id);
            _uploadStageId = next.Id;
            _reviewedUploadFingerprint = _uploadFingerprint;
            _uploadStageTitle = next.Draft.Title;
            _uploadMessage = "Review the estimate, then approve exactly one stage.";
        }
        catch
        {
            ClearUploadReview();
            _uploadMessage = "Unable to estimate or reconcile file stages. No transaction submitted.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerBusy = false;
        }
    }

    private async Task PublishUploadStageAsync()
    {
        if (_ledgerBusy || !_uploadApproved || _uploadCost is null || _uploadPlan is null ||
            _uploadStageId is null || _reviewedUploadFingerprint != _uploadFingerprint ||
            !Ledger.IsConnected || _rootAccountId is null ||
            _uploadFingerprint is null) return;
        var approvedId = _uploadStageId;
        var approvedPlan = _uploadPlan;
        var approvedEntry = approvedPlan.Entries.FirstOrDefault(x => x.Id == approvedId);
        if (approvedEntry.Draft is null)
        {
            ClearUploadReview();
            _uploadMessage = "Approved file stage no longer exists. Review the upload again.";
            return;
        }
        var approvedDraft = approvedEntry.Draft;
        var approvedCost = _uploadCost;
        _ledgerBusy = true;
        ClearUploadReview();
        bool stageConfirmed = false;
        bool fileVerified = false;
        try
        {
            StorageMode.Select(VaultStorageMode.StellarLedger);
            if (!await Ledger.HasRegistryAsync())
                throw new InvalidOperationException("Ledger registry not initialized.");
            // Re-estimate after explicit approval; a changed fee or reserve
            // invalidates the previous authorization.
            var currentCost = await Ledger.EstimateAsync(approvedDraft, approvedId);
            if (currentCost != approvedCost)
            {
                _uploadMessage = "Fee or reserve changed since approval. Review this upload stage again; nothing was submitted.";
                return;
            }
            var published = await UploadCoordinator.PublishNextApprovedAsync(approvedPlan,
                draft => Task.FromResult(ReferenceEquals(draft, approvedDraft)));
            stageConfirmed = published;
            var remaining = await UploadCoordinator.ReviewAsync(_uploadPlan);
            _uploadRemaining = remaining.Count;
            await UploadCheckpoints.SaveAsync(_rootAccountId, new StellarUploadCheckpoint(
                StellarUploadCheckpoint.CurrentVersion, _uploadFingerprint,
                _uploadPlan.Entries.Select(x => x.Id).ToArray(),
                _uploadPlan.Entries.Count - remaining.Count));
            _uploadNeedsReconciliation = false;
            _uploadMessage = _uploadRemaining == 0
                ? "File manifest confirmed on Stellar. Upload complete."
                : published ? "Stage confirmed. Review the next transaction."
                    : "Stage changed during review. Re-approve before proceeding.";
            if (_uploadRemaining == 0)
            {
                // Reconstruct from the authoritative ledger, not the original
                // upload bytes, before clearing the recovery checkpoint.
                var snapshot = await Ledger.ReadAsync();
                var manifest = snapshot.SingleOrDefault(x => x.Id == _uploadPlan.ManifestId)
                    ?? throw new InvalidDataException("Confirmed manifest was not found.");
                var recovered = StellarLedgerFileProtocol.DecodeFile(manifest, snapshot);
                try
                {
                    if (_uploadBytes is null ||
                        !System.Security.Cryptography.CryptographicOperations.FixedTimeEquals(recovered, _uploadBytes))
                        throw new InvalidDataException("Recovered file content differs from the submitted bytes.");
                }
                finally
                {
                    System.Security.Cryptography.CryptographicOperations.ZeroMemory(recovered);
                }
                fileVerified = true;
                _ledgerRecords = snapshot;
                await UploadCheckpoints.ClearAsync(_rootAccountId);
                CancelUpload();
                _uploadMessage = "File recovered and verified from Stellar. Upload complete.";
            }
        }
        catch
        {
            _uploadNeedsReconciliation = true;
            _uploadMessage = fileVerified
                ? "File verified on Stellar, but checkpoint cleanup failed. Reconcile before selecting another file."
                : stageConfirmed
                    ? "Upload stage confirmed on Stellar, but follow-up recovery failed. Reconcile before continuing; do not submit the stage again."
                    : "Submission failed or confirmation is uncertain. Reconcile and re-approve before retry.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerBusy = false;
        }
    }

    private void VerifySelectedFile()
    {
        _verifiedFileMessage = null;
        var selected = _selectedRecord;
        if (selected is null || !StellarLedgerFileProtocol.IsFile(selected)) return;
        try
        {
            // The shared codec validates the manifest, ordered parts and SHA-256.
            // No file content is stored in app-private storage or shown in the UI.
            var bytes = StellarLedgerFileProtocol.DecodeFile(selected, _ledgerRecords);
            try
            {
                var name = StellarLedgerFileProtocol.FileName(selected);
                _verifiedFileMessage = $"Verified file: {name} ({bytes.Length} bytes).";
            }
            finally { System.Security.Cryptography.CryptographicOperations.ZeroMemory(bytes); }
        }
        catch (Exception ex) when (ex is InvalidDataException or FormatException or System.Text.Json.JsonException or InvalidOperationException)
        {
            _verifiedFileMessage = "File verification failed. An incomplete or corrupted ledger file cannot be opened.";
        }
    }

    private async Task ExportSelectedFileAsync()
    {
        if (_ledgerBusy || !Ledger.IsConnected) return;
        var selected = _selectedRecord;
        if (selected is null || !StellarLedgerFileProtocol.IsFile(selected)) return;
        _ledgerBusy = true;
        _verifiedFileMessage = null;
        byte[]? plaintext = null;
        try
        {
            // Always reconstruct and re-verify just before exporting, rather
            // than trusting an earlier verification of mutable ledger state.
            plaintext = StellarLedgerFileProtocol.DecodeFile(selected, _ledgerRecords);
            var name = StellarLedgerFileProtocol.FileName(selected);
            StellarLedgerFileProtocol.ValidateName(name);
            using var stream = new MemoryStream(plaintext, writable: false);
            var saved = await NativeFiles.SaveAsync(name, stream);
            _verifiedFileMessage = saved
                ? "Unencrypted file exported to the location you selected."
                : "File export was canceled or failed. Your vault remains unchanged.";
        }
        catch (Exception ex) when (ex is InvalidDataException or FormatException or
                                    System.Text.Json.JsonException or InvalidOperationException or
                                    UnauthorizedAccessException or IOException or NotSupportedException)
        {
            _verifiedFileMessage = "File export failed. The file was not marked as exported.";
        }
        finally
        {
            if (plaintext is not null)
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(plaintext);
            _ledgerBusy = false;
        }
    }

    private void ResetSelection()
    {
        _selectedRecord = null;
        _revealSecret = false;
        _verifiedFileMessage = null;
    }

    private void SelectRecord(string id)
    {
        _revealSecret = false;
        _verifiedFileMessage = null;
        var record = _ledgerRecords.SingleOrDefault(x => x.Id == id);
        if (record is null) { _selectedRecord = null; return; }
        if (record.IsFolder)
        {
            _selectedFolderId = record.Id;
            _selectedRecord = null;
        }
        else _selectedRecord = record;
    }

    private void ToggleSecret() => _revealSecret = !_revealSecret;

    private void ClearLedgerView()
    {
        _ledgerRecords = [];
        _rootAccountId = null;
        _selectedFolderId = string.Empty;
        ResetSelection();
        CancelUpload();
        CancelPublish();
        _publishTitle = string.Empty;
        _publishContent = string.Empty;
    }

    private async Task ConnectLedgerAsync()
    {
        if (_ledgerBusy || Ledger.IsConnected || _runtimeReady != true ||
            (_ledgerNetwork == "public" && !_confirmMainnetAccess)) return;
        _ledgerBusy = true;
        _ledgerMessage = null;
        try
        {
            var (url, passphrase) = _ledgerNetwork switch
            {
                "testnet" => ("https://horizon-testnet.stellar.org", "Test SDF Network ; September 2015"),
                "public" => ("https://horizon.stellar.org", "Public Global Stellar Network ; September 2015"),
                "custom" when !string.IsNullOrWhiteSpace(NetworkSelection.CustomHorizonUrl) &&
                              !string.IsNullOrWhiteSpace(NetworkSelection.CustomPassphrase) =>
                    (NetworkSelection.CustomHorizonUrl, NetworkSelection.CustomPassphrase),
                _ => throw new InvalidOperationException("Select and detect a supported network.")
            };
            // The earlier UI preflight may be stale after a WebView reload.
            // Recheck dependencies immediately before passing any mnemonic to JS.
            var readiness = await JS.InvokeAsync<RuntimeStatus>("stellarVaultNativeRuntime.inspect");
            if (!readiness.Ready)
            {
                _runtimeReady = false;
                throw new InvalidOperationException("Stellar runtime is not ready.");
            }
            await Ledger.ConnectAsync(_ledgerMnemonic, url, passphrase);
            NetworkSelection.Select(_ledgerNetwork);
            // A connected transport is not permission to write: remain local.
            StorageMode.Reset();
            _ledgerRecords = await Ledger.ReadAsync();
            var account = await Ledger.InspectAccountInfoAsync();
            _rootAccountId = account.RootAccountId;
            _selectedFolderId = string.Empty;
            ResetSelection();
            _ledgerMessage = null;
        }
        catch
        {
            StorageMode.Reset();
            ClearLedgerView();
            _ledgerMessage = "Ledger connection or recovery failed. Check your mnemonic, network and connection.";
            try { await Ledger.DisconnectAsync(); } catch { /* Do not mask the recovery failure. */ }
        }
        finally
        {
            _ledgerMnemonic = string.Empty;
            _ledgerBusy = false;
        }
    }

    private async Task RefreshLedgerAsync()
    {
        if (_ledgerBusy || !Ledger.IsConnected) return;
        _ledgerBusy = true;
        try
        {
            _ledgerRecords = await Ledger.ReadAsync();
            _selectedFolderId = string.Empty;
            ResetSelection();
            _ledgerMessage = null;
        }
        catch
        {
            ClearLedgerView();
            _ledgerMessage = "Ledger recovery failed. No records were displayed.";
        }
        finally { _ledgerBusy = false; }
    }

    private async Task DisconnectLedgerAsync()
    {
        if (_ledgerBusy) return;
        _ledgerBusy = true;
        try
        {
            await Ledger.DisconnectAsync();
            _ledgerMessage = null;
        }
        catch
        {
            // Do not claim disconnection when session-key cleanup is uncertain.
            _ledgerMessage = "Ledger disconnect failed. Close this application before reusing the vault.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerMnemonic = string.Empty;
            ClearLedgerView();
            _ledgerBusy = false;
        }
    }

    private bool _localConsent;
    private string _accountId = string.Empty;
    private string _passphrase = string.Empty;
    private string? _message;
    private bool _busy;

    private bool _foregroundRevoked;

    protected override void OnInitialized()
    {
        Sessions.StateChanged += OnSessionChanged;
        ForegroundLifecycle.ForegroundLost += OnForegroundLost;
        NativeNavigation.BackRequested += OnAndroidBackRequested;
        NativeNavigation.SetSecondaryDestination(_nativePage != "stellar");
    }

    private void OnForegroundLost()
    {
        // Immediately hide all native signer and unlocked record controls.
        // Queue reservations are durable: never resubmit an interrupted write.
        _foregroundRevoked = true;
        NativeNavigation.Clear();
        _ = InvokeAsync(RevokeForegroundAsync);
    }

    private async Task RevokeForegroundAsync()
    {
        _ledgerMnemonic = string.Empty;
        _passphrase = string.Empty;
        _localConsent = false;
        StorageMode.Reset();
        Retention.Reset();
        Workflow.Lock();
        ClearLedgerView();
        var disconnected = !Ledger.IsConnected;
        try
        {
            if (!disconnected) await Ledger.DisconnectAsync();
            disconnected = true;
        }
        catch
        {
            // A failed JS cleanup is not an unlocked state: leave a fail-closed
            // screen requiring full native restart instead of offering signing.
        }
        finally
        {
            _runtimeReady = null;
            _ledgerMessage = disconnected ? "Signing session cleared." :
                "Signer cleanup failed. Restart the application.";
            _foregroundRevoked = !disconnected;
            StateHasChanged();
        }
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private Task CreateVault() => RunAsync(create: true);
    private Task UnlockVault() => RunAsync(create: false);

    private async Task RunAsync(bool create)
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        try
        {
            if (!_localConsent)
                throw new InvalidOperationException("Explicit encrypted device storage consent is required.");
            if (create && _passphrase.Length < 12)
                throw new ArgumentException("Local vault passphrase must have at least 12 characters.");
            // Local-only namespace authorization does NOT establish Stellar
            // signer ownership and MUST NOT be used for paid transactions.
            StellarAccountAddress.Validate(_accountId.Trim());
            Retention.Select(VaultDeviceRetentionPolicy.EncryptedLocalWithManualSync);
            if (create) await Workflow.CreateAsync(_accountId.Trim(), _passphrase);
            else await Workflow.UnlockAsync(_accountId.Trim(), _passphrase);
            _message = "Encrypted local vault unlocked. No Stellar ownership proof or transaction approval was granted.";
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or ArgumentException or
                                     System.Security.Cryptography.CryptographicException or
                                     FileNotFoundException or InvalidOperationException or OperationCanceledException)
        {
            // Never disclose underlying credentials or intermediate cryptographic values.
            _message = ex is UnauthorizedAccessException
                ? "Account ownership verification is unavailable. Vault remains locked."
                : "Vault operation failed. Check the account and credentials.";
        }
        finally
        {
            if (!Sessions.IsUnlocked) Retention.Reset();
            _passphrase = string.Empty;
            _busy = false;
        }
    }

    private void LockVault()
    {
        Workflow.Lock();
        Retention.Reset();
        _passphrase = string.Empty;
        _localConsent = false;
        _message = "Vault locked.";
    }

    public async ValueTask DisposeAsync()
    {
        Sessions.StateChanged -= OnSessionChanged;
        ForegroundLifecycle.ForegroundLost -= OnForegroundLost;
        NativeNavigation.BackRequested -= OnAndroidBackRequested;
        NativeNavigation.Clear();
        StorageMode.Reset();
        Retention.Reset();
        _ledgerMnemonic = string.Empty;
        ClearLedgerView();
        // Closing the WebView must release any session keys retained by JS.
        if (Ledger.IsConnected)
        {
            try { await Ledger.DisconnectAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
                // The native WebView may already be gone during app shutdown.
            }
        }
    }
}
