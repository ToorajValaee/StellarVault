    private string _nativeMode = "browse";
    private string _nativeCollection = "all";
    private string _nativeSearch = "";
    private bool _nativeGrid;

    private void OpenNativeFolder(string id)
    {
        _selectedFolderId = id;
        ResetSelection();
    }

    private int NativeFolderDepth(string id)
    {
        var visited = new HashSet<string>(StringComparer.Ordinal);
        var depth = 0;
        var folder = _ledgerRecords.FirstOrDefault(x => x.IsFolder && x.Id == id);
        while (folder?.FolderId is { Length: > 0 } parent && visited.Add(folder.Id) && depth < 12)
        {
            depth++;
            folder = _ledgerRecords.FirstOrDefault(x => x.IsFolder && x.Id == parent);
        }
        return depth;
    }

    private string NativeFolderPath(string id)
    {
        var names = new List<string>();
        var visited = new HashSet<string>(StringComparer.Ordinal);
        var folder = _ledgerRecords.FirstOrDefault(x => x.IsFolder && x.Id == id);
        while (folder is not null && visited.Add(folder.Id) && names.Count < 16)
        {
            names.Insert(0, folder.Title);
            folder = _ledgerRecords.FirstOrDefault(x => x.IsFolder && x.Id == folder.FolderId);
        }
        return string.Join(" / ", names);
    }

    private void SetNativeMode(string mode)
    {
        if (_ledgerBusy || _nativeDirectFilePlan is not null ||
            mode is not ("browse" or "record" or "folder" or "file")) return;
        if (_nativeMode is "record" or "folder" && mode != _nativeMode && _publishEstimate is not null) CancelPublish();
        if (_nativeMode == "browse" && mode is ("record" or "folder"))
            _publishFolder = _selectedFolderId;
        _nativeMode = mode;
    }

    private sealed class RuntimeStatus
    {
        public bool Ready { get; set; }
        public bool CryptoReady { get; set; }
        public bool Bip39Ready { get; set; }
        public bool HdReady { get; set; }
        public bool LedgerReady { get; set; }
        public bool SdkReady { get; set; }
    }

    private sealed class NativeNetworkPreference
    {
        public string? Network { get; set; }
        public string? HorizonUrl { get; set; }
    }

    private bool? _runtimeReady;
    private bool? _secretRuntimeReady;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // JS interop is available after the WebView's first render. Run the
        // credential-free check automatically so the UI fails closed promptly.
        await CheckRuntimeAsync();
        try
        {
            var preference = await JS.InvokeAsync<NativeNetworkPreference?>("stellarVaultNetworkPreference.load");
            if (preference?.Network is "testnet" or "public" && CanChangeNetwork)
                NetworkSelection.ChoosePreset(preference.Network);
            else if (preference?.Network == "custom" && CanChangeNetwork &&
                     !string.IsNullOrWhiteSpace(preference.HorizonUrl))
            {
                NetworkSelection.ResetCustom();
                NetworkSelection.ChoosePreset("custom");
                NetworkSelection.CustomHorizonUrl = preference.HorizonUrl;
                _customHorizon = preference.HorizonUrl;
                _networkError = "Verifying remembered custom Horizon…";
                await InvokeAsync(StateHasChanged);
                // Never reuse a stored passphrase as verified identity. Probe
                // Horizon on each new native session before opening this chain.
                await DiscoverNativeNetworkAsync();
            }
        }
        catch (JSException) { /* Preferences are optional; never block native startup. */ }
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckRuntimeAsync()
    {
        if (_ledgerBusy) return;
        _ledgerBusy = true;
        try
        {
            // The native UI must render independently of the large Stellar
            // runtime. Load packaged JS only after the first Blazor render.
            await JS.InvokeVoidAsync("stellarVaultNativeRuntime.load");
            var status = await JS.InvokeAsync<RuntimeStatus>("stellarVaultNativeRuntime.inspect");
            _runtimeReady = status.Ready;
            _secretRuntimeReady = await JS.InvokeAsync<bool>("stellarVaultNativeRuntime.inspectSecret");
            if (!status.Ready) _ledgerMnemonic = string.Empty;
            _ledgerMessage = status.Ready ? null
                : _secretRuntimeReady == true
                    ? "HD runtime is unavailable. Independent Secret Key inspection is still available."
                    : "Unable to prepare a secure connection. Restart the app or try again.";
        }
        catch
        {
            _runtimeReady = false;
            try { _secretRuntimeReady = await JS.InvokeAsync<bool>("stellarVaultNativeRuntime.inspectSecret"); }
            catch { _secretRuntimeReady = false; }
            _ledgerMnemonic = string.Empty;
            _ledgerMessage = _secretRuntimeReady == true
                ? "HD runtime is unavailable. Independent Secret Key inspection is still available."
                : "Unable to prepare a secure connection. Restart the app or try again.";
        }
        finally { _ledgerBusy = false; }
    }

    private bool _confirmMainnetAccess;
    private string _customHorizon = string.Empty;
    private string? _networkError;
    private bool _networkDiscovering;
    private bool CanChangeNetwork => !_foregroundRevoked && !Ledger.IsConnected && !SecretLedger.IsConnected && !Sessions.IsUnlocked && !_ledgerBusy && !_networkDiscovering;
    private string NetworkLabel => _ledgerNetwork switch
    {
        "testnet" => "Testnet", "public" => "Mainnet", _ => "Custom"
    };
    private bool CustomNetworkReady => _ledgerNetwork == "custom" &&
        !string.IsNullOrWhiteSpace(NetworkSelection.CustomPassphrase) &&
        string.Equals(NetworkSelection.CustomHorizonUrl, _customHorizon.Trim(), StringComparison.Ordinal);

    private async Task SelectNativeNetwork(string network)
    {
        if (network is not ("testnet" or "public" or "custom") || !CanChangeNetwork) return;
        NetworkSelection.ChoosePreset(network);
        _confirmMainnetAccess = false;
        _ledgerMnemonic = string.Empty;
        _networkError = null;
        _ledgerMessage = null;
        if (network == "custom")
        {
            NetworkSelection.ResetCustom();
            _customHorizon = NetworkSelection.CustomHorizonUrl;
        }
        else
        {
            try { await JS.InvokeVoidAsync("stellarVaultNetworkPreference.save", network, (string?)null); }
            catch (JSException) { _networkError = "Network selected, but its preference could not be saved."; }
        }
    }

    private async Task DiscoverNativeNetworkAsync()
    {
        if (_ledgerNetwork != "custom" || !CanChangeNetwork ||
            string.IsNullOrWhiteSpace(_customHorizon)) return;
        var requestedHorizon = _customHorizon.Trim();
        var startingEpoch = Sessions.Epoch;
        _networkDiscovering = true;
        _networkError = null;
        NetworkSelection.ResetCustom();
        try
        {
            if (_runtimeReady != true)
                await JS.InvokeVoidAsync("stellarVaultNativeRuntime.load");
            var detected = await JS.InvokeAsync<string>("stellarVaultV2Network.probeCustom", requestedHorizon);
            if (_foregroundRevoked || Sessions.Epoch != startingEpoch ||
                _ledgerNetwork != "custom" || Ledger.IsConnected ||
                !string.Equals(_customHorizon.Trim(), requestedHorizon, StringComparison.Ordinal))
                return; // Never attach a stale discovery result to a changed endpoint.
            if (string.IsNullOrWhiteSpace(detected))
                throw new InvalidOperationException("No network passphrase was detected.");
            NetworkSelection.ConfigureCustom(detected);
            NetworkSelection.CustomHorizonUrl = requestedHorizon;
            _networkError = null;
            _ledgerMessage = "Custom network verified and selected.";
            try { await JS.InvokeVoidAsync("stellarVaultNetworkPreference.save", "custom", requestedHorizon); }
            catch (JSException) { _networkError = "Network detected, but its preference could not be saved."; }
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or ArgumentException)
        {
            NetworkSelection.ResetCustom();
            _networkError = "Could not verify the custom network. Check the HTTPS Horizon URL and select Detect network to retry.";
        }
        finally { _networkDiscovering = false; }
    }

    private string _ledgerNetwork => NetworkSelection.SelectedPreset;
    private VaultCredentialMode _ledgerCredentialMode = VaultCredentialMode.MnemonicHd;
    private string _ledgerSecretKey = string.Empty;
    private VaultSecretChainInspection? _secretInspection;
    private void SelectLedgerCredentialMode(VaultCredentialMode mode)
    {
        if (_ledgerBusy || mode == _ledgerCredentialMode) return;
        _ledgerCredentialMode = mode;
        _ledgerSecretKey = string.Empty;
        _ledgerMnemonic = string.Empty;
        _secretInspection = null;
        _ledgerMessage = null;
    }
    private string _ledgerMnemonic = string.Empty;
    private bool _ledgerBusy;
    private string? _ledgerMessage;
    private IReadOnlyList<LedgerRecordItem> _ledgerRecords = [];
    private string? _rootAccountId;
    private string _selectedFolderId = string.Empty;
    private LedgerRecordItem? _selectedRecord;
    private bool _revealSecret;
    private string? _verifiedFileMessage;

    private string _publishTitle = string.Empty;
    private string _publishContent = string.Empty;
    private string _publishFolder = string.Empty;
    private string _publishUsername = string.Empty;
    private string _publishUrl = string.Empty;
    private string _publishNotes = string.Empty;
    private string _publishTags = string.Empty;
    private bool _showPublishSecret;

    private LedgerRecordDraft CurrentPublishDraft() =>
        new(_publishTitle.Trim(), _nativeMode == "folder" ? "folder" : _publishContent,
            string.IsNullOrWhiteSpace(_publishFolder) ? null : _publishFolder,
            _nativeMode == "folder" ? [] :
                _publishTags.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                    .Distinct(StringComparer.OrdinalIgnoreCase).ToArray(),
            _nativeMode == "folder", _publishUsername, _publishUrl, _publishNotes);
    private string CurrentPublishFingerprint() =>
        Convert.ToHexString(System.Security.Cryptography.SHA256.HashData(
            System.Text.Json.JsonSerializer.SerializeToUtf8Bytes(new {
                network = _ledgerNetwork, kind = _nativeMode,
                title = _publishTitle.Trim(), content = _publishContent, folder = _publishFolder,
                username = _publishUsername, url = _publishUrl, notes = _publishNotes,
                tags = _publishTags
            })));
    private LedgerCostPreview? _publishEstimate;
    private bool _publishApproved;
    private string? _publishFingerprint;

    private void CancelPublish()
    {
        _publishEstimate = null;
        _publishApproved = false;
        _publishFingerprint = null;
    }

    private async Task EstimatePublishAsync()
    {
        if (_ledgerBusy || !Ledger.IsConnected || string.IsNullOrWhiteSpace(_publishTitle) ||
            (_nativeMode != "folder" && string.IsNullOrWhiteSpace(_publishContent))) return;
        _ledgerBusy = true;
        CancelPublish();
        try
        {
            // This gate remains local until a real user-approved publish.
            StorageMode.Select(VaultStorageMode.StellarLedger);
            var draft = CurrentPublishDraft();
            _publishEstimate = await Ledger.EstimateAsync(draft);
            _publishFingerprint = CurrentPublishFingerprint();
            _ledgerMessage = "Review the estimated fee and reserve before approving.";
        }
        catch
        {
            CancelPublish();
            _ledgerMessage = "Transaction estimate failed. Nothing was submitted.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerBusy = false;
        }
    }

    private async Task ConfirmPublishAsync()
    {
        if (_ledgerBusy || !_publishApproved || _publishEstimate is null ||
            _publishFingerprint is null || !Ledger.IsConnected) return;
        // Recreate the EXACT reviewed draft. A minimal two-field draft here
        // silently discarded folder, tags, URL, username and notes even
        // though they were included in the fee preview.
        var draft = CurrentPublishDraft();
        if (_publishFingerprint != CurrentPublishFingerprint())
        {
            CancelPublish();
            _ledgerMessage = "Record changed since cost review. Review the transaction again.";
            return;
        }
        var approvedEstimate = _publishEstimate;
        _ledgerBusy = true;
        CancelPublish();
        try
        {
            StorageMode.Select(VaultStorageMode.StellarLedger);
            if (!await Ledger.HasRegistryAsync())
                throw new InvalidOperationException("Registry must be initialized before publishing.");
            var newCost = await Ledger.EstimateAsync(draft);
            if (newCost != approvedEstimate)
            {
                _ledgerMessage = "Network fee or reserve changed. Review the transaction cost again; nothing was submitted.";
                return;
            }
            var hash = await Ledger.PublishDetailedAsync(draft);
            hash = LedgerMutationResult.RequireConfirmed(hash).TransactionHash;
            _ledgerMessage = "Stellar transaction confirmed: " + hash;
            _publishTitle = string.Empty;
            _publishContent = string.Empty;
            _publishFolder = _publishUsername = _publishUrl = _publishNotes = _publishTags = string.Empty;
            _showPublishSecret = false;
            _nativeMode = "browse";
            // Once the receipt is confirmed, a subsequent read failure must
            // not be reported as a failed submission (which invites retries).
            try
            {
                _ledgerRecords = await Ledger.ReadAsync();
                ResetSelection();
            }
            catch
            {
                _ledgerMessage = "Transaction confirmed: " + hash +
                    ". The record list could not refresh; refresh it manually. Do not submit again.";
            }
        }
        catch
        {
            _ledgerMessage = "Publishing failed or confirmation is uncertain. Refresh the ledger before retrying to avoid duplicates.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerBusy = false;
        }
    }

    // Both hosts reuse the same Core reconciliation-first uploader.
    // The plan is deliberately volatile; it is not encrypted local retention.
    private StellarLedgerUploadPlan? _nativeDirectFilePlan;
    private string? _nativeDirectFileRoot;
    private string? _nativeDirectFileScope;
    private string? _nativeDirectFileNextId;
    private LedgerRecordDraft? _nativeDirectFileNextDraft;
    private LedgerCostPreview? _nativeDirectFileCost;
    private int _nativeDirectFileCompleted;
    private bool _nativeDirectFileApproved;
    private bool _nativeDirectFileUncertain;

    private void RequireNativeDirectFileScope()
    {
        if (!Ledger.IsConnected || _nativeDirectFileRoot is null ||
            _nativeDirectFileScope != NetworkSelection.CredentialKey(_nativeDirectFileRoot) ||
            _nativeDirectFileUncertain)
            throw new InvalidOperationException(
                "Stellar root or network changed, or this upload needs historical reconciliation.");
    }

    private async Task PrepareNativeDirectFileAsync()
    {
        if (_ledgerBusy || !Ledger.IsConnected || _nativeDirectFilePlan is not null)
            return;
        _ledgerBusy = true;
        byte[]? content = null;
        _uploadMessage = null;
        try
        {
            var picked = await NativeFiles.PickAsync();
            if (picked is null)
            {
                _uploadMessage = "File selection canceled. No transaction was sent.";
                return;
            }
            await using var input = picked.Stream;
            StellarLedgerFileProtocol.ValidateName(picked.FileName);
            var root = await Ledger.InspectAccountInfoAsync();
            // Enforce the protocol limit incrementally, never buffering an
            // unbounded native file before determining it is too large.
            await using var memory = new MemoryStream();
            var buffer = new byte[16 * 1024];
            try
            {
                while (true)
                {
                    var count = await input.ReadAsync(buffer);
                    if (count == 0) break;
                    if (memory.Length + count > StellarLedgerFileProtocol.MaxFileBytes)
                        throw new InvalidDataException(
                            "Direct Stellar-only files are limited to 1 MiB. Use the separately consented encrypted Sync queue for larger files.");
                    await memory.WriteAsync(buffer.AsMemory(0, count));
                }
                content = memory.ToArray();
            }
            finally
            {
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(buffer);
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(memory.GetBuffer());
            }
            StorageMode.Select(VaultStorageMode.StellarLedger);
            var title = picked.FileName.Length > 256
                ? picked.FileName[..256] : picked.FileName;
            var mime = string.IsNullOrWhiteSpace(picked.ContentType)
                ? "application/octet-stream" : picked.ContentType;
            _nativeDirectFilePlan = new StellarLedgerUploadPlan(title,
                picked.FileName, mime, content,
                string.IsNullOrEmpty(_selectedFolderId) ? null : _selectedFolderId);
            _nativeDirectFileRoot = root.RootAccountId;
            _nativeDirectFileScope = NetworkSelection.CredentialKey(root.RootAccountId);
            _nativeDirectFileCompleted = 0;
            _uploadMessage = "Direct file plan prepared in volatile memory. Every record needs separate approval.";
        }
        catch (Exception ex)
        {
            _nativeDirectFilePlan = null;
            _uploadMessage = "Direct file preparation failed; no transaction submitted: " + ex.Message;
        }
        finally
        {
            if (content is not null)
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(content);
            StorageMode.Reset();
            _ledgerBusy = false;
        }
        if (_nativeDirectFilePlan is not null)
            await ReviewNextNativeDirectFileAsync();
    }

    private async Task ReviewNextNativeDirectFileAsync()
    {
        if (_ledgerBusy || _nativeDirectFileCost is not null ||
            _nativeDirectFilePlan is not { } plan || _nativeDirectFileUncertain) return;
        _ledgerBusy = true;
        try
        {
            RequireNativeDirectFileScope();
            StorageMode.Select(VaultStorageMode.StellarLedger);
            if ((await Ledger.InspectAccountInfoAsync()).RootAccountId != _nativeDirectFileRoot)
                throw new InvalidOperationException("Signing root changed.");
            var remaining = await DirectFileUpload.ReviewAsync(plan);
            if (remaining.Count == 0)
            {
                var ledgerRecords = await Ledger.ReadAsync();
                var published = ledgerRecords.Single(x => x.Id == plan.ManifestId);
                var decoded = StellarLedgerFileProtocol.DecodeFile(published, ledgerRecords);
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(decoded);
                _nativeDirectFilePlan = null;
                _uploadMessage = "File integrity verified on Stellar. All transactions completed.";
                _nativeMode = "browse";
                _ledgerRecords = ledgerRecords;
                return;
            }
            _nativeDirectFileCompleted = plan.Entries.Count - remaining.Count;
            _nativeDirectFileNextId = remaining[0].Id;
            _nativeDirectFileNextDraft = remaining[0].Draft;
            _nativeDirectFileCost = await Ledger.EstimateAsync(remaining[0].Draft);
            _nativeDirectFileApproved = false;
            _uploadMessage = "Review transaction " + (_nativeDirectFileCompleted + 1) +
                " of " + plan.Entries.Count + ". Each record must be approved individually.";
        }
        catch (Exception ex)
        {
            _nativeDirectFileCost = null;
            _nativeDirectFileNextId = null;
            _nativeDirectFileNextDraft = null;
            _uploadMessage = "File review unavailable; nothing new was submitted: " + ex.Message;
        }
        finally
        {
            StorageMode.Reset();
            _ledgerBusy = false;
        }
    }

    private void CancelNativeDirectFileCost()
    {
        if (_ledgerBusy) return;
        _nativeDirectFileCost = null;
        _nativeDirectFileNextId = null;
        _nativeDirectFileNextDraft = null;
        _nativeDirectFileApproved = false;
    }

    private void StopNativeDirectFile()
    {
        if (_ledgerBusy) return;
        _nativeDirectFileCost = null;
        _nativeDirectFileNextDraft = null;
        _nativeDirectFileNextId = null;
        _nativeDirectFilePlan = null;
        _nativeDirectFileApproved = false;
        _uploadMessage = "Upload stopped. Published chunks are not deleted or retried automatically.";
    }

    private static bool SameNativeFileDraft(LedgerRecordDraft x, LedgerRecordDraft y) =>
        x.Title == y.Title && x.Content == y.Content && x.FolderId == y.FolderId &&
        x.IsFolder == y.IsFolder && x.UserName == y.UserName && x.Url == y.Url &&
        x.Notes == y.Notes && (x.Tags ?? []).SequenceEqual(y.Tags ?? [], StringComparer.Ordinal);

    private async Task ConfirmNativeDirectFileAsync()
    {
        if (_ledgerBusy || !_nativeDirectFileApproved ||
            _nativeDirectFilePlan is not { } plan ||
            _nativeDirectFileNextId is not { } approvedId ||
            _nativeDirectFileNextDraft is not { } draft ||
            _nativeDirectFileCost is not { } cost || _nativeDirectFileUncertain) return;
        _ledgerBusy = true;
        CancelNativeDirectFileCost();
        var committed = false;
        var mayHaveSubmitted = false;
        try
        {
            RequireNativeDirectFileScope();
            StorageMode.Select(VaultStorageMode.StellarLedger);
            if ((await Ledger.InspectAccountInfoAsync()).RootAccountId != _nativeDirectFileRoot)
                throw new InvalidOperationException("Signing root changed.");
            var remaining = await DirectFileUpload.ReviewAsync(plan);
            if (remaining.Count == 0 || remaining[0].Id != approvedId ||
                !SameNativeFileDraft(remaining[0].Draft, draft))
                throw new InvalidOperationException("File plan changed since approval.");
            committed = await DirectFileUpload.PublishNextApprovedAsync(plan,
                async current =>
                {
                    if (!SameNativeFileDraft(draft, current)) return false;
                    var fresh = await Ledger.EstimateAsync(current);
                    var eligible = fresh.NetworkFeeXlm <= cost.NetworkFeeXlm &&
                        fresh.PeakReserveXlm <= cost.PeakReserveXlm &&
                        fresh.CreatesChildNode == cost.CreatesChildNode;
                    if (eligible) mayHaveSubmitted = true;
                    return eligible;
                });
            if (!committed)
            {
                _uploadMessage = "File or costs changed before authorization. Review the transaction again.";
                return;
            }
            _nativeDirectFileCompleted++;
            _uploadMessage = "Published and verified " + _nativeDirectFileCompleted +
                " of " + plan.Entries.Count + " file records. Review the next transaction.";
        }
        catch (Exception ex)
        {
            _nativeDirectFileUncertain = mayHaveSubmitted;
            _uploadMessage = mayHaveSubmitted
                ? "Transaction outcome uncertain (" + ex.GetType().Name +
                    "). Investigate current and historical ledger state. Do not retry."
                : "File review failed before signing (" + ex.GetType().Name +
                    "). Review the transaction costs again; nothing was submitted.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerBusy = false;
        }
        if (committed && !_nativeDirectFileUncertain)
            await ReviewNextNativeDirectFileAsync();
    }

    private string? _uploadMessage;

    private async Task StageNativeTreeFileAsync()
    {
        if (_ledgerBusy || !Ledger.IsConnected || !Sessions.IsUnlocked ||
            !Retention.AllowsLocalPersistence) return;
        // A device-only unlock for some *other* HD account must never stage
        // on-chain file mutations under the currently connected root.
        if (_rootAccountId is null ||
            !string.Equals(Sessions.ActiveAccountId, _rootAccountId,
                StringComparison.Ordinal))
        {
            _uploadMessage = "Unlock encrypted local storage for the same Stellar HD root account before staging files.";
            return;
        }
        _ledgerBusy = true;
        _uploadMessage = null;
        try
        {
            var picked = await NativeFiles.PickAsync();
            if (picked is null)
            {
                _uploadMessage = "File selection was canceled. No transaction was sent.";
                return;
            }
            await using var input = picked.Stream;
            StellarLedgerFileProtocol.ValidateName(picked.FileName);
            var title = picked.FileName.Length > 256
                ? picked.FileName[..256] : picked.FileName;
            var mime = string.IsNullOrWhiteSpace(picked.ContentType)
                ? "application/octet-stream" : picked.ContentType;
            var staged = await HybridDrafts.StageTreeFileAsync(
                title, picked.FileName, mime, input,
                string.IsNullOrEmpty(_selectedFolderId) ? null : _selectedFolderId);
            _uploadMessage = "Encrypted file tree staged as " + staged.NodeCount +
                " independent ledger nodes. Open Sync to review fees and historically confirm each transaction. Root " +
                staged.RootId + " publishes last. No transaction was submitted.";
        }
        catch (Exception ex)
        {
            _uploadMessage = "Encrypted file staging failed (" + ex.GetType().Name +
                "). Inspect the local Sync journal before retrying. No transaction was submitted.";
        }
        finally { _ledgerBusy = false; }
    }

    private sealed record VerifiedNativeTree(string RootId, string FileName,
        long Length, string Sha256Hex, string RootAccount, string Network);
    private VerifiedNativeTree? _verifiedNativeTree;

    private async Task VerifySelectedFile()
    {
        _verifiedFileMessage = null;
        _verifiedNativeTree = null;
        var selected = _selectedRecord;
        if (selected is null || !VaultPublishedFileClassification.IsFile(selected) ||
            !Ledger.IsConnected) return;
        try
        {
            var fresh = await Ledger.ReadAsync();
            var current = fresh.SingleOrDefault(x => x.Id == selected.Id)
                ?? throw new InvalidDataException("The selected ledger file no longer exists.");
            if (VaultLinkedTreeFilePolicy.IsRootRecord(current))
            {
                // No unverified plaintext reaches a user-selected destination.
                var verified = await VaultLinkedTreeFilePolicy.ReadAsync(
                    current.Id, fresh, Stream.Null);
                var rootAccount = _rootAccountId
                    ?? throw new InvalidOperationException("The HD account is disconnected.");
                if (!Ledger.IsConnected || _rootAccountId != rootAccount)
                    throw new InvalidOperationException("The HD session changed during verification.");
                _verifiedNativeTree = new(current.Id, verified.FileName,
                    verified.Length, verified.Sha256Hex, rootAccount, _ledgerNetwork);
                _verifiedFileMessage = "File contents and hierarchy verified. Select Save verified file.";
            }
            else
            {
                // Legacy SVFILE readers remain read-only; all new files use
                // bounded encrypted staging rather than whole-file arrays.
                var bytes = StellarLedgerFileProtocol.DecodeFile(current, fresh);
                try
                {
                    _verifiedFileMessage = "Verified legacy file: " +
                        StellarLedgerFileProtocol.FileName(current) + " (" +
                        bytes.Length + " bytes).";
                }
                finally { System.Security.Cryptography.CryptographicOperations.ZeroMemory(bytes); }
            }
        }
        catch (Exception)
        {
            // A network, JSON or host failure must never expose a partially
            // authenticated file or print an untrusted exception message.
            _verifiedNativeTree = null;
            _verifiedFileMessage = "File integrity could not be verified. Nothing was exported.";
        }
    }

    private async Task ExportSelectedFileAsync()
    {
        if (_ledgerBusy || !Ledger.IsConnected) return;
        var selected = _selectedRecord;
        if (selected is null || !VaultPublishedFileClassification.IsFile(selected)) return;
        _ledgerBusy = true;
        byte[]? plaintext = null;
        try
        {
            if (VaultLinkedTreeFilePolicy.IsRootRecord(selected))
            {
                var prepared = _verifiedNativeTree;
                _verifiedNativeTree = null; // one-shot, including failed picker
                if (prepared is null || prepared.RootId != selected.Id ||
                    prepared.RootAccount != _rootAccountId ||
                    prepared.Network != _ledgerNetwork || !Ledger.IsConnected)
                    throw new InvalidOperationException("Verify the tree file again after an account or network change.");

                // A new read ensures the root and its referenced children have
                // not been changed or removed since the user's verification.
                var current = await Ledger.ReadAsync();
                // LedgerRecordItem contains reference-type tag arrays; record
                // equality would report false for identical fresh Horizon
                // snapshots. Authenticate the entire current tree instead.
                var currentRoot = await VaultLinkedTreeFilePolicy.ReadAsync(
                    prepared.RootId, current, Stream.Null);
                if (currentRoot.FileName != prepared.FileName ||
                    currentRoot.Length != prepared.Length ||
                    !string.Equals(currentRoot.Sha256Hex, prepared.Sha256Hex,
                        StringComparison.OrdinalIgnoreCase))
                    throw new InvalidDataException(
                        "The file changed after verification. Verify again.");

                var pipe = new Pipe(new PipeOptions(pauseWriterThreshold: 256 * 1024,
                    resumeWriterThreshold: 128 * 1024));
                using var cancel = new CancellationTokenSource();
                var producer = Task.Run(async () =>
                {
                    await using var writer = pipe.Writer.AsStream(leaveOpen: true);
                    try
                    {
                        await VaultLinkedTreeFilePolicy.ReadAsync(
                            prepared.RootId, current, writer, cancel.Token);
                        await writer.FlushAsync(cancel.Token);
                        await pipe.Writer.CompleteAsync();
                    }
                    catch (Exception ex)
                    {
                        await pipe.Writer.CompleteAsync(ex);
                        throw;
                    }
                });
                try
                {
                    await using var reader = pipe.Reader.AsStream(leaveOpen: true);
                    if (!await NativeFiles.SaveAsync(prepared.FileName, reader))
                        throw new IOException("File selection was canceled or write failed.");
                    await producer;
                    _verifiedFileMessage = "Authenticated file saved with bounded-memory streaming.";
                }
                catch
                {
                    cancel.Cancel();
                    try { await producer; } catch { /* preserve original export failure */ }
                    throw;
                }
                finally { await pipe.Reader.CompleteAsync(); }
            }
            else
            {
                var fresh = await Ledger.ReadAsync();
                var current = fresh.Single(x => x.Id == selected.Id);
                plaintext = StellarLedgerFileProtocol.DecodeFile(current, fresh);
                var name = StellarLedgerFileProtocol.FileName(current);
                using var stream = new MemoryStream(plaintext, writable: false);
                _verifiedFileMessage = await NativeFiles.SaveAsync(name, stream)
                    ? "Verified legacy file exported."
                    : "Legacy file export canceled; no ledger data changed.";
            }
        }
        catch (Exception)
        {
            _verifiedNativeTree = null;
            _verifiedFileMessage = "File export failed. Verify again before retrying.";
        }
        finally
        {
            if (plaintext is not null)
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(plaintext);
            _ledgerBusy = false;
        }
    }

    private async Task CopyNativeRecordValueAsync(string? value)
    {
        if (string.IsNullOrEmpty(value)) return;
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", value); }
        catch { _verifiedFileMessage = "Clipboard is unavailable on this device."; }
    }

    private void ResetSelection()
    {
        _selectedRecord = null;
        _revealSecret = false;
        _verifiedFileMessage = null;
        _verifiedNativeTree = null;
    }

    private void SelectRecord(string id)
    {
        _revealSecret = false;
        _verifiedFileMessage = null;
        _verifiedNativeTree = null;
        var record = _ledgerRecords.SingleOrDefault(x => x.Id == id);
        if (record is null) { _selectedRecord = null; return; }
        if (record.IsFolder)
        {
            _selectedFolderId = record.Id;
            _selectedRecord = null;
        }
        else _selectedRecord = record;
    }

    private void ToggleSecret() => _revealSecret = !_revealSecret;

    private void ClearLedgerView()
    {
        _ledgerRecords = [];
        _rootAccountId = null;
        _selectedFolderId = string.Empty;
        ResetSelection();
        CancelPublish();
        _nativeDirectFilePlan = null;
        _nativeDirectFileCost = null;
        _nativeDirectFileNextDraft = null;
        _nativeDirectFileNextId = null;
        _nativeDirectFileApproved = false;
        _nativeDirectFileUncertain = false;
        _publishTitle = string.Empty;
        _publishContent = string.Empty;
        _publishFolder = _publishUsername = _publishUrl = _publishNotes = _publishTags = string.Empty;
        _showPublishSecret = false;
    }

    private Task ConnectSelectedLedgerCredentialAsync() =>
        _ledgerCredentialMode == VaultCredentialMode.MnemonicHd
            ? ConnectLedgerAsync()
            : InspectNativeSecretChainAsync();

    private async Task InspectNativeSecretChainAsync()
    {
        if (_ledgerBusy || Ledger.IsConnected || SecretLedger.IsConnected || _secretRuntimeReady != true ||
            _ledgerCredentialMode != VaultCredentialMode.StellarSecretKeyChain ||
            (_ledgerNetwork == "public" && !_confirmMainnetAccess) ||
            (_ledgerNetwork == "custom" && !CustomNetworkReady)) return;
        _ledgerBusy = true;
        _secretInspection = null;
        _ledgerMessage = null;
        try
        {
            new VaultAccessCredential(VaultCredentialMode.StellarSecretKeyChain, _ledgerSecretKey).Validate();
            var (url, passphrase) = _ledgerNetwork switch
            {
                "testnet" => ("https://horizon-testnet.stellar.org", "Test SDF Network ; September 2015"),
                "public" => ("https://horizon.stellar.org", "Public Global Stellar Network ; September 2015"),
                "custom" when CustomNetworkReady =>
                    (NetworkSelection.CustomHorizonUrl, NetworkSelection.CustomPassphrase),
                _ => throw new InvalidOperationException("Select a verified Stellar network.")
            };
            if (string.IsNullOrWhiteSpace(passphrase))
                throw new InvalidOperationException("Select a verified Stellar network passphrase.");
            if (!await JS.InvokeAsync<bool>("stellarVaultNativeRuntime.inspectSecret"))
                throw new InvalidOperationException("Stellar S-key runtime is unavailable.");
            _secretInspection = await SecretChain.InspectAsync(_ledgerSecretKey, url, passphrase);
            await SecretLedger.ConnectAsync(_ledgerSecretKey, url, passphrase);
            await SecretLedger.ReadAsync();
            _ledgerMessage = "Independent Secret Key vault unlocked.";
            StorageMode.Reset();
        }
        catch (Exception ex)
        {
            try { if (SecretLedger.IsConnected) await SecretLedger.DisconnectAsync(); }
            catch { /* Preserve the original failure. */ }
            _ledgerMessage = ex.Message.Contains("historical vault record format", StringComparison.OrdinalIgnoreCase)
                ? "An older vault record format was found. It requires verified read-only migration; no records were overwritten."
                : "Secret Key vault recovery failed. Verify signer permissions, account links, encrypted records and network.";
        }
        finally
        {
            _ledgerSecretKey = string.Empty;
            _ledgerBusy = false;
        }
    }

    private async Task DisconnectSelectedLedgerAsync()
    {
        if (SecretLedger.IsConnected)
        {
            await LinkedQueueKeys.LockAsync();
            await SecretLedger.DisconnectAsync();
            _secretInspection = null;
            _ledgerMessage = "Secret Key vault locked.";
            return;
        }
        if (Ledger.IsConnected) await DisconnectLedgerAsync();
    }

    private async Task ConnectLedgerAsync()
    {
        if (_ledgerBusy || Ledger.IsConnected || SecretLedger.IsConnected || _runtimeReady != true ||
            (_ledgerNetwork == "public" && !_confirmMainnetAccess) ||
            (_ledgerNetwork == "custom" && !CustomNetworkReady)) return;
        _ledgerBusy = true;
        _ledgerMessage = null;
        try
        {
            var (url, passphrase) = _ledgerNetwork switch
            {
                "testnet" => ("https://horizon-testnet.stellar.org", "Test SDF Network ; September 2015"),
                "public" => ("https://horizon.stellar.org", "Public Global Stellar Network ; September 2015"),
                "custom" when !string.IsNullOrWhiteSpace(NetworkSelection.CustomHorizonUrl) &&
                              !string.IsNullOrWhiteSpace(NetworkSelection.CustomPassphrase) =>
                    (NetworkSelection.CustomHorizonUrl, NetworkSelection.CustomPassphrase),
                _ => throw new InvalidOperationException("Select and detect a supported network.")
            };
            // The earlier UI preflight may be stale after a WebView reload.
            // Recheck dependencies immediately before passing any mnemonic to JS.
            var readiness = await JS.InvokeAsync<RuntimeStatus>("stellarVaultNativeRuntime.inspect");
            if (!readiness.Ready)
            {
                _runtimeReady = false;
                throw new InvalidOperationException("Stellar runtime is not ready.");
            }
            await Ledger.ConnectAsync(_ledgerMnemonic, url, passphrase);
            NetworkSelection.Select(_ledgerNetwork);
            // A connected transport is not permission to write: remain local.
            StorageMode.Reset();
            _ledgerRecords = await Ledger.ReadAsync();
            var account = await Ledger.InspectAccountInfoAsync();
            _rootAccountId = account.RootAccountId;
            _selectedFolderId = string.Empty;
            ResetSelection();
            _ledgerMessage = null;
        }
        catch
        {
            StorageMode.Reset();
            ClearLedgerView();
            _ledgerMessage = "Ledger connection or recovery failed. Check your mnemonic, network and connection.";
            try { await Ledger.DisconnectAsync(); } catch { /* Do not mask the recovery failure. */ }
        }
        finally
        {
            _ledgerMnemonic = string.Empty;
            _ledgerBusy = false;
        }
    }

    private async Task RefreshLedgerAsync()
    {
        if (_ledgerBusy || !Ledger.IsConnected) return;
        _ledgerBusy = true;
        try
        {
            _ledgerRecords = await Ledger.ReadAsync();
            _selectedFolderId = string.Empty;
            ResetSelection();
            _ledgerMessage = null;
        }
        catch
        {
            ClearLedgerView();
            _ledgerMessage = "Ledger recovery failed. No records were displayed.";
        }
        finally { _ledgerBusy = false; }
    }

    private async Task DisconnectLedgerAsync()
    {
        if (_ledgerBusy) return;
        _ledgerBusy = true;
        try
        {
            await Ledger.DisconnectAsync();
            _ledgerMessage = null;
        }
        catch
        {
            // Do not claim disconnection when session-key cleanup is uncertain.
            _ledgerMessage = "Ledger disconnect failed. Close this application before reusing the vault.";
        }
        finally
        {
            StorageMode.Reset();
            _ledgerMnemonic = string.Empty;
            ClearLedgerView();
            _ledgerBusy = false;
        }
    }

    private bool _localConsent;
    private string _accountId = string.Empty;
    private string _passphrase = string.Empty;
    private string? _message;
    private bool _busy;

    private bool _foregroundRevoked;

    protected override void OnInitialized()
    {
        Sessions.StateChanged += OnSessionChanged;
        ForegroundLifecycle.ForegroundLost += OnForegroundLost;
        NativeNavigation.BackRequested += OnAndroidBackRequested;
        NativeNavigation.SetSecondaryDestination(_nativePage != "stellar");
    }

    private void OnForegroundLost()
    {
        // Immediately hide all native signer and unlocked record controls.
        // Queue reservations are durable: never resubmit an interrupted write.
        _foregroundRevoked = true;
        NativeNavigation.Clear();
        _ = InvokeAsync(RevokeForegroundAsync);
    }

    private async Task RevokeForegroundAsync()
    {
        await LinkedQueueKeys.LockAsync();
        _ledgerMnemonic = string.Empty;
        _passphrase = string.Empty;
        _localConsent = false;
        StorageMode.Reset();
        Retention.Reset();
        Workflow.Lock();
        ClearLedgerView();
        var disconnected = !Ledger.IsConnected && !SecretLedger.IsConnected;
        try
        {
            if (Ledger.IsConnected) await Ledger.DisconnectAsync();
            if (SecretLedger.IsConnected) await SecretLedger.DisconnectAsync();
            _ledgerSecretKey = string.Empty;
            _secretInspection = null;
            disconnected = true;
        }
        catch
        {
            // A failed JS cleanup is not an unlocked state: leave a fail-closed
            // screen requiring full native restart instead of offering signing.
        }
        finally
        {
            _runtimeReady = null;
            _ledgerMessage = disconnected ? "Signing session cleared." :
                "Signer cleanup failed. Restart the application.";
            _foregroundRevoked = !disconnected;
            StateHasChanged();
        }
    }

    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private Task CreateVault() => RunAsync(create: true);
    private Task UnlockVault() => RunAsync(create: false);

    private async Task RunAsync(bool create)
    {
        if (_busy) return;
        if (_ledgerNetwork == "custom" && !CustomNetworkReady)
        {
            _message = "Detect the custom network before unlocking local storage.";
            return;
        }
        _busy = true;
        _message = null;
        try
        {
            if (!_localConsent)
                throw new InvalidOperationException("Explicit encrypted device storage consent is required.");
            if (create && _passphrase.Length < 12)
                throw new ArgumentException("Local vault passphrase must have at least 12 characters.");
            // Local-only namespace authorization does NOT establish Stellar
            // signer ownership and MUST NOT be used for paid transactions.
            StellarAccountAddress.Validate(_accountId.Trim());
            Retention.Select(VaultDeviceRetentionPolicy.EncryptedLocalWithManualSync);
            if (create) await Workflow.CreateAsync(_accountId.Trim(), _passphrase);
            else await Workflow.UnlockAsync(_accountId.Trim(), _passphrase);
            _message = "Encrypted local vault unlocked. No Stellar ownership proof or transaction approval was granted.";
        }
        catch (Exception ex) when (ex is UnauthorizedAccessException or ArgumentException or
                                     System.Security.Cryptography.CryptographicException or
                                     FileNotFoundException or InvalidOperationException or OperationCanceledException)
        {
            // Never disclose underlying credentials or intermediate cryptographic values.
            _message = ex is UnauthorizedAccessException
                ? "Account ownership verification is unavailable. Vault remains locked."
                : "Vault operation failed. Check the account and credentials.";
        }
        finally
        {
            if (!Sessions.IsUnlocked) Retention.Reset();
            _passphrase = string.Empty;
            _busy = false;
        }
    }

    private async Task LockVault()
    {
        await LinkedQueueKeys.LockAsync();
        Workflow.Lock();
        Retention.Reset();
        _passphrase = string.Empty;
        _localConsent = false;
        _message = "Vault locked.";
    }

    public async ValueTask DisposeAsync()
    {
        await LinkedQueueKeys.LockAsync();
        Sessions.StateChanged -= OnSessionChanged;
        ForegroundLifecycle.ForegroundLost -= OnForegroundLost;
        NativeNavigation.BackRequested -= OnAndroidBackRequested;
        NativeNavigation.Clear();
        StorageMode.Reset();
        Retention.Reset();
        _ledgerMnemonic = string.Empty;
        ClearLedgerView();
        // Closing the WebView must release any session keys retained by JS.
        if (Ledger.IsConnected)
        {
            try { await Ledger.DisconnectAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
                // The native WebView may already be gone during app shutdown.
            }
        }
        if (SecretLedger.IsConnected)
        {
            try { await SecretLedger.DisconnectAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException)
            {
                // The native WebView may already be gone during app shutdown.
            }
        }
        _ledgerSecretKey = string.Empty;
        _secretInspection = null;
    }
}
