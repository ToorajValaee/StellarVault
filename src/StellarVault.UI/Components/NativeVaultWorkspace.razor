        else if (Ledger.IsConnected) SetNativeMode("folder");
    }

    private async Task RefreshNativeActiveStrategyAsync()
    {
        if (SecretLedger.IsConnected)
        {
            if (_linkedWorkspace is not null)
                await _linkedWorkspace.RefreshFromShellAsync();
        }
        else if (Ledger.IsConnected) await RefreshLedgerAsync();
