@using StellarVault.UI.Components
@using StellarVault.Core.Services
@using Microsoft.JSInterop
@using System.IO.Pipelines
@inject VaultSessionManager Sessions
@inject VaultLinkedQueueKeySession LinkedQueueKeys
@inject VaultSessionWorkflow Workflow
@inject IStellarLedgerRecords Ledger
@inject IStellarSecretKeyVaultDiscovery SecretChain
@inject IStellarSecretKeyLedger SecretLedger
@inject VaultStorageModeGate StorageMode
@inject VaultDeviceRetentionGate Retention
@inject VaultNetworkSelection NetworkSelection
@inject VaultNativeForegroundLifecycle ForegroundLifecycle
@inject VaultNativeNavigationState NativeNavigation
@inject Microsoft.JSInterop.IJSRuntime JS
@inject IVaultNativeFileAccess NativeFiles
@inject VaultHybridDraftWorkspace HybridDrafts
@inject StellarLedgerUploadCoordinator DirectFileUpload
@implements IAsyncDisposable

@if (_foregroundRevoked)
{
    <section class="terminal-panel" role="alert">
        <h2>NATIVE SESSION LOCKED</h2>
        <p>StellarVault left the foreground. Encryption and signing credentials are being
           cleared. If this screen remains, close and reopen the app before reconnecting.</p>
    </section>
}
else if (ActiveMode == VaultWorkspaceMode.ConflictingSessions)
{
    <section class="terminal-panel" role="alert">
        <h2>Conflicting vault sessions</h2>
        <p>Mnemonic/HD and independent Secret Key sessions are both active.
           Vault actions are disabled until both are locked. No transaction was sent.</p>
        <button type="button" class="pixel-button primary" disabled="@_ledgerBusy"
                @onclick="LockConflictingNativeSessionsAsync">Lock both vaults</button>
        @if (_conflictingLockError is not null)
        {
            <p role="alert" class="terminal-alert warning">@_conflictingLockError</p>
        }
    </section>
}
else
{
    <div class="sv-native-shell native-@HostPlatform.ToLowerInvariant()">
        <header class="sv-native-topbar">
            <div class="sv-native-brand"><span class="sv-native-brandmark" aria-hidden="true">✦</span>
                <span><strong>StellarVault</strong></span></div>
            <div class="sv-native-header-actions">
                <details class="sv-native-header-network">
                    <summary aria-label="Select Stellar network" title="Network: @NetworkLabel">
                        <span aria-hidden="true">◎</span><span class="sv-native-network-dot @(_ledgerNetwork == "public" ? "mainnet" : _ledgerNetwork == "custom" ? "custom" : "")"></span>
                    </summary>
                    <div class="sv-native-network-popover">
                        <strong>Network</strong>
                        <div class="sv-native-network-choice" role="group" aria-label="Choose Stellar network">
                            <button type="button" class="pixel-button compact @(_ledgerNetwork == "testnet" ? "primary" : "")"
                                    disabled="@(!CanChangeNetwork)" @onclick='() => SelectNativeNetwork("testnet")'>Testnet</button>
                            <button type="button" class="pixel-button compact @(_ledgerNetwork == "public" ? "primary" : "")"
                                    disabled="@(!CanChangeNetwork)" @onclick='() => SelectNativeNetwork("public")'>Mainnet</button>
                            <button type="button" class="pixel-button compact @(_ledgerNetwork == "custom" ? "primary" : "")"
                                    disabled="@(!CanChangeNetwork)" @onclick='() => SelectNativeNetwork("custom")'>Custom</button>
                        </div>
                        @if (_ledgerNetwork == "custom")
                        {
                            <label class="terminal-label" for="native-custom-horizon">Horizon URL</label>
                            <input id="native-custom-horizon" class="terminal-input" type="url" autocomplete="url"
                                   placeholder="https://horizon.example.com"
                                   @bind="_customHorizon" @bind:event="oninput" disabled="@(!CanChangeNetwork)" />
                            <button type="button" class="pixel-button compact" @onclick="DiscoverNativeNetworkAsync"
                                    disabled="@(!CanChangeNetwork || string.IsNullOrWhiteSpace(_customHorizon))">
                                @(_networkDiscovering ? "Detecting…" : "Detect network")
                            </button>
                            @if (CustomNetworkReady)
                            {
                                <p class="sv-native-subtle-status" role="status">Network detected and ready.</p>
                                <details class="sv-native-help"><summary>Network passphrase</summary>
                                    <code>@NetworkSelection.CustomPassphrase</code>
                                </details>
                            }
                            else
                            {
                                <p class="sv-native-subtle-status">Detect the network before connecting.</p>
                            }
                        }
                        @if (!string.IsNullOrWhiteSpace(_networkError))
                        {
                            <p class="terminal-alert warning" role="alert">@_networkError</p>
                        }
                    </div>
                </details>
                <span class="sv-native-online-pill"><span aria-hidden="true">◉</span> @(Ledger.IsConnected || SecretLedger.IsConnected ? "Online · Connected" : "Offline · Local")</span>
            </div>
        </header>
        <nav class="sv-native-nav" aria-label="Primary navigation">
            <button type="button" class="@(_nativePage == "stellar" ? "selected" : "")" aria-current="@(_nativePage == "stellar" ? "page" : null)" @onclick='() => NavigateNative("stellar")'><span class="sv-native-nav-icon" aria-hidden="true">⌂</span><span>Vault</span></button>
            <button type="button" class="@(_nativePage == "local" ? "selected" : "")" aria-current="@(_nativePage == "local" ? "page" : null)" @onclick='() => NavigateNative("local")'><span class="sv-native-nav-icon" aria-hidden="true">♙</span><span>Device</span></button>
            <button type="button" class="@(_nativePage == "sync" ? "selected" : "")" aria-current="@(_nativePage == "sync" ? "page" : null)" @onclick='() => NavigateNative("sync")'><span class="sv-native-nav-icon" aria-hidden="true">⟳</span><span>Sync</span></button>
            <button type="button" class="@(_nativePage == "settings" ? "selected" : "")" aria-current="@(_nativePage == "settings" ? "page" : null)" @onclick='() => NavigateNative("settings")'><span class="sv-native-nav-icon" aria-hidden="true">⚙</span><span>Settings</span></button>
        </nav>
        <main class="sv-native-scroll" id="native-content" tabindex="-1" @key="NativeContentKey">
          <div class="sv-native-content">
            @if (_nativePage != "stellar" || Ledger.IsConnected || SecretLedger.IsConnected)
            {
                <div class="sv-native-page-heading">
                    <h1>@(_nativePage == "stellar" ? "Records" : _nativePage == "local" ? "My vault" : _nativePage == "settings" ? "Settings" : "Sync")</h1>
                </div>
            }
    @if (_nativePage == "settings" && !SecretLedger.IsConnected)
    {
        <section class="sv-native-settings" aria-label="Vault settings">
            <div class="terminal-panel">
                <h2>Connection</h2>
                <div class="sv-native-setting-row">
                    <div><strong>Network</strong><p>@NetworkLabel</p></div>
                    <span>@(Ledger.IsConnected || SecretLedger.IsConnected ? "Connected" : "Not connected")</span>
                </div>
                @if (Ledger.IsConnected || SecretLedger.IsConnected)
                {
                    <button type="button" class="pixel-button compact"
                            disabled="@_ledgerBusy" @onclick="DisconnectSelectedLedgerAsync">Disconnect Stellar</button>
                }
            </div>
            <div class="terminal-panel">
                <h2>Privacy &amp; storage</h2>
                <div class="sv-native-setting-row">
                    <div><strong>Encrypted device vault</strong>
                        <p>@(Sessions.IsUnlocked ? "Unlocked on this device" : "Locked")</p></div>
                </div>
                @if (Sessions.IsUnlocked)
                {
                    <button type="button" class="pixel-button compact" @onclick="LockVault">Lock device vault</button>
                }
                <details class="sv-native-help">
                    <summary>Storage and backups</summary>
                    <VaultStorageSecurityNotice Native="true" />
                </details>
            </div>
        </section>
    }
    <section class="native-preview sv-vault-data" aria-label="Native vault workspace">
        @if (SecretLedger.IsConnected)
        {
            @* Keep the same linked component mounted across native tabs to
               preserve signer-bound quotes, local encrypted queue and recovery. *@
            <VaultSecretKeyWorkspace Embedded="true"
                                     View="@(_nativePage == "stellar" ? "records" :
                                             _nativePage == "local" ? "drafts" : _nativePage)"
                                     OnViewChange="NavigateLinkedNative"
                                     @ref="_linkedWorkspace" />
        }
        else
        {
        @if (_nativePage == "stellar")
        {
        <section aria-label="Stellar ledger recovery" class="terminal-panel">
            @if (!Ledger.IsConnected && !SecretLedger.IsConnected)
            {
                @if (_ledgerNetwork == "public")
                {
                    <label class="sv-native-mainnet-consent">
                        <input type="checkbox" @bind="_confirmMainnetAccess" disabled="@_ledgerBusy" />
                        I understand that Mainnet uses real funds and approved transactions may incur fees in the network's native asset.
                    </label>
                }
                <div class="sv-credential-mode-picker" role="group" aria-label="Vault account type">
                    <button type="button" class="@(_ledgerCredentialMode == VaultCredentialMode.MnemonicHd ? "selected" : "")"
                            disabled="@_ledgerBusy" aria-pressed="@(_ledgerCredentialMode == VaultCredentialMode.MnemonicHd)"
                            @onclick='() => SelectLedgerCredentialMode(VaultCredentialMode.MnemonicHd)'>Recovery phrase / HD</button>
                    <button type="button" class="@(_ledgerCredentialMode == VaultCredentialMode.StellarSecretKeyChain ? "selected" : "")"
                            disabled="@_ledgerBusy" aria-pressed="@(_ledgerCredentialMode == VaultCredentialMode.StellarSecretKeyChain)"
                            @onclick='() => SelectLedgerCredentialMode(VaultCredentialMode.StellarSecretKeyChain)'>Stellar secret key</button>
                </div>
                @if (_ledgerCredentialMode == VaultCredentialMode.MnemonicHd)
                {
                    <label class="terminal-label" for="native-ledger-mnemonic">Recovery phrase</label>
                    <VaultMnemonicInput @bind-Value="_ledgerMnemonic" Disabled="@(_ledgerBusy || _runtimeReady != true)" />
                }
                else
                {
                    <label class="terminal-label" for="native-ledger-secret">Stellar secret key (S-key)</label>
                    <input id="native-ledger-secret" class="terminal-input" type="password" autocomplete="off"
                           spellcheck="false" maxlength="56" @bind="_ledgerSecretKey" @bind:event="oninput"
                           disabled="@(_ledgerBusy || _secretRuntimeReady != true)" />
                    <p class="sv-native-subtle-status">Independent Secret Key vault. Verify account signers and encrypted records before unlocking. Ledger mutations require a separate fee review and are Testnet-only until audit.</p>
                    <VaultLinkedLocalQueuePanel />
                    @if (_secretInspection is not null)
                    {
                        <section class="terminal-panel" aria-label="Verified secret-key account chain">
                            <h3>Linked accounts</h3>
                            <p>Root: <code>@_secretInspection.RootAccountId</code></p>
                            <p>Verified accounts: @_secretInspection.Accounts.Count</p>
                            <p>Tail: <code>@_secretInspection.TailAccountId</code></p>
                            <p>No transaction was sent; this is not yet a record unlock.</p>
                        </section>
                    }
                }
                @if (_runtimeReady is null || (_runtimeReady == false && _ledgerBusy))
                { <p class="sv-native-subtle-status" role="status">Preparing your vault…</p> }

            }
            else
            {
                @if (_nativeMode == "browse")
                {
                <div class="sv-native-browser-toolbar">
                    <span class="sv-native-subtle-status">@_ledgerRecords.Count(x => !VaultPublishedFileClassification.IsInternalNode(x)) items</span>
                    <div class="sv-native-browser-actions">
                        <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick='() => SetNativeMode("record")'>＋ Record</button>
                        <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick='() => SetNativeMode("folder")'>＋ Folder</button>
                        <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick='() => SetNativeMode("file")'>⇧ File</button>
                    </div>
                </div>
                }
                else
                {
                    <button type="button" class="sv-native-back" disabled="@_ledgerBusy"
                            @onclick='() => SetNativeMode("browse")'>← Back to records</button>
                }
                @if (_nativeMode is "record" or "folder")
                {
                                <section aria-label="Publish Stellar item" class="terminal-panel">
                    <h3>@(_nativeMode == "folder" ? "New folder" : "New record")</h3>
                    <VaultRecordFields IsFolder="@(_nativeMode == "folder")"
                                       Disabled="_ledgerBusy"
                                       Folders="@_ledgerRecords.Where(x => x.IsFolder).ToArray()"
                                       @bind-Title="_publishTitle"
                                       @bind-FolderId="_publishFolder"
                                       @bind-Username="_publishUsername"
                                       @bind-Url="_publishUrl"
                                       @bind-Secret="_publishContent"
                                       @bind-Notes="_publishNotes"
                                       @bind-Tags="_publishTags"
                                       @bind-ShowSecret="_showPublishSecret" />
                    <details class="sv-native-help"><summary>About publishing</summary>
                        <p>Publishing writes an encrypted record to Stellar. Network fees and account reserves apply; every transaction requires explicit approval.</p>
                    </details>
                    <button type="button" class="pixel-button compact" disabled="@(_ledgerBusy || string.IsNullOrWhiteSpace(_publishTitle) || (_nativeMode != "folder" && string.IsNullOrWhiteSpace(_publishContent)))" @onclick="EstimatePublishAsync">Review transaction cost</button>
                    @if (_publishEstimate is not null)
                    {
                        <VaultTransactionCostReview Cost="_publishEstimate" Network="@_ledgerNetwork" Title="@(_nativeMode == "folder" ? "CREATE FOLDER" : "PUBLISH RECORD")" />
                        <label><input type="checkbox" @bind="_publishApproved" disabled="@_ledgerBusy" /> I approve publishing this encrypted @(_nativeMode == "folder" ? "folder" : "record") to @_ledgerNetwork.</label>
                        <button type="button" class="pixel-button compact" disabled="@(_ledgerBusy || !_publishApproved)" @onclick="ConfirmPublishAsync">Approve and submit to Stellar</button>
                        <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="CancelPublish">Cancel</button>
                    }
                </section>
                }
                @if (_nativeMode == "file")
                {
                                <section aria-label="Upload Stellar file" class="terminal-panel">
                    <h3>Add file</h3>
                    @if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked &&
                        Sessions.ActiveAccountId == _rootAccountId)
                    {
                        <p class="notice">Hybrid upload: stream any file into the encrypted Sync queue, then approve and historically verify its SVTREE3 transactions separately. No transaction is sent during staging.</p>
                        <button type="button" class="pixel-button compact" disabled="@(_ledgerBusy || _nativeDirectFilePlan is not null)" @onclick="StageNativeTreeFileAsync">Choose file and stage securely</button>
                    }
                    else
                    {
                        <p class="notice">Stellar-only upload: publish an SVFILE1/SVFILE2 file up to 1 MiB directly without saving encrypted drafts on this device. Every chunk and the final manifest require separate fee approval. Closing during upload loses its in-memory plan and can leave orphan chunks.</p>
                        <button type="button" class="pixel-button compact" disabled="@(_ledgerBusy || !Ledger.IsConnected || _nativeDirectFilePlan is not null)" @onclick="PrepareNativeDirectFileAsync">Choose file to review on Stellar</button>
                    }
                    @if (_nativeDirectFilePlan is not null)
                    {
                        <p class="sv-native-subtle-status" role="status">Verified @_nativeDirectFileCompleted of @_nativeDirectFilePlan.Entries.Count file records in this session.</p>
                        @if (_nativeDirectFileUncertain)
                        {
                            <p class="terminal-alert warning">The last transaction outcome is uncertain. Do not retry without historical investigation; incomplete chunks may remain on Stellar.</p>
                        }
                        else
                        {
                            @if (_nativeDirectFileCost is not null)
                            {
                                <VaultTransactionCostReview Cost="_nativeDirectFileCost" Network="@_ledgerNetwork" Title="PUBLISH FILE RECORD" />
                                <label><input type="checkbox" @bind="_nativeDirectFileApproved" disabled="@_ledgerBusy" /> I approve this file transaction and its displayed fee and reserve.</label>
                                <button type="button" class="pixel-button primary" disabled="@(_ledgerBusy || !_nativeDirectFileApproved)" @onclick="ConfirmNativeDirectFileAsync">Approve and publish this record</button>
                                <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="CancelNativeDirectFileCost">Cancel this approval</button>
                            }
                            else
                            {
                                <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="ReviewNextNativeDirectFileAsync">Review next file transaction</button>
                            }
                            <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="StopNativeDirectFile">Stop upload (preserve on-chain chunks)</button>
                        }
                    }
                    @if (!string.IsNullOrWhiteSpace(_uploadMessage))
                    {
                        <p role="status">@_uploadMessage</p>
                    }
                </section>
                }
                @if (_nativeMode == "browse")
                {
                    <div class="sv-access-actions"><details class="sv-object-actions"><summary>⋯ Vault menu</summary><div class="sv-object-menu"><VaultRecordTransferPanel Mode="import" Strategy="@VaultMutationStrategyPolicy.Hd" Records="_ledgerRecords" /></div></details></div>
                    <div class="sv-native-mobile-collections" role="group" aria-label="Browse items">
                        <button type="button" class="@(_nativeCollection == "all" ? "selected" : "")" @onclick='() => _nativeCollection = "all"'>▱ All Items</button>
                        <button type="button" class="@(_nativeCollection == "folders" ? "selected" : "")" @onclick='() => _nativeCollection = "folders"'>▱ Folders</button>
                        <button type="button" class="@(_nativeCollection == "records" ? "selected" : "")" @onclick='() => _nativeCollection = "records"'>◷ Records</button>
                    </div>
                    <label class="sv-native-mobile-search"><span aria-hidden="true">⌕</span><input type="search" aria-label="Search vault items" placeholder="Search your vault…" @bind="_nativeSearch" @bind:event="oninput" /></label>
                    @if (_ledgerRecords.Any(x => x.IsFolder && string.IsNullOrEmpty(x.FolderId)) && string.IsNullOrEmpty(_selectedFolderId))
                    {
                        <section class="sv-native-folder-shortcuts" aria-label="Folder shortcuts">
                            <div class="sv-native-section-title"><h2>Folder Shortcuts</h2><button type="button" @onclick='() => _nativeCollection = "folders"'>See all ›</button></div>
                            <div class="sv-native-shortcut-grid">
                                @foreach (var shortcut in _ledgerRecords.Where(x => x.IsFolder && string.IsNullOrEmpty(x.FolderId)).Take(4))
                                {
                                    <button type="button" @onclick="() => OpenNativeFolder(shortcut.Id)">
                                        <span aria-hidden="true">📁</span><strong>@shortcut.Title</strong>
                                        <small>@_ledgerRecords.Count(x => x.FolderId == shortcut.Id && !VaultPublishedFileClassification.IsInternalNode(x)) items</small>
                                    </button>
                                }
                            </div>
                        </section>
                    }
                    <div class="sv-native-list-toolbar">
                        @if (!string.IsNullOrEmpty(_selectedFolderId))
                        {
                            <button class="sv-native-folder-back" type="button" aria-label="Back to vault root" @onclick='() => OpenNativeFolder("")'>‹</button>
                        }
                        <h2>@(_nativeCollection == "folders" ? "Folders" : _nativeCollection == "records" ? "Records" : "All Items")</h2><button type="button" aria-label="Toggle item layout" @onclick='() => _nativeGrid = !_nativeGrid'>☷</button></div>
                    <div class="sv-native-explorer sv-native-collection-@_nativeCollection @(_nativeGrid ? "sv-native-grid-mode" : "")">
                        <VaultExplorerTree Folders="@_ledgerRecords.Where(x => x.IsFolder).ToArray()"
                                           SelectedFolderId="@(string.IsNullOrEmpty(_selectedFolderId) ? null : _selectedFolderId)"
                                           CollapsedFolderIds="_nativeCollapsedFolders"
                                           OnFolderSelected="SelectNativeFolderFromSharedTree"
                                           OnToggleFolder="ToggleNativeFolder" />
                        <div class="sv-native-object-storage">
                            <label class="terminal-label" for="native-ledger-folder">Folder</label>
                            <select id="native-ledger-folder" class="terminal-input sv-native-mobile-folder"
                                    @bind="_selectedFolderId" @bind:after="ResetSelection" disabled="@_ledgerBusy">
                                <option value="">My vault</option>
                                @foreach (var folder in _ledgerRecords.Where(x => x.IsFolder))
                                {
                                    <option value="@folder.Id">@NativeFolderPath(folder.Id)</option>
                                }
                            </select>
                            <div class="sv-native-object-grid">
                            <VaultPublishedItemsView Strategy="@VaultMutationStrategyPolicy.Hd" Items="_ledgerRecords"
                                                     FolderId="_selectedFolderId"
                                                     Search="_nativeSearch"
                                                     Collection="_nativeCollection"
                                                     SelectedItemId="_selectedRecord?.Id"
                                                     Busy="_ledgerBusy"
                                                     OnOpen="SelectNativePublishedItem" />
                            </div>
                        </div>
                    </div>
                @if (_selectedRecord is not null && !_selectedRecord.IsFolder)
                {
                    <VaultRecordInspector @key="_selectedRecord.Id"
                                          Embedded="true"
                                          Item="_selectedRecord"
                                          Strategy="@VaultMutationStrategyPolicy.Hd"
                                          Records="_ledgerRecords"
                                          FolderPath="@(string.IsNullOrEmpty(_selectedFolderId)
                                              ? "My vault" : NativeFolderPath(_selectedFolderId))"
                                          CanEdit="false"
                                          CanDelete="false"
                                          FileStatus="_verifiedFileMessage"
                                          CanSaveVerifiedFile="@(StellarLedgerFileProtocol.IsFile(_selectedRecord) ||
                                               (_verifiedNativeTree is not null &&
                                                _verifiedNativeTree.RootId == _selectedRecord.Id))"
                                          OnClose="ResetSelection"
                                          OnCopy="CopyNativeRecordValueAsync"
                                          OnVerifyFile="VerifySelectedFile"
                                          OnSaveVerifiedFile="ExportSelectedFileAsync" />
                }
                }
            }
            @if (!string.IsNullOrEmpty(_ledgerMessage))
            {
                <div class="terminal-alert warning" role="alert">
                    <span>@_ledgerMessage</span>
                    @if (_runtimeReady == false && !Ledger.IsConnected)
                    { <button type="button" class="pixel-button compact" disabled="@_ledgerBusy" @onclick="CheckRuntimeAsync">Try again</button> }
                </div>
            }
            @if (Ledger.IsConnected)
            {
                <details class="sv-native-help"><summary>About storage and transactions</summary>
                    <p>Local records stay on this device. Publishing to Stellar needs your approval and may incur network-native fees.</p>
                </details>
            }
        </section>
        }
        @if (_nativePage is "local" or "sync")
        {
        <section class="terminal-panel" aria-label="Local encrypted vault status">
            <h3>@(Sessions.IsUnlocked ? "Your saved items" : "Unlock local storage")</h3>
            @if (Sessions.IsUnlocked)
            {
                <p class="sv-native-subtle-status">Protected on this device</p>
                @if (_nativePage == "local")
                {
                    <nav class="sv-native-segments" aria-label="Local vault views">
                        <button type="button" class="@(_localMode == "records" ? "selected" : "")"
                                aria-pressed="@(_localMode == "records")"
                                @onclick='() => _localMode = "records"'>Device records</button>
                        <button type="button" class="@(_localMode == "drafts" ? "selected" : "")"
                                aria-pressed="@(_localMode == "drafts")"
                                @onclick='() => _localMode = "drafts"'>Offline drafts</button>
                    </nav>
                    @if (_localMode == "records")
                    {
                        <VaultRecordWorkspaceView />
                    }
                    else
                    {
                        <VaultHybridDraftEditor />
                    }
                }
                else
                {
                    <p class="sv-native-subtle-status">Only records and folders can be synced.</p>
                    <nav class="sv-native-segments" aria-label="Hybrid sync views">
                        <button type="button" class="@(_syncMode == "changes" ? "selected" : "")"
                                aria-pressed="@(_syncMode == "changes")"
                                @onclick='() => _syncMode = "changes"'>Stage changes</button>
                        <button type="button" class="@(_syncMode == "review" ? "selected" : "")"
                                aria-pressed="@(_syncMode == "review")"
                                @onclick='() => _syncMode = "review"'>Review &amp; sync</button>
                    </nav>
                    @if (_syncMode == "changes")
                    {
                        <VaultHybridRemoteChanges />
                    }
                    else
                    {
                        <VaultHybridSyncReview />
                    }
                }
            }
            else
            {
                <p>Your saved items are encrypted on this device. Choose local storage to get started.</p>
                <label class="sv-biometric-choice">
                    <input type="checkbox" @bind="_localConsent" disabled="@_busy" />
                    Save encrypted items on this device (I understand I need my own backup)
                </label>
                @if (_localConsent)
                {
                    <label class="terminal-label" for="native-local-account">Stellar account address</label>
                    <input id="native-local-account" class="terminal-input"
                           autocomplete="off" spellcheck="false" maxlength="56"
                           @bind="_accountId" disabled="@_busy" />
                    <label class="terminal-label" for="native-local-passphrase">Vault passphrase</label>
                    <input id="native-local-passphrase" class="terminal-input" type="password"
                           autocomplete="off" @bind="_passphrase" disabled="@_busy" />
                    <div class="sv-access-actions">
                        <button type="button" class="pixel-button compact"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_passphrase) || _accountId.Length != 56 || (_ledgerNetwork == "custom" && !CustomNetworkReady))"
                                @onclick="CreateVault">Create vault</button>
                        <button type="button" class="pixel-button compact"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_passphrase) || _accountId.Length != 56 || (_ledgerNetwork == "custom" && !CustomNetworkReady))"
                                @onclick="UnlockVault">Unlock vault</button>
                    </div>
                    <p class="sv-native-subtle-status">For a new vault, use at least 12 characters. Keep your passphrase safe.</p>
                }
            }
            <details class="sv-native-help"><summary>How local storage works</summary>
                <VaultStorageSecurityNotice Native="true" />
            </details>
        </section>
        @if (!string.IsNullOrEmpty(_message))
        {
            <p role="status" aria-live="polite">@_message</p>
        }
        }
        }
    </section>
          </div>
        </main>
        @if (_nativePage == "stellar" && _nativeMode == "browse" &&
             (Ledger.IsConnected || SecretLedger.IsConnected))
        {
            <button class="sv-native-mobile-fab" type="button" aria-label="New record"
                    @onclick="NewNativeRecordForActiveStrategy">＋</button>
        }
        <div class="sv-native-commandbar @(_nativePage == "stellar" && (Ledger.IsConnected || SecretLedger.IsConnected) && _nativeMode == "browse" ? "sv-native-commandbar-quiet" : "")" aria-label="Quick actions">
            @if (_nativePage == "stellar")
            {
                @if (SecretLedger.IsConnected)
                {
                    <button type="button" class="sv-native-command primary"
                            disabled="@_ledgerBusy" @onclick="NewNativeRecordForActiveStrategy">＋ Record</button>
                    <button type="button" class="sv-native-command"
                            disabled="@_ledgerBusy" @onclick="NewNativeFolderForActiveStrategy">＋ Folder</button>
                    <button type="button" class="sv-native-command"
                            disabled="@_ledgerBusy" @onclick="RefreshNativeActiveStrategyAsync">Refresh</button>
                    <button type="button" class="sv-native-command"
                            disabled="@_ledgerBusy" @onclick="DisconnectSelectedLedgerAsync">Lock</button>
                }
                else if (Ledger.IsConnected)
                {
                    <button type="button" class="sv-native-command primary"
                            disabled="@_ledgerBusy" @onclick="NewNativeRecordForActiveStrategy">＋ Record</button>
                    <button type="button" class="sv-native-command"
                            disabled="@_ledgerBusy" @onclick="NewNativeFolderForActiveStrategy">＋ Folder</button>
                    <button type="button" class="sv-native-command"
                            disabled="@_ledgerBusy" @onclick="RefreshNativeActiveStrategyAsync">Refresh</button>
                    <button type="button" class="sv-native-command"
                            disabled="@_ledgerBusy" @onclick="DisconnectSelectedLedgerAsync">Lock</button>
                }
                else
                {
                    <span class="sv-native-command-hint">@(_runtimeReady == false ? "Connection unavailable" : "Your vault")</span>
                    <button type="button" class="sv-native-command primary"
                            disabled="@(_ledgerBusy || (_ledgerCredentialMode == VaultCredentialMode.MnemonicHd ? _runtimeReady != true : _secretRuntimeReady != true) || string.IsNullOrWhiteSpace(_ledgerCredentialMode == VaultCredentialMode.MnemonicHd ? _ledgerMnemonic : _ledgerSecretKey) || (_ledgerNetwork == "public" && !_confirmMainnetAccess) || (_ledgerNetwork == "custom" && !CustomNetworkReady))"
                            @onclick="ConnectSelectedLedgerCredentialAsync">@(_ledgerCredentialMode == VaultCredentialMode.MnemonicHd ? "Connect Stellar" : "Inspect linked accounts")</button>
                }
            }
            else if (SecretLedger.IsConnected)
            {
                @if (_nativePage == "local")
                {
                    <button type="button" class="sv-native-command primary"
                            @onclick='() => NavigateNative("sync")'>Review Sync</button>
                }
                else if (_nativePage == "sync")
                {
                    <button type="button" class="sv-native-command primary"
                            @onclick='() => NavigateNative("local")'>Encrypted drafts</button>
                }
                <button type="button" class="sv-native-command"
                        disabled="@_ledgerBusy" @onclick="DisconnectSelectedLedgerAsync">Lock</button>
            }
            else if (_nativePage == "settings")
            {
                <span class="sv-native-command-hint">Privacy &amp; security</span>
                @if (Sessions.IsUnlocked)
                {
                    <button type="button" class="sv-native-command" @onclick="LockVault">Lock</button>
                }
            }
            else if (Sessions.IsUnlocked)
            {
                @if (_nativePage == "local")
                {
                    <button type="button" class="sv-native-command primary"
                            @onclick="OpenSyncReview">Review sync queue</button>
                }
                else
                {
                    <button type="button" class="sv-native-command primary"
                            @onclick='() => NavigateNative("local")'>Open local vault</button>
                }
                <button type="button" class="sv-native-command" @onclick="LockVault">Lock</button>
            }
            else
            {
                <span class="sv-native-command-hint">Your saved items</span>
                <button type="button" class="sv-native-command primary"
                        disabled="@(_busy || !_localConsent || _accountId.Length != 56 || string.IsNullOrWhiteSpace(_passphrase) || (_ledgerNetwork == "custom" && !CustomNetworkReady))"
                        @onclick="UnlockVault">Unlock vault</button>
            }
        </div>
        <footer class="sv-native-footer">Vault content stays private until you approve a transaction.</footer>
    </div>
}

@code {
    private VaultWorkspaceMode ActiveMode =>
        VaultWorkspaceModeResolver.Resolve(
            Sessions.IsUnlocked, Ledger.IsConnected, SecretLedger.IsConnected);
    private string? _conflictingLockError;

    private async Task LockConflictingNativeSessionsAsync()
    {
        if (_ledgerBusy) return;
        _ledgerBusy = true;
        bool failed = false;
        try { await LinkedQueueKeys.LockAsync(); } catch { failed = true; }
        try { Workflow.Lock(); } catch { failed = true; }
        try { if (SecretLedger.IsConnected) await SecretLedger.DisconnectAsync(); }
        catch { failed = true; }
        try { if (Ledger.IsConnected) await Ledger.DisconnectAsync(); }
        catch { failed = true; }
        _ledgerMnemonic = string.Empty;
        _ledgerSecretKey = string.Empty;
        _passphrase = string.Empty;
        _localConsent = false;
        Retention.Reset();
        if (failed)
        {
            // A failed native/WebView signer teardown cannot be bypassed by
            // switching account strategies or navigating to another tab.
            _foregroundRevoked = true;
            _conflictingLockError = "Signer cleanup could not be confirmed. Restart the app before unlocking again.";
        }
        else
        {
            _conflictingLockError = null;
            ClearLedgerView();
            _nativePage = "stellar";
        }
        _ledgerBusy = false;
    }

    [Parameter] public string HostPlatform { get; set; } = "Android";
    private string _nativePage = "stellar";
    private string _localMode = "records";
    private string _syncMode = "changes";
    // Recreate only the content scroller when the selected screen changes;
    // don't carry a deep scroll offset into a different native destination.
    private VaultSecretKeyWorkspace? _linkedWorkspace;
    // Preserve one signer-bound linked component and its pending quotes across
    // all native tabs, but keep HD content isolated in other sessions.
    private string NativeContentKey => SecretLedger.IsConnected
        ? "linked-authenticated-session"
        : _nativePage switch
        {
            "local" => "local:" + _localMode,
            "sync" => "sync:" + _syncMode,
            "settings" => "settings",
            _ => "stellar:" + _nativeMode + ":" + (_selectedRecord?.Id ?? _selectedFolderId)
        };

    private void NewNativeRecordForActiveStrategy()
