            "sync" => "sync",
            "settings" => "settings",
            _ => "stellar"
        });

    private void NavigateNative(string page)
    {
        if (_nativeDirectFilePlan is not null && !_nativeDirectFileUncertain)
        {
            _uploadMessage = "Stop the current file upload before leaving this screen. Published chunks will remain on Stellar.";
            return;
        }
        if (page is not ("stellar" or "local" or "sync" or "settings")) return;
        _nativePage = page;
        NativeNavigation.SetSecondaryDestination(page != "stellar");
    }

    private void OnAndroidBackRequested()
    {
        _ = InvokeAsync(() =>
        {
            NavigateNative("stellar");
            StateHasChanged();
        });
