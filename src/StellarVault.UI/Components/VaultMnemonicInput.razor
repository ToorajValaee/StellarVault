@using Microsoft.AspNetCore.Components
<div class="sv-mnemonic-controls">
    <label class="terminal-label">WORDS
        <select class="terminal-input" value="@_wordCount" @onchange="ChangeCount" disabled="@Disabled">
            @foreach (var count in new[] { 12, 15, 18, 21, 24 })
            {
                <option value="@count">@count</option>
            }
        </select>
    </label>
    <button class="pixel-button compact" type="button" disabled="@Disabled" @onclick="() => _revealed = !_revealed">@(_revealed ? "HIDE WORDS" : "SHOW WORDS")</button>
</div>
<div class="sv-mnemonic-grid">
    @for (var i = 0; i < _wordCount; i++)
    {
        var index = i;
        <label class="terminal-label">
            <span>WORD @(index + 1)</span>
            <input class="terminal-input" type="@(_revealed ? "text" : "password")" value="@_words[index]"
                   @oninput="e => UpdateWordAsync(index, e.Value?.ToString() ?? string.Empty)"
                   autocomplete="off" autocapitalize="none" spellcheck="false"
                   disabled="@Disabled" placeholder="••••••" />
        </label>
    }
</div>
<p class="advanced-help">Words are masked by default. You may paste a complete 12–24 word phrase into the first slot.</p>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private readonly string[] _words = new string[24];
    private int _wordCount = 12;
    private bool _revealed;
    private string _previousValue = string.Empty;

    protected override void OnParametersSet()
    {
        if (string.Equals(Value, _previousValue, StringComparison.Ordinal)) return;
        Array.Clear(_words);
        var incoming = (Value ?? string.Empty).Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (new[] { 12, 15, 18, 21, 24 }.Contains(incoming.Length)) _wordCount = incoming.Length;
        for (var i = 0; i < Math.Min(incoming.Length, _words.Length); i++) _words[i] = incoming[i];
        _previousValue = Value ?? string.Empty;
        if (incoming.Length == 0) _revealed = false;
    }
    private async Task ChangeCount(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var count) || count is not (12 or 15 or 18 or 21 or 24)) return;
        _wordCount = count;
        await NotifyAsync();
    }
    private async Task UpdateWordAsync(int index, string value)
    {
        var words = value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length > 1)
        {
            if (index == 0 && words.Length is (12 or 15 or 18 or 21 or 24)) _wordCount = words.Length;
            for (var i = 0; i < words.Length && index + i < _words.Length; i++) _words[index + i] = words[i];
        }
        else _words[index] = value.Trim();
        await NotifyAsync();
    }
    private async Task NotifyAsync()
    {
        _previousValue = string.Join(" ", _words.Take(_wordCount));
        await ValueChanged.InvokeAsync(_previousValue);
    }
}
