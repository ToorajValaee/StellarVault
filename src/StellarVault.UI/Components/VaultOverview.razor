@using StellarVault.Core.Services

<section class="hero-terminal terminal-panel sv-access-welcome" aria-label="StellarVault welcome">
    <span class="sv-access-welcome-mark" aria-hidden="true">✦</span>
    <h1>Your vault<span class="blink-cursor">_</span></h1>
    <p class="hero-copy">Your records, files, and private data in one place.</p>
    <details class="sv-access-learn">
        <summary>How StellarVault works</summary>
        <p>Keep encrypted items on this device, or save supported records and files on Stellar.
           You approve every on-chain transaction before it can cost XLM.</p>
        <p>Local items are not backed up or synced automatically. Keep your recovery
           phrase and vault passphrase safe.</p>
    </details>
    <details class="sv-access-learn"><summary>Session details</summary>
        <ManagedVaultSessionStatus />
    </details>
</section>
