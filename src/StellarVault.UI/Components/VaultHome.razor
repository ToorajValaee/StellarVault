@using StellarVault.Core.Services
@using Microsoft.JSInterop
@inject VaultSessionManager Sessions
@inject VaultSessionWorkflow Workflow
@inject IJSRuntime JS
@implements IDisposable

<AdaptiveShell PlatformName="@Platform" Subtitle="ENCRYPTED ACCOUNT DATABASE">
    <div class="access-grid">
        <section class="hero-terminal terminal-panel" aria-label="StellarVault overview">
            <div class="panel-kicker">SECURE DATA LINK // ACCOUNT VAULT</div>
            <h1>OPEN STELLAR<br />CHAIN DATABASE<span class="blink-cursor">_</span></h1>
            <p class="hero-copy">
                An encrypted database for your Stellar account. Keep private records and files
                in an account-scoped vault using the new shared .NET 10 architecture.
            </p>
            <div class="boot-log" aria-label="Vault capabilities">
                <span><b>[OK]</b> AES-256-GCM ENCRYPTED RECORDS</span>
                <span><b>[OK]</b> ACCOUNT-SCOPED PRIVATE STORAGE</span>
                <span><b>[OK]</b> SHARED PWA + NATIVE INTERFACE</span>
                <span><b>[LOCAL]</b> SWALLET INTEGRATION PLANNED</span>
            </div>
            <ManagedVaultSessionStatus />
        </section>

        <section class="access-form terminal-panel" aria-label="Vault access">
            <div class="panel-heading">
                <div>
                    <div class="panel-kicker">SECURE ACCESS</div>
                    <h2>OPEN YOUR VAULT</h2>
                </div>
                <span class="step-led">01</span>
            </div>
            @if (Platform == "WEB PWA")
            {
                <div class="panel-heading">
                    <div>
                        <div class="panel-kicker">STEP 01</div>
                        <h2>SELECT NETWORK</h2>
                    </div>
                </div>
                <div class="network-selector" role="group" aria-label="Stellar network">
                    <button type="button" class="network-option @(_network == "testnet" ? "active" : "")"
                            aria-pressed="@(_network == "testnet")" disabled="@(_busy || Sessions.IsUnlocked)"
                            @onclick='() => SelectNetwork("testnet")'>
                        <span class="network-symbol">T</span><span><strong>TESTNET</strong><small>STELLAR TEST NETWORK</small></span>
                    </button>
                    <button type="button" class="network-option @(_network == "public" ? "active" : "")"
                            aria-pressed="@(_network == "public")" disabled="@(_busy || Sessions.IsUnlocked)"
                            @onclick='() => SelectNetwork("public")'>
                        <span class="network-symbol">P</span><span><strong>PUBLIC</strong><small>STELLAR MAIN NETWORK</small></span>
                    </button>
                </div>
                <p class="advanced-help">Network selection determines which funded root and account chain to discover. Local encrypted storage is not yet separated by network.</p>
                <div class="panel-heading"><div><div class="panel-kicker">STEP 02</div><h2>ACCESS VAULT</h2></div></div>
                <label class="terminal-label" for="sv-mnemonic">RECOVERY PHRASE</label>
                <textarea id="sv-mnemonic" class="terminal-input" rows="4"
                          autocomplete="off" spellcheck="false" @bind="_mnemonic" @bind:event="oninput"
                          disabled="@(_busy || Sessions.IsUnlocked)"
                          placeholder="Enter your BIP-39 recovery words"></textarea>
                <label class="terminal-label" for="sv-passphrase">VAULT ENCRYPTION PASSPHRASE</label>
                <input id="sv-passphrase" class="terminal-input" type="password"
                       autocomplete="off" @bind="_passphrase" @bind:event="oninput" disabled="@(_busy || Sessions.IsUnlocked)" />
                <p class="advanced-help">Your recovery phrase selects its vault automatically. Your separate encryption passphrase protects the vault data stored in this browser.</p>
                <div class="sv-access-actions">
                    @if (Sessions.IsUnlocked)
                    {
                        <button class="pixel-button primary" type="button" @onclick="LockAsync">LOCK VAULT</button>
                    }
                    else
                    {
                        <button class="pixel-button primary" type="button"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_mnemonic) || string.IsNullOrWhiteSpace(_passphrase))"
                                @onclick="AccessVaultAsync">ACCESS VAULT</button>
                    }
                </div>
                <div class="terminal-alert warning" role="status">
                    <strong>LOCAL ENCRYPTED VAULT PREVIEW</strong>
                    <span>The account is derived privately from your mnemonic. Existing encrypted credentials are detected automatically; otherwise a new local vault is initialized. Read-only child discovery runs for funded roots; cross-device sync and encrypted backup are not yet available. Use only test credentials.</span>
                </div>
            }
            else
            {
                <div class="terminal-alert warning" role="status">
                    <strong>NATIVE ACCESS COMING LATER</strong>
                    <span>The shared native UI awaits secure mnemonic handling and SWallet integration.</span>
                </div>
            }
            @if (_childAccounts is not null)
            {
                <section class="terminal-panel" aria-label="Discovered Stellar child accounts">
                    <h3>DISCOVERED ACCOUNT CHAIN</h3>
                    <p class="advanced-help">Authenticated registry-aware SEP-5 scan with 16-index recovery lookahead (maximum 256 indices).</p>
                    @if (_childAccounts.Length == 0)
                    {
                        <p>No funded child accounts were found in this scan.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var child in _childAccounts)
                            {
                                <li>@child</li>
                            }
                        </ul>
                    }
                </section>
            }
            @if (!string.IsNullOrWhiteSpace(_networkStatus))
            {
                <p class="advanced-help" role="status">@_networkStatus</p>
            }
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="terminal-alert warning" role="status">
                    <strong>VAULT STATUS</strong><span>@_message</span>
                </div>
            }
        </section>
    </div>
    @if (Sessions.IsUnlocked)
    {
        <section class="sv-vault-data" aria-label="Encrypted vault records">
            <VaultRecordWorkspaceView />
            @if (string.Equals(Platform, "WEB PWA", StringComparison.OrdinalIgnoreCase))
            {
                <VaultBinaryFilesView />
            }
        </section>
    }
</AdaptiveShell>

@code {
    [Parameter] public string Platform { get; set; } = "WEB";
    private sealed record RootDiscovery(string Account, bool Found, bool NetworkAvailable);
    private string _mnemonic = string.Empty;
    private string _passphrase = string.Empty;
    private string? _message;
    private bool _busy;
    private string _network = "testnet";
    private string? _networkStatus;
    private string[]? _childAccounts;
    private void SelectNetwork(string value)
    {
        if (_busy || Sessions.IsUnlocked || (value != "testnet" && value != "public")) return;
        _network = value;
        _networkStatus = null;
        _childAccounts = null;
        _message = null;
    }

    private async Task AccessVaultAsync()
    {
        if (_busy || Platform != "WEB PWA" || Sessions.IsUnlocked) return;
        _busy = true;
        _message = null;
        _networkStatus = null;
        _childAccounts = null;
        try
        {
            // The mnemonic identifies the namespace; never persist it or derive
            // a second, different account identity for an existing local vault.
            var root = await JS.InvokeAsync<RootDiscovery>("stellarVaultV2Mnemonic.resolveRoot", _mnemonic, _network);
            var account = root.Account;
            if (!StellarAccountAddress.IsValid(account))
                throw new InvalidDataException("Derived root account was not a valid Stellar G-address.");
            bool exists = await Workflow.HasLocalVaultAsync(account);
            if (exists)
                await Workflow.UnlockAsync(account, _passphrase);
            else
                await Workflow.CreateAsync(account, _passphrase);
            _message = exists ? "Vault opened." : "Your local encrypted vault is ready.";
            _networkStatus = !root.NetworkAvailable
                ? "Horizon is unavailable or returned an unexpected network identity. Local encrypted records remain accessible; account discovery was not performed."
                : root.Found
                    ? "Root account found on the selected Stellar network."
                    : "No funded root account was found on the selected network. Local encrypted records remain accessible.";
            if (root.Found)
            {
                try
                {
                    _childAccounts = await JS.InvokeAsync<string[]>(
                        "stellarVaultV2Chain.discover", _mnemonic, _network, 16);
                }
                catch (JSException)
                {
                    _childAccounts = null;
                    _networkStatus = "Child discovery failed; existing local encrypted records remain accessible. The account chain has not been fully verified.";
                }
            }
        }
        catch (JSException)
        {
            _message = "Recovery phrase validation failed or browser derivation is unavailable.";
        }
        catch (System.Security.Cryptography.CryptographicException)
        {
            _message = "Vault could not be unlocked. Check your encryption passphrase.";
        }
        catch (ArgumentException ex)
        {
            _message = ex.ParamName switch
            {
                "accountId" or "address" => "The derived Stellar address failed validation.",
                "passphrase" => "Enter a nonempty vault encryption passphrase.",
                _ => "Vault input was rejected. Check the recovery phrase and passphrase."
            };
        }
        catch (UnauthorizedAccessException)
        {
            _message = "Vault access is not authorized in this environment.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or InvalidDataException or OperationCanceledException)
        {
            _message = "Could not open the vault. Check your browser storage and try again.";
        }
        finally
        {
            _mnemonic = string.Empty;
            _passphrase = string.Empty;
            _busy = false;
        }
    }

    private void LockAsync()
    {
        Workflow.Lock();
        _mnemonic = string.Empty;
        _passphrase = string.Empty;
        _childAccounts = null;
        _networkStatus = null;
        _message = "Vault locked.";
    }

    protected override void OnInitialized() => Sessions.StateChanged += OnSessionChanged;
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Sessions.StateChanged -= OnSessionChanged;
}
