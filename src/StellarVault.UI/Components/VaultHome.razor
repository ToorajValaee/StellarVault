@using Microsoft.Extensions.Logging
@using VaultEngine.Stellar.Services
@using Microsoft.JSInterop
@inject VaultSessionManager Sessions
@inject VaultSessionWorkflow Workflow
@inject VaultNetworkSelection NetworkSelection
@inject IStellarLedgerRecords LedgerRecords
@inject IStellarSecretKeyVaultDiscovery SecretChain
@inject IStellarSecretKeyLedger SecretLedger
@inject VaultStorageModeGate StorageMode
@inject VaultDeviceRetentionGate Retention
@inject VaultLinkedLocalRetentionGate LinkedRetention
@inject VaultLinkedQueueKeySession LinkedQueueKeys
@inject VaultDeviceUnlockPreference DeviceUnlockPreference
@inject VaultLedgerRecordWorkspace LedgerWorkspace
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<VaultHome> Logger
@implements IDisposable

<AdaptiveShell PlatformName="@Platform" Subtitle="YOUR VAULT">
    <HeaderActions>
            <details class="sv-network-menu">
                <summary title="Network: @(_network == "public" ? "Mainnet" : _network == "testnet" ? "Testnet" : "Custom")"
                         aria-label="Select Stellar network" class="sv-network-icon-trigger">
                    <svg class="sv-network-symbol" viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m4.5 15.5 15-7M3.3 11.1l15-7M5.8 19l14.9-7"/></svg>
                    <span class="sv-network-indicator @(_network == "public" ? "mainnet" : _network == "custom" ? "custom" : "")" aria-hidden="true"></span>
                </summary>
                <div class="sv-network-popover terminal-panel">
                    <strong class="sv-network-popup-title">Network</strong>
                    <div class="sv-network-choice">
                        <button type="button" class="pixel-button compact" disabled="@(_busy || Sessions.IsUnlocked || LedgerRecords.IsConnected)" @onclick='() => SelectNetwork("testnet")'>Testnet @(_network == "testnet" ? "✓" : "")</button>
                        <button type="button" class="pixel-button compact" disabled="@(_busy || Sessions.IsUnlocked || LedgerRecords.IsConnected)" @onclick='() => SelectNetwork("public")'>Mainnet @(_network == "public" ? "✓" : "")</button>
                        <button type="button" class="pixel-button compact" disabled="@(_busy || Sessions.IsUnlocked || LedgerRecords.IsConnected)" @onclick='() => SelectNetwork("custom")'>Custom @(_network == "custom" ? "✓" : "")</button>
                    </div>
                    @if (_network == "custom")
                    {
                        <label class="terminal-label" for="sv-horizon">Horizon URL</label>
                        <input id="sv-horizon" class="terminal-input" type="url" autocomplete="url" @bind="_customHorizon" @bind:event="oninput" disabled="@(_busy || Sessions.IsUnlocked || LedgerRecords.IsConnected)" placeholder="https://horizon.example.com/" />
                        <button class="pixel-button compact" type="button" @onclick="DetectCustomAsync" disabled="@(_busy || Sessions.IsUnlocked || LedgerRecords.IsConnected || string.IsNullOrWhiteSpace(_customHorizon))">Detect network</button>
                        @if (!string.IsNullOrEmpty(_customPassphrase))
                        {
                            <p class="advanced-help" role="status">Detected network: @_customPassphrase</p>
                        }
                    }
                    @if (Sessions.IsUnlocked || LedgerRecords.IsConnected) { <p class="advanced-help">Lock and disconnect before switching networks.</p> }
                </div>
            </details>
    </HeaderActions>
    <ChildContent>
    @if (Platform != "WEB PWA")
    {
        <div class="access-grid">
            <VaultOverview />
            <section class="access-form terminal-panel" aria-label="Native vault access and ledger workspace">
                <NativeVaultWorkspace />
            </section>
        </div>
    }
    else
    {
    <div class="access-grid sv-pwa-access-grid sv-modern-entry">
        <aside class="sv-entry-showcase" aria-label="Welcome to StellarVault">
            <div class="sv-entry-brand"><span class="sv-entry-shield" aria-hidden="true">✦</span><strong>StellarVault</strong></div>
            <div class="sv-entry-showcase-content">
                <span class="sv-entry-eyebrow">YOUR PRIVATE DIGITAL VAULT</span>
                <h1>Everything important.<br />Safely in your hands.</h1>
                <p>Protect your records, organize your digital life, and connect to Stellar when you choose.</p>
                <div class="sv-entry-feature"><span aria-hidden="true">◇</span><span>Encrypted from the moment you unlock</span></div>
                <div class="sv-entry-feature"><span aria-hidden="true">▣</span><span>Your records and folders, in one place</span></div>
                <div class="sv-entry-feature"><span aria-hidden="true">◎</span><span>Stellar-backed storage when you approve</span></div>
                <details class="sv-entry-storage-guide">
                    <summary>About local storage and Sync</summary>
                    <p>Optional device storage uses a separate vault passphrase for either HD or Secret Key access. Local drafts remain encrypted on this device until you explicitly review and approve publication to Stellar. Signing credentials are never saved as plaintext.</p>
                </details>
            </div>
            <div class="sv-entry-showcase-foot">PRIVATE BY DESIGN <span aria-hidden="true">·</span> YOU STAY IN CONTROL</div>
        </aside>
        <div class="sv-entry-main">
            <div class="sv-entry-intro">
                <span class="sv-entry-kicker">SECURE ACCESS</span>
                <h1>Unlock your vault</h1>
                <p>@(_credentialMode == VaultCredentialMode.MnemonicHd ? "Enter your recovery phrase to securely access your StellarVault workspace." : "Inspect an independent vault rooted in your existing Stellar secret key.")</p>
            </div>
        @if (Platform == "WEB PWA")
        {
            <section class="sv-access-storage-settings sv-entry-storage-outside" aria-label="Optional encrypted device storage">
                <h2 class="sv-storage-heading">Device storage <span class="sv-storage-optional">(optional)</span></h2>
                <fieldset class="sv-access-storage-choices" disabled="@_busy">
                    <legend class="sr-only">Device storage preference</legend>
                    <label class="sv-biometric-choice">
                        <input type="radio" name="device-retention" checked="@(!CurrentDeviceStoragePreference)"
                               @onchange="() => SelectDeviceStorageAsync(false)" />
                        <span>Stellar only</span>
                    </label>
                    <label class="sv-biometric-choice">
                        <input type="radio" name="device-retention" checked="@CurrentDeviceStoragePreference"
                               @onchange="() => SelectDeviceStorageAsync(true)" />
                        <span>Encrypted on this device</span>
                    </label>
                </fieldset>
                @if (CurrentDeviceStoragePreference)
                {
                    <div class="sv-storage-credential-group">
                        <label class="sv-biometric-choice sv-storage-device-unlock">
                            <input type="checkbox" @bind="_requestBiometricEnrollment" disabled="@_busy" />
                            <span>Enable device unlock <small>(optional)</small></span>
                        </label>
                        <div class="sv-storage-passphrase-field">
                            <label class="terminal-label" for="sv-passphrase">Vault passphrase</label>
                            <input id="sv-passphrase" form="sv-access-form" class="terminal-input"
                                   type="password" autocomplete="new-password"
                                   @bind="_passphrase" @bind:event="oninput"
                                   disabled="@(_busy || Sessions.IsUnlocked)" />
                            <p class="sv-storage-passphrase-hint">Protects encrypted records on this device. Device unlock can optionally use this passphrase after enrollment.</p>
                        </div>
                    </div>
                }
                <div class="sv-storage-help-actions">
                    <button type="button" class="sv-storage-help-trigger"
                            aria-expanded="@_storageHelpOpen" aria-controls="sv-storage-help"
                            @onclick="() => _storageHelpOpen = !_storageHelpOpen">
                        <span aria-hidden="true">ⓘ</span> About encrypted storage
                    </button>
                    <button type="button" class="sv-storage-help-trigger"
                            aria-expanded="@_deviceHelpOpen" aria-controls="sv-device-help"
                            @onclick="() => _deviceHelpOpen = !_deviceHelpOpen">
                        <span aria-hidden="true">ⓘ</span> About device unlock
                    </button>
                </div>
                @if (_storageHelpOpen)
                {
                    <p id="sv-storage-help" class="sv-storage-help-text">
                        Encrypted local drafts use a separate passphrase and explicit consent.
                        Stellar-only access does not erase previously saved encrypted data.
                        Both HD and Secret Key vaults require separate transaction approval for publication.
                    </p>
                }
                @if (_deviceHelpOpen)
                {
                    <p id="sv-device-help" class="sv-storage-help-text">
                        Device unlock can protect a local vault passphrase on supported devices.
                        It does not store or replace the mnemonic or Stellar secret key.
                    </p>
                }
            </section>
        }
        <form id="sv-access-form" class="access-form terminal-panel" aria-label="Vault access" @onsubmit="AccessVaultAsync" @onsubmit:preventDefault="true">

            @if (Platform == "WEB PWA")
            {
                <div class="sv-credential-mode-picker" role="group" aria-label="Vault credential type">
                    <button type="button" class="@(_credentialMode == VaultCredentialMode.MnemonicHd ? "selected" : "")"
                            aria-pressed="@(_credentialMode == VaultCredentialMode.MnemonicHd)"
                            disabled="@_busy" @onclick='() => SelectCredentialMode(VaultCredentialMode.MnemonicHd)'>Recovery phrase / HD</button>
                    <button type="button" class="@(_credentialMode == VaultCredentialMode.StellarSecretKeyChain ? "selected" : "")"
                            aria-pressed="@(_credentialMode == VaultCredentialMode.StellarSecretKeyChain)"
                            disabled="@_busy" @onclick='() => SelectCredentialMode(VaultCredentialMode.StellarSecretKeyChain)'>Stellar secret key</button>
                </div>
                @if (_credentialMode == VaultCredentialMode.MnemonicHd)
                {
                    <div class="sv-entry-field-heading"><span class="terminal-label">Recovery phrase</span><span class="sv-entry-field-hint">12–24 words</span></div>
                    <VaultMnemonicInput @bind-Value="_mnemonic" Disabled="@(_busy || Sessions.IsUnlocked)" />
                }
                else
                {
                    <label class="terminal-label" for="sv-secret-key">Stellar secret key (S-key)</label>
                    <input id="sv-secret-key" class="terminal-input" type="password" autocomplete="off"
                           autocapitalize="characters" spellcheck="false" maxlength="56"
                           @bind="_secretKey" @bind:event="oninput" disabled="@_busy" />
                    <p class="advanced-help">Independent linked-account vault. Signing and publication require separate approval; mutations remain Testnet-only until security review.</p>
                }
                @if (_credentialMode == VaultCredentialMode.MnemonicHd && _recentAccount is not null && !Sessions.IsUnlocked && _network == _recentNetwork)
                {
                    <details class="sv-access-learn"><summary>Saved device vault</summary>
                        <p>Encrypted items for @_recentAccount are stored in this browser. Enter your recovery phrase and vault passphrase to reopen them.</p>
                        <button class="pixel-button compact" type="button" disabled="@_busy" @onclick="ForgetRecentAsync">Forget saved account</button>
                    </details>
                }


                @if (_network == "public" && !Sessions.IsUnlocked)
                {
                    <div class="terminal-alert warning" role="alert">
                        <strong>MAINNET // REAL ASSETS AND NETWORK FEES</strong>
                        <span>You selected Stellar PUBLIC. Any approved on-chain operation may spend the network's native asset. Local encrypted records remain browser-only unless you explicitly publish them.</span>
                        <label class="sv-biometric-choice"><input type="checkbox" @bind="_confirmMainnetAccess" disabled="@_busy" />
                            I UNDERSTAND THIS IS STELLAR MAINNET
                        </label>
                    </div>
                }
                 @if (_pendingBiometricAccount is not null && Sessions.IsUnlocked)
                {
                    <div class="terminal-alert" role="status">
                        <strong>ENABLE DEVICE UNLOCK?</strong>
                        <span>A supported passkey is needed. Otherwise, you can continue using your vault passphrase.</span>
                    </div>
                    <div class="sv-access-actions">
                        <button class="pixel-button primary" type="button" disabled="@_busy" @onclick="EnrollBiometricAsync">ENABLE DEVICE UNLOCK</button>
                        <button class="pixel-button compact" type="button" disabled="@_busy" @onclick="SkipBiometricEnrollment">NOT NOW</button>
                    </div>
                }
                @if (_busy)
                {
                    <div class="terminal-alert" role="status" aria-live="polite" aria-busy="true">
                        <span class="sv-loading-spinner" aria-hidden="true"></span>
                        <strong>Opening vault…</strong>
                        <span>Keep this screen open.</span>
                    </div>
                }

            }
            else
            {
                <div class="terminal-alert warning" role="status">
                    <strong>NATIVE ACCESS COMING LATER</strong>
                    <span>The shared native UI awaits secure mnemonic handling and SWallet integration.</span>
                </div>
            }
            @if (_childAccounts is not null)
            {
                <section class="terminal-panel" aria-label="Discovered Stellar child accounts">
                    <h3>DISCOVERED ACCOUNT CHAIN</h3>
                    <p class="advanced-help">Authenticated registry-aware SEP-5 scan with 16-index recovery lookahead (maximum 256 indices).</p>
                    @if (_childAccounts.Length == 0)
                    {
                        <p>No funded child accounts were found in this scan.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var child in _childAccounts)
                            {
                                <li>@child</li>
                            }
                        </ul>
                    }
                </section>
            }
            @if (Sessions.IsUnlocked && !LedgerRecords.IsConnected && !string.IsNullOrWhiteSpace(_ledgerMessage))
            {
                <div class="terminal-alert warning" role="alert"><strong>STELLAR CONNECTION FAILED</strong><span>@_ledgerMessage</span></div>
            }
            @if (!string.IsNullOrWhiteSpace(_networkStatus))
            {
                <p class="advanced-help" role="status">@_networkStatus</p>
            }
            @if (_credentialMode == VaultCredentialMode.StellarSecretKeyChain && _secretChainInspection is not null)
            {
                <section class="terminal-panel sv-secret-chain-summary" aria-label="Read-only linked account inspection">
                    <h3>Linked account inspection</h3>
                    <p>Root: <code>@_secretChainInspection.RootAccountId</code></p>
                    <p>Verified account count: @_secretChainInspection.Accounts.Count</p>
                    <p>Tail: <code>@_secretChainInspection.TailAccountId</code></p>
                    <p class="advanced-help">Each account passed root-signer and chain-pointer checks. No secrets were stored and no Stellar transaction was sent. This is not yet a record unlock.</p>
                </section>
            }
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="terminal-alert warning" role="status">
                    <strong>VAULT STATUS</strong><span>@_message</span>
                </div>
            }
        </form>
        @if (Platform == "WEB PWA")
        {
            <div class="sv-access-actions sv-entry-actions-outside">
                @if (Sessions.IsUnlocked)
                {
                    <button class="pixel-button primary" type="button" disabled="@_busy" @onclick="LockAsync">LOCK VAULT</button>
                }
                else
                {
                    <button class="pixel-button primary" type="submit" form="sv-access-form" disabled="@_busy">@(_busy ? "Checking…" : _credentialMode == VaultCredentialMode.MnemonicHd ? "Unlock vault" : "Unlock Secret Key vault")</button>
                }
            </div>
        }
        <p class="sv-entry-privacy"><span aria-hidden="true">♧</span> Your recovery credential stays in this session. Never share it with anyone.</p>
        </div>
    </div>
    @if (Sessions.IsUnlocked && Platform != "WEB PWA")
    {
        <section class="sv-vault-data" aria-label="Encrypted vault records">
            <header class="page-command-header">
                <div>
                    <div class="panel-kicker">SECURE DATABASE // WORKSPACE</div>
                    <h2>VAULT WORKSPACE</h2>
                    <p class="page-subtitle">Choose the record or file operation. Stellar ledger writes are separate from local encrypted drafts.</p>
                </div>
            </header>
            <nav class="network-selector" aria-label="Vault workspace mode">
                <button class="network-option @(_workspaceMode == "ledger" ? "active" : "")" type="button"
                        aria-pressed="@(_workspaceMode == "ledger")" @onclick='() => SelectWorkspace("ledger")'>
                    <span class="network-symbol">S</span><span><strong>STELLAR RECORD</strong><small>ON-CHAIN</small></span>
                </button>
                <button class="network-option @(_workspaceMode == "record" ? "active" : "")" type="button"
                        aria-pressed="@(_workspaceMode == "record")" @onclick='() => SelectWorkspace("record")'>
                    <span class="network-symbol">R</span><span><strong>ADD RECORD</strong><small>LOCAL ENCRYPTED</small></span>
                </button>
                <button class="network-option @(_workspaceMode == "hybrid" ? "active" : "")" type="button"
                        aria-pressed="@(_workspaceMode == "hybrid")" @onclick='() => SelectWorkspace("hybrid")'>
                    <span class="network-symbol">H</span><span><strong>HYBRID SYNC</strong><small>OFFLINE QUEUE</small></span>
                </button>
                @if (Platform == "WEB PWA")
                {
                    <button class="network-option @(_workspaceMode == "file" ? "active" : "")" type="button"
                            aria-pressed="@(_workspaceMode == "file")" @onclick='() => SelectWorkspace("file")'>
                        <span class="network-symbol">F</span><span><strong>ADD FILE</strong><small>LOCAL ENCRYPTED</small></span>
                    </button>
                }
            </nav>
            @if (_workspaceMode == "ledger")
            {
            <section class="terminal-panel" aria-label="Stellar ledger records">
                <div class="panel-kicker">ON-CHAIN HD-V2 DATABASE</div>
                <h2>STELLAR LEDGER</h2>
                <p class="advanced-help">These records use Stellar ManageData entries and are separate from browser-only encrypted records. Transactions incur native-asset fees and require a funded root account and initialized HD registry.</p>
                @if (LedgerRecords.IsConnected)
                {
                    <p class="advanced-help" role="status">Signed ledger session connected.</p>
                    @if (!_ledgerRegistryReady)
                    {
                        <button class="pixel-button compact" type="button" disabled="@_busy" @onclick="InitializeLedgerAsync">INITIALIZE ACCOUNT REGISTRY</button>
                    }
                    else
                    {
                        <label class="terminal-label" for="sv-ledger-title">RECORD TITLE</label>
                        <input id="sv-ledger-title" class="terminal-input" @bind="_ledgerTitle" @bind:event="oninput" disabled="@_busy" />
                        <label class="terminal-label" for="sv-ledger-content">RECORD CONTENT</label>
                        <textarea id="sv-ledger-content" class="terminal-input" rows="3" @bind="_ledgerContent" @bind:event="oninput" disabled="@_busy"></textarea>
                        <button class="pixel-button primary" type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_ledgerTitle) || string.IsNullOrWhiteSpace(_ledgerContent))" @onclick="PublishLedgerAsync">PUBLISH TO STELLAR</button>
                        <button class="pixel-button compact" type="button" disabled="@_busy" @onclick="RefreshLedgerAsync">READ FROM STELLAR</button>
                        @if (_ledgerItems is not null)
                        {
                            <ul>
                                @foreach (var item in _ledgerItems)
                                {
                                    <li><strong>@item.Title</strong> — @item.Content</li>
                                }
                            </ul>
                        }
                    }
                }
                else
                {
                    <p class="advanced-help">Ledger connection is unavailable. Local records are not automatically published.</p>
                }
                @if (!string.IsNullOrEmpty(_ledgerMessage))
                {
                    <p role="status" class="advanced-help">@_ledgerMessage</p>
                }
            </section>

            }
            else if (_workspaceMode == "record")
            {
                <VaultRecordWorkspaceView />
            }
            else if (_workspaceMode == "file" && Platform == "WEB PWA")
            {
                <VaultBinaryFilesView />
            }
            else if (_workspaceMode == "hybrid" && Platform == "WEB PWA")
            {
                <VaultHybridDraftEditor />
                <p class="advanced-help" role="status">
                    Hybrid mode supports encrypted offline records and folders only.
                    File uploads, file deletion and file synchronization are disabled in Hybrid mode.
                    Use direct on-chain mode for files.
                </p>
                <VaultHybridRemoteChanges />
                <VaultHybridSyncReview />
            }
        </section>
    }
    }
    </ChildContent>
</AdaptiveShell>

@code {
    [Parameter] public string Platform { get; set; } = "WEB";
    private string? _recentAccount;
    private string? _recentNetwork;
    private string? _recentHorizonUrl;
    private bool _recentHasDeviceUnlock;

    private sealed class RecentVault
    {
        public string? Account { get; set; }
        public string? Network { get; set; }
        public string? HorizonUrl { get; set; }
        public string? NetworkPassphrase { get; set; }
    }

    private sealed class NetworkPreference
    {
        public string? Network { get; set; }
        public string? HorizonUrl { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Platform != "WEB PWA") return;
        try
        {
            // A network preference is public UI metadata. Never restore a custom
            // passphrase from local storage as trusted chain identity.
            var preference = await JS.InvokeAsync<NetworkPreference?>("stellarVaultNetworkPreference.load");
            var recent = await JS.InvokeAsync<RecentVault?>("stellarVaultRecentVault.load");
            if (recent?.Account is not null && StellarAccountAddress.IsValid(recent.Account) &&
                recent.Network is "testnet" or "public" or "custom")
            {
                _recentAccount = recent.Account;
                _recentNetwork = recent.Network;
                _recentHorizonUrl = recent.HorizonUrl;
            }

            if (!Sessions.IsUnlocked && !LedgerRecords.IsConnected && !_busy)
            {
                var selected = preference?.Network is "testnet" or "public" or "custom"
                    ? preference.Network
                    : recent?.Network is "testnet" or "public" or "custom" ? recent.Network : null;
                if (selected is "testnet" or "public")
                {
                    NetworkSelection.ChoosePreset(selected);
                    _network = selected;
                }
                else if (selected == "custom")
                {
                    var url = preference?.Network == "custom"
                        ? preference.HorizonUrl : recent?.HorizonUrl;
                    if (!string.IsNullOrWhiteSpace(url))
                    {
                        NetworkSelection.ResetCustom();
                        NetworkSelection.ChoosePreset("custom");
                        NetworkSelection.CustomHorizonUrl = url;
                        _network = "custom";
                        _customHorizon = url;
                        _customPassphrase = null;
                        _detectedHorizon = null;
                        _networkStatus = "Verifying remembered custom Horizon…";
                        await InvokeAsync(StateHasChanged);
                        // Re-read the public network identity from Horizon. The
                        // preference never stores a trusted network passphrase.
                        // Do not require the user to repeat the Detect action.
                        await DetectCustomAsync();
                    }
                }

                if (_recentAccount is not null && _recentNetwork == _network &&
                    (_network != "custom" || !string.IsNullOrWhiteSpace(_customPassphrase)))
                {
                    _recentHasDeviceUnlock = await JS.InvokeAsync<bool>(
                        "stellarVaultBiometric.has", NetworkSelection.CredentialKey(_recentAccount));
                }
            }
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            _networkStatus = "Network preference could not be restored. Select the network again.";
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReopenWithDeviceAsync()
    {
        if (_busy || !_recentHasDeviceUnlock || _recentAccount is null) return;
        _busy = true;
        try
        {
            _passphrase = await JS.InvokeAsync<string>("stellarVaultBiometric.unlock", NetworkSelection.CredentialKey(_recentAccount));
        }
        catch
        {
            _message = "Device unlock failed or was canceled. Use your vault passphrase.";
            _passphrase = string.Empty;
        }
        finally { _busy = false; }
        if (!string.IsNullOrWhiteSpace(_passphrase)) await ReopenLocalAsync();
    }

    private async Task ReopenLocalAsync()
    {
        if (_busy || Sessions.IsUnlocked || _recentAccount is null ||
            _recentNetwork != _network || string.IsNullOrWhiteSpace(_passphrase) ||
            (_network == "custom" &&
             (string.IsNullOrWhiteSpace(_customPassphrase) ||
              _detectedHorizon != _recentHorizonUrl ||
              NetworkSelection.CustomPassphrase != _customPassphrase))) return;
        _busy = true;
        try
        {
            NetworkSelection.Select(_network);
            if (!await Workflow.HasLocalVaultAsync(_recentAccount))
                throw new InvalidOperationException("Local vault was not found.");
            await Workflow.UnlockAsync(_recentAccount, _passphrase);
            if (Platform == "WEB PWA")
                await JS.InvokeVoidAsync("stellarVaultRecentVault.markHybridSession",
                    _recentAccount, _network);
            StorageMode.Select(VaultStorageMode.LocalEncrypted);
            _workspaceMode = "record";
            // Local reopening succeeds without Stellar signing; route out of the
            // access form regardless of connectivity.
            Navigation.NavigateTo("/vault");
        }
        catch
        {
            Workflow.Lock();
            StorageMode.Reset();
            _message = "Unable to reopen local vault. Verify your passphrase and browser storage.";
        }
        finally
        {
            _passphrase = string.Empty;
            _busy = false;
        }
    }

    private async Task ForgetRecentAsync()
    {
        await JS.InvokeVoidAsync("stellarVaultRecentVault.clear");
        _recentAccount = null;
        _recentNetwork = null;
        _recentHorizonUrl = null;
        _recentHasDeviceUnlock = false;
    }

    private string _workspaceMode = "ledger";

    private void SelectWorkspace(string workspace)
    {
        if (_busy) return;
        if (workspace is not ("ledger" or "record" or "file" or "hybrid"))
            throw new ArgumentOutOfRangeException(nameof(workspace));
        if (workspace == "ledger")
        {
            // The connection panel remains accessible before ledger authorization.
            // Never label the selected persistence mode as on-chain without a transport.
            if (LedgerRecords.IsConnected)
                StorageMode.Select(VaultStorageMode.StellarLedger);
            else
                StorageMode.Reset();
        }
        else
        {
            StorageMode.Select(VaultStorageMode.LocalEncrypted);
        }
        _workspaceMode = workspace;
    }
    private bool _enableLocalStorage;
    private bool _requestBiometricEnrollment
    {
        get => DeviceUnlockPreference.Requested;
        set => DeviceUnlockPreference.Requested = CurrentDeviceStoragePreference && value;
    }
    private bool _confirmMainnetAccess;
    private string? _pendingBiometricAccount;
    private string? _pendingBiometricPassphrase;
    private string? _postAccessUrl;
    private async Task EnrollBiometricAsync()
    {
        if (_busy || _pendingBiometricAccount is null || _pendingBiometricPassphrase is null) return;
        _busy = true;
        _accessStage = "registering device unlock";
        try
        {
            await JS.InvokeVoidAsync("stellarVaultBiometric.enroll", NetworkSelection.CredentialKey(_pendingBiometricAccount), _pendingBiometricPassphrase);
            _message = "Device unlock enabled. Your vault passphrase remains available as a fallback.";
            FinishBiometricEnrollment();
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or OperationCanceledException)
        {
            _message = "Device unlock could not be enabled. Your vault passphrase still works. " + ex.Message;
        }
        finally { _busy = false; }
    }
    private void SkipBiometricEnrollment() => FinishBiometricEnrollment();
    private void FinishBiometricEnrollment()
    {
        _pendingBiometricAccount = null;
        _pendingBiometricPassphrase = null;
        _requestBiometricEnrollment = false;
        var destination = _postAccessUrl;
        _postAccessUrl = null;
        if (destination is not null) Navigation.NavigateTo(destination);
    }
    private bool CurrentDeviceStoragePreference =>
        _credentialMode == VaultCredentialMode.MnemonicHd
            ? _enableLocalStorage : LinkedRetention.AllowsLocalPersistence;

    private async Task SelectDeviceStorageAsync(bool enabled)
    {
        if (_busy || Sessions.IsUnlocked || LedgerRecords.IsConnected || SecretLedger.IsConnected)
            return;
        if (_credentialMode == VaultCredentialMode.MnemonicHd)
        {
            _enableLocalStorage = enabled;
            if (!enabled)
            {
                _passphrase = string.Empty;
                DeviceUnlockPreference.Reset();
            }
            return;
        }
        if (enabled)
        {
            LinkedRetention.GrantExplicitConsent();
        }
        else
        {
            await LinkedQueueKeys.LockAsync();
            LinkedRetention.Reset();
            _passphrase = string.Empty;
            DeviceUnlockPreference.Reset();
        }
    }

    private VaultCredentialMode _credentialMode = VaultCredentialMode.MnemonicHd;
    private string _secretKey = string.Empty;
    private VaultSecretChainInspection? _secretChainInspection;
    private void SelectCredentialMode(VaultCredentialMode mode)
    {
        if (_busy || _credentialMode == mode) return;
        _credentialMode = mode;
        _secretKey = string.Empty;
        _secretChainInspection = null;
        // Never carry the HD local passphrase into an independent S-key
        // account session (or vice versa) when changing credential strategies.
        _passphrase = string.Empty;
        ClearMnemonic();
        _message = null;
    }
    private string _mnemonic = string.Empty;
    private readonly string[] _mnemonicWords = new string[24];
    private int _mnemonicWordCount = 12;
    private void UpdateMnemonicWord(int index, string value)
    {
        var words = value.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (words.Length > 1)
        {
            if (index == 0 && new[] { 12, 15, 18, 21, 24 }.Contains(words.Length))
                _mnemonicWordCount = words.Length;
            for (var i = 0; i < words.Length && index + i < _mnemonicWords.Length; i++)
                _mnemonicWords[index + i] = words[i];
        }
        else
            _mnemonicWords[index] = value.Trim();
    }
    private string AssembleMnemonic() =>
        string.Join(' ', _mnemonicWords.Take(_mnemonicWordCount).Select(x => x?.Trim() ?? ""));
    private void ClearMnemonic()
    {
        Array.Clear(_mnemonicWords);
        _mnemonic = string.Empty;
    }
    private bool _ledgerRegistryReady;
    private string _ledgerTitle = string.Empty;
    private string _ledgerContent = string.Empty;
    private string? _ledgerMessage;
    private IReadOnlyList<LedgerRecordItem>? _ledgerItems;

    private async Task InitializeLedgerAsync()
    {
        _busy = true;
        try
        {
            await LedgerRecords.InitializeRegistryAsync();
            _ledgerRegistryReady = true;
            _ledgerMessage = "Ledger registry initialized. You can now publish encrypted records.";
        }
        catch (Exception ex) { _ledgerMessage = "Ledger initialization failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task PublishLedgerAsync()
    {
        _busy = true;
        try
        {
            string hash = await LedgerWorkspace.PublishAsync(new LedgerRecordDraft(_ledgerTitle, _ledgerContent));
            _ledgerContent = string.Empty;
            _ledgerMessage = "Stellar transaction confirmed: " + hash;
            try
            {
                _ledgerItems = await LedgerWorkspace.ListAsync();
            }
            catch (Exception ex)
            {
                _ledgerItems = null;
                _ledgerMessage = "Stellar transaction confirmed: " + hash +
                    ". The subsequent refresh failed: " + ex.Message +
                    ". Do not publish again before checking the ledger.";
            }
        }
        catch (Exception ex) { _ledgerMessage = "Ledger publishing failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task RefreshLedgerAsync()
    {
        _busy = true;
        try
        {
            _ledgerItems = await LedgerWorkspace.ListAsync();
            _ledgerMessage = "Ledger records loaded from Horizon.";
        }
        catch (Exception ex) { _ledgerMessage = "Ledger read failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private bool _storageHelpOpen;
    private bool _deviceHelpOpen;
    private string _passphrase = string.Empty;
    private string? _message;
    private bool _busy;
    private string _accessStage = "starting";
    private string _network = "testnet";
    private string _customHorizon = string.Empty;
    private string? _customPassphrase;
    private string? _detectedHorizon;
    private string? _networkStatus;
    private string[]? _childAccounts;
    private async Task SelectNetwork(string value)
    {
        if (_busy || Sessions.IsUnlocked || LedgerRecords.IsConnected || (value != "testnet" && value != "public" && value != "custom")) return;
        // Re-entering a custom endpoint always requires fresh detection.
        // A previous custom passphrase must never authorize a new selection.
        NetworkSelection.ResetCustom();
        NetworkSelection.ChoosePreset(value);
        _network = value;
        _customPassphrase = null;
        _detectedHorizon = null;
        _confirmMainnetAccess = false;
        _networkStatus = null;
        _childAccounts = null;
        _message = null;
        if (value != "custom")
        {
            try { await JS.InvokeVoidAsync("stellarVaultNetworkPreference.save", value, (string?)null); }
            catch (JSException) { _networkStatus = "Network selected for this session; browser preference could not be saved."; }
        }
    }

    private async Task DetectCustomAsync()
    {
        if (_busy || Sessions.IsUnlocked || LedgerRecords.IsConnected || _network != "custom") return;
        var requestedHorizon = _customHorizon.Trim();
        var startingEpoch = Sessions.Epoch;
        _busy = true;
        _message = null;
        _customPassphrase = null;
        _detectedHorizon = null;
        _networkStatus = "Verifying custom Horizon…";
        NetworkSelection.ResetCustom();
        try
        {
            var detected = await JS.InvokeAsync<string>("stellarVaultV2Network.probeCustom", requestedHorizon);
            if (Sessions.Epoch != startingEpoch || Sessions.IsUnlocked || LedgerRecords.IsConnected ||
                _network != "custom" ||
                !string.Equals(_customHorizon.Trim(), requestedHorizon, StringComparison.Ordinal))
                return; // Do not trust a response to an endpoint edited during discovery.
            if (string.IsNullOrWhiteSpace(detected))
                throw new JSException("Custom network returned no passphrase.");
            _customPassphrase = detected;
            NetworkSelection.ConfigureCustom(detected);
            NetworkSelection.CustomHorizonUrl = requestedHorizon;
            _detectedHorizon = requestedHorizon;
            _networkStatus = "Custom network verified and selected.";
            try { await JS.InvokeVoidAsync("stellarVaultNetworkPreference.save", "custom", requestedHorizon); }
            catch (JSException) { _networkStatus = "Network detected, but browser preference could not be saved."; }
        }
        catch (Exception ex) when (ex is JSException or ArgumentException or InvalidOperationException)
        {
            NetworkSelection.ResetCustom();
            _customPassphrase = null;
            _detectedHorizon = null;
            _networkStatus = "Could not verify the custom network. Check the Horizon URL and select Detect network to retry.";
            _message = null;
        }
        finally
        {
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private int EnteredWordCount => _mnemonic.Split((char[]?)null,
        StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Length;

    private async Task AccessVaultAsync()
    {
        if (_busy || Platform != "WEB PWA" || Sessions.IsUnlocked || LedgerRecords.IsConnected || SecretLedger.IsConnected) return;
        if (_credentialMode == VaultCredentialMode.StellarSecretKeyChain)
        {
            if (CurrentDeviceStoragePreference && _passphrase.Length < 12)
            {
                _message = "Enter a vault passphrase of at least 12 characters for encrypted device storage.";
                return;
            }
            await InspectSecretKeyChainAsync();
            return;
        }
        if (EnteredWordCount is not (12 or 15 or 18 or 21 or 24))
        {
            _message = "Enter a complete BIP-39 recovery phrase of 12, 15, 18, 21 or 24 words.";
            return;
        }
        if (_enableLocalStorage && string.IsNullOrWhiteSpace(_passphrase))
        {
            _message = "Enter a vault passphrase before enabling encrypted device storage.";
            return;
        }
        if (_network == "public" && !_confirmMainnetAccess)
        {
            _message = "Confirm the Stellar mainnet warning before accessing a public-network vault.";
            return;
        }
        if (_network == "custom" && (string.IsNullOrWhiteSpace(_customPassphrase) ||
            NetworkSelection.CustomPassphrase != _customPassphrase ||
            !string.Equals(_detectedHorizon, _customHorizon.Trim(), StringComparison.Ordinal)))
        {
            _message = "Detect the custom network before accessing the vault.";
            return;
        }
        NetworkSelection.Select(_network);
        _mnemonic = _mnemonic.Trim();
        _busy = true;
        _accessStage = "starting";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
        _message = null;
        _networkStatus = null;
        _childAccounts = null;
        try
        {
            // The mnemonic identifies the namespace; never persist it or derive
            // a second, different account identity for an existing local vault.
            await ReportAccessStageAsync("deriving account");
            var account = await JS.InvokeAsync<string>("stellarVaultV2Mnemonic.rootPublicKey", _mnemonic);
            if (!StellarAccountAddress.IsValid(account))
                throw new InvalidDataException("Derived root account was not a valid Stellar G-address.");
            // A mnemonic can derive a valid Stellar address even when the account
            // does not yet exist on this network. Detect this before opening the
            // ledger so an unfunded root is not reported as a broken vault.
            if (!_enableLocalStorage)
            {
                await ReportAccessStageAsync("checking Stellar root account");
                bool rootExists = await JS.InvokeAsync<bool>(
                    "stellarVaultV2Network.inspectAccount", account, _network,
                    _customHorizon, _customPassphrase);
                if (!rootExists)
                {
                    _message = "The root account " + account +
                        " does not exist on the selected Stellar network. Fund or create this account on that network, then try ACCESS VAULT again. No vault data has been deleted or written.";
                    return;
                }
            }
            // Re-entering on-chain-only explicitly replaces any prior tab's
            // hybrid-resume intent. Saved encrypted data is not erased.
            if (!_enableLocalStorage)
                await JS.InvokeVoidAsync("stellarVaultRecentVault.clearHybridSession");
            Retention.Select(_enableLocalStorage
                ? VaultDeviceRetentionPolicy.EncryptedLocalWithManualSync
                : VaultDeviceRetentionPolicy.OnChainOnly);
            bool exists = false;
            if (_enableLocalStorage)
            {
                Retention.RequireLocalPersistence();
                await ReportAccessStageAsync("checking local credentials");
                exists = await Workflow.HasLocalVaultAsync(account);
                await ReportAccessStageAsync(exists ? "unlocking encrypted credentials" : "creating encrypted credentials");
                if (exists) await Workflow.UnlockAsync(account, _passphrase);
                else await Workflow.CreateAsync(account, _passphrase);
                try
                {
                    await JS.InvokeVoidAsync("stellarVaultRecentVault.save", account, _network,
                        _network == "custom" ? _detectedHorizon : null,
                        _network == "custom" ? _customPassphrase : null);
                }
                catch (JSException) { /* Recent-account hint is optional. */ }
                // Device-storage consent includes encrypted recovery material.
                // Failure is explicit; never claim future offline signing access.
                await ReportAccessStageAsync("encrypting on-device recovery credentials");
                await JS.InvokeVoidAsync("stellarVaultRecentVault.saveEncryptedSeed",
                    account, _network, _mnemonic, _passphrase);
                // Mark a resumable HYBRID tab only after its credential unlock
                // and encrypted recovery seed have both succeeded.
                await JS.InvokeVoidAsync("stellarVaultRecentVault.markHybridSession",
                    account, _network);
            }
            await ReportAccessStageAsync("connecting to Stellar ledger");
            _message = !_enableLocalStorage ? "Opening on-chain-only vault." : exists ? "Vault opened." : "Your local encrypted vault is ready.";
            try
            {
                await LedgerRecords.DisconnectAsync();
                var horizonUrl = _network switch
                {
                    "testnet" => "https://horizon-testnet.stellar.org",
                    "public" => "https://horizon.stellar.org",
                    _ => _customHorizon
                };
                var networkPassphrase = _network switch
                {
                    "testnet" => "Test SDF Network ; September 2015",
                    "public" => "Public Global Stellar Network ; September 2015",
                    _ => _customPassphrase ?? throw new InvalidOperationException("Custom network not detected.")
                };
                await LedgerRecords.ConnectAsync(_mnemonic, horizonUrl, networkPassphrase);
                if (!_enableLocalStorage || _workspaceMode == "ledger")
                    StorageMode.Select(VaultStorageMode.StellarLedger);
                _ledgerRegistryReady = await LedgerRecords.HasRegistryAsync();
                if (_ledgerRegistryReady) _ledgerItems = await LedgerWorkspace.ListAsync();
                _ledgerMessage = "On-chain vault connected.";
            }
            catch (Exception ex)
            {
                StorageMode.Reset();
                _ledgerMessage = "On-chain connection failed: " + ex.Message;
                if (!_enableLocalStorage)
                {
                    await LedgerRecords.DisconnectAsync();
                    throw new InvalidOperationException("On-chain-only access requires a working Stellar connection: " + ex.Message, ex);
                }
            }
            try
            {
                bool found = await JS.InvokeAsync<bool>("stellarVaultV2Network.inspectAccount", account, _network, _customHorizon, _customPassphrase);
                _networkStatus = found ? "Root account found on the selected network." : "Root account not found on selected network. Local vault remains accessible.";
            }
            catch (JSException)
            {
                _childAccounts = null;
                _networkStatus = "Network discovery unavailable; local vault remains accessible.";
            }
            if ((Sessions.IsUnlocked || (!_enableLocalStorage && LedgerRecords.IsConnected)) && Platform == "WEB PWA")
            {
                // Local storage is usable even if Horizon is offline or the
                // Stellar registry is unavailable. Ledger work has its own route.
                const string destination = "/vault";
                if (_enableLocalStorage && _requestBiometricEnrollment)
                {
                    _pendingBiometricAccount = account;
                    _pendingBiometricPassphrase = _passphrase;
                    _postAccessUrl = destination;
                    _message = "Vault opened. Choose whether to register device unlock.";
                }
                else Navigation.NavigateTo(destination);
            }
        }
        catch (JSException ex)
        {
            Logger.LogError("Vault access JavaScript failure at stage {Stage}: {ExceptionType}", _accessStage, ex.GetType().Name);
            _message = $"Vault access failed during {_accessStage} (browser interop). Check the recovery phrase and browser console.";
        }
        catch (System.Security.Cryptography.CryptographicException ex)
        {
            Logger.LogError("Vault cryptographic error at stage {Stage}: {ExceptionType}", _accessStage, ex.GetType().Name);
            _message = "Vault could not be unlocked. Check your encryption passphrase.";
        }
        catch (ArgumentException ex)
        {
            Logger.LogError("Vault argument error at stage {Stage}: {ExceptionType}, parameter {Parameter}", _accessStage, ex.GetType().Name, ex.ParamName);
            _message = ex.ParamName switch
            {
                "accountId" or "address" => "The derived Stellar address failed validation.",
                "passphrase" => "Enter a nonempty vault encryption passphrase.",
                _ => "Vault input was rejected. Check the recovery phrase and passphrase."
            };
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogError("Vault authorization error at stage {Stage}: {ExceptionType}", _accessStage, ex.GetType().Name);
            _message = "Vault access is not authorized in this environment.";
        }
        catch (OperationCanceledException)
        {
            _message = "Vault unlock was interrupted because the session was locked (for example when the browser tab became hidden). Keep this tab visible and retry.";
        }
        catch (Exception ex)
        {
            Logger.LogError("Vault unexpected error at stage {Stage}: {ExceptionType}; HResult {Code}", _accessStage, ex.GetType().FullName, ex.HResult);
            _message = _accessStage == "connecting to Stellar ledger"
                ? "Unable to connect to the Stellar account on the selected network. Verify that the derived root account exists and is funded, that the network is correct, and that Horizon is reachable. Details: " + ex.Message
                : $"Vault access failed during {_accessStage} ({ex.GetType().Name}). Check browser console for details.";
        }
        finally
        {
            ClearMnemonic();
            _passphrase = string.Empty;
            _busy = false;
        }
    }

    private async Task InspectSecretKeyChainAsync()
    {
        _secretChainInspection = null;
        _message = null;
        _busy = true;
        var recoveryStage = "checking credential and network";
        try
        {
            new VaultAccessCredential(VaultCredentialMode.StellarSecretKeyChain, _secretKey).Validate();
            if (_network == "public" && !_confirmMainnetAccess)
                throw new InvalidOperationException("Confirm the Mainnet risk notice first.");
            if (_network == "custom" &&
                (string.IsNullOrWhiteSpace(_customPassphrase) ||
                 NetworkSelection.CustomPassphrase != _customPassphrase ||
                 _detectedHorizon != _customHorizon.Trim()))
                throw new InvalidOperationException("Detect the custom network first.");

            var horizon = _network switch
            {
                "public" => "https://horizon.stellar.org",
                "testnet" => "https://horizon-testnet.stellar.org",
                _ => _customHorizon
            };
            var passphrase = _network switch
            {
                "public" => "Public Global Stellar Network ; September 2015",
                "testnet" => "Test SDF Network ; September 2015",
                _ => _customPassphrase ?? throw new InvalidOperationException("Custom network is not configured.")
            };
            // Verify signer authority and chain recovery before opening the
            // independent encrypted record backend. No on-chain writes here.
            recoveryStage = "inspecting account signers and linked chain";
            _secretChainInspection = await SecretChain.InspectAsync(_secretKey, horizon, passphrase);
            // A new independent S-key session must never inherit the tab's
            // mnemonic-hybrid resume flow.
            if (Platform == "WEB PWA")
                await JS.InvokeVoidAsync("stellarVaultRecentVault.clearHybridSession");
            recoveryStage = "opening encrypted Secret Key ledger";
            await SecretLedger.ConnectAsync(_secretKey, horizon, passphrase);
            recoveryStage = "decrypting and validating ledger records";
            var recovered = await SecretLedger.ReadAsync();
            NetworkSelection.Select(_network);
            // The shared access passphrase unlocks only this strategy's
            // separate, explicitly consented encrypted device vault. The
            // S-key signer and network connection never depend on a local
            // passphrase in Stellar-only mode.
            if (CurrentDeviceStoragePreference)
            {
                if (_passphrase.Length < 12)
                    throw new InvalidOperationException("Encrypted device vault passphrase is too short.");
                recoveryStage = "unlocking independent encrypted device drafts";
                LinkedRetention.RequireLocalPersistence();
                var localExists = await LinkedQueueKeys.HasLocalCredentialsAsync();
                if (localExists)
                    await LinkedQueueKeys.UnlockAsync(_passphrase);
                else
                    await LinkedQueueKeys.CreateAsync(_passphrase);
                if (_requestBiometricEnrollment &&
                    SecretLedger.RootAccountId is string linkedRoot)
                {
                    try
                    {
                        await JS.InvokeVoidAsync("stellarVaultBiometric.enroll",
                            "linked-s-key:" + NetworkSelection.CredentialKey(linkedRoot), _passphrase);
                    }
                    catch (Exception ex) when (ex is JSException or
                        InvalidOperationException or OperationCanceledException)
                    {
                        // Device unlock is optional and must not abort an
                        // otherwise authenticated encrypted local session.
                    }
                    DeviceUnlockPreference.Reset();
                }
            }
            // Match the HD first-run route without pretending that an
            // independent S-key account has a mnemonic-derived registry.
            // Existing nonempty S-key vaults go straight to their workspace.
            Navigation.NavigateTo(recovered.Count == 0
                ? "/initialize" : "/vault");
        }
        catch (Exception ex)
        {
            // Never log a credential, exception object or untrusted Horizon
            // response; only the stage and sanitized exception type.
            Logger.LogWarning("Secret Key unlock failed at {RecoveryStage}: {ErrorType}",
                recoveryStage, ex.GetType().Name);
            try { await LinkedQueueKeys.LockAsync(); }
            catch { /* Do not mask the original failure. */ }
            try { if (SecretLedger.IsConnected) await SecretLedger.DisconnectAsync(); }
            catch { /* Do not mask the original failure. */ }
            _message = ExplainSecretKeyRecoveryFailure(recoveryStage, ex);
        }
        finally
        {
            _secretKey = string.Empty;
            _passphrase = string.Empty;
            _busy = false;
        }
    }

    private static string ExplainSecretKeyRecoveryFailure(string stage, Exception error)
    {
        // Error messages can originate from browser JS or an untrusted Horizon
        // response. Categorize known fixed strings; never echo their raw text.
        var detail = error.Message;
        string advice;
        if (detail.Contains("historical vault record format", StringComparison.OrdinalIgnoreCase) ||
            detail.Contains("different or historical vault record format", StringComparison.OrdinalIgnoreCase))
            advice = "Older encrypted record format detected; read-only migration verification is required.";
        else if (detail.Contains("HD-v2 vault root", StringComparison.OrdinalIgnoreCase) ||
                 detail.Contains("registered as an HD-v2 vault", StringComparison.OrdinalIgnoreCase))
            advice = "This is a mnemonic/HD vault account. Choose Recovery phrase / HD instead.";
        else if (detail.Contains("404", StringComparison.OrdinalIgnoreCase) ||
                 detail.Contains("Account not found", StringComparison.OrdinalIgnoreCase))
            advice = "The root or linked account was not found. Check the selected network and fund the root account if it is new.";
        else if (detail.Contains("network identity", StringComparison.OrdinalIgnoreCase) ||
                 detail.Contains("network does not match", StringComparison.OrdinalIgnoreCase) ||
                 detail.Contains("Horizon network", StringComparison.OrdinalIgnoreCase))
            advice = "The selected Horizon endpoint does not match the network. Verify Testnet/Mainnet selection.";
        else if (detail.Contains("signer", StringComparison.OrdinalIgnoreCase) ||
                 detail.Contains("threshold", StringComparison.OrdinalIgnoreCase) ||
                 detail.Contains("chain pointer", StringComparison.OrdinalIgnoreCase))
            advice = "Signer thresholds or linked account pointers require inspection. No signing permissions were changed.";
        else if (detail.Contains("record chunk", StringComparison.OrdinalIgnoreCase) ||
                 detail.Contains("ciphertext", StringComparison.OrdinalIgnoreCase) ||
                 detail.Contains("manifest", StringComparison.OrdinalIgnoreCase) ||
                 detail.Contains("decrypted record", StringComparison.OrdinalIgnoreCase))
            advice = "Encrypted ledger records could not be authenticated. No records were changed.";
        else
            advice = "Check browser console for a sanitized failure category, the selected network and account funding.";
        return "Secret Key vault opening stopped while " + stage + ". " + advice +
            " No transaction was sent.";
    }

    private async Task ReportAccessStageAsync(string stage)
    {
        _accessStage = stage;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(50);
    }

    private async Task LockAsync()
    {
        if (_busy) return;
        Workflow.Lock();
        if (Platform == "WEB PWA")
        {
            try { await JS.InvokeVoidAsync("stellarVaultRecentVault.clearHybridSession"); }
            catch (JSException) { /* In-memory vault session is already locked. */ }
        }
        Retention.Reset();
        LinkedRetention.Reset();
        StorageMode.Reset();
        _enableLocalStorage = false;
        _workspaceMode = "ledger";
        await LedgerRecords.DisconnectAsync();
        _ledgerItems = null;
        _ledgerRegistryReady = false;
        _ledgerMessage = null;
        ClearMnemonic();
        _pendingBiometricAccount = null;
        _pendingBiometricPassphrase = null;
        _postAccessUrl = null;
        _passphrase = string.Empty;
        _childAccounts = null;
        _networkStatus = null;
        _message = "Vault locked.";
    }

    protected override void OnInitialized()
    {
        Sessions.StateChanged += OnSessionChanged;
        _network = NetworkSelection.SelectedPreset;
        _customHorizon = NetworkSelection.CustomHorizonUrl;
        _customPassphrase = NetworkSelection.CustomPassphrase;
        if (_network == "custom" && !string.IsNullOrWhiteSpace(_customPassphrase))
            _detectedHorizon = _customHorizon;
    }
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Sessions.StateChanged -= OnSessionChanged;
}
