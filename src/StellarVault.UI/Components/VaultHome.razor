@using StellarVault.Core.Services
@using Microsoft.JSInterop
@inject VaultSessionManager Sessions
@inject VaultSessionWorkflow Workflow
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IDisposable

<AdaptiveShell PlatformName="@Platform" Subtitle="ENCRYPTED ACCOUNT DATABASE">
    <div class="access-grid">
        <section class="hero-terminal terminal-panel" aria-label="StellarVault overview">
            <div class="panel-kicker">SECURE DATA LINK // ACCOUNT VAULT</div>
            <h1>OPEN STELLAR<br />CHAIN DATABASE<span class="blink-cursor">_</span></h1>
            <p class="hero-copy">
                An encrypted database for your Stellar account. Keep private records and files
                in an account-scoped vault using the new shared .NET 10 architecture.
            </p>
            <div class="boot-log" aria-label="Vault capabilities">
                <span><b>[OK]</b> AES-256-GCM ENCRYPTED RECORDS</span>
                <span><b>[OK]</b> ACCOUNT-SCOPED PRIVATE STORAGE</span>
                <span><b>[OK]</b> SHARED PWA + NATIVE INTERFACE</span>
                <span><b>[WAIT]</b> WALLET OWNERSHIP SIGNING</span>
            </div>
            <ManagedVaultSessionStatus />
        </section>

        <section class="access-form terminal-panel" aria-label="Vault access">
            <div class="panel-heading">
                <div>
                    <div class="panel-kicker">STEP 01</div>
                    <h2>STELLAR ACCOUNT</h2>
                </div>
                <span class="step-led">01</span>
            </div>
            @if (Platform == "WEB PWA")
            {
                <p class="advanced-help">Testnet preview — connect your Freighter desktop wallet. A funded Testnet account and an authorized high-threshold signer are required.</p>
                <button class="pixel-button" type="button" disabled="@_busy" @onclick="ConnectWalletAsync">CONNECT FREIGHTER</button>
            }
            <label class="terminal-label" for="sv-account">PUBLIC ACCOUNT ADDRESS</label>
            <input id="sv-account" class="terminal-input" placeholder="G…" maxlength="56"
                   autocomplete="off" spellcheck="false" @bind="AccountInput" disabled="@_busy" />

            <div class="panel-heading unlock-heading">
                <div>
                    <div class="panel-kicker">STEP 02</div>
                    <h2>VAULT PASSPHRASE</h2>
                </div>
                <span class="step-led">02</span>
            </div>
            <label class="terminal-label" for="sv-passphrase">LOCAL ENCRYPTION PASSPHRASE</label>
            <input id="sv-passphrase" class="terminal-input" type="password"
                   autocomplete="off" @bind="_passphrase" disabled="@_busy" />
            <p class="advanced-help">Your passphrase unlocks the encrypted local vault key. The Stellar wallet must separately prove account ownership.</p>

            <button class="pixel-button compact" type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_account))"
                    @onclick="CheckLocalVaultAsync">CHECK LOCAL VAULT</button>
            @if (_hasLocalVault is not null)
            {
                <p class="advanced-help" role="status">
                    @(_hasLocalVault.Value
                        ? "An encrypted vault already exists for this account in this browser/device. Choose UNLOCK."
                        : "No local vault was found for this account. Choose CREATE to initialize one.")
                </p>
            }
            <div class="sv-access-actions">
                <button class="pixel-button primary" type="button" disabled="@(_busy || _hasLocalVault != true)" @onclick="UnlockAsync">UNLOCK VAULT</button>
                <button class="pixel-button" type="button" disabled="@(_busy || _hasLocalVault != false)" @onclick="CreateAsync">CREATE NEW VAULT</button>
            </div>
            <div class="terminal-alert warning" role="status">
                <strong>TESTNET DEVELOPMENT PREVIEW</strong>
                <span>Browser: Freighter SEP-53 wallet signing and live Stellar Testnet signer verification. Native: account authorization is not configured. Do not store valuable secrets until tested.</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="terminal-alert warning" role="status"><strong>VAULT STATUS</strong><span>@_message</span></div>
            }
        </section>
    </div>
    @if (Sessions.IsUnlocked)
    {
        <section class="sv-vault-data" aria-label="Encrypted vault records">
            <VaultRecordWorkspaceView />
            @if (string.Equals(Platform, "WEB PWA", StringComparison.OrdinalIgnoreCase))
            {
                <VaultBinaryFilesView />
            }
        </section>
    }
</AdaptiveShell>

@code {
    [Parameter] public string Platform { get; set; } = "WEB";
    private string _account = string.Empty;
    private string AccountInput
    {
        get => _account;
        set
        {
            if (string.Equals(_account, value, StringComparison.Ordinal)) return;
            _account = value;
            _hasLocalVault = null;
        }
    }
    private string _passphrase = string.Empty;
    private string? _message;
    private bool _busy;
    private bool? _hasLocalVault;

    private async Task ConnectWalletAsync()
    {
        if (_busy || Platform != "WEB PWA") return;
        _busy = true;
        _message = null;
        try
        {
            _account = await JS.InvokeAsync<string>("stellarVaultV2Wallet.connect");
            _hasLocalVault = await Workflow.HasLocalVaultAsync(_account);
            _message = _hasLocalVault.Value ? "Freighter connected. Local vault found: choose UNLOCK." : "Freighter connected. No local vault found: choose CREATE.";
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or InvalidOperationException)
        {
            _message = "Could not connect Freighter. Install or unlock the desktop extension and approve access.";
        }
        finally { _busy = false; }
    }

    private async Task CheckLocalVaultAsync()
    {
        if (_busy) return;
        _busy = true;
        _hasLocalVault = null;
        _message = null;
        try
        {
            _hasLocalVault = await Workflow.HasLocalVaultAsync(_account.Trim());
        }
        catch (ArgumentException)
        {
            _message = "Enter a valid Stellar public G-address before checking local storage.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or Microsoft.JSInterop.JSException)
        {
            _message = "Could not read local vault status. Check browser storage permissions.";
        }
        finally { _busy = false; }
    }

    private Task CreateAsync() => RunAsync((account, passphrase) =>
        Workflow.CreateAsync(account, passphrase));

    private Task UnlockAsync() => RunAsync((account, passphrase) =>
        Workflow.UnlockAsync(account, passphrase));

    private async Task RunAsync(Func<string, string, Task> operation)
    {
        if (_busy) return;
        _busy = true;
        _message = null;
        try
        {
            await operation(_account.Trim(), _passphrase);
            _hasLocalVault = true;
            _message = "Vault unlocked.";
        }
        catch (UnauthorizedAccessException)
        {
            _message = "Wallet ownership proof failed or was rejected. Confirm Freighter Testnet and the account signer policy.";
        }
        catch (ArgumentException)
        {
            _message = "Enter a valid Stellar public account and a nonempty vault passphrase.";
        }
        catch (FileNotFoundException)
        {
            _hasLocalVault = false;
            _message = "No vault credentials exist for this account on this device. Create a new local vault.";
        }
        catch (OperationCanceledException)
        {
            _message = "Vault operation canceled.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or
            System.Security.Cryptography.CryptographicException)
        {
            _message = "Vault operation failed. Check the account, passphrase, and storage.";
        }
        finally
        {
            _passphrase = string.Empty;
            _busy = false;
        }
    }


    protected override void OnInitialized() => Sessions.StateChanged += OnSessionChanged;
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Sessions.StateChanged -= OnSessionChanged;
}
