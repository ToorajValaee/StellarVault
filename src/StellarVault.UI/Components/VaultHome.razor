@using StellarVault.Core.Services
@using Microsoft.JSInterop
@inject VaultSessionManager Sessions
@inject VaultSessionWorkflow Workflow
@inject VaultNetworkSelection NetworkSelection
@inject IStellarLedgerRecords LedgerRecords
@inject IJSRuntime JS
@implements IDisposable

<AdaptiveShell PlatformName="@Platform" Subtitle="ENCRYPTED ACCOUNT DATABASE">
    <div class="access-grid">
        <section class="hero-terminal terminal-panel" aria-label="StellarVault overview">
            <div class="panel-kicker">SECURE DATA LINK // ACCOUNT VAULT</div>
            <h1>OPEN STELLAR<br />CHAIN DATABASE<span class="blink-cursor">_</span></h1>
            <p class="hero-copy">
                An encrypted database for your Stellar account. Keep private records and files
                in an account-scoped vault using the new shared .NET 10 architecture.
            </p>
            <div class="boot-log" aria-label="Vault capabilities">
                <span><b>[OK]</b> AES-256-GCM ENCRYPTED RECORDS</span>
                <span><b>[OK]</b> ACCOUNT-SCOPED PRIVATE STORAGE</span>
                <span><b>[OK]</b> SHARED PWA + NATIVE INTERFACE</span>
                <span><b>[LOCAL]</b> SWALLET INTEGRATION PLANNED</span>
            </div>
            <ManagedVaultSessionStatus />
        </section>

        <section class="access-form terminal-panel" aria-label="Vault access">
            <div class="panel-heading">
                <div>
                    <div class="panel-kicker">SECURE ACCESS</div>
                    <h2>OPEN YOUR VAULT</h2>
                </div>
                <span class="step-led">01</span>
            </div>
            @if (Platform == "WEB PWA")
            {
                <div class="panel-heading">
                    <div>
                        <div class="panel-kicker">STEP 01</div>
                        <h2>SELECT NETWORK</h2>
                    </div>
                </div>
                <div class="network-selector" role="group" aria-label="Stellar network">
                    <button type="button" class="network-option @(_network == "testnet" ? "active" : "")"
                            aria-pressed="@(_network == "testnet")" disabled="@(_busy || Sessions.IsUnlocked)"
                            @onclick='() => SelectNetwork("testnet")'>
                        <span class="network-symbol">T</span><span><strong>TESTNET</strong><small>STELLAR TEST NETWORK</small></span>
                    </button>
                    <button type="button" class="network-option @(_network == "public" ? "active" : "")"
                            aria-pressed="@(_network == "public")" disabled="@(_busy || Sessions.IsUnlocked)"
                            @onclick='() => SelectNetwork("public")'>
                        <span class="network-symbol">P</span><span><strong>PUBLIC</strong><small>STELLAR MAIN NETWORK</small></span>
                    </button>
                    <button type="button" class="network-option" disabled="@(_busy || Sessions.IsUnlocked)" @onclick='() => SelectNetwork("custom")'>
                        <span class="network-symbol">C</span><span><strong>CUSTOM</strong><small>PRIVATE NETWORK</small></span>
                    </button>
                </div>
                @if (_network == "custom")
                {
                    <label class="terminal-label" for="sv-horizon">PRIVATE HORIZON URL</label>
                    <input id="sv-horizon" class="terminal-input" type="url" autocomplete="url"
                           @bind="_customHorizon" @bind:event="oninput" disabled="@(_busy || Sessions.IsUnlocked)"
                           placeholder="https://horizon.example.com/" />
                    <button class="pixel-button compact" type="button" @onclick="DetectCustomAsync"
                            disabled="@(_busy || Sessions.IsUnlocked || string.IsNullOrWhiteSpace(_customHorizon))">DETECT NETWORK</button>
                    @if (!string.IsNullOrEmpty(_customPassphrase))
                    {
                        <p class="advanced-help" role="status">Detected network: @_customPassphrase</p>
                    }
                }
                <p class="advanced-help">Network selection determines which funded root and account chain to discover. Local encrypted vault credentials are separated by network.</p>
                <div class="panel-heading"><div><div class="panel-kicker">STEP 02</div><h2>ACCESS VAULT</h2></div></div>
                <label class="terminal-label" for="sv-mnemonic">RECOVERY PHRASE</label>
                <textarea id="sv-mnemonic" class="terminal-input" rows="4"
                          autocomplete="off" spellcheck="false" @bind="_mnemonic" @bind:event="oninput"
                          disabled="@(_busy || Sessions.IsUnlocked)"
                          placeholder="Enter your BIP-39 recovery words"></textarea>
                <label class="terminal-label" for="sv-passphrase">VAULT ENCRYPTION PASSPHRASE</label>
                <input id="sv-passphrase" class="terminal-input" type="password"
                       autocomplete="off" @bind="_passphrase" @bind:event="oninput" disabled="@(_busy || Sessions.IsUnlocked)" />
                <p class="advanced-help">Your recovery phrase selects its vault automatically. Your separate encryption passphrase protects the vault data stored in this browser.</p>
                <div class="sv-access-actions">
                    @if (Sessions.IsUnlocked)
                    {
                        <button class="pixel-button primary" type="button" disabled="@_busy" @onclick="LockAsync">LOCK VAULT</button>
                    }
                    else
                    {
                        <button class="pixel-button primary" type="button"
                                disabled="@(_busy || string.IsNullOrWhiteSpace(_mnemonic) || string.IsNullOrWhiteSpace(_passphrase) || (_network == "custom" && string.IsNullOrWhiteSpace(_customPassphrase)))"
                                @onclick="AccessVaultAsync">ACCESS VAULT</button>
                    }
                </div>
                <div class="terminal-alert warning" role="status">
                    <strong>LOCAL ENCRYPTED VAULT PREVIEW</strong>
                    <span>The account is derived privately from your mnemonic. Existing encrypted credentials are detected automatically; otherwise a new local vault is initialized. Records and files are saved only in this browser, NOT on the Stellar ledger. Read-only child discovery runs for funded roots. On-chain publishing, cross-device recovery, and encrypted backup are not yet connected. Use only test credentials.</span>
                </div>
            }
            else
            {
                <div class="terminal-alert warning" role="status">
                    <strong>NATIVE ACCESS COMING LATER</strong>
                    <span>The shared native UI awaits secure mnemonic handling and SWallet integration.</span>
                </div>
            }
            @if (_childAccounts is not null)
            {
                <section class="terminal-panel" aria-label="Discovered Stellar child accounts">
                    <h3>DISCOVERED ACCOUNT CHAIN</h3>
                    <p class="advanced-help">Authenticated registry-aware SEP-5 scan with 16-index recovery lookahead (maximum 256 indices).</p>
                    @if (_childAccounts.Length == 0)
                    {
                        <p>No funded child accounts were found in this scan.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var child in _childAccounts)
                            {
                                <li>@child</li>
                            }
                        </ul>
                    }
                </section>
            }
            @if (!string.IsNullOrWhiteSpace(_networkStatus))
            {
                <p class="advanced-help" role="status">@_networkStatus</p>
            }
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="terminal-alert warning" role="status">
                    <strong>VAULT STATUS</strong><span>@_message</span>
                </div>
            }
        </section>
    </div>
    @if (Sessions.IsUnlocked)
    {
        <section class="sv-vault-data" aria-label="Encrypted vault records">
            <section class="terminal-panel" aria-label="Stellar ledger records">
                <div class="panel-kicker">ON-CHAIN HD-V2 DATABASE</div>
                <h2>STELLAR LEDGER</h2>
                <p class="advanced-help">These records are written to Stellar ManageData entries. This is separate from browser-only records. Transactions cost XLM and require a funded root and initialized HD registry.</p>
                @if (LedgerRecords.IsConnected)
                {
                    <p class="advanced-help" role="status">Signed ledger session connected.</p>
                    @if (!_ledgerRegistryReady)
                    {
                        <button class="pixel-button compact" type="button" disabled="@_busy" @onclick="InitializeLedgerAsync">INITIALIZE ACCOUNT REGISTRY</button>
                    }
                    else
                    {
                        <label class="terminal-label" for="sv-ledger-title">RECORD TITLE</label>
                        <input id="sv-ledger-title" class="terminal-input" @bind="_ledgerTitle" @bind:event="oninput" disabled="@_busy" />
                        <label class="terminal-label" for="sv-ledger-content">RECORD CONTENT</label>
                        <textarea id="sv-ledger-content" class="terminal-input" rows="3" @bind="_ledgerContent" @bind:event="oninput" disabled="@_busy"></textarea>
                        <button class="pixel-button primary" type="button" disabled="@(_busy || string.IsNullOrWhiteSpace(_ledgerTitle) || string.IsNullOrWhiteSpace(_ledgerContent))" @onclick="PublishLedgerAsync">PUBLISH TO STELLAR</button>
                        <button class="pixel-button compact" type="button" disabled="@_busy" @onclick="RefreshLedgerAsync">READ FROM STELLAR</button>
                        @if (_ledgerItems is not null)
                        {
                            <ul>
                                @foreach (var item in _ledgerItems)
                                {
                                    <li><strong>@item.Title</strong> — @item.Content</li>
                                }
                            </ul>
                        }
                    }
                }
                else
                {
                    <p class="advanced-help">Ledger connection is unavailable. Local records are not automatically published.</p>
                }
                @if (!string.IsNullOrEmpty(_ledgerMessage))
                {
                    <p role="status" class="advanced-help">@_ledgerMessage</p>
                }
            </section>

            <section class="terminal-panel"><h2>LOCAL-ONLY RECORDS</h2><p class="advanced-help">These records stay in this browser. Use PUBLISH TO STELLAR above for the actual on-chain database.</p></section>
            <VaultRecordWorkspaceView />
            @if (string.Equals(Platform, "WEB PWA", StringComparison.OrdinalIgnoreCase))
            {
                <VaultBinaryFilesView />
            }
        </section>
    }
</AdaptiveShell>

@code {
    [Parameter] public string Platform { get; set; } = "WEB";
    private string _mnemonic = string.Empty;
    private bool _ledgerRegistryReady;
    private string _ledgerTitle = string.Empty;
    private string _ledgerContent = string.Empty;
    private string? _ledgerMessage;
    private IReadOnlyList<LedgerRecordItem>? _ledgerItems;

    private async Task InitializeLedgerAsync()
    {
        _busy = true;
        try
        {
            await LedgerRecords.InitializeRegistryAsync();
            _ledgerRegistryReady = true;
            _ledgerMessage = "Ledger registry initialized. You can now publish encrypted records.";
        }
        catch (Exception ex) { _ledgerMessage = "Ledger initialization failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task PublishLedgerAsync()
    {
        _busy = true;
        try
        {
            string hash = await LedgerRecords.PublishAsync(_ledgerTitle, _ledgerContent);
            _ledgerContent = string.Empty;
            _ledgerMessage = "Stellar transaction confirmed: " + hash;
            try
            {
                _ledgerItems = await LedgerRecords.ReadAsync();
            }
            catch (Exception ex)
            {
                _ledgerItems = null;
                _ledgerMessage = "Stellar transaction confirmed: " + hash +
                    ". The subsequent refresh failed: " + ex.Message +
                    ". Do not publish again before checking the ledger.";
            }
        }
        catch (Exception ex) { _ledgerMessage = "Ledger publishing failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task RefreshLedgerAsync()
    {
        _busy = true;
        try
        {
            _ledgerItems = await LedgerRecords.ReadAsync();
            _ledgerMessage = "Ledger records loaded from Horizon.";
        }
        catch (Exception ex) { _ledgerMessage = "Ledger read failed: " + ex.Message; }
        finally { _busy = false; }
    }

    private string _passphrase = string.Empty;
    private string? _message;
    private bool _busy;
    private string _network = "testnet";
    private string _customHorizon = string.Empty;
    private string? _customPassphrase;
    private string? _detectedHorizon;
    private string? _networkStatus;
    private string[]? _childAccounts;
    private void SelectNetwork(string value)
    {
        if (_busy || Sessions.IsUnlocked || (value != "testnet" && value != "public" && value != "custom")) return;
        if (value != "custom") NetworkSelection.Select(value);
        _network = value;
        _networkStatus = null;
        _childAccounts = null;
        _message = null;
    }

    private async Task DetectCustomAsync()
    {
        if (_busy || Sessions.IsUnlocked || _network != "custom") return;
        _busy = true;
        _message = null;
        _customPassphrase = null;
        _detectedHorizon = null;
        NetworkSelection.ResetCustom();
        try
        {
            _customPassphrase = await JS.InvokeAsync<string>("stellarVaultV2Network.probeCustom", _customHorizon);
            NetworkSelection.ConfigureCustom(_customPassphrase);
            _detectedHorizon = _customHorizon.Trim();
            _networkStatus = "Private network detected.";
        }
        catch (JSException)
        {
            _message = "Private network detection failed. Check Horizon URL, HTTPS and browser CORS permissions.";
        }
        finally { _busy = false; }
    }

    private async Task AccessVaultAsync()
    {
        if (_busy || Platform != "WEB PWA" || Sessions.IsUnlocked) return;
        if (_network == "custom" && (string.IsNullOrWhiteSpace(_customPassphrase) ||
            NetworkSelection.CustomPassphrase != _customPassphrase ||
            !string.Equals(_detectedHorizon, _customHorizon.Trim(), StringComparison.Ordinal)))
        {
            _message = "Detect the custom network before accessing the vault.";
            return;
        }
        NetworkSelection.Select(_network);
        _busy = true;
        _message = null;
        _networkStatus = null;
        _childAccounts = null;
        try
        {
            // The mnemonic identifies the namespace; never persist it or derive
            // a second, different account identity for an existing local vault.
            var account = await JS.InvokeAsync<string>("stellarVaultV2Mnemonic.rootPublicKey", _mnemonic);
            if (!StellarAccountAddress.IsValid(account))
                throw new InvalidDataException("Derived root account was not a valid Stellar G-address.");
            bool exists = await Workflow.HasLocalVaultAsync(account);
            if (exists)
                await Workflow.UnlockAsync(account, _passphrase);
            else
                await Workflow.CreateAsync(account, _passphrase);
            _message = exists ? "Vault opened." : "Your local encrypted vault is ready.";
            try
            {
                await LedgerRecords.DisconnectAsync();
                var horizonUrl = _network switch
                {
                    "testnet" => "https://horizon-testnet.stellar.org",
                    "public" => "https://horizon.stellar.org",
                    _ => _customHorizon
                };
                var networkPassphrase = _network switch
                {
                    "testnet" => "Test SDF Network ; September 2015",
                    "public" => "Public Global Stellar Network ; September 2015",
                    _ => _customPassphrase ?? throw new InvalidOperationException("Custom network not detected.")
                };
                await LedgerRecords.ConnectAsync(_mnemonic, horizonUrl, networkPassphrase);
                _ledgerRegistryReady = await LedgerRecords.HasRegistryAsync();
                if (_ledgerRegistryReady) _ledgerItems = await LedgerRecords.ReadAsync();
                _ledgerMessage = "On-chain vault connected.";
            }
            catch (Exception ex)
            {
                _ledgerMessage = "On-chain connection failed: " + ex.Message;
            }
            try
            {
                bool found = await JS.InvokeAsync<bool>("stellarVaultV2Network.inspectAccount", account, _network, _customHorizon, _customPassphrase);
                _networkStatus = found ? "Root account found on the selected network." : "Root account not found on selected network. Local vault remains accessible.";
                if (found && Sessions.IsUnlocked)
                    _childAccounts = await JS.InvokeAsync<string[]>("stellarVaultV2Chain.discover", _mnemonic, _network, 16, _customHorizon, _customPassphrase);
            }
            catch (JSException)
            {
                _childAccounts = null;
                _networkStatus = "Network discovery unavailable; local vault remains accessible.";
            }
        }
        catch (JSException)
        {
            _message = "Recovery phrase validation failed or browser derivation is unavailable.";
        }
        catch (System.Security.Cryptography.CryptographicException)
        {
            _message = "Vault could not be unlocked. Check your encryption passphrase.";
        }
        catch (ArgumentException ex)
        {
            _message = ex.ParamName switch
            {
                "accountId" or "address" => "The derived Stellar address failed validation.",
                "passphrase" => "Enter a nonempty vault encryption passphrase.",
                _ => "Vault input was rejected. Check the recovery phrase and passphrase."
            };
        }
        catch (UnauthorizedAccessException)
        {
            _message = "Vault access is not authorized in this environment.";
        }
        catch (Exception ex) when (ex is InvalidOperationException or IOException or InvalidDataException or OperationCanceledException)
        {
            _message = "Could not open the vault. Check your browser storage and try again.";
        }
        finally
        {
            _mnemonic = string.Empty;
            _passphrase = string.Empty;
            _busy = false;
        }
    }

    private async Task LockAsync()
    {
        if (_busy) return;
        Workflow.Lock();
        await LedgerRecords.DisconnectAsync();
        _ledgerItems = null;
        _ledgerRegistryReady = false;
        _ledgerMessage = null;
        _mnemonic = string.Empty;
        _passphrase = string.Empty;
        _childAccounts = null;
        _networkStatus = null;
        _message = "Vault locked.";
    }

    protected override void OnInitialized() => Sessions.StateChanged += OnSessionChanged;
    private void OnSessionChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Sessions.StateChanged -= OnSessionChanged;
}
