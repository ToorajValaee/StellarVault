@using Microsoft.JSInterop
@using VaultEngine.Stellar.Services
@inject Microsoft.JSInterop.IJSRuntime JS
@inject VaultNetworkSelection NetworkSelection

@if (Embedded)
{
    @ChildContent
}
else
{
<div class="sv-adaptive-shell @(PlatformName == "WEB PWA" ? "sv-web-shell" : "sv-native-shell")">
    <header class="sv-adaptive-header">
        <div class="sv-brand">
            <span class="sv-mark sv-brand-shield" aria-hidden="true"><svg viewBox="0 0 32 36" width="27" height="30" fill="none"><path d="M16 2 29 7v11c0 8-6.2 13.5-13 16C9.2 31.5 3 26 3 18V7L16 2Z" fill="currentColor" opacity=".95"/><path d="m16 9 2.7 6.3L25 18l-6.3 2.7L16 27l-2.7-6.3L7 18l6.3-2.7L16 9Z" fill="#065640"/></svg></span>
            <span class="sv-brand-name"><strong>StellarVault</strong><small>Secure digital vault</small></span>
        </div>
        <div class="sv-header-actions">
            <span class="sv-header-privacy"><span aria-hidden="true">●</span> Encrypted vault</span>
            @if (HeaderActions is not null)
            {
                @HeaderActions
            }
            else
            {
                <details class="sv-network-menu">
                    <summary class="sv-network-icon-trigger" aria-label="Current Stellar network" title="Current network">
                        <svg class="sv-network-symbol" viewBox="0 0 24 24" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m4.5 15.5 15-7M3.3 11.1l15-7M5.8 19l14.9-7"/></svg>
                        <span class="sv-network-indicator @(NetworkSelection.SelectedPreset == "public" ? "mainnet" : NetworkSelection.SelectedPreset == "custom" ? "custom" : "")" aria-hidden="true"></span>
                    </summary>
                    <div class="sv-network-popover terminal-panel">
                        <strong class="sv-network-popup-title">@(NetworkSelection.SelectedPreset == "public" ? "Mainnet" : NetworkSelection.SelectedPreset == "custom" ? "Custom network" : "Testnet")</strong>
                        <p class="advanced-help">To change networks, lock and disconnect your vault first.</p>
                    </div>
                </details>
            }
            <button class="icon-button sv-theme-toggle" type="button" title="Switch color theme" aria-label="Change color theme" @onclick="ToggleThemeAsync"><span class="sv-theme-symbol" aria-hidden="true">◐</span></button>
        </div>
    </header>
    <main class="sv-adaptive-main" id="main-content">
        <VaultTransactionRecoveryPanel />
        @ChildContent
    </main>
</div>
}

@code {
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public string PlatformName { get; set; } = "WEB";
    [Parameter] public string Subtitle { get; set; } = "ENCRYPTED VAULT";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Embedded) return;
        try { await JS.InvokeVoidAsync("stellarVaultTheme.initialize"); }
        catch (Microsoft.JSInterop.JSException) { }
    }
    private async Task ToggleThemeAsync()
    {
        try { await JS.InvokeVoidAsync("stellarVaultTheme.toggle"); }
        catch (Microsoft.JSInterop.JSException) { }
    }
}
