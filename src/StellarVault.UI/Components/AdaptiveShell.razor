@inject Microsoft.JSInterop.IJSRuntime JS

<div class="sv-adaptive-shell">
    <header class="sv-adaptive-header">
        <div class="sv-brand">
            <span class="sv-mark" aria-hidden="true">SV</span>
            <span><strong>STELLARVAULT</strong><small>@Subtitle</small></span>
        </div>
        <div class="sv-header-actions">@HeaderActions<button class="icon-button sv-theme-toggle" type="button" title="Switch green / amber theme" aria-label="Change phosphor theme" @onclick="ToggleThemeAsync"><span aria-hidden="true">◐</span></button><span class="sv-platform">@PlatformName</span></div>
    </header>
    <main class="sv-adaptive-main" id="main-content">
        @ChildContent
    </main>
</div>

@code {
    [Parameter] public string PlatformName { get; set; } = "WEB";
    [Parameter] public string Subtitle { get; set; } = "ENCRYPTED VAULT";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderActions { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await JS.InvokeVoidAsync("stellarVaultTheme.initialize"); }
        catch (Microsoft.JSInterop.JSException) { }
    }
    private async Task ToggleThemeAsync()
    {
        try { await JS.InvokeVoidAsync("stellarVaultTheme.toggle"); }
        catch (Microsoft.JSInterop.JSException) { }
    }
}
