@using System.Globalization
@if (Estimate is not null)
{
    <section class="ledger-cost-panel" aria-label="Estimated Stellar ledger cost">
        <div class="panel-kicker">LEDGER COST ESTIMATE</div>
        <div class="cost-grid">
            <div>
                <span>NETWORK FEE // SPENT</span>
                <strong>@Native(Estimate.NetworkFeeNative)</strong>
            </div>
            <div>
                <span>NET RESERVE CHANGE</span>
                <strong class="@(Estimate.NetReserveChangeNative < 0 ? "reserve-release" : string.Empty)">
                    @SignedNative(Estimate.NetReserveChangeNative)
                </strong>
            </div>
            <div>
                <span>PEAK EXTRA RESERVE</span>
                <strong>@Native(Estimate.PeakReserveIncreaseNative)</strong>
            </div>
            <div>
                <span>OPERATIONS / TX</span>
                <strong>@Estimate.OperationCount / @Estimate.TransactionCount</strong>
            </div>
            <div>
                <span>CHUNKS</span>
                <strong>@Estimate.ChunkCount</strong>
            </div>
            <div>
                <span>ENTRY DELTA</span>
                <strong>+@Estimate.DataEntriesAdded / -@Estimate.DataEntriesRemoved</strong>
            </div>
        </div>

        @if (Estimate.CreatesChildNode)
        {
            <div class="terminal-alert warning cost-node-warning">
                <strong>NEW CHAIN NODE REQUIRED</strong>
                <span>
                    @Native(Estimate.ChildFundingTransferNative) will move from the root account to the new child account.
                    This is controlled reserve funding, not a network fee.
                </span>
            </div>
        }

        <p class="cost-explainer">
            Network fees are spent. Reserve is native balance locked by the ledger while accounts and data entries exist;
            deleting entries can release reserve, but transaction fees are never refunded. The estimate uses the selected fee bid and the current account-chain snapshot.
        </p>
    </section>
}

@code {
    [Parameter] public VaultCostEstimate? Estimate { get; set; }

    private static string Native(decimal value) =>
        $"{value.ToString("0.#######", CultureInfo.InvariantCulture)} NATIVE";

    private static string SignedNative(decimal value)
    {
        var sign = value > 0 ? "+" : value < 0 ? "−" : string.Empty;
        return $"{sign}{Math.Abs(value).ToString("0.#######", CultureInfo.InvariantCulture)} NATIVE";
    }
}
