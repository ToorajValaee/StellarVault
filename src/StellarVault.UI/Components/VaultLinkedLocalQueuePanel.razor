    private IBrowserFile? _smallFile;

    private void SelectLinkedSmallFile(InputFileChangeEventArgs args)
    {
        _smallFile = args.File;
        _message = _smallFile.Size is < 1 or > VaultLinkedSingleFilePolicy.MaxBytes
            ? "This S-key single-record file mode accepts only 1–2048 bytes."
            : "File selected. Staging will encrypt its contents locally without a Stellar transaction.";
    }

    private async Task StageLinkedSmallFileAsync()
    {
        if (_busy || !QueueKeys.IsUnlocked || _smallFile is null) return;
        _busy = true;
        byte[]? contents = null;
        try
        {
            if (_smallFile.Size is < 1 or > VaultLinkedSingleFilePolicy.MaxBytes)
                throw new InvalidDataException("The selected file exceeds the single-record limit.");
            await using var input = _smallFile.OpenReadStream(VaultLinkedSingleFilePolicy.MaxBytes);
            using var buffer = new MemoryStream();
            await input.CopyToAsync(buffer);
            contents = buffer.ToArray();
            await DraftWorkspace.StageSmallFileAsync(
                _smallFile.Name.Length > 256 ? _smallFile.Name[..256] : _smallFile.Name,
                _smallFile.Name,
                string.IsNullOrWhiteSpace(_smallFile.ContentType)
                    ? "application/octet-stream" : _smallFile.ContentType,
                contents);
            _smallFile = null;
            _drafts = await DraftWorkspace.ListAsync();
            _report = await QueueInspection.InspectAsync();
            _manualSyncPlan = null;
            _message = "Encrypted file draft staged. Review its separate fee before publication.";
        }
        catch (Exception ex)
        {
            _message = "S-key file staging failed. Refresh the encrypted queue before repeating: " + ex.Message;
        }
        finally
        {
            if (contents is not null)
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(contents);
            _busy = false;
        }
    }

    private async Task DownloadLinkedSmallFileAsync(string recordId)
    {
        if (_busy || !QueueKeys.CanPublish) return;
        _busy = true;
        byte[]? decoded = null;
        try
        {
            var records = await Ledger.ReadAsync();
            var file = records.Single(x => x.Id == recordId);
            if (!file.Content.StartsWith(StellarLedgerFileProtocol.SinglePrefix,
                    StringComparison.Ordinal))
                throw new InvalidDataException("Only a verified SVFILE1 file is supported.");
            decoded = StellarLedgerFileProtocol.DecodeFile(file, records);
            if (decoded.Length is < 1 or > VaultLinkedSingleFilePolicy.MaxBytes)
                throw new InvalidDataException("The linked file exceeds its safe single-record size.");
            await JS.InvokeVoidAsync("stellarVaultV2Download.save",
                StellarLedgerFileProtocol.FileName(file), decoded);
            _message = "Verified encrypted S-key file decrypted and downloaded.";
        }
        catch (Exception ex)
        {
            _message = "Unable to verify and download the selected S-key file: " + ex.Message;
        }
        finally
        {
            if (decoded is not null)
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(decoded);
            _busy = false;
        }
    }

    private IReadOnlyList<LedgerRecordItem> _publishedRecords = [];
    private string? _editingRemoteId;
    private string? _editingRemoteRevision;
    private string? _deletePublishedId;
    private string? _deletePublishedRevision;
    private string? _deletePublishedTitle;

    private async Task LoadPublishedRecordsAsync()
    {
        if (_busy || !QueueKeys.CanPublish) return;
        _busy = true;
        try
        {
            var records = await Ledger.ReadAsync();
            _publishedRecords = records.OrderBy(x => x.Title, StringComparer.OrdinalIgnoreCase)
                .Take(200).ToArray();
            _message = "Published S-key records loaded. Select an explicit local change.";
        }
        catch (Exception ex)
        {
            _publishedRecords = [];
            _message = "Published records could not be loaded: " + ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task<(LedgerRecordItem Record, string Revision)> ReadStablePublishedAsync(
        string id, IStellarSecretKeyRecordRevisionReader reader)
    {
        var before = await reader.ReadRecordRevisionAsync(id)
            ?? throw new InvalidOperationException("Published record has no valid manifest revision.");
        var remote = await Ledger.ReadAsync();
        var record = remote.Single(x => x.Id == id);
        var after = await reader.ReadRecordRevisionAsync(id);
        if (before != after)
            throw new InvalidOperationException(
                "The record changed while opening its contents. Reload before editing or deleting.");
        return (record, before);
    }

    private async Task EditPublishedRecordAsync(string id)
    {
        if (_busy || !QueueKeys.CanPublish || _review is not null ||
            Ledger is not IStellarSecretKeyRecordRevisionReader reader) return;
        _busy = true;
        try
        {
            var (record, revision) = await ReadStablePublishedAsync(id, reader);
            ClearDraftEditor();
            _deletePublishedId = null;
            _editingRemoteId = id;
            _editingRemoteRevision = revision;
            _draftTitle = record.Title;
            _draftContent = record.Content;
            _draftIsFolder = record.IsFolder;
            _draftFolderId = record.FolderId ?? string.Empty;
            _draftUsername = record.UserName ?? string.Empty;
            _draftUrl = record.Url ?? string.Empty;
            _draftNotes = record.Notes ?? string.Empty;
            _draftTags = string.Join(", ", record.Tags ?? []);
            _message = "Editing published record locally. Its original manifest revision must remain unchanged.";
        }
        catch (Exception ex)
        {
            ClearDraftEditor();
            _message = "Published record cannot be opened for staging: " + ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task SelectPublishedDeletionAsync(string id)
    {
        if (_busy || !QueueKeys.CanPublish ||
            Ledger is not IStellarSecretKeyRecordRevisionReader reader) return;
        _busy = true;
        try
        {
            var (record, revision) = await ReadStablePublishedAsync(id, reader);
            _deletePublishedId = id;
            _deletePublishedTitle = record.Title;
            _deletePublishedRevision = revision;
            _message = "Review and confirm local delete staging; no Stellar transaction is sent.";
        }
        catch (Exception ex)
        {
            CancelPublishedDeletion();
            _message = "Cannot prepare the local deletion: " + ex.Message;
        }
        finally { _busy = false; }
    }

    private void CancelPublishedDeletion()
    {
        _deletePublishedId = _deletePublishedRevision = _deletePublishedTitle = null;
    }

    private async Task ConfirmStagePublishedDeletionAsync()
    {
        if (_busy || !QueueKeys.CanPublish || _deletePublishedId is null ||
            _deletePublishedRevision is null) return;
        _busy = true;
        try
        {
            await DraftWorkspace.StageDeleteAsync(_deletePublishedId, _deletePublishedRevision);
            CancelPublishedDeletion();
            _manualSyncPlan = null;
            _publishedRecords = [];
            _drafts = await DraftWorkspace.ListAsync();
            _report = await QueueInspection.InspectAsync();
            _message = "Revision-pinned local deletion staged. No Stellar transaction was sent.";
        }
        catch (Exception ex)
        {
            _message = "Deletion staging could not be verified. Refresh before retrying: " + ex.Message;
        }
        finally { _busy = false; }
    }


    private async Task EditDraftAsync(string id)
    {
        if (_busy || !QueueKeys.IsUnlocked || _review is not null) return;
        _busy = true;
        try
        {
            // Explicit edit action decrypts only this draft into the local UI.
            // The secret input remains masked and no remote write occurs.
            var detail = await DraftWorkspace.OpenDraftAsync(id);
            ClearDraftEditor();
            _editingMutationId = detail.MutationId;
            _editingPayloadSha256 = detail.PayloadSha256;
            _draftTitle = detail.Draft.Title;
            _draftContent = detail.Draft.Content;
            _draftFolderId = detail.Draft.FolderId ?? string.Empty;
            _draftIsFolder = detail.Draft.IsFolder;
            _draftUsername = detail.Draft.UserName ?? string.Empty;
            _draftUrl = detail.Draft.Url ?? string.Empty;
            _draftNotes = detail.Draft.Notes ?? string.Empty;
            _draftTags = string.Join(", ", detail.Draft.Tags ?? []);
            _message = "Local draft opened for editing. Changes remain encrypted on this device until separately published.";
        }
        catch
        {
            ClearDraftEditor();
            _message = "Cannot open the unpublished draft. Refresh the encrypted queue.";
        }
        finally { _busy = false; }
    }

    private sealed record FolderOption(string EntityId, string Title, bool Local);
    private IReadOnlyList<FolderOption> _availableFolders = [];

    private async Task RefreshFolderOptionsAsync()
    {
        if (!QueueKeys.IsUnlocked) { _availableFolders = []; return; }
        IReadOnlyList<LedgerRecordItem> published = QueueKeys.IsOfflineOnly
            ? []
            : await Ledger.ReadAsync();
        var remoteFolders = published.Where(x => x.IsFolder)
            .Select(x => new FolderOption(x.Id, x.Title, false));
        var localFolders = _drafts.Where(x => x.IsFolder &&
                x.Kind == VaultMutationKind.CreateFolder &&
                (x.State is VaultSyncState.Pending or VaultSyncState.Confirmed) &&
                !x.IsCorrupt)
            .Select(x => new FolderOption(x.EntityId, x.Title, true));
        _availableFolders = remoteFolders.Concat(localFolders)
            .GroupBy(x => x.EntityId, StringComparer.OrdinalIgnoreCase)
            .Select(x => x.First())
            .OrderBy(x => x.Title, StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private void ClearDraftEditor()
    {
        _draftContent = _draftUsername = _draftUrl = _draftNotes = _draftTags = string.Empty;
        _draftTitle = _draftFolderId = string.Empty;
        _draftIsFolder = false;
        _editingMutationId = null;
        _editingPayloadSha256 = null;
        _editingRemoteId = null;
        _editingRemoteRevision = null;
    }

    private async Task LoadDraftsAsync()
    {
        if (_busy || !QueueKeys.IsUnlocked) return;
        _busy = true;
        try
        {
            _drafts = await DraftWorkspace.ListAsync();
            await RefreshFolderOptionsAsync();
        }
        catch
        {
            _drafts = [];
            _message = "The encrypted drafts could not be read. Check the local queue and connected signer.";
        }
        finally { _busy = false; }
    }

    private async Task StageDraftAsync()
    {
        if (_busy || !QueueKeys.IsUnlocked ||
            string.IsNullOrWhiteSpace(_draftTitle) ||
            (!_draftIsFolder && string.IsNullOrEmpty(_draftContent))) return;
        _busy = true;
        try
        {
            var draft = new LedgerRecordDraft(
                _draftTitle.Trim(),
                _draftIsFolder && _editingRemoteId is null && _editingMutationId is null
                    ? "folder" : _draftContent,
                string.IsNullOrWhiteSpace(_draftFolderId) ? null : _draftFolderId.Trim(),
                _draftTags.Split(',', StringSplitOptions.RemoveEmptyEntries |
                    StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase).ToArray(),
                _draftIsFolder, _draftUsername, _draftUrl, _draftNotes);
            _manualSyncPlan = null;
            if (_editingRemoteId is { } remoteId &&
                _editingRemoteRevision is { } remoteRevision)
            {
                await DraftWorkspace.StageUpdateAsync(remoteId, draft, remoteRevision);
            }
            else if (_editingMutationId is { } editingId &&
                     _editingPayloadSha256 is { } revision)
            {
                await DraftWorkspace.ReviseAsync(editingId, draft, revision);
            }
            else
            {
                await DraftWorkspace.CreateAsync(draft);
            }
            if (_editingRemoteId is not null) _publishedRecords = [];
            ClearDraftEditor();
            _message = "Encrypted local draft saved. No transaction was submitted.";
            try
            {
                _drafts = await DraftWorkspace.ListAsync();
                await RefreshFolderOptionsAsync();
                _report = await QueueInspection.InspectAsync();
            }
            catch { _message += " Screen refresh failed; inspect existing drafts before saving again."; }
        }
        catch (Exception ex)
        {
            _message = "Local draft save could not be verified; it may already exist. Refresh before repeating: " + ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task DiscardDraftAsync(string id)
    {
        if (_busy || !QueueKeys.IsUnlocked) return;
        _busy = true;
        try
        {
            _manualSyncPlan = null;
            await DraftWorkspace.DiscardAsync(id);
            _message = "Unpublished local draft discarded.";
            try
            {
                _drafts = await DraftWorkspace.ListAsync();
                await RefreshFolderOptionsAsync();
                _report = await QueueInspection.InspectAsync();
            }
            catch
            {
                _drafts = [];
                _message += " Screen refresh failed; inspect existing drafts before another change.";
            }
        }
        catch (Exception ex) { _message = "Draft removal outcome could not be verified. Refresh first: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task ChangeConsentAsync(ChangeEventArgs args)
    {
        if (_busy) return;
        await Publisher.CancelAsync();
        _review = null;
        _approvePublish = false;
        _report = null;
        _recoveryFinding = null;
        _drafts = [];
        _availableFolders = [];
        _publishedRecords = [];
        _smallFile = null;
        CancelPublishedDeletion();
        ClearDraftEditor();
        _exists = null;
        _passphrase = string.Empty;
        _offlineRoot = string.Empty;
        var consented = args.Value is true ||
            args.Value is string value && string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
        if (!consented)
        {
            await QueueKeys.LockAsync();
            LinkedRetention.Reset();
                        _message = "Independent device retention disabled for this session. Previously encrypted data was not erased.";
            return;
        }
        LinkedRetention.GrantExplicitConsent();
        await DiscoverAsync();
    }

    private async Task DiscoverAsync()
    {
        if (_busy || !LinkedRetention.DeviceRetention.AllowsLocalPersistence || !LinkedRetention.AllowsLocalPersistence) return;
        _busy = true;
        _message = null;
        try
        {
            _exists = Ledger.IsConnected
                ? await QueueKeys.HasLocalCredentialsAsync()
                : await QueueKeys.HasLocalCredentialsOfflineAsync(_offlineRoot.Trim());
            _message = _exists == true
                ? "Encrypted device credentials found. Unlock with the separate local passphrase."
                : "No local credentials found for this S-key account and network.";
            _deviceUnlockAvailable = false;
            if (_exists == true && DeviceUnlockKey() is { } deviceKey)
            {
                try
                {
                    _deviceUnlockAvailable = await JS.InvokeAsync<bool>(
                        "stellarVaultBiometric.has", deviceKey);
                }
                catch { /* Passkey APIs may be unavailable in the native WebView. */ }
            }
        }
        catch
        {
            _exists = null;
            _message = "Local encrypted credentials could not be verified for this public account and selected network.";
        }
        finally { _busy = false; }
    }

    private bool _deviceUnlockAvailable;

    private string? DeviceUnlockKey()
    {
        var root = Ledger.IsConnected ? Ledger.RootAccountId : _offlineRoot.Trim();
        // Do not reuse a mnemonic/HD passkey even if its public root address
        // matches an imported S-key vault on the same network.
        return StellarAccountAddress.IsValid(root)
            ? "linked-s-key:" + Networks.CredentialKey(root) : null;
    }

    private async Task UnlockWithDeviceAsync()
    {
        if (_busy || !_deviceUnlockAvailable || _exists != true) return;
        var key = DeviceUnlockKey();
        if (key is null) return;
        try
        {
            _passphrase = await JS.InvokeAsync<string>(
                "stellarVaultBiometric.unlock", key);
            await ActivateAsync(create: false);
        }
        catch
        {
            _message = "Device unlock is unavailable or was canceled. Use your separate local passphrase.";
        }
        finally { _passphrase = string.Empty; }
    }

    private Task CreateAsync() => ActivateAsync(create: true);
    private Task UnlockAsync() => ActivateAsync(create: false);

    private async Task ActivateAsync(bool create)
    {
        if (_busy || !LinkedRetention.DeviceRetention.AllowsLocalPersistence || !LinkedRetention.AllowsLocalPersistence || _passphrase.Length < 12)
            return;
        _busy = true;
        _report = null;
        try
        {
            if (create)
            {
                if (!Ledger.IsConnected)
                    throw new InvalidOperationException("New S-key device enrollment requires the connected signer.");
                await QueueKeys.CreateAsync(_passphrase);
            }
            else if (Ledger.IsConnected)
                await QueueKeys.UnlockAsync(_passphrase);
            else
                await QueueKeys.UnlockOfflineAsync(_offlineRoot.Trim(), _passphrase);
            _exists = true;
            _message = QueueKeys.IsOfflineOnly
                ? "Local encrypted drafts unlocked without Horizon. No transaction can be submitted in this mode."
                : "Independent encrypted device storage unlocked. Publication requires a separate fee review.";
            if (DeviceUnlockPreference.Requested)
            {
                DeviceUnlockPreference.Reset();
                if (DeviceUnlockKey() is { } key)
                {
                    try
                    {
                        await JS.InvokeVoidAsync(
                            "stellarVaultBiometric.enroll", key, _passphrase);
                        _deviceUnlockAvailable = true;
                        _message += " Device unlock enrolled for this encrypted queue. The S-key was not saved.";
                    }
                    catch
                    {
                        _message += " Device unlock could not be enrolled on this device. Continue using your local passphrase.";
                    }
                }
            }
            try
            {
                _drafts = await DraftWorkspace.ListAsync();
                await RefreshFolderOptionsAsync();
            }
            catch
            {
                _drafts = [];
                _availableFolders = [];
                _message += " Draft list refresh failed; the local key remains unlocked. Inspect drafts before making another change.";
            }
        }
        catch
        {
            _message = "Device encryption setup or unlock failed. Verify the local passphrase, network and signer session.";
        }
        finally
        {
            _passphrase = string.Empty;
            _busy = false;
        }
    }

    private async Task InspectAsync()
    {
        if (_busy || !QueueKeys.IsUnlocked) return;
        _busy = true;
        _report = null;
        try
        {
            _report = await QueueInspection.InspectAsync();
            _drafts = await DraftWorkspace.ListAsync();
            await RefreshFolderOptionsAsync();
            _message = "Read-only inspection completed. No transactions were broadcast.";
        }
        catch
        {
            _message = "Cannot inspect the encrypted local queue. Check local consent, public account, selected network and key unlock.";
        }
        finally { _busy = false; }
    }

    private async Task LockAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Publisher.CancelAsync();
            _review = null;
            _approvePublish = false;
            await QueueKeys.LockAsync();
            _report = null;
            _drafts = [];
            _availableFolders = [];
            _publishedRecords = [];
            _smallFile = null;
        CancelPublishedDeletion();
            ClearDraftEditor();
            _passphrase = string.Empty;
            _message = "Independent local encryption key cleared from memory.";
        }
        finally { _busy = false; }
    }

    public async ValueTask DisposeAsync()
    {
        _passphrase = string.Empty;
        _report = null;
        _recoveryFinding = null;
        _drafts = [];
        _availableFolders = [];
        _publishedRecords = [];
        _smallFile = null;
        CancelPublishedDeletion();
        ClearDraftEditor();
        await Publisher.CancelAsync();
        await LinkedExpansion.AbandonUnsubmittedAsync();
        await QueueKeys.LockAsync();
        LinkedRetention.Reset();
            }
}
