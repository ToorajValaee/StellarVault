@using StellarVault.Core.Services
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject IStellarSecretKeyLedger Ledger
@inject VaultLinkedLocalRetentionGate LinkedRetention
@inject VaultLinkedQueueKeySession QueueKeys
@inject VaultNetworkSelection Networks
@inject VaultDeviceUnlockPreference DeviceUnlockPreference
@inject VaultLinkedQueueInspection QueueInspection
@inject VaultLinkedDraftWorkspace DraftWorkspace
@inject VaultLinkedDraftPublication Publisher
@inject VaultLinkedAccountExpansion LinkedExpansion
@inject VaultLinkedExpansionJournal ExpansionJournal
@inject VaultLinkedDraftRecoveryReview RecoveryReview
@inject VaultLinkedVerifiedReconciliation VerifiedReconciliation
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="sv-secret-review" aria-label="Encrypted local queue for independent Secret Key vault">
    <h3>Encrypted device drafts</h3>
    <p>Optional local encrypted storage for this independent Stellar S-key vault.
       This device uses a separate local passphrase, separate encryption key and separate
       storage namespace from mnemonic-based vaults. Saving a draft is local-only;
       publishing later requires a separate connected signer and fee approval.</p>
    <label class="sv-secret-approval">
        <input type="checkbox" checked="@LinkedRetention.AllowsLocalPersistence"
               disabled="@_busy" @onchange="ChangeConsentAsync" />
        I consent to encrypted local storage on this device. Locking or turning off consent does not delete previously saved encrypted data.
    </label>
    @if (LinkedRetention.AllowsLocalPersistence && LinkedRetention.DeviceRetention.AllowsLocalPersistence)
    {
        @if (!Ledger.IsConnected && !QueueKeys.IsUnlocked)
        {
            <label>Stellar root public address (G…)
                <input maxlength="56" autocomplete="off" spellcheck="false"
                       @bind="_offlineRoot" @bind:event="oninput" disabled="@_busy" />
            </label>
            <p>The account address and selected network locate an existing encrypted
               device vault. The separate local passphrase decrypts it; the S-key
               is not required for local-only records. First-time setup requires
               connecting the S-key while online.</p>
        }
        @if (_exists is null)
        {
            <button type="button" class="pixel-button compact"
                    disabled="@(_busy || (!Ledger.IsConnected && _offlineRoot.Length != 56))"
                    @onclick="DiscoverAsync">Check local encrypted storage</button>
        }
        else if (!QueueKeys.IsUnlocked)
        {
            <label>Separate local passphrase
                <input type="password" autocomplete="new-password" minlength="12"
                       spellcheck="false" @bind="_passphrase" @bind:event="oninput"
                       disabled="@_busy" />
            </label>
            <div class="sv-secret-workspace-actions">
                @if (_exists == true)
                {
                    <button type="button" class="pixel-button compact"
                            disabled="@(_busy || _passphrase.Length < 12)"
                            @onclick="UnlockAsync">Unlock encrypted local drafts</button>
                    @if (_deviceUnlockAvailable)
                    {
                        <button type="button" class="pixel-button compact"
                                disabled="@_busy" @onclick="UnlockWithDeviceAsync">
                            Unlock encrypted drafts with device
                        </button>
                    }
                }
                else if (Ledger.IsConnected)
                {
                    <button type="button" class="pixel-button compact"
                            disabled="@(_busy || _passphrase.Length < 12)"
                            @onclick="CreateAsync">Create encrypted device storage</button>
                }
                else
                {
                    <p>Encrypted credentials were not found for this public account
                       and network. Connect with the S-key to enroll local storage.</p>
                }
            </div>
        }
        else
        {
            <p role="status">@(QueueKeys.IsOfflineOnly
                ? "Local-only queue unlocked. No Stellar signing or live remote verification is available."
                : "The independent local encryption key is unlocked in memory.")</p>
            <div class="sv-secret-workspace-actions">
                <button type="button" class="pixel-button compact" disabled="@_busy"
                        @onclick="InspectAsync">Inspect encrypted draft queue</button>
                <button type="button" class="pixel-button compact" disabled="@_busy"
                        @onclick="LoadDraftsAsync">Refresh local drafts</button>
                <button type="button" class="pixel-button compact" disabled="@_busy"
                        @onclick="ReviewManualSyncAsync">Review manual sync order</button>
                <button type="button" class="pixel-button compact" disabled="@_busy"
                        @onclick="LockAsync">Lock local drafts</button>
            </div>
            @if (_manualSyncPlan is not null)
            {
                <section class="sv-secret-review" aria-label="Manual linked draft synchronization order">
                    <h3>Manual sync review</h3>
                    <p><strong>Pending:</strong> @_manualSyncPlan.PendingCount
                       · <strong>Unresolved:</strong> @_manualSyncPlan.UnresolvedCount</p>
                    <p>Each draft requires a separate Stellar quote and fee approval.
                       No automatic publication, retry, or submission is performed here.</p>
                    @foreach (var draft in _manualSyncPlan.Items)
                    {
                        <p @key="draft.MutationId">
                            <strong>@draft.Title</strong> · @draft.State
                            @if (draft.Blockers.Length > 0)
                            {
                                <span> — @string.Join(", ", draft.Blockers)</span>
                            }
                            else
                            {
                                <span> — Ready for an individual review</span>
                            }
                        </p>
                    }
                    @if (_manualSyncPlan.CanReviewNext &&
                         _manualSyncPlan.NextReadyMutationId is { } nextId)
                    {
                        <button type="button" class="pixel-button compact"
                                disabled="@(_busy || _review is not null || !QueueKeys.CanPublish)"
                                @onclick="() => ReviewDraftAsync(nextId)">Review next ready draft</button>
                    }
                </section>
            }
            @if (_expandQuote is not null)
            {
                <section class="sv-secret-review" aria-label="Review additional linked Stellar storage account">
                    <h3>Review additional storage account</h3>
                    <p>A new linked Stellar account is needed before the next record can be saved.
                       The root signer will authorize it; its master key is disabled by the linked ledger protocol.</p>
                    <p><strong>New account:</strong> <code>@_expandQuote.TargetAccountId</code></p>
                    <p><strong>Network fee:</strong> @_expandQuote.NetworkFeeXlm XLM</p>
                    <p><strong>Peak reserve:</strong> @_expandQuote.PeakReserveXlm XLM</p>
                    <p><strong>Funding top-up:</strong> @_expandQuote.FundingTopUpXlm XLM</p>
                    <p><strong>Operations:</strong> @_expandQuote.Operations</p>
                    <label class="sv-secret-approval">
                        <input type="checkbox" @bind="_approveExpand" disabled="@_busy" />
                        I approve creation of this specific linked account and its fees and reserve.
                    </label>
                    <button type="button" class="pixel-button primary"
                            disabled="@(_busy || !_approveExpand || !QueueKeys.CanPublish)"
                            @onclick="SubmitExpansionAsync">Create reviewed storage account</button>
                    <button type="button" class="pixel-button compact" disabled="@_busy"
                            @onclick="CancelExpansionAsync">Cancel account review</button>
                </section>
            }
            @if (_expandQuote is null && QueueKeys.CanPublish)
            {
                <button type="button" class="pixel-button compact"
                        disabled="@(_busy || _review is not null)"
                        @onclick="ReviewExpansionAsync">Review additional account capacity</button>
            }
            @if (_review is not null)
            {
                <section class="sv-secret-review" aria-label="Review encrypted local draft publication">
                    <h3>Review local draft publication</h3>
                    <p><strong>Record:</strong> @_review.Title (@(_review.IsFolder ? "Folder" : "Record"))</p>
                    <p><strong>Target:</strong> <code>@_review.Quote.TargetAccountId</code></p>
                    <p><strong>Network fee:</strong> @_review.Quote.NetworkFeeXlm XLM</p>
                    <p><strong>Peak reserve:</strong> @_review.Quote.PeakReserveXlm XLM</p>
                    <p><strong>Funding top-up:</strong> @_review.Quote.FundingTopUpXlm XLM</p>
                    <p><strong>Operations:</strong> @_review.Quote.Operations</p>
                    <label class="sv-secret-approval">
                        <input type="checkbox" @bind="_approvePublish" disabled="@_busy" />
                        I approve this specific Stellar transaction, fee and account reserve.
                    </label>
                    <button type="button" class="pixel-button primary"
                            disabled="@(_busy || !_approvePublish)"
                            @onclick="PublishReviewedDraftAsync">Sign and submit reviewed draft</button>
                    <button type="button" class="pixel-button compact"
                            disabled="@_busy" @onclick="CancelPublicationReviewAsync">Cancel review</button>
                </section>
            }
            @if (QueueKeys.CanPublish)
            {
                <section class="sv-secret-review" aria-label="Published S-key records available for local edits">
                    <h3>Stage changes to published records</h3>
                    <p>Load a current Stellar snapshot, then stage a revision-pinned update or delete.
                       Nothing is signed or transmitted until the later individual fee approval.
                       A changed remote manifest blocks stale publication.</p>
                    <button type="button" class="pixel-button compact" disabled="@_busy"
                            @onclick="LoadPublishedRecordsAsync">Load published records</button>
                    @foreach (var record in _publishedRecords)
                    {
                        <div class="sv-secret-workspace-actions" @key="record.Id">
                            <span><strong>@record.Title</strong> — @(StellarLedgerFileProtocol.IsFile(record) ? "Encrypted file" : record.IsFolder ? "Folder" : "Record")</span>
                            <button type="button" class="pixel-button compact"
                                    disabled="@(_busy || _review is not null || StellarLedgerFileProtocol.IsFile(record))"
                                    @onclick="() => EditPublishedRecordAsync(record.Id)">Stage update</button>
                            <button type="button" class="pixel-button compact"
                                    disabled="@(_busy || _review is not null)"
                                    @onclick="() => SelectPublishedDeletionAsync(record.Id)">Stage delete…</button>
                            @if (record.Content.StartsWith(StellarLedgerFileProtocol.SinglePrefix,
                                    StringComparison.Ordinal))
                            {
                                <button type="button" class="pixel-button compact"
                                        disabled="@_busy"
                                        @onclick="() => DownloadLinkedSmallFileAsync(record.Id)">Download decrypted file</button>
                            }
                        </div>
                    }
                    @if (_deletePublishedId is not null)
                    {
                        <p role="alert">Stage local deletion for the selected published
                           @(_deletePublishedTitle)? This does not delete anything from Stellar yet,
                           but later publication will require a separate transaction approval.</p>
                        <button type="button" class="pixel-button compact" disabled="@_busy"
                                @onclick="ConfirmStagePublishedDeletionAsync">Confirm local delete draft</button>
                        <button type="button" class="pixel-button compact" disabled="@_busy"
                                @onclick="CancelPublishedDeletion">Cancel</button>
                    }
                </section>
            }
            <section class="sv-secret-review" aria-label="Single-record encrypted S-key files">
                <h3>Encrypted small files (single-record)</h3>
                <p>Stage files of 1–2048 bytes using the shared SVFILE1 format.
                   Files stay encrypted locally until separately fee-reviewed.
                   The larger multipart file protocol is not enabled for this S-key vault.</p>
                <InputFile OnChange="SelectLinkedSmallFile" disabled="@_busy" />
                @if (_smallFile is not null)
                {
                    <p>Selected: @_smallFile.Name (@_smallFile.Size bytes)</p>
                    <button type="button" class="pixel-button compact"
                            disabled="@(_busy || _smallFile.Size < 1 || _smallFile.Size > VaultLinkedSingleFilePolicy.MaxBytes)"
                            @onclick="StageLinkedSmallFileAsync">Stage encrypted file draft</button>
                }
            </section>
            <section class="sv-secret-editor" aria-label="Save independent encrypted local draft">
                <h3>@(_editingRemoteId is not null ? "Stage update to published record" :
                    _editingMutationId is null ? "Save to encrypted device storage" : "Edit unpublished encrypted draft")</h3>
                <p>Local-only. This draft will not be uploaded, signed or submitted to Stellar.</p>
                @if (QueueKeys.IsOfflineOnly)
                {
                    <p role="status">Offline mode lists only locally staged folders.
                       Published folder contents cannot be fetched or verified until reconnecting.
                       Publishing remains disabled.</p>
                }
                <label class="sv-secret-approval">
                    <input type="checkbox" @bind="_draftIsFolder"
                           disabled="@(_busy || _editingMutationId is not null || _editingRemoteId is not null)" />
                    New folder instead of record
                </label>
                <label>Title
                    <input maxlength="256" @bind="_draftTitle" @bind:event="oninput" disabled="@_busy" />
                </label>
                @if (!_draftIsFolder)
                {
                    <label>Username
                        <input @bind="_draftUsername" @bind:event="oninput" disabled="@_busy" />
                    </label>
                    <label>URL
                        <input type="url" @bind="_draftUrl" @bind:event="oninput" disabled="@_busy" />
                    </label>
                    <label>Secret
                        <input type="password" autocomplete="off" spellcheck="false"
                               @bind="_draftContent" @bind:event="oninput" disabled="@_busy" />
                    </label>
                    <label>Notes
                        <textarea rows="3" @bind="_draftNotes" @bind:event="oninput"
                                  disabled="@_busy"></textarea>
                    </label>
                    <label>Tags (comma-separated)
                        <input @bind="_draftTags" @bind:event="oninput" disabled="@_busy" />
                    </label>
                }
                <label>Parent folder
                    <select @bind="_draftFolderId" disabled="@_busy">
                        <option value="">Root of vault</option>
                        @if (!string.IsNullOrWhiteSpace(_draftFolderId) &&
                             !_availableFolders.Any(x => x.EntityId == _draftFolderId))
                        {
                            <option value="@_draftFolderId">Unverified parent — @_draftFolderId</option>
                        }
                        @foreach (var folder in _availableFolders)
                        {
                            <option value="@folder.EntityId">@folder.Title @(folder.Local ? "(local draft)" : "(on Stellar)")</option>
                        }
                    </select>
                </label>
                <button type="button" class="pixel-button primary"
                        disabled="@(_busy || string.IsNullOrWhiteSpace(_draftTitle) || (!_draftIsFolder && string.IsNullOrEmpty(_draftContent)))"
                        @onclick="StageDraftAsync">@(_editingRemoteId is not null ? "Stage revision-pinned update" :
                            _editingMutationId is null ? "Save encrypted local draft" : "Save encrypted changes")</button>
                @if (_editingMutationId is not null || _editingRemoteId is not null)
                {
                    <button type="button" class="pixel-button compact" disabled="@_busy"
                            @onclick="ClearDraftEditor">Cancel editing</button>
                }
            </section>
            @if (_drafts.Count > 0)
            {
                <section class="sv-secret-review" aria-label="Pending encrypted local records and folders">
                    <h3>Encrypted queue — drafts and transaction history (@_drafts.Count)</h3>
                    @foreach (var draft in _drafts)
                    {
                        <div class="sv-secret-workspace-actions" @key="draft.MutationId">
                            <span><strong>@draft.Title</strong> — @(draft.IsFile ? "Encrypted file" : draft.IsFolder ? "Folder" : "Record")
                                · @draft.Kind · @draft.State
                                @if (draft.IsJournal)
                                {
                                    <em>Capacity transaction journal — do not retry an unresolved entry</em>
                                }
                                else if (draft.IsCorrupt) { <em>Unreadable draft</em> }
                            </span>
                            @if (draft.IsJournal && draft.State == VaultSyncState.Pending)
                            {
                                <button type="button" class="pixel-button compact"
                                        disabled="@(_busy || !QueueKeys.CanPublish)"
                                        @onclick="() => DiscardUnreservedExpansionAsync(draft.MutationId)">
                                    Discard never-submitted reservation
                                </button>
                            }
                            @if (draft.State is VaultSyncState.Submitting or VaultSyncState.Uncertain)
                            {
                                <button type="button" class="pixel-button compact"
                                        disabled="@(_busy || !Ledger.IsConnected)"
                                        @onclick="() => InspectUnresolvedAsync(draft.MutationId)">Assess unresolved (read-only)</button>
                            }
                            @if (draft.State == VaultSyncState.Pending &&
                                 !draft.IsCorrupt && !draft.IsJournal)
                            {
                                @if (!draft.IsFile &&
                                     (draft.Kind is not (VaultMutationKind.DeleteRecord or VaultMutationKind.DeleteFolder)))
                                {
                                    <button type="button" class="pixel-button compact"
                                            disabled="@(_busy || _review is not null)"
                                            @onclick="() => EditDraftAsync(draft.MutationId)">Edit local draft</button>
                                }
                                <button type="button" class="pixel-button compact"
                                        disabled="@(_busy || _review is not null || !QueueKeys.CanPublish)"
                                        @onclick="() => ReviewDraftAsync(draft.MutationId)">Review publish</button>
                                <button type="button" class="pixel-button compact" disabled="@_busy"
                                        @onclick="() => DiscardDraftAsync(draft.MutationId)">Discard local draft</button>
                            }
                        </div>
                    }
                </section>
            }
        }
        @if (_recoveryFinding is not null && QueueKeys.IsUnlocked)
        {
            <section class="sv-secret-review" aria-label="Uncertain local draft recovery assessment">
                <h3>Read-only recovery assessment</h3>
                <p><strong>Record:</strong> @_recoveryFinding.EntityId</p>
                <p><strong>Durable queue state:</strong> @_recoveryFinding.DurableState</p>
                @if (_recoveryFinding.TransactionHash is { } txHash)
                {
                    <p><strong>Signed transaction hash (public recovery handle, not proof):</strong>
                        <code style="overflow-wrap:anywhere">@txHash</code></p>
                }
                <p><strong>Current expected mutation result (advisory):</strong> @(_recoveryFinding.CurrentRecordMatches is true ? "Observed" :
                    _recoveryFinding.CurrentRecordMatches is false ? "Not observed" : "Unknown")</p>
                <p><strong>Advisory receipt:</strong> @(_recoveryFinding.HistoricalReceiptObserved ? "Observed (insufficient for release)" : "Not established")</p>
                <p><strong>Historical record operation check:</strong>
                    @(_recoveryFinding.HistoricalRecordOperationsMatch ? "skh/skc manifest and chunks match (not signer or decryption proof)" : "Not established")
                </p>
                @if (_recoveryFinding.HistoricalStorageAccount is { } account)
                {
                    <p><strong>Historical storage account:</strong> <code style="overflow-wrap:anywhere">@account</code></p>
                }
                <p><strong>Historical linked expansion operations:</strong>
                    @(_recoveryFinding.HistoricalExpansionOperationsMatch ? "Child account, root signer and parent pointer observed (not full authorization proof)" : "Not established")
                </p>
                @if (_recoveryFinding.HistoricalParentAccount is { } parentAccount)
                {
                    <p><strong>Historical parent account:</strong> <code style="overflow-wrap:anywhere">@parentAccount</code></p>
                }
                <p role="alert">@_recoveryFinding.Explanation</p>
                <p>No queue state was changed. Independent operation-level verification is required before any release or retry.</p>
                <p>Historical proof finalization is available for record creates, updates and deletes only.
                   It requires the currently connected S-key to verify the exact signed XDR,
                   root signature and decrypted historical ciphertext. If any check fails,
                   the encrypted journal stays quarantined.</p>
                @if (_recoveryFinding.TransactionHash is not null &&
                     (_recoveryFinding.DurableState is VaultSyncState.Uncertain or VaultSyncState.Submitting))
                {
                    <button type="button" class="pixel-button compact"
                            disabled="@(_busy || !QueueKeys.CanPublish)"
                            @onclick="() => ConfirmVerifiedMutationAsync(_recoveryFinding.MutationId)">
                        Verify signed history and finalize journal
                    </button>
                }
            </section>
        }
        @if (_report is not null && QueueKeys.IsUnlocked)
        {
            <p><strong>Queued drafts:</strong> @_report.Pending</p>
            <p><strong>Uncertain/submitting:</strong> @_report.UncertainOrSubmitting</p>
            <p><strong>Conflicts:</strong> @_report.Conflicts</p>
            <p><strong>Folder mutations:</strong> @_report.FolderEntries</p>
            <p>Manual create/update/delete publication requires individual fee review and a live linked S-key signer.
               Remote-version checks prevent stale writes. Automatic synchronization and full historical signer/record verification remain unavailable.</p>
        }
    }
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <p class="sv-secret-status" role="status">@_message</p>
    }
</section>

@code {
    private bool _busy;
    private bool? _exists;
    private string _passphrase = string.Empty;
    private string _offlineRoot = string.Empty;
    private string? _message;
    private VaultLinkedQueueInspection.Report? _report;
    private IReadOnlyList<VaultLinkedDraftWorkspace.DraftItem> _drafts = [];
    private VaultLinkedManualSyncPlan.Review? _manualSyncPlan;

    private async Task ReviewManualSyncAsync()
    {
        if (_busy || !QueueKeys.IsUnlocked) return;
        _busy = true;
        _manualSyncPlan = null;
        try
        {
            _manualSyncPlan = await DraftWorkspace.ReviewManualSyncAsync();
            _message = "Read-only manual sync ordering complete. Every transaction requires its own fresh fee approval.";
        }
        catch
        {
            _message = "Manual sync ordering failed. Refresh the encrypted queue and connected signer.";
        }
        finally { _busy = false; }
    }

    private VaultLinkedDraftPublication.Review? _review;
    private bool _approvePublish;
    private VaultSecretLedgerQuote? _expandQuote;
    private bool _approveExpand;

    private async Task ReviewExpansionAsync()
    {
        if (_busy || !QueueKeys.CanPublish || _expandQuote is not null ||
            _review is not null) return;
        _busy = true;
        try
        {
            _expandQuote = await ExpansionJournal.PrepareAsync();
            _approveExpand = false;
            _manualSyncPlan = null;
            _message = "Review a separate linked-account transaction. Draft publication will require its own quote afterward.";
        }
        catch (Exception ex)
        {
            _message = "Account expansion review unavailable: " + ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task SubmitExpansionAsync()
    {
        if (_busy || !_approveExpand || _expandQuote is null ||
            !QueueKeys.CanPublish) return;
        var quote = _expandQuote;
        _expandQuote = null;
        _approveExpand = false;
        _busy = true;
        try
        {
            var hash = await ExpansionJournal.SubmitApprovedAsync(quote, true);
            _manualSyncPlan = null;
            _message = "Additional storage account observed after transaction " + hash +
                ". Its encrypted journal remains UNCERTAIN until historical signer and operation evidence is verified. Do not retry or publish dependent drafts.";
        }
        catch (VaultLinkedExpansionPreflightException)
        {
            _message = "Expansion was rejected before this transaction was sent. Refresh and review again; other unresolved transactions still require reconciliation.";
        }
        catch
        {
            _message = "Expansion outcome may be uncertain. Do not repeat the account creation or any queued publication until ledger history is reconciled.";
        }
        finally { _busy = false; }
    }

    private async Task DiscardUnreservedExpansionAsync(string id)
    {
        if (_busy || !QueueKeys.CanPublish) return;
        _busy = true;
        try
        {
            await ExpansionJournal.DiscardNeverSubmittedIntentAsync(id);
            _manualSyncPlan = null;
            _drafts = await DraftWorkspace.ListAsync();
            _message = "The never-reserved local expansion intent was discarded. No transaction was submitted by that journal.";
        }
        catch
        {
            _message = "Expansion journal was not discarded. Refresh its state; never discard uncertain or submitting transactions.";
        }
        finally { _busy = false; }
    }

    private async Task CancelExpansionAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await LinkedExpansion.AbandonUnsubmittedAsync();
            _expandQuote = null;
            _approveExpand = false;
            _message = "Unsubmitted account expansion review canceled.";
        }
        finally { _busy = false; }
    }


    private VaultLinkedDraftRecoveryReview.Finding? _recoveryFinding;

    private async Task ConfirmVerifiedMutationAsync(string mutationId)
    {
        if (_busy || !QueueKeys.CanPublish) return;
        _busy = true;
        try
        {
            var journal = _drafts.SingleOrDefault(x => x.MutationId == mutationId)
                ?? throw new InvalidOperationException("Refresh the encrypted journal before reconciling.");
            var result = journal.Kind == VaultMutationKind.ExtendLinkedChain
                ? await VerifiedReconciliation.ConfirmVerifiedExpansionAsync(mutationId)
                : await VerifiedReconciliation.ConfirmVerifiedRecordAsync(mutationId);
            _recoveryFinding = null;
            _manualSyncPlan = null;
            _drafts = await DraftWorkspace.ListAsync();
            _report = await QueueInspection.InspectAsync();
            _message = result.Explanation;
        }
        catch (Exception ex)
        {
            _message = "Historical transaction verification did not release the encrypted queue. Do not retry the transaction: " + ex.Message;
        }
        finally { _busy = false; }
    }

    private async Task InspectUnresolvedAsync(string id)
    {
        if (_busy || !QueueKeys.IsUnlocked) return;
        _busy = true;
        _recoveryFinding = null;
        try
        {
            _recoveryFinding = await RecoveryReview.InspectAsync(id);
            _message = "Recovery assessment is read-only. An unresolved draft cannot be retried or marked confirmed.";
        }
        catch
        {
            _message = "Uncertain draft could not be inspected. Keep it quarantined and do not retry.";
        }
        finally { _busy = false; }
    }


    private async Task ReviewDraftAsync(string id)
    {
        if (_busy || _review is not null || !QueueKeys.CanPublish) return;
        _manualSyncPlan = null;
        _busy = true;
        try
        {
            _review = await Publisher.PrepareAsync(id);
            _approvePublish = false;
            _message = "Review the fresh account, fee and reserve before approving. No transaction has been sent.";
        }
        catch (Exception ex) { _message = "Draft publication review unavailable: " + ex.Message; }
        finally { _busy = false; }
    }

    private async Task PublishReviewedDraftAsync()
    {
        if (_busy || !_approvePublish || _review is null) return;
        var approved = _review;
        _review = null;
        _approvePublish = false;
        _busy = true;
        try
        {
            _manualSyncPlan = null;
            var hash = await Publisher.SubmitAsync(approved.Quote, true);
            _message = "Transaction submitted; " +
                (approved.Quote.Kind == "delete" ? "current record absence" : "matching current record") +
                " observed. Queue remains UNCERTAIN for transaction: " + hash +
                ". Current state is not historical transaction proof. Do not retry until independently reconciled.";
            try
            {
                _drafts = await DraftWorkspace.ListAsync();
                await RefreshFolderOptionsAsync();
                _report = await QueueInspection.InspectAsync();
            }
            catch { _message += " Screen refresh failed; do not repeat this submission."; }
        }
        catch (Exception ex)
        {
            // Any failure after the durable reservation may represent an
            // accepted transaction. Do not offer retry without new review
            // and verified reconciliation of the queue state.
            _message = "Publication cannot be confirmed. Do not retry an uncertain draft: " +
                ex.Message;
            try
            {
                _drafts = await DraftWorkspace.ListAsync();
                _report = await QueueInspection.InspectAsync();
            }
            catch { _drafts = []; _report = null; }
        }
        finally { _busy = false; }
    }

    private async Task CancelPublicationReviewAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Publisher.CancelAsync();
            _review = null;
            _approvePublish = false;
            _message = "Unsubmitted publication quote canceled.";
        }
        finally { _busy = false; }
    }

    private bool _draftIsFolder;
    private string _draftTitle = string.Empty;
    private string _draftContent = string.Empty;
    private string _draftUsername = string.Empty;
    private string _draftUrl = string.Empty;
    private string _draftNotes = string.Empty;
    private string _draftTags = string.Empty;
    private string _draftFolderId = string.Empty;
