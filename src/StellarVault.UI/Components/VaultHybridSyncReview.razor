@using StellarVault.Core.Services
@inject VaultHybridSyncReviewService HybridReview
@inject VaultManualSyncCoordinator ManualSync
@inject VaultNetworkSelection Networks
@inject VaultPendingMutationQueue PendingQueue
@inject VaultSessionManager Sessions
@inject VaultDeviceRetentionGate Retention
@inject IStellarLedgerRecords Ledger

<section class="terminal-panel" aria-label="Hybrid encrypted device queue">
    <div class="panel-heading">
        <div><div class="panel-kicker">ENCRYPTED DEVICE VAULT // HYBRID SYNC</div>
        <h3>LOCAL CHANGES — REVIEW AND MANUAL SYNC</h3></div>
    </div>
    <p>Local drafts stay on this device until you explicitly approve a paid Stellar transaction.
       Submission is not confirmation. An unknown outcome remains quarantined and must never be retried automatically.</p>
    @if (!Retention.AllowsLocalPersistence)
    {
        <p role="status">Encrypted device retention is not enabled for this session. No queue data will be opened.</p>
    }
    else if (!Sessions.IsUnlocked || Sessions.ActiveAccountId is not string)
    {
        <p role="status">Unlock the encrypted local vault before reviewing device-only changes.</p>
    }
    else
    {
        <button type="button" class="pixel-button compact" disabled="@_busy"
                @onclick="ReviewAsync">REVIEW LOCAL CHANGES</button>
        <button type="button" class="pixel-button compact" disabled="@(_busy || !Ledger.IsConnected)"
                @onclick="EstimateAsync">ESTIMATE STELLAR SYNC COSTS</button>
        @if (_report is not null)
        {
            <p role="status">Ready: @_report.Queue.Ready.Count · Blocked: @_report.Queue.Blocked.Count ·
                Uncertain: @_report.Queue.NeedsReconciliation · Conflicts: @_report.Queue.Conflicts</p>
            @if (_report.Queue.NeedsReconciliation > 0)
            {
                <p class="terminal-alert warning" role="alert">Unresolved submission detected. Do not retry or publish additional drafts before investigating the ledger.</p>
                @foreach (var pending in _unresolved)
                {
                    <div class="data-field">
                        <p>Mutation <code>@pending.Id</code> · @pending.Kind · @pending.State</p>
                        @if (pending.TransactionHash is { Length: 64 } recordedHash &&
                            pending.Kind is VaultMutationKind.CreateRecord or VaultMutationKind.CreateFolder)
                        {
                            <p>Recorded hash: <code>@recordedHash</code></p>
                            <button type="button" class="pixel-button compact"
                                    disabled="@(_busy || !Ledger.IsConnected)"
                                    @onclick="() => VerifyRecordedHashAsync(pending)">
                                VERIFY RECORDED TRANSACTION — NO RETRY
                            </button>
                        }
                        else if (pending.TransactionHash is null)
                        {
                            <p role="alert">No hash was recorded. The original submission might have succeeded. This action cannot automatically confirm it; investigate independently.</p>
                        }
                        else
                        {
                            <p role="alert">Update/delete transaction recorded. Historical confirmation for this mutation kind is not available. Do not retry.</p>
                        }
                    </div>
                }
            }
            @foreach (var item in _report.Estimates)
            {
                <div class="data-field">
                    <strong>@item.Title</strong>
                    <p>@item.Kind — @item.Explanation</p>
                    @if (item.Quote is not null)
                    {
                        <p>Quote expires after 5 minutes and applies to this exact encrypted draft and network.</p>
                        <button type="button" class="pixel-button compact"
                                disabled="@(_busy || _report.Queue.NeedsReconciliation != 0 || _report.Queue.Conflicts != 0)"
                                @onclick="() => SelectQuoteAsync(item)">REVIEW TRANSACTION APPROVAL</button>
                    }
                </div>
            }
            @if (_selectedQuote is not null && _report.Queue.NeedsReconciliation == 0 &&
                _report.Queue.Conflicts == 0)
            {
                <section class="terminal-panel" aria-label="Explicit hybrid sync transaction approval">
                    <h3>PAID STELLAR TRANSACTION APPROVAL</h3>
                    <p><strong>@_selectedTitle</strong> · @(_selectedKind.ToString().ToUpperInvariant())</p>
                    <p>Account: <code>@_selectedQuote.AccountId</code></p>
                    <p>Network: <code>@Networks.Network</code></p>
                    <p>Record mutation: <code>@_selectedQuote.MutationId</code></p>
                    <p>Maximum fee: <strong>@_selectedQuote.QuotedFeeXlm XLM</strong></p>
                    <p>Estimated peak reserve: <strong>@_selectedQuote.QuotedPeakReserveXlm XLM</strong></p>
                    <p>Draft fingerprint: <code>@(_selectedQuote.DraftSha256[..12])</code></p>
                    @if (_selectedKind is VaultMutationKind.UpdateRecord or VaultMutationKind.UpdateFolder or
                        VaultMutationKind.DeleteRecord or VaultMutationKind.DeleteFolder)
                    {
                        <p class="terminal-alert warning" role="alert">
                            Experimental update/delete Sync is Testnet-only. The remote version is
                            checked before submission but Stellar does not enforce an atomic
                            version precondition; concurrent external changes remain possible.
                            Update/delete historical confirmation is not implemented.
                        </p>
                    }
                    <p class="terminal-alert warning" role="alert">
                        Submitting may spend real XLM. This action writes the local draft
                        to Stellar. Even if a transaction hash is returned, the queue will
                        remain Uncertain until independently verified reconciliation.
                        Update/delete historical confirmation is not yet available, so
                        those operations will remain quarantined after submission.
                        Never repeat an interrupted submission.
                    </p>
                    <label class="sv-biometric-choice">
                        <input type="checkbox" @bind="_explicitApproval" disabled="@_busy" />
                        I explicitly approve this single paid Stellar transaction, its maximum fee
                        and reserve, and understand the no-retry recovery rule.
                    </label>
                    @if (Networks.Network == "public")
                    {
                        <p class="terminal-alert warning" role="alert">MAINNET: This operation may spend real XLM and is not reversible.</p>
                        <label class="sv-biometric-choice">
                            <input type="checkbox" @bind="_mainnetApproved" disabled="@_busy" />
                            I understand this transaction will be submitted to STELLAR PUBLIC MAINNET.
                        </label>
                    }
                    <button type="button" class="pixel-button primary"
                            disabled="@(_busy || !_explicitApproval ||
                                (_selectedKind is VaultMutationKind.UpdateRecord or VaultMutationKind.UpdateFolder or
                                  VaultMutationKind.DeleteRecord or VaultMutationKind.DeleteFolder) && Networks.Network != "testnet" ||
                                (Networks.Network == "public" && !_mainnetApproved) || !Ledger.IsConnected)"
                            @onclick="PublishSelectedAsync">APPROVE AND SUBMIT ONE MUTATION</button>
                    <button type="button" class="pixel-button compact" disabled="@_busy"
                            @onclick="CancelApproval">CANCEL WITHOUT SUBMISSION</button>
                </section>
            }
            @foreach (var blocked in _report.Queue.Blocked)
            {
                <p class="terminal-alert warning" role="status">Blocked mutation @blocked.MutationId:
                    @string.Join(", ", blocked.MissingDependencies.Concat(blocked.WaitingDependencies))</p>
            }
        }
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <p role="alert" class="terminal-alert warning">@_error</p>
        }
    }
</section>

@code {
    private VaultHybridSyncReviewService.Report? _report;
    private string? _error;
    private bool _busy;
    private IReadOnlyList<VaultPendingMutation> _unresolved = [];
    private VaultSyncApprovalSnapshot? _selectedQuote;
    private string? _selectedTitle;
    private VaultMutationKind _selectedKind;
    private bool _explicitApproval;
    private bool _mainnetApproved;

    private void CancelApproval()
    {
        _selectedQuote = null;
        _selectedTitle = null;
        _explicitApproval = false;
        _mainnetApproved = false;
    }

    private async Task VerifyRecordedHashAsync(VaultPendingMutation mutation)
    {
        if (_busy || !Retention.AllowsLocalPersistence || !Sessions.IsUnlocked ||
            Sessions.ActiveAccountId != mutation.AccountId ||
            mutation.State is not (VaultSyncState.Uncertain or VaultSyncState.Submitting) ||
            mutation.TransactionHash is not { Length: 64 })
            return;
        CancelApproval();
        _busy = true;
        _error = null;
        _report = null;
        try
        {
            var network = Networks.CredentialKey(mutation.AccountId);
            if (network != mutation.NetworkId)
                throw new InvalidOperationException("Network mismatch.");
            var result = await PendingQueue.ReconcileAsync(
                mutation.AccountId, network, mutation.Id);
            _error = result.Confirmed
                ? "Historically verified transaction confirmed for this exact queued mutation. Review the remaining queue and its dependent drafts again."
                : "Transaction remains unresolved: " + result.Explanation +
                  " Do not retry or discard the draft automatically.";
            _unresolved = (await PendingQueue.ReviewAllAsync(mutation.AccountId, network))
                .Where(x => x.State is VaultSyncState.Submitting or VaultSyncState.Uncertain)
                .ToArray();
            _report = await HybridReview.ReviewAsync(mutation.AccountId, estimateFees: false);
        }
        catch (Exception)
        {
            _error = "Historical verification was unavailable or queue state changed. The original submission may have reached Stellar; do not retry.";
        }
        finally { _busy = false; }
    }

    private async Task SelectQuoteAsync(VaultHybridSyncReviewService.Item item)
    {
        CancelApproval();
        if (_busy || item.Quote is null || _report is null ||
            _report.Queue.NeedsReconciliation != 0 || _report.Queue.Conflicts != 0 ||
            !Sessions.IsUnlocked || Sessions.ActiveAccountId != _report.AccountId)
            return;
        _busy = true;
        _error = null;
        try
        {
            var canPublish = item.Kind is VaultMutationKind.CreateRecord or VaultMutationKind.CreateFolder
                ? await ManualSync.CanPublishApprovedCreateAsync(item.Quote, _report.AccountId)
                : await ManualSync.CanPublishApprovedRemoteMutationAsync(item.Quote, _report.AccountId);
            if (!canPublish)
            {
                _error = "Queue, signing root, network, remote inventory or fee estimate changed. Review again.";
                _report = null;
                return;
            }
            _selectedQuote = item.Quote;
            _selectedTitle = item.Title;
            _selectedKind = item.Kind;
        }
        catch (Exception)
        {
            _error = "Transaction eligibility could not be revalidated. No submission occurred.";
            _report = null;
        }
        finally { _busy = false; }
    }

    private async Task PublishSelectedAsync()
    {
        if (_busy || !_explicitApproval ||
            (Networks.Network == "public" && !_mainnetApproved) ||
            _selectedQuote is null ||
            _report is null || !Retention.AllowsLocalPersistence ||
            !Sessions.IsUnlocked || Sessions.ActiveAccountId != _report.AccountId)
            return;
        var quote = _selectedQuote;
        var account = _report.AccountId;
        CancelApproval(); // Checkbox is consumed even when validation rejects.
        _busy = true;
        _error = null;
        _report = null;
        try
        {
            // Shared Core coordinator repeats all approval checks, fee checks,
            // signed-root binding and durable CAS reservation. After reservation,
            // failure is ALWAYS an unknown outcome and must never be retried.
            var outcome = _selectedKind is VaultMutationKind.CreateRecord or VaultMutationKind.CreateFolder
                ? await ManualSync.PublishApprovedCreateAsync(
                    quote, account, explicitlyApproved: true)
                : await ManualSync.PublishApprovedRemoteMutationAsync(
                    quote, account, explicitlyApproved: true);
            _error = "SUBMISSION UNRESOLVED. Mutation " + outcome.MutationId +
                ". Transaction hash: " + (outcome.TransactionHash ?? "NOT RECORDED") +
                ". " + outcome.Message +
                " Do not resubmit. Investigate and reconcile before any other Sync.";
        }
        catch (Exception)
        {
            // Could have failed AFTER durable reservation or broadcast. Never
            // label as a failed transaction or offer a retry shortcut.
            _error = "Submission could not be completed or verified. The mutation may already have reached Stellar. Inspect the durable queue and ledger; DO NOT RETRY.";
        }
        finally { _busy = false; }
    }


    private Task ReviewAsync() => LoadAsync(false);
    private Task EstimateAsync() => LoadAsync(true);

    private async Task LoadAsync(bool costs)
    {
        if (_busy || !Retention.AllowsLocalPersistence ||
            !Sessions.IsUnlocked || Sessions.ActiveAccountId is not string account)
            return;
        CancelApproval();
        _busy = true;
        _error = null;
        _report = null;
        _unresolved = [];
        try
        {
            _report = await HybridReview.ReviewAsync(account, costs);
            _unresolved = (await PendingQueue.ReviewAllAsync(account,
                _report.NetworkId)).Where(x =>
                    x.State is VaultSyncState.Submitting or VaultSyncState.Uncertain).ToArray();
            if (!Sessions.IsUnlocked || Sessions.ActiveAccountId != account)
            {
                _report = null;
                _error = "Local vault session changed during review. Unlock and review again.";
            }
        }
        catch (Exception)
        {
            _error = "Hybrid queue review is unavailable. No transaction was sent.";
        }
        finally { _busy = false; }
    }
}
