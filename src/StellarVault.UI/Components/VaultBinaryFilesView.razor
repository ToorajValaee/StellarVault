@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using StellarVault.Core.Services
@inject VaultBinaryWorkspace Files
@inject VaultRecordWorkspace Records
@inject IJSRuntime JS
@implements IDisposable

<section class="form-page" aria-label="Encrypted file records">
    <header class="page-command-header">
        <div>
            <div class="panel-kicker">WRITE OPERATION // LOCAL ENCRYPTED FILE</div>
            <h2>ADD FILE</h2>
            <p class="page-subtitle">Encrypt files in the browser vault. Ledger file publishing is not connected yet.</p>
        </div>
        <button class="pixel-button compact" type="button" disabled="@_busy" @onclick="RefreshFilesAsync">REFRESH FILES</button>
    </header>
    <div class="terminal-panel credential-form">
        <div class="form-section-title"><span>01</span> FILE SELECTION</div>
        <p class="advanced-help">Current browser implementation supports files up to 1 MiB. Larger files and on-chain chunking are still pending.</p>
        <InputFile OnChange="SelectFile" disabled="@_busy" />
        <label class="terminal-label" for="sv-file-record-name">FILE RECORD NAME *</label>
        <input id="sv-file-record-name" class="terminal-input" maxlength="512" @bind="_name"
               @bind:event="oninput" disabled="@_busy" placeholder="Encrypted file name" />
        <div class="commit-preview">
            <span>MODE</span><strong>LOCAL ENCRYPTED FILE</strong>
            <span>STORAGE</span><strong>BROWSER INDEXEDDB — NOT LEDGER</strong>
        </div>
        <button class="pixel-button primary" type="button"
                disabled="@(_busy || _file is null || string.IsNullOrWhiteSpace(_name))"
                @onclick="UploadAsync">@(_busy ? "PROCESSING..." : "SAVE ENCRYPTED FILE")</button>
        <div class="form-section-title"><span>02</span> RETRIEVE / REMOVE</div>
        <label class="terminal-label" for="sv-file-open-name">EXISTING FILE RECORD</label>
        <input id="sv-file-open-name" class="terminal-input" maxlength="512" @bind="_openName"
               @bind:event="oninput" disabled="@_busy" />
        <div class="sv-access-actions">
            <button class="pixel-button compact" type="button"
                    disabled="@(_busy || string.IsNullOrWhiteSpace(_openName))"
                    @onclick="DownloadAsync">DOWNLOAD AND DECRYPT</button>
            <label class="terminal-label"><input type="checkbox" @bind="_confirmRemoval" disabled="@_busy" /> CONFIRM REMOVAL</label>
            <button class="pixel-button compact" type="button"
                    disabled="@(_busy || !_confirmRemoval || string.IsNullOrWhiteSpace(_openName))"
                    @onclick="RemoveAsync">REMOVE FILE</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(_status))
        {
            <div class="terminal-alert" role="status"><strong>FILE STATUS</strong><span>@_status</span></div>
        }
    </div>
    <section class="terminal-panel">
        <div class="panel-kicker">STORED FILES</div>
        <h3>FILE DIRECTORY</h3>
        @if (_files is null)
        {
            <p class="advanced-help">File directory unavailable.</p>
        }
        else if (_files.Count == 0)
        {
            <p class="advanced-help">No encrypted files yet.</p>
        }
        else
        {
            <ul class="sv-record-directory">
                @foreach (var item in _files)
                {
                    <li><button class="pixel-button compact" type="button" disabled="@_busy"
                                @onclick="() => SelectStoredFile(item.Name)">@item.Name</button></li>
                }
            </ul>
        }
    </section>
</section>

@code {
    private const long MaximumFileLength = 1024 * 1024;
    private IBrowserFile? _file;
    private IReadOnlyList<VaultRecordWorkspace.RecordSummary>? _files;

    protected override async Task OnInitializedAsync() => await RefreshFilesAsync();

    private void SelectStoredFile(string name)
    {
        _openName = name;
        _confirmRemoval = false;
    }

    private async Task RefreshFilesAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var entries = await Records.ListAsync();
            _files = entries.Where(e => e.ContentType is not null &&
                !e.ContentType.StartsWith("text/plain", StringComparison.OrdinalIgnoreCase))
                .OrderBy(e => e.Name, StringComparer.Ordinal).ToArray();
        }
        catch (Exception ex) when (ex is InvalidOperationException or InvalidDataException or IOException or
                                    System.Security.Cryptography.CryptographicException or JSException or OperationCanceledException)
        {
            _status = "Unable to load encrypted file names. Reopen the vault and try again.";
        }
        finally { _busy = false; }
    }
    private string _name = string.Empty;
    private string _openName = string.Empty;
    private string? _status;
    private bool _busy;
    private bool _confirmRemoval;

    private void SelectFile(InputFileChangeEventArgs args)
    {
        _file = args.File;
        _name = _file.Name;
        _status = _file.Size > MaximumFileLength ? "File exceeds the current 1 MiB upload limit." : null;
    }

    private async Task UploadAsync()
    {
        if (_busy || _file is null) return;
        _busy = true;
        try
        {
            if (_file.Size > MaximumFileLength) throw new InvalidDataException("File too large.");
            // Use create-only semantics; existing record updates require explicit version handling.
            await using var input = _file.OpenReadStream(MaximumFileLength);
            await Files.SaveAsync(_name, input,
                string.IsNullOrWhiteSpace(_file.ContentType) ? "application/octet-stream" : _file.ContentType);
            _openName = _name;
            _status = "Encrypted file saved.";
            // The listing is refreshed after _busy has been cleared in finally.
        }
        catch (Exception ex) when (ex is InvalidDataException or ArgumentException or InvalidOperationException
                                    or IOException or System.Security.Cryptography.CryptographicException
                                    or JSException or OperationCanceledException)
        {
            _status = "File could not be saved. Verify name, size and session state.";
        }
        finally { _busy = false; }
        if (_status == "Encrypted file saved.") await RefreshFilesAsync();
    }

    private async Task DownloadAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            using var record = await Files.OpenAsync(_openName);
            if (record is null) { _status = "File record not found."; return; }
            if (record.Content.Length > MaximumFileLength)
                throw new InvalidDataException("File exceeds current download limit.");
            byte[] temporaryDownload = record.Content.ToArray();
            try
            {
                await JS.InvokeVoidAsync("stellarVaultV2Download.save", _openName, temporaryDownload);
            }
            finally
            {
                System.Security.Cryptography.CryptographicOperations.ZeroMemory(temporaryDownload);
            }
            _status = "Decrypted file downloaded.";
        }
        catch (Exception ex) when (ex is InvalidDataException or ArgumentException or InvalidOperationException
                                    or IOException or System.Security.Cryptography.CryptographicException
                                    or JSException or OperationCanceledException)
        {
            _status = "File could not be downloaded or authenticated.";
        }
        finally { _busy = false; }
    }

    private async Task RemoveAsync()
    {
        if (_busy || !_confirmRemoval || string.IsNullOrWhiteSpace(_openName)) return;
        _busy = true;
        try
        {
            // A catalog/version lookup is enough for logical removal.
            // Do not decrypt and allocate an entire file just to remove its listing.
            var version = await Files.GetFileVersionAsync(_openName);
            if (version is null)
            {
                _status = "File not found in the active catalog.";
                return;
            }
            await Files.DeleteAsync(_openName, version);
            _status = "File removed from the catalog. Historical ciphertext may remain in storage.";
            _openName = string.Empty;
            _confirmRemoval = false;
        }
        catch (Exception ex) when (ex is InvalidDataException or ArgumentException or InvalidOperationException
                                    or IOException or System.Security.Cryptography.CryptographicException
                                    or JSException or OperationCanceledException)
        {
            _status = "Removal failed or the file changed. Refresh the list and retry.";
            _confirmRemoval = false;
        }
        finally { _busy = false; }
        if (_status?.StartsWith("File removed from the catalog.", StringComparison.Ordinal) == true)
            await RefreshFilesAsync();
    }

    public void Dispose() => _file = null;
}
