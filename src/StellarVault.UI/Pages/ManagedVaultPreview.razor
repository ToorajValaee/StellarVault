@page "/vault-v2-preview"
@using StellarVault.UI.Components
@using StellarVault.Core.Services
@inject VaultSessionManager Sessions

<PageTitle>New Vault Architecture — Preview</PageTitle>
<section class="terminal-panel">
    <h1>Vault v2 — browser integration</h1>
    <p>This is the isolated preview of the shared .NET 10 vault-session architecture.
       Existing legacy vault records and unlock mechanisms are unchanged.</p>
    <ManagedVaultSessionStatus />
    <p>Create and unlock remain unavailable here until a vetted wallet-signing bridge,
       ownership verification, and persistent browser credential/object storage are integrated.</p>
    <p>No passwords or secrets should be entered into this preview.</p>
</section>
