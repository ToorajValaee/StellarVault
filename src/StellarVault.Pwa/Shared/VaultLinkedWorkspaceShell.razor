@using StellarVault.Core.Services
@inject IStellarSecretKeyLedger SecretLedger
@inject VaultNetworkSelection Networks

@* Identical application shell and navigation to the HD /vault route.
   The embedded workspace keeps its own S-key signer, ledger and local queue;
   changing views NEVER changes credential or account strategy. *@
<div class="sv-pwa-app" aria-label="StellarVault application">
    <nav class="sv-pwa-rail" aria-label="Vault navigation">
        <div class="sv-pwa-rail-heading">
            <span class="sv-pwa-rail-mark sv-rail-shield" aria-hidden="true">✦</span>
            <span><strong>StellarVault</strong></span>
        </div>
        <button type="button" class="@(_view == "records" ? "selected" : "")"
                aria-current="@(_view == "records" ? "page" : null)"
                @onclick='() => SelectView("records")'><span aria-hidden="true">▣</span> Vault</button>
        <button type="button" class="@(_view == "drafts" ? "selected" : "")"
                aria-current="@(_view == "drafts" ? "page" : null)"
                @onclick='() => SelectView("drafts")'><span aria-hidden="true">▧</span> Drafts</button>
        <button type="button" class="@(_view == "sync" ? "selected" : "")"
                aria-current="@(_view == "sync" ? "page" : null)"
                @onclick='() => SelectView("sync")'><span aria-hidden="true">⇅</span> Sync</button>
        <button type="button" class="@(_view == "settings" ? "selected" : "")"
                aria-current="@(_view == "settings" ? "page" : null)"
                @onclick='() => SelectView("settings")'><span aria-hidden="true">⚙</span> Settings</button>
        <button type="button" class="sv-rail-link sv-inline-help-nav @(_view == "help" ? "selected" : "")"
                aria-current="@(_view == "help" ? "page" : null)"
                @onclick='() => SelectView("help")'><span aria-hidden="true">ⓘ</span> Documentation &amp; Help</button>
        <div class="sv-pwa-rail-divider"></div>
        <div class="sv-sidebar-network">
            <span class="sv-sidebar-network-label">Stellar network</span>
            <div class="sv-sidebar-connected"><span aria-hidden="true">●</span> Connected</div>
            <p>@(Networks.SelectedPreset == "public" ? "Mainnet" : Networks.SelectedPreset == "custom" ? "Custom network" : "Testnet") · Independent Secret Key account chain</p>
        </div>
        <div class="sv-rail-trust">
            <a href="https://github.com/ToorajValaee/StellarVault" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌘</span> View source on GitHub <span aria-hidden="true">↗</span></a>
        </div>
        <div class="sv-pwa-rail-foot"><span class="sv-pwa-led connected"></span>Stellar connected</div>
        <div class="sv-rail-attribution">Powered by <a href="https://badje.ir/" target="_blank" rel="noopener noreferrer">badje.ir</a></div>
    </nav>
    <main class="sv-pwa-stage" id="sv-pwa-workspace" tabindex="-1">
        <section class="vault-page sv-pwa-vault-page sv-linked-unified-workspace">
            <header class="sv-pwa-screen-header">
                <div>
                    <h1>@(_view == "records" ? "Vault" : _view == "drafts" ? "Drafts" : _view == "sync" ? "Sync" : _view == "settings" ? "Settings" : "Documentation & Help")</h1>
                    @if (_view == "records")
                    {
                        <p class="sv-vault-subtitle">Your secure records, organized and always in your control.</p>
                    }
                </div>
                <div class="sv-pwa-screen-tools">
                    <button type="button" class="pixel-button compact"
                            @onclick="LockAsync">Lock</button>
                </div>
            </header>
            <div hidden="@(_view == "help")">
                <VaultSecretKeyWorkspace Embedded="true"
                                         View="@(_view == "help" ? "records" : _view)"
                                         OnViewChange="SelectView"
                                         @ref="_workspace" />
            </div>
            @if (_view == "help")
            {
                <VaultHelpContent />
            }
        </section>
        <nav class="sv-pwa-mobile-tabs" aria-label="Mobile vault navigation">
            <button type="button" class="@(_view == "records" ? "selected" : "")"
                    @onclick='() => SelectView("records")'>Vault</button>
            <button type="button" class="@(_view == "drafts" ? "selected" : "")"
                    @onclick='() => SelectView("drafts")'>Drafts</button>
            <button type="button" class="@(_view == "sync" ? "selected" : "")"
                    @onclick='() => SelectView("sync")'>Sync</button>
            <button type="button" class="@(_view == "settings" ? "selected" : "")"
                    @onclick='() => SelectView("settings")'>Settings</button>
        </nav>
    </main>
</div>

@code {
    private string _view = "records";
    private VaultSecretKeyWorkspace? _workspace;

    private void SelectView(string view)
    {
        if (view is "records" or "drafts" or "sync" or "settings" or "help")
            _view = view;
    }

    private async Task LockAsync()
    {
        if (_workspace is not null) await _workspace.LockFromShellAsync();
    }
}
