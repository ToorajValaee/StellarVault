@using StellarVault.Core.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@using System.Security.Cryptography
@using StellarVault.Pwa.Services
@implements IDisposable
@inject IStellarLedgerRecords Ledger
@inject VaultHybridDraftWorkspace HybridDrafts
@inject VaultSessionManager Sessions
@inject VaultDeviceRetentionGate Retention
@inject VaultPendingMutationQueue PendingQueue
@inject VaultNetworkSelection Networks
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS

<div class="sv-editor-host @(Embedded ? "sv-editor-embedded" : "")">
<AdaptiveShell PlatformName="WEB PWA" Subtitle="YOUR VAULT" Embedded="@Embedded">
@if (!Sessions.IsUnlocked && !Ledger.IsConnected)
{
    <section class="terminal-panel centered-message"><h1>DATABASE LOCKED</h1><a class="pixel-button primary" href="/">OPEN ACCESS TERMINAL</a></section>
}
else
{
    <div class="@(Embedded ? "sv-inline-editor-layout" : "sv-pwa-app sv-pwa-secondary-app")">
        @if (!Embedded)
        {
            <nav class="sv-pwa-rail" aria-label="Vault navigation">
                <a class="sv-pwa-rail-action" href="/vault"><span aria-hidden="true">▤</span> Vault</a>
                <div class="sv-pwa-rail-divider"></div>
                <div class="sv-pwa-rail-foot">Encrypted vault workspace</div>
            </nav>
        }
        <div class="@(Embedded ? "sv-inline-editor-stage" : "sv-pwa-stage sv-pwa-secondary-stage")">
    <section class="form-page sv-pwa-editor">
        <nav class="sv-pwa-editor-breadcrumb" aria-label="Edit workflow navigation">
            @if (Embedded) { <button type="button" class="sv-inline-back" @onclick="CancelEmbeddedEditor">← Back to vault</button> }
            else { <a href="@ReturnUrl">← Back to vault</a> }
            <span aria-hidden="true">/</span>
            <span>@(!string.IsNullOrWhiteSpace(RecordId) ? "Edit item" : "New " + (_kind == "folder" ? "folder" : _kind == "file" ? "file" : "record"))</span>
        </nav>
        <header class="page-command-header sv-pwa-editor-heading">
            <div><h1>@(!string.IsNullOrWhiteSpace(RecordId) ? "Edit record" : _kind == "folder" ? "New folder" : _kind == "file" ? "Add file" : "New record")</h1></div>
        </header>
        @if (string.IsNullOrWhiteSpace(RecordId))
        {
            <nav class="sv-pwa-editor-modes" aria-label="Choose the type of item">
                @if (Embedded) { <button type="button" class="@(_kind == "record" ? "selected" : "")" @onclick='() => SelectEmbeddedKind("record")'>▤ Record</button> }
                else { <a class="@(_kind == "record" ? "selected" : "")" href="/add" aria-current="@(_kind == "record" ? "page" : null)">▤ Record</a> }
                @if (Embedded) { <button type="button" class="@(_kind == "folder" ? "selected" : "")" @onclick='() => SelectEmbeddedKind("folder")'>▣ Folder</button> }
                else { <a class="@(_kind == "folder" ? "selected" : "")" href="/add?kind=folder" aria-current="@(_kind == "folder" ? "page" : null)">▣ Folder</a> }
                @if (Embedded) { <button type="button" class="@(_kind == "file" ? "selected" : "")" @onclick='() => SelectEmbeddedKind("file")'>⇧ File</button> }
                else { <a class="@(_kind == "file" ? "selected" : "")" href="/add?kind=file" aria-current="@(_kind == "file" ? "page" : null)">⇧ File</a> }
            </nav>
        }
        @if (_loading) { <div class="terminal-alert" role="status" aria-live="polite"><span class="sv-loading-spinner" aria-hidden="true"></span> LOADING RECORD AND FOLDERS...</div> }
        @if (_kind == "file")
        {
            <div class="terminal-panel credential-form">
                <div class="form-section-title">Choose file</div>
                <label class="terminal-label" for="sv-ledger-file">FILE *</label>
                <div class="sv-file-picker">
                    <label class="pixel-button compact sv-file-picker-button" for="sv-ledger-file">+ CHOOSE FILE</label>
                    <span class="sv-file-picked-name">@(_selectedHdFile is null ? "NO FILE SELECTED" : _fileOriginalName)</span>
                    <InputFile id="sv-ledger-file" class="sv-file-native-input sv-ledger-file-native-input" OnChange="SelectLedgerFileAsync" disabled="@(_busy || _loading)" />
                </div>
                <p class="advanced-help">Files of any logical length are streamed into the encrypted local HD queue as independently reviewable SVTREE3 records. No transaction is sent until you approve each Sync entry. This requires explicit encrypted local-storage consent, and large files may require substantial Stellar fees, reserves and time.</p>
                @if (_selectedHdFile is not null) { <p class="advanced-help">SELECTED: @_fileOriginalName (@_selectedHdFile.Size bytes)</p> }
                @if (!Retention.AllowsLocalPersistence || !Sessions.IsUnlocked) { <p class="terminal-alert warning">Unlock encrypted local storage and grant local retention consent before staging a resumable on-chain file.</p> }
                <label class="terminal-label" for="sv-ledger-file-title">FILE RECORD NAME *</label>
                <input id="sv-ledger-file-title" class="terminal-input" maxlength="256" @bind="_title" @bind:event="oninput" disabled="@(_busy || _loading)" />
                <details class="sv-access-learn"><summary>About file publishing</summary><p>Files are encrypted and published to Stellar. Each transaction needs your approval and may incur fees in the network's native asset.</p></details>
                @if (!string.IsNullOrWhiteSpace(_status)) { <div class="terminal-alert" role="status"><strong>FILE STATUS</strong><span>@_status</span></div> }
                @if (_busy) { <p role="status"><span class="sv-loading-spinner"></span> @_status</p> }
                <button class="pixel-button primary access-button" type="button" disabled="@(_busy || _loading || !Sessions.IsUnlocked || !Retention.AllowsLocalPersistence || _selectedHdFile is null || string.IsNullOrWhiteSpace(_title))" @onclick="StageHdTreeFileAsync">STAGE ENCRYPTED FILE FOR SYNC</button>
                 
            </div>
        }
        else
        {
            <div class="terminal-panel credential-form">
                <div class="form-section-title">Details</div>
                <label class="terminal-label" for="sv-title">TITLE *</label>
                <input id="sv-title" class="terminal-input" @bind="_title" @bind:event="oninput" autocomplete="off" maxlength="256"/>
                <label class="terminal-label" for="sv-folder">FOLDER</label>
                <select id="sv-folder" class="terminal-input" @bind="_folder">
                    <option value="">Unfiled</option>
                    @foreach (var folder in AvailableFolders.OrderBy(f => FolderPath(f.Id), StringComparer.OrdinalIgnoreCase)) { <option value="@folder.Id">@FolderPath(folder.Id)</option> }
                </select>
                <p class="advanced-help">Move to any nested folder, or choose Unfiled for the vault root.</p>
                @if (_kind != "folder")
                {
                    <label class="terminal-label">USERNAME / IDENTIFIER</label>
                    <input class="terminal-input" @bind="_username" autocomplete="off"/>
                    <label class="terminal-label">URL</label>
                    <input class="terminal-input" type="url" @bind="_url" autocomplete="off"/>
                    <div class="form-section-title"><span>02</span> SECRET PAYLOAD</div>
                    <label class="terminal-label">SECRET / PASSWORD *</label>
                    <input class="terminal-input" type="@(_showSecret ? "text" : "password")" @bind="_secret" autocomplete="new-password"/>
                    <button type="button" class="pixel-button compact" @onclick="() => _showSecret = !_showSecret">@(_showSecret ? "HIDE" : "SHOW")</button>
                    <label class="terminal-label">NOTES</label>
                    <textarea class="terminal-input terminal-textarea" rows="4" @bind="_notes"></textarea>
                    <label class="terminal-label">TAGS // COMMA SEPARATED</label>
                    <input class="terminal-input" @bind="_tags" placeholder="work, infrastructure, private"/>
                }
                @if (!string.IsNullOrWhiteSpace(_status)) { <div class="terminal-alert" role="status"><strong>COMMIT STATUS</strong><span>@_status</span></div> }
                @if (_busy) { <p role="status"><span class="sv-loading-spinner"></span> @_status</p> }
                <button class="pixel-button primary access-button" type="button" disabled="@(_busy || _loading || !Ledger.IsConnected || string.IsNullOrWhiteSpace(_title) || (_kind != "folder" && string.IsNullOrWhiteSpace(_secret)))" @onclick="ReviewAsync">REVIEW AND APPROVE</button>
                @if (CanSaveOffline) { <button class="pixel-button compact" type="button" disabled="@(_busy || _loading || string.IsNullOrWhiteSpace(_title) || (_kind != "folder" && string.IsNullOrWhiteSpace(_secret)))" @onclick="SaveOfflineDraftAsync">SAVE ENCRYPTED LOCAL DRAFT</button> }
            </div>
        }
    </section>
        </div>
    </div>
    <LedgerCostApprovalModal Open="@(_estimate is not null)" Estimate="_estimate" Title="APPROVE LEDGER WRITE" Busy="_busy" OnConfirm="CommitAsync" OnCancel="CancelReview" />
}
</AdaptiveShell>
</div>

@code {
    [Parameter] public bool Embedded { get; set; }
    public bool BlocksDismissal => _busy || _estimate is not null;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnDraftSaved { get; set; }
    [Parameter] public IReadOnlyList<LedgerRecordItem>? CachedFolders { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string? RecordId { get; set; }
    [Parameter] public string? InitialFolder { get; set; }
    [Parameter] public string? Kind { get; set; }
    private string _kind => _editingFolder ? "folder" : Kind is "folder" or "file" ? Kind : "record";
    private bool _editingFolder;
    private string? _loadedId;
    private string _title = "", _secret = "", _username = "", _url = "", _notes = "", _tags = "";
    private string _folder = "";
    private bool _showSecret, _busy;
    private IBrowserFile? _selectedHdFile;
    private string _fileOriginalName = "";
    private string _fileContentType = "application/octet-stream";
    private Task SelectLedgerFileAsync(InputFileChangeEventArgs args)
    {
        _status = null;
        _estimate = null;
        _reviewedDraft = null;

        _selectedHdFile = null;
        var file = args.File;
        try
        {
            LedgerFileProtocol.ValidateName(file.Name);
            _fileOriginalName = file.Name;
            _fileContentType = string.IsNullOrWhiteSpace(file.ContentType)
                ? "application/octet-stream" : file.ContentType;
            _title = file.Name.Length > 256 ? file.Name[..256] : file.Name;
            _selectedHdFile = file;
        }
        catch (Exception)
        {
            _status = "Invalid file name or content type. No data was staged.";
        }
        return Task.CompletedTask;
    }

    private async Task StageHdTreeFileAsync()
    {
        if (_busy || _loading || _selectedHdFile is not { } selected ||
            !Sessions.IsUnlocked || !Retention.AllowsLocalPersistence ||
            string.IsNullOrWhiteSpace(_title))
            return;
        _busy = true;
        _status = "STREAMING FILE TO ENCRYPTED LOCAL SYNC QUEUE...";
        try
        {
            await using var input = selected.OpenReadStream(selected.Size);
            var staged = await HybridDrafts.StageTreeFileAsync(
                _title, selected.Name, _fileContentType, input,
                string.IsNullOrWhiteSpace(_folder) ? null : _folder);
            _selectedHdFile = null;
            _status = "Staged " + staged.NodeCount +
                " encrypted file-tree records. Open Sync to review and approve each transaction; root " +
                staged.RootId + " is published last. No transaction was submitted.";
            await CompleteEditorAsync(savedLocally: true);
        }
        catch (Exception ex)
        {
            _status = "File staging failed. Inspect the encrypted local queue before retrying. " +
                ex.GetType().Name + ". No network transaction was sent.";
        }
        finally { _busy = false; }
    }

    private bool _loading;
    private bool _newEditorInitialized;
    private LedgerCostPreview? _estimate;
    private LedgerRecordDraft? _reviewedDraft;
    private string? _reviewedRecordId;
    private string ReturnUrl => string.IsNullOrEmpty(_folder) ? "/vault" : "/vault?folder=" + Uri.EscapeDataString(_folder);
    private async Task CompleteEditorAsync(bool savedLocally = false)
    {
        if (Embedded)
        {
            if (savedLocally) await OnDraftSaved.InvokeAsync();
            else await OnSaved.InvokeAsync();
        }
        else Nav.NavigateTo(ReturnUrl);
    }
    private async Task CancelEmbeddedEditor()
    {
        if (BlocksDismissal)
        {
            _status = "Finish or cancel the current approval, or reconcile the uncertain file stage before closing.";
            return;
        }
        await OnCancel.InvokeAsync();
    }
    private void SelectEmbeddedKind(string kind)
    {
        if (BlocksDismissal || kind is not ("record" or "folder" or "file")) return;
        Kind = kind;
        _estimate = null;
        _status = null;
        _selectedHdFile = null;
    }
    private string? _status;
    private IReadOnlyList<LedgerRecordItem> _folders = [];
    private IEnumerable<LedgerRecordItem> AvailableFolders =>
        _folders.Where(f => !(_editingFolder && (f.Id == RecordId || IsDescendantOf(f.Id, RecordId))));
    private bool IsDescendantOf(string id, string? ancestorId) {
        var visited = new HashSet<string>(StringComparer.Ordinal);
        while (visited.Add(id)) {
            var current = _folders.FirstOrDefault(f => f.Id == id);
            if (current?.FolderId is null) return false;
            if (current.FolderId == ancestorId) return true;
            id = current.FolderId;
        }
        return true;
    }
    private string FolderPath(string id) {
        var names = new List<string>();
        var visited = new HashSet<string>(StringComparer.Ordinal);
        while (visited.Add(id)) {
            var folder = _folders.FirstOrDefault(f => f.Id == id);
            if (folder is null) break;
            names.Insert(0, folder.Title);
            if (folder.FolderId is null) break;
            id = folder.FolderId;
        }
        return "MY VAULT / " + string.Join(" / ", names);
    }
    protected override async Task OnParametersSetAsync() {
        // Creating an encrypted local draft is an offline operation. Never
        // discover ledger account indices just to populate its folder picker.
        // The parent view can provide its last verified folder snapshot.
        if (string.IsNullOrWhiteSpace(RecordId))
        {
            if (!_newEditorInitialized)
            {
                _folder = InitialFolder ?? "";
                _newEditorInitialized = true;
            }
            _folders = CachedFolders ?? [];
            _loading = false;
            return;
        }
        if (!Ledger.IsConnected)
        {
            _status = "Editing a published record requires a Stellar connection. You can create a new encrypted local draft while offline.";
            return;
        }
        _loading = true;
        try {
            var all = await Ledger.ReadAsync();
            _folders = all.Where(x => x.IsFolder).ToArray();
            if (!string.IsNullOrWhiteSpace(RecordId)) {
                if (_loadedId == RecordId) return;
                var current = all.SingleOrDefault(x => x.Id == RecordId)
                    ?? throw new InvalidOperationException("Record not found on the Stellar ledger.");
                _loadedId = RecordId;
                _editingFolder = current.IsFolder;
                _title = current.Title;
                _secret = current.Content;
                _username = current.UserName ?? "";
                _url = current.Url ?? "";
                _notes = current.Notes ?? "";
                _tags = string.Join(", ", current.Tags ?? []);
                _folder = current.FolderId ?? "";
            }
            else _folder = InitialFolder ?? "";
        }
        catch (Exception ex) {
            _status = IsHorizonUnavailable(ex)
                ? "Stellar is offline. Published records cannot be loaded for editing. You can create a new encrypted local draft without a network connection."
                : "Published record could not be loaded. Try again after checking the selected network.";
        }
        finally { _loading = false; }
    }
    private LedgerRecordDraft Draft() {
        if (_kind == "file")
            throw new InvalidOperationException("Use the streamed encrypted file staging flow.");
        var tags = _tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
        return new LedgerRecordDraft(_title, _kind == "folder" ? "folder" : _secret,
            string.IsNullOrWhiteSpace(_folder) ? null : _folder, tags, _kind == "folder", _username, _url, _notes);
    }
    private async Task ReviewAsync()
    {
        if (_busy || !Ledger.IsConnected || _kind == "file") return;
        _busy = true;
        _status = "CALCULATING LEDGER COST...";
        try
        {
            _reviewedDraft = Draft();
            _reviewedRecordId = RecordId;
            _estimate = await Ledger.EstimateAsync(_reviewedDraft, RecordId);
            if (_estimate is not null) _status = null;
        }
        catch (Exception ex)
        {
            _estimate = null;
            _status = IsHorizonUnavailable(ex)
                ? "Stellar is unreachable. No transaction was sent. To keep these changes offline, select Save encrypted local draft."
                : "Ledger cost could not be estimated. No transaction was sent; review the record and retry.";
        }
        finally { _busy = false; }
    }

    public void Dispose() => _selectedHdFile = null;

    private static bool IsHorizonUnavailable(Exception ex) =>
        ex is HttpRequestException ||
        ex.Message.Contains("Failed to fetch", StringComparison.OrdinalIgnoreCase) ||
        ex.Message.Contains("NetworkError", StringComparison.OrdinalIgnoreCase);

    private bool CanSaveOffline => Retention.AllowsLocalPersistence &&
        Sessions.IsUnlocked && Sessions.ActiveAccountId is not null;

    private async Task SaveOfflineDraftAsync()
    {
        if (_busy || _loading || !CanSaveOffline || _kind == "file") return;
        _busy = true;
        _estimate = null;
        bool saved = false;
        try
        {
            if (string.IsNullOrWhiteSpace(_title) ||
                (_kind != "folder" && _kind != "file" && string.IsNullOrWhiteSpace(_secret)))
                throw new InvalidOperationException("Provide the required record fields first.");
            var account = Sessions.ActiveAccountId
                ?? throw new InvalidOperationException("Unlock the local vault first.");
            var payload = JsonSerializer.SerializeToUtf8Bytes(Draft());
            try
            {
                var kind = _kind switch {
                    "folder" => RecordId is null ? VaultMutationKind.CreateFolder : VaultMutationKind.UpdateFolder,
                    _ => RecordId is null ? VaultMutationKind.CreateRecord : VaultMutationKind.UpdateRecord
                };
                var mutation = VaultPendingMutation.Create(account,
                    Networks.CredentialKey(account), kind, RecordId ?? Guid.NewGuid().ToString("N")[..16],
                    payload, expectedRemoteVersion: RecordId is null ? null : "requires-remote-reconciliation");
                await PendingQueue.EnqueueAsync(mutation);
                saved = true;
                _status = "Encrypted draft saved on this device. It has not been submitted to Stellar.";
            }
            finally { CryptographicOperations.ZeroMemory(payload); }
        }
        catch (Exception ex)
        {
            _status = "Local draft could not be saved: " + ex.Message;
        }
        finally { _busy = false; }

        if (!saved) return;
        try
        {
            // A successful local commit must not be reported as failed if
            // subsequent navigation or a background queue refresh fails.
            await CompleteEditorAsync(savedLocally: true);
        }
        catch
        {
            _status = "Encrypted draft saved on this device. Open Drafts to review it; the view could not refresh.";
        }
    }

    private static bool SameDraft(LedgerRecordDraft x, LedgerRecordDraft y) =>
        x.Title == y.Title && x.Content == y.Content && x.FolderId == y.FolderId &&
        x.IsFolder == y.IsFolder && x.UserName == y.UserName && x.Url == y.Url &&
        x.Notes == y.Notes && (x.Tags ?? []).SequenceEqual(y.Tags ?? []);
    private void CancelReview() { if (!_busy) { _estimate = null; _reviewedDraft = null; } }
    private async Task CommitAsync()
    {
        if (_busy || _kind == "file" || _estimate is null ||
            !Ledger.IsConnected || _reviewedDraft is null) return;
        if (_reviewedRecordId != RecordId || !SameDraft(_reviewedDraft, Draft()))
        {
            _estimate = null;
            _status = "Record changed; review costs again.";
            return;
        }
        _busy = true;
        _status = "SIGNING AND SUBMITTING TO STELLAR...";
        try
        {
            var draft = Draft();
            if (!string.IsNullOrWhiteSpace(RecordId))
            {
                var result = await Ledger.UpdateAsync(RecordId, draft);
                _status = "UPDATED TX: " + result.TransactionHash + " " + result.Warning;
            }
            else
            {
                var hash = await Ledger.PublishDetailedAsync(draft);
                _status = "COMMITTED TX: " + hash;
            }
            await CompleteEditorAsync();
        }
        catch (Exception ex) { _status = "Ledger commit failed: " + ex.Message; }
        finally { _busy = false; }
    }

}
