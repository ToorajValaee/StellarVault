@page "/"
@using StellarVault.Core.Services
@inject VaultSessionManager Sessions
@inject IStellarLedgerRecords Ledger
@inject NavigationManager Navigation

@if (!(Sessions.IsUnlocked || Ledger.IsConnected))
{
    <VaultHome Platform="WEB PWA" />
}

@code {
    protected override void OnParametersSet()
    {
        if (Sessions.IsUnlocked || Ledger.IsConnected)
            Navigation.NavigateTo("/vault", replace: true);
    }
}
