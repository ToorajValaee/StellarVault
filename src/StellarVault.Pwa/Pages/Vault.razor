@code {
    private int FolderDepth(string id)
    {
        var visited = new HashSet<string>(StringComparer.Ordinal);
        var depth = 0;
        var current = Folders.FirstOrDefault(x => x.Id == id);
        while (current is not null && current.FolderId is { Length: > 0 } parent &&
               visited.Add(current.Id) && depth < 12)
        {
            depth++;
            current = Folders.FirstOrDefault(x => x.Id == parent);
        }
        return depth;
    }

    private string _appView = "records";
    private string _syncTask = "review";
    private void SelectAppView(string view)
    {
        if (view is not ("records" or "drafts" or "sync")) return;
        if (view != "records" && (!Retention.AllowsLocalPersistence || !Sessions.IsUnlocked)) return;
        _appView = view;
        if (view == "sync") _ = InvokeAsync(LoadPendingAsync);
    }

    private string? _pendingFileStatus;
    private async Task DownloadPendingFileAsync()
    {
        if (_selectedPending is not { Kind: VaultMutationKind.UploadFile } item) return;
        byte[]? data = null;
        try
        {
            var draft = JsonSerializer.Deserialize<LedgerRecordDraft>(item.EncryptedPayload)
                ?? throw new InvalidDataException("Local file draft is invalid.");
            if (!draft.Content.StartsWith(StellarLedgerFileProtocol.SinglePrefix, StringComparison.Ordinal))
                throw new InvalidDataException("Unsupported local file draft format.");
            var file = JsonSerializer.Deserialize<StellarLedgerFileProtocol.Single>(
                draft.Content[StellarLedgerFileProtocol.SinglePrefix.Length..])
                ?? throw new InvalidDataException("Invalid local file metadata.");
            data = Convert.FromBase64String(file.DataBase64);
            if (file.Sha256Hex is null ||
                !string.Equals(Convert.ToHexString(SHA256.HashData(data)), file.Sha256Hex,
                    StringComparison.OrdinalIgnoreCase))
                throw new CryptographicException("Local file checksum mismatch.");
            StellarLedgerFileProtocol.ValidateName(file.FileName);
            await JS.InvokeVoidAsync("stellarVaultV2Download.save", file.FileName, data);
            _pendingFileStatus = "Local file downloaded. It has not been published on Stellar.";
        }
        catch (Exception ex) { _pendingFileStatus = "Local file recovery failed: " + ex.Message; }
        finally { if (data is not null) CryptographicOperations.ZeroMemory(data); }
    }

    private string _candidateHash = "";
    private string _candidateChildAccount = "";
    private int _candidateChildIndex = 1;
    private string? _candidateInvestigationStatus;

    private async Task InspectUnrecordedCandidateAsync()
    {
        if (_pendingDeleting || !Ledger.IsConnected ||
            _selectedPending is not { TransactionHash: null,
                State: VaultSyncState.Uncertain or VaultSyncState.Submitting } selected ||
            selected.Kind is not (VaultMutationKind.CreateRecord or VaultMutationKind.CreateFolder))
            return;

        _candidateInvestigationStatus = null;
        if (_candidateHash.Length != 64 || !_candidateHash.All(Uri.IsHexDigit) ||
            _candidateChildAccount.Length != 56 ||
            _candidateChildAccount[0] != 'G' ||
            !_candidateChildAccount.All(c => c is >= 'A' and <= 'Z' or >= '2' and <= '7') ||
            _candidateChildIndex is <= 0 or >= 64)
        {
            _candidateInvestigationStatus = "Enter a 64-character hexadecimal hash, valid G-account and child index from 1 to 63.";
            return;
        }

        _pendingDeleting = true;
        try
        {
            var finding = await UnknownHashInvestigation.InspectCandidateAsync(
                selected.AccountId, selected.Id, _candidateHash,
                _candidateChildAccount, _candidateChildIndex);
            _candidateInvestigationStatus = finding.HistoricalRecordMatched
                ? "CANDIDATE CONTENT MATCHED. This does not establish that your interrupted submission produced this transaction. The draft remains unresolved and MUST NOT be resubmitted automatically."
                : "CANDIDATE NOT VERIFIED. " + finding.Explanation +
                  " The submission remains unresolved; do not retry.";
            await LoadPendingAsync();
            _selectedPending = _pendingItems.FirstOrDefault(x => x.Id == selected.Id);
        }
        catch (Exception)
        {
            _candidateInvestigationStatus = "Candidate investigation could not be completed. Submission remains unresolved; do not retry.";
        }
        finally { _pendingDeleting = false; }
    }

    private async Task ReconcileSelectedAsync()
    {
        if (_pendingDeleting || _selectedPending is not { State: VaultSyncState.Uncertain or VaultSyncState.Submitting } selected) return;
        _pendingDeleting = true;
        _pendingDeleteError = null;
        try
        {
            var result = await PendingQueue.ReconcileAsync(selected.AccountId, selected.NetworkId, selected.Id);
            _pendingDeleteError = result.Explanation;
            await LoadPendingAsync();
            _selectedPending = _pendingItems.FirstOrDefault(x => x.Id == selected.Id);
        }
        catch (Exception ex) { _pendingDeleteError = "Reconciliation unavailable: " + ex.Message; }
        finally { _pendingDeleting = false; }
    }

    private async Task MigrateSelectedLegacyIdAsync()
    {
        if (_pendingDeleting || !Ledger.IsConnected ||
            _selectedPending is not { State: VaultSyncState.Pending } selected ||
            selected.EntityId.Length != 32 ||
            selected.Kind is not (VaultMutationKind.CreateRecord or VaultMutationKind.CreateFolder)) return;
        _pendingDeleting = true;
        _pendingDeleteError = null;
        try
        {
            var records = await Ledger.ReadAsync();
            var entries = await PendingQueue.ReviewAllAsync(selected.AccountId, selected.NetworkId);
            var occupied = new HashSet<string>(records.Select(x => x.Id), StringComparer.OrdinalIgnoreCase);
            occupied.UnionWith(entries.Select(x => x.EntityId));
            string nextId;
            do { nextId = Guid.NewGuid().ToString("N")[..16]; }
            while (occupied.Contains(nextId));
            var migrated = await PendingQueue.MigrateLegacyCreateIdAsync(
                selected.AccountId, selected.NetworkId, selected.Id, nextId);
            _selectedPending = migrated;
            await LoadPendingAsync();
            _syncReview = null;
            _syncEstimates = [];
            _pendingDeleteError = "Legacy draft ID migrated locally. Review dependencies and costs before synchronization.";
        }
        catch (Exception ex) { _pendingDeleteError = "Legacy ID migration blocked: " + ex.Message; }
        finally { _pendingDeleting = false; }
    }

    private bool _pendingDeleting;
    private string? _pendingDeleteError;
    private async Task DiscardSelectedPendingAsync()
    {
        if (_pendingDeleting || _selectedPending is not { State: VaultSyncState.Pending } selected) return;
        _pendingDeleting = true;
        _pendingDeleteError = null;
        try
        {
            await PendingQueue.DiscardPendingAsync(selected.AccountId, selected.NetworkId, selected.Id);
            _syncReview = null;
            _syncEstimates = [];
            _syncEstimateNote = "Queue changed. Review synchronization readiness again.";
            _selectedPending = null;
            await LoadPendingAsync();
        }
        catch (Exception ex) { _pendingDeleteError = "Cannot discard local draft: " + ex.Message; }
        finally { _pendingDeleting = false; }
    }

    private VaultPendingMutation? _selectedPending;
    private string _pendingEditTitle = "";
    private string _pendingEditFolder = "";
    private string _pendingEditContent = "", _pendingEditUsername = "", _pendingEditUrl = "",
        _pendingEditNotes = "", _pendingEditTags = "";
    private void OpenPending(VaultPendingMutation mutation)
    {
        _selectedPending = mutation;
        _candidateHash = "";
        _candidateChildAccount = "";
        _candidateChildIndex = 1;
        _candidateInvestigationStatus = null;
        _pendingFileStatus = null;
        _pendingEditTitle = PendingTitle(mutation);
        _pendingEditFolder = "";
        _pendingEditContent = _pendingEditUsername = _pendingEditUrl = _pendingEditNotes = _pendingEditTags = "";
        try
        {
            using var doc = JsonDocument.Parse(mutation.EncryptedPayload);
            string Read(string key) => doc.RootElement.TryGetProperty(key, out var value) && value.ValueKind == JsonValueKind.String
                ? value.GetString() ?? "" : "";
            _pendingEditFolder = Read("FolderId");
            _pendingEditContent = Read("Content");
            _pendingEditUsername = Read("UserName");
            _pendingEditUrl = Read("Url");
            _pendingEditNotes = Read("Notes");
            if (doc.RootElement.TryGetProperty("Tags", out var tags) && tags.ValueKind == JsonValueKind.Array)
                _pendingEditTags = string.Join(", ", tags.EnumerateArray().Where(x => x.ValueKind == JsonValueKind.String).Select(x => x.GetString()));
        }
        catch (JsonException) { }
        _pendingDeleteError = null;
    }
    private async Task SavePendingTitleAsync()
    {
        if (_pendingDeleting || _selectedPending is not { State: VaultSyncState.Pending } selected) return;
        _pendingDeleting = true;
        _pendingDeleteError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_pendingEditTitle))
                throw new InvalidOperationException("A draft title is required.");
            var fields = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(selected.EncryptedPayload)
                ?? throw new InvalidDataException("Cannot read saved draft fields.");
            fields["Title"] = JsonSerializer.SerializeToElement(_pendingEditTitle.Trim());
            if (!string.IsNullOrEmpty(_pendingEditFolder))
            {
                if (!Folders.Any(x => x.Id == _pendingEditFolder) &&
                    !PendingLocalFolders.Any(x => x.EntityId == _pendingEditFolder))
                    throw new InvalidOperationException("Parent folder is unavailable.");
                if (selected.Kind is VaultMutationKind.CreateFolder or VaultMutationKind.UpdateFolder &&
                    WouldCreateLocalFolderCycle(selected.EntityId, _pendingEditFolder))
                    throw new InvalidOperationException("Circular folder nesting is not permitted.");
            }
            fields["FolderId"] = JsonSerializer.SerializeToElement(
                string.IsNullOrEmpty(_pendingEditFolder) ? (string?)null : _pendingEditFolder);
            if (selected.Kind is VaultMutationKind.CreateRecord or VaultMutationKind.UpdateRecord)
            {
                fields["Content"] = JsonSerializer.SerializeToElement(_pendingEditContent);
                fields["UserName"] = JsonSerializer.SerializeToElement(_pendingEditUsername);
                fields["Url"] = JsonSerializer.SerializeToElement(_pendingEditUrl);
                fields["Notes"] = JsonSerializer.SerializeToElement(_pendingEditNotes);
                fields["Tags"] = JsonSerializer.SerializeToElement(_pendingEditTags.Split(',',
                    StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                    .Distinct(StringComparer.OrdinalIgnoreCase).ToArray());
            }
            byte[] revised = JsonSerializer.SerializeToUtf8Bytes(fields);
            try
            {
                _syncReview = null;
                _syncEstimates = [];
                ClearSyncApproval();
                _syncEstimateNote = "Local draft changed. Re-run sync review and fee estimation.";
                _selectedPending = await PendingQueue.RevisePendingAsync(
                    selected.AccountId, selected.NetworkId, selected.Id, revised);
                await LoadPendingAsync();
            }
            finally { CryptographicOperations.ZeroMemory(revised); }
        }
        catch (Exception ex) { _pendingDeleteError = "Cannot revise local draft: " + ex.Message; }
        finally { _pendingDeleting = false; }
    }
    private void ClosePending() { if (!_pendingDeleting) { _selectedPending = null; _pendingDeleteError = null; } }

    private static string PendingTitle(VaultPendingMutation change)
    {
        // Draft bytes are accessed only while the encrypted local vault session
        // is open. The queue adapter decrypts the authenticated entry in memory.
        try
        {
            using var document = JsonDocument.Parse(change.EncryptedPayload);
            if (document.RootElement.TryGetProperty("Title", out var title) &&
                title.ValueKind == JsonValueKind.String)
                return title.GetString() ?? change.Kind.ToString();
        }
        catch (JsonException) { /* Corrupt drafts remain visible for recovery. */ }
        return change.Kind.ToString();
    }

    private static string? PendingFolderId(VaultPendingMutation draft)
    {
        try
        {
            using var document = JsonDocument.Parse(draft.EncryptedPayload);
            if (document.RootElement.TryGetProperty("FolderId", out var folder) &&
                folder.ValueKind == JsonValueKind.String)
                return folder.GetString();
        }
        catch (JsonException) { }
        return null;
    }

    private IEnumerable<VaultPendingMutation> PendingLocalFolders =>
        _pendingItems.Where(x => x.State == VaultSyncState.Pending &&
            (x.Kind == VaultMutationKind.CreateFolder || x.Kind == VaultMutationKind.UpdateFolder));

    private bool WouldCreateLocalFolderCycle(string movingId, string parentId)
    {
        var seen = new HashSet<string>(StringComparer.Ordinal);
        while (!string.IsNullOrEmpty(parentId))
        {
            if (parentId == movingId || !seen.Add(parentId)) return true;
            var folder = PendingLocalFolders.FirstOrDefault(x => x.EntityId == parentId);
            if (folder is null) return false;
            try
            {
                using var doc = JsonDocument.Parse(folder.EncryptedPayload);
                parentId = doc.RootElement.TryGetProperty("FolderId", out var value) &&
                    value.ValueKind == JsonValueKind.String ? value.GetString() ?? "" : "";
            }
            catch (JsonException) { return true; }
        }
        return false;
    }

    private sealed record PendingEstimate(string Title, string Summary, VaultSyncApprovalSnapshot? Snapshot = null);
    private List<PendingEstimate> _syncEstimates = [];
    private string? _syncEstimateNote;

    private async Task EstimateReadyDraftsAsync()
    {
        if (_pendingLoading || !Retention.AllowsLocalPersistence ||
            !Sessions.IsUnlocked || Sessions.ActiveAccountId is not string account)
            return;
        _pendingLoading = true;
        _syncEstimates = [];
        _syncEstimateNote = null;
        ClearSyncApproval();
        try
        {
            var report = await HybridReview.ReviewAsync(account, estimateFees: true);
            _syncReview = report.Queue;
            _syncEstimates = report.Estimates.Select(x =>
                new PendingEstimate(x.Title, x.Explanation, x.Quote)).ToList();
            _syncEstimateNote = "Estimates are read-only and expire. Manual synchronization remains disabled.";
        }
        catch (Exception)
        {
            _syncEstimateNote = "Shared hybrid review unavailable. Reconnect and refresh the queue; no transaction was sent.";
        }
        finally { _pendingLoading = false; }
    }

    private async Task QuarantineInterruptedAsync()
    {
        if (_pendingLoading || !Retention.AllowsLocalPersistence ||
            !Sessions.IsUnlocked || Sessions.ActiveAccountId is not string account) return;
        _pendingLoading = true;
        try
        {
            var network = Networks.CredentialKey(account);
            var interrupted = await PendingQueue.ReviewInterruptedAsync(account, network);
            foreach (var entry in interrupted.Where(x => x.State == VaultSyncState.Submitting))
                await PendingQueue.QuarantineInterruptedAsync(account, network, entry.Id);
            _pendingError = null;
            _syncReview = await PendingQueue.PrepareReviewAsync(account, network);
            _pendingItems = await PendingQueue.ReviewAllAsync(account, network);
            _syncEstimates = [];
            ClearSyncApproval();
            _approvalStatus = null;
        }
        catch (Exception ex) { _pendingError = "Interrupted submission review failed: " + ex.Message; }
        finally { _pendingLoading = false; }
    }

    private VaultSyncApprovalSnapshot? _reviewedQuote;
    private bool _approvalAcknowledged;
    private string? _reviewedDraftTitle;
    private void ClearSyncApproval()
    {
        _reviewedQuote = null;
        _approvalAcknowledged = false;
        _reviewedDraftTitle = null;
    }

    private string? _approvalStatus;
    private async Task ReviewApprovalAsync(VaultSyncApprovalSnapshot snapshot)
    {
        _approvalStatus = null;
        ClearSyncApproval();
        if (_pendingLoading || !Ledger.IsConnected || !Sessions.IsUnlocked ||
            Sessions.ActiveAccountId is not string account) return;
        _pendingLoading = true;
        try
        {
            var network = Networks.CredentialKey(account);
            var review = await PendingQueue.PrepareReviewAsync(account, network);
            var mutation = review.Ready.SingleOrDefault(x => x.Id == snapshot.MutationId)
                ?? throw new InvalidOperationException("Mutation is no longer ready.");
            VaultSyncApprovalGuard.RequireFresh(snapshot, mutation, account, network,
                DateTimeOffset.UtcNow, TimeSpan.FromMinutes(5));
            var draft = JsonSerializer.Deserialize<LedgerRecordDraft>(mutation.EncryptedPayload)
                ?? throw new InvalidDataException("Invalid queued record draft.");
            var fresh = await Ledger.EstimateAsync(draft);
            if (fresh.NetworkFeeXlm > snapshot.QuotedFeeXlm ||
                fresh.PeakReserveXlm > snapshot.QuotedPeakReserveXlm)
                throw new InvalidOperationException("Costs increased. Estimate again.");
            _reviewedQuote = snapshot;
            _reviewedDraftTitle = draft.Title;
            _approvalStatus = "Quote checked against current queue and costs. Review the details below. Broadcasting is disabled.";
        }
        catch (Exception ex) { _approvalStatus = "Quote rejected: " + ex.Message; }
        finally { _pendingLoading = false; }
    }

    private async Task CheckApprovedPreflightAsync()
    {
        if (!_approvalAcknowledged || _reviewedQuote is null || !Ledger.IsConnected ||
            _pendingLoading || Sessions.ActiveAccountId is not string account) return;
        _pendingLoading = true;
        _approvalStatus = null;
        try
        {
            var eligible = await ManualSync.CanPublishApprovedCreateAsync(_reviewedQuote, account);
            _approvalStatus = eligible ? "Current approval, ledger and costs pass the read-only check. Publishing stays disabled." : "Eligibility failed. Review network, draft, remote records and cost limits again.";
        }
        catch (Exception ex)
        {
            ClearSyncApproval();
            _approvalStatus = "Preflight rejected. Start a new review: " + ex.Message;
        }
        finally { _pendingLoading = false; }
    }

    private void ConfirmPreviewOnly()
    {
        if (_approvalAcknowledged && _reviewedQuote is not null)
            _approvalStatus = "Review acknowledged locally. No transaction was reserved, signed or broadcast.";
    }

    private VaultSyncReview? _syncReview;
    private async Task PrepareLocalSyncReviewAsync()
    {
        if (_pendingLoading || !Retention.AllowsLocalPersistence ||
            Sessions.ActiveAccountId is not string account) return;
        _pendingLoading = true;
        _pendingError = null;
        _syncReview = null;
        _syncEstimates = [];
        _syncEstimateNote = null;
        ClearSyncApproval();
        try
        {
            _syncReview = await PendingQueue.PrepareReviewAsync(account, Networks.CredentialKey(account));
        }
        catch (Exception ex) { _pendingError = "Sync readiness review failed: " + ex.Message; }
        finally { _pendingLoading = false; }
    }

    private IReadOnlyList<VaultPendingMutation> _pendingItems = [];
    private IReadOnlyList<VaultRecoveryInspection> _recoveryInspections = [];
    private string? _pendingError;
    private bool _pendingLoading;

    private async Task LoadPendingAsync()
    {
        if (_pendingLoading || !Retention.AllowsLocalPersistence || !Sessions.IsUnlocked ||
            Sessions.ActiveAccountId is not string account) return;
        _pendingLoading = true;
        _pendingError = null;
        _syncReview = null;
        _recoveryInspections = [];
        try
        {
            var network = Networks.CredentialKey(account);
            _pendingItems = await PendingQueue.ReviewAllAsync(account, network);
            _recoveryInspections = await PendingQueue.InspectOutstandingRecoveriesAsync(account, network);
        }
        catch (Exception ex) { _pendingError = "Unable to open encrypted device queue: " + ex.Message; }
        finally { _pendingLoading = false; }
    }

    private IReadOnlyList<LedgerRecordItem> _records = [];
    private string _search = "";
    private string? _folder;
    private bool _includeChildren;
    private bool? _registryReady;


    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;
    private static bool IsLedgerFile(LedgerRecordItem item) => LedgerFileProtocol.IsFile(item);
    private async Task DownloadLedgerFileAsync()
    {
        if (_selected is null || !IsLedgerFile(_selected)) return;
        _fileDownloadStatus = "RECOVERING ENCRYPTED FILE FROM STELLAR...";
        try
        {
            // Re-read the full authenticated ledger snapshot rather than trusting
            // an old in-memory list that may omit parts from a recent publication.
            var all = await Ledger.ReadAsync();
            var current = all.SingleOrDefault(r => r.Id == _selected.Id)
                ?? throw new InvalidDataException("File manifest is no longer available.");
            var bytes = LedgerFileProtocol.DecodeFile(current, all);
            try
            {
                await JS.InvokeVoidAsync("stellarVaultV2Download.save",
                    LedgerFileProtocol.FileName(current), bytes);
                _fileDownloadStatus = "File verified and downloaded.";
            }
            finally { CryptographicOperations.ZeroMemory(bytes); }
        }
        catch (Exception ex)
        {
            _fileDownloadStatus = "Encrypted file recovery failed: " + ex.Message;
        }
    }
    private string? _fileDownloadStatus;
    private LedgerRecordItem? _selected;
    private bool _revealed;
    private void OpenRecord(LedgerRecordItem item) { _selected = item; _revealed = false; _fileDownloadStatus = null; }
    private void CloseRecord() { if (_busy) return; _selected = null; _revealed = false; _fileDownloadStatus = null; }
    private void CancelDelete() { if (_busy) return; _deleteCandidate = null; _deleteEstimate = null; }
    private async Task CopyValueAsync(string? value) { if (!string.IsNullOrEmpty(value)) await JS.InvokeVoidAsync("navigator.clipboard.writeText", value); }
    private bool _showAccountInfo, _infoLoading;
    private LedgerAccountInfo? _accountInfo;
    private string? _infoError;
    private void CloseAccountInfo() { if (!_infoLoading) _showAccountInfo = false; }
    private async Task OpenAccountInfoAsync()
    {
        if (_infoLoading || !Ledger.IsConnected) return;
        _showAccountInfo = true;
        _infoLoading = true;
        _infoError = null;
        try { _accountInfo = await Ledger.InspectAccountInfoAsync(); }
        catch (Exception ex) { _infoError = "Unable to retrieve account information: " + ex.Message; }
        finally { _infoLoading = false; }
    }
    private bool _busy;
    private string _busyMessage = "SYNCING STELLAR LEDGER...";
    private LedgerCostPreview? _deleteEstimate;
    private readonly HashSet<string> _revealedIds = new(StringComparer.Ordinal);
    private void ToggleReveal(string id) { if (!_revealedIds.Add(id)) _revealedIds.Remove(id); }
    private void OpenFolder(string id) { _folder = id; _revealedIds.Clear(); }
    private void OpenLocalParentFolder()
    {
        var local = PendingLocalFolders.FirstOrDefault(x => x.EntityId == _folder);
        if (local is not null) OpenFolder(PendingFolderId(local) ?? string.Empty);
    }
    private LedgerRecordItem? _deleteCandidate;
    private async Task SelectDelete(LedgerRecordItem item) {
        if (_busy) return;
        _deleteCandidate = item; _deleteEstimate = null;
        _busy = true; _busyMessage = "ESTIMATING DELETE COST...";
        try { _deleteEstimate = await Ledger.EstimateDeleteAsync(item.Id); }
        catch (Exception ex) { _error = "Delete estimate failed: " + ex.Message; }
        finally { _busy = false; }
    }
    private async Task DeleteSelectedAsync() {
        if (_busy || _deleteCandidate is null) return;
        _busy = true; _busyMessage = "DELETING FROM STELLAR...";
        var id = _deleteCandidate.Id;
        try {
            var result = await Ledger.DeleteAsync(id);
            _deleteCandidate = null; _deleteEstimate = null; _selected = null; _revealed = false;
            _records = await Ledger.ReadAsync();
            _error = "Deletion committed: " + result.TransactionHash + (result.Warning is null ? "" : " Cleanup warning: " + result.Warning);
        } catch (Exception ex) { _error = "Deletion failed or refresh unavailable: " + ex.Message; }
        finally { _busy = false; }
    }
    private string? _error;
    private List<LedgerRecordItem> Folders => _records.Where(r => r.IsFolder).ToList();
    private List<LedgerRecordItem> Records => _records.Where(r => !r.IsFolder && !r.Content.StartsWith(LedgerFileProtocol.ChunkPrefix, StringComparison.Ordinal)).ToList();
    private IEnumerable<LedgerRecordItem> Breadcrumbs
    {
        get {
            var result = new List<LedgerRecordItem>();
            var visited = new HashSet<string>();
            var id = _folder;
            while (id is not null && visited.Add(id)) {
                var item = Folders.FirstOrDefault(f => f.Id == id);
                if (item is null) break;
                result.Insert(0, item);
                id = item.FolderId;
            }
            return result;
        }
    }
    private List<LedgerRecordItem> Filtered {
        get {
            var included = new HashSet<string?> { _folder };
            if (_includeChildren) {
                bool changed;
                do {
                    changed = false;
                    foreach (var f in Folders)
                        if (included.Contains(f.FolderId) && included.Add(f.Id)) changed = true;
                } while (changed);
            }
            return Records.Where(r => (!string.IsNullOrWhiteSpace(_search) || included.Contains(r.FolderId)) &&
                (string.IsNullOrWhiteSpace(_search) ||
                new[] { r.Title, r.UserName, r.Url, r.Notes, r.Tags is null ? "" : string.Join(" ",r.Tags), FolderPath(r.FolderId) }
                .Any(x => x?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true))).ToList();
        }
    }
    private string FolderName(string? id) => Folders.FirstOrDefault(f => f.Id == id)?.Title ?? "";
    private string FolderPath(string? id) {
        var names = new List<string>(); var visited = new HashSet<string>();
        while (id is not null && visited.Add(id)) {
            var folder = Folders.FirstOrDefault(f => f.Id == id);
            if (folder is null) { names.Insert(0, "[missing folder]"); break; }
            names.Insert(0, folder.Title); id = folder.FolderId;
        }
        return names.Count == 0 ? "My vault" : "My vault / " + string.Join(" / ", names);
    }
    [SupplyParameterFromQuery(Name = "folder")] public string? InitialFolder { get; set; }
    protected override void OnParametersSet() {
        if (!string.IsNullOrEmpty(InitialFolder)) _folder = InitialFolder;
    }
    protected override async Task OnInitializedAsync() {
        if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked) await LoadPendingAsync();
        if (!Ledger.IsConnected) return;
        try {
            _registryReady = await Ledger.HasRegistryAsync();
            if (_registryReady == true) await RefreshAsync();
            else Nav.NavigateTo("/initialize", replace: true);
        } catch (Exception ex) { _error = "Ledger setup check failed: " + ex.Message; }
    }
    private async Task RefreshAsync() {
        if (_busy) return;
        _busy = true; _busyMessage = "SYNCING STELLAR LEDGER..."; _error = null; _revealedIds.Clear();
        try { _records = await Ledger.ReadAsync(); }
        catch (Exception ex) { _error = "Ledger synchronization failed: " + ex.Message; }
        finally { _busy = false; }
    }
    private async Task ReconnectAsync()
    {
        // The access screen cannot accept a new mnemonic while the local session
        // remains unlocked. End the session, never clear IndexedDB.
        Workflow.Lock();
        try { await Ledger.DisconnectAsync(); }
        catch { /* Disconnect must not prevent opening the access screen. */ }
        Nav.NavigateTo("/", replace: true);
    }
    private async Task LockAsync() {
        Workflow.Lock(); await Ledger.DisconnectAsync(); Nav.NavigateTo("/");
    }
}