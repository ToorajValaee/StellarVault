    private static bool IsLedgerFile(LedgerRecordItem item) =>
        LedgerFileProtocol.IsFile(item) || VaultLinkedTreeFilePolicy.IsRootRecord(item);

    private sealed record VerifiedTreeDownload(string RootId, string FileName,
        IReadOnlyList<LedgerRecordItem> Records);
    private VerifiedTreeDownload? _verifiedTreeDownload;
    private string? _fileDownloadStatus;
    private LedgerRecordItem? _selected;
    private bool _revealed;

    private async Task DownloadLedgerFileAsync()
    {
        if (_selected is null || !IsLedgerFile(_selected)) return;
        _verifiedTreeDownload = null;
        _fileDownloadStatus = "VERIFYING ENCRYPTED FILE FROM STELLAR...";
        try
        {
            var all = await Ledger.ReadAsync();
            var current = all.SingleOrDefault(r => r.Id == _selected.Id)
                ?? throw new InvalidDataException("File root is no longer available.");
            if (VaultLinkedTreeFilePolicy.IsRootRecord(current))
            {
                // This pass never exports plaintext or opens a file picker.
                var verified = await VaultLinkedTreeFilePolicy.ReadAsync(
                    current.Id, all, Stream.Null);
                _verifiedTreeDownload = new VerifiedTreeDownload(
                    current.Id, verified.FileName, all);
                _fileDownloadStatus = "File integrity verified. Choose SAVE VERIFIED FILE to select a destination.";
            }
            else
            {
                var bytes = LedgerFileProtocol.DecodeFile(current, all);
                try
                {
                    await JS.InvokeVoidAsync("stellarVaultV2Download.save",
                        LedgerFileProtocol.FileName(current), bytes);
                    _fileDownloadStatus = "Legacy file verified and downloaded.";
                }
                finally { CryptographicOperations.ZeroMemory(bytes); }
            }
        }
        catch (Exception ex)
        {
            _fileDownloadStatus = "Encrypted file recovery failed: " + ex.GetType().Name;
        }
    }

    private async Task SaveVerifiedTreeFileAsync()
    {
        if (_verifiedTreeDownload is not { } prepared) return;
        _verifiedTreeDownload = null;
        var pipe = new Pipe(new PipeOptions(
            pauseWriterThreshold: 256 * 1024,
            resumeWriterThreshold: 128 * 1024));
        using var cancel = new CancellationTokenSource();
        var producer = Task.Run(async () =>
        {
            await using var writer = pipe.Writer.AsStream(leaveOpen: true);
            try
            {
                await VaultLinkedTreeFilePolicy.ReadAsync(
                    prepared.RootId, prepared.Records, writer, cancel.Token);
                await writer.FlushAsync(cancel.Token);
                await pipe.Writer.CompleteAsync();
            }
            catch (Exception ex)
            {
                await pipe.Writer.CompleteAsync(ex);
                throw;
            }
        });
        try
        {
            await using var reader = pipe.Reader.AsStream(leaveOpen: true);
            if (!await NativeFiles.SaveAsync(prepared.FileName, reader))
                throw new IOException("File export was cancelled.");
            await producer;
            _fileDownloadStatus = "Streamed verified file saved.";
        }
        catch (Exception ex)
        {
            cancel.Cancel();
            try { await producer; } catch { /* Preserve export error. */ }
            _fileDownloadStatus = "File export failed: " + ex.GetType().Name +
                ". Verify the file again before retrying.";
        }
        finally { await pipe.Reader.CompleteAsync(); }
    }

