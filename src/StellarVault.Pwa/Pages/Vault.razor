    private string? _error;
    private List<LedgerRecordItem> Folders => _records.Where(r => r.IsFolder).ToList();
    private List<LedgerRecordItem> Records => _records.Where(r => !r.IsFolder &&
        !r.Content.StartsWith(LedgerFileProtocol.ChunkPrefix, StringComparison.Ordinal) &&
        (!r.Content.StartsWith(VaultLinkedTreeFilePolicy.Prefix, StringComparison.Ordinal) ||
         VaultLinkedTreeFilePolicy.IsRootRecord(r))).ToList();
    private IEnumerable<LedgerRecordItem> Breadcrumbs
    {
        get {
            var result = new List<LedgerRecordItem>();
            var visited = new HashSet<string>();
            var id = _folder;
            while (id is not null && visited.Add(id)) {
                var item = Folders.FirstOrDefault(f => f.Id == id);
                if (item is null) break;
                result.Insert(0, item);
                id = item.FolderId;
            }
            return result;
        }
    }
    private List<LedgerRecordItem> Filtered {
        get {
            var included = new HashSet<string?> { _folder };
            if (_includeChildren) {
                bool changed;
                do {
                    changed = false;
                    foreach (var f in Folders)
                        if (included.Contains(f.FolderId) && included.Add(f.Id)) changed = true;
                } while (changed);
            }
            return Records.Where(r => (!string.IsNullOrWhiteSpace(_search) || included.Contains(r.FolderId)) &&
                (string.IsNullOrWhiteSpace(_search) ||
                new[] { r.Title, r.UserName, r.Url, r.Notes, r.Tags is null ? "" : string.Join(" ",r.Tags), FolderPath(r.FolderId) }
                .Any(x => x?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true))).ToList();
        }
    }
    private string FolderName(string? id) => Folders.FirstOrDefault(f => f.Id == id)?.Title ?? "";
    private string FolderPath(string? id) {
        var names = new List<string>(); var visited = new HashSet<string>();
        while (id is not null && visited.Add(id)) {
            var folder = Folders.FirstOrDefault(f => f.Id == id);
            if (folder is null) { names.Insert(0, "[missing folder]"); break; }
            names.Insert(0, folder.Title); id = folder.FolderId;
        }
        return names.Count == 0 ? "My vault" : "My vault / " + string.Join(" / ", names);
    }
    [SupplyParameterFromQuery(Name = "folder")] public string? InitialFolder { get; set; }
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(InitialFolder)) _folder = InitialFolder;
        if (RequestedView == "help") _appView = "help";
    }
    private string? _conflictLockError;

    private async Task LockConflictingSessionsAsync()
    {
        // Do not switch strategies while either signing or local unlock key
        // remains live. Preserve uncertain transaction markers on lock.
        var failed = false;
        try { await LinkedQueueKeys.LockAsync(); } catch { failed = true; }
        try { await SecretLedger.DisconnectAsync(); } catch { failed = true; }
        try { Workflow.Lock(); } catch { failed = true; }
        try { await Ledger.DisconnectAsync(); } catch { failed = true; }
        if (failed)
        {
            _conflictLockError = "Not all sessions could be closed. Restart the application before unlocking another vault.";
            return;
        }
        Nav.NavigateTo("/", replace: true);
    }

    private VaultWorkspaceMode ActiveMode =>
        VaultWorkspaceModeResolver.Resolve(
            Sessions.IsUnlocked, Ledger.IsConnected, SecretLedger.IsConnected);

    protected override async Task OnInitializedAsync() {
        // An independent S-key session must never inspect the HD queue,
        // registry or mnemonic-derived account in the shared route.
        if (ActiveMode != VaultWorkspaceMode.MnemonicHd) return;
        if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked) await LoadPendingAsync();
        if (!Ledger.IsConnected) return;
        try {
            _registryReady = await Ledger.HasRegistryAsync();
            if (_registryReady == true) await RefreshAsync();
            else Nav.NavigateTo("/initialize", replace: true);
        } catch (Exception) {
            // A disconnected Horizon is not evidence that registry setup is
            // missing. Keep locally unlocked drafts accessible.
            _error = "Stellar cannot be reached right now. You can continue working with encrypted local drafts and retry network refresh later.";
        }
    }
    private async Task RefreshAsync() {
        if (_busy) return;
        _busy = true; _busyMessage = "Refreshing Stellar records…"; _error = null; _revealedIds.Clear();
        try { _records = await Ledger.ReadAsync(); }
        catch (Exception ex) {
            // Retain the last verified snapshot and keep the local draft queue
            // available. Do not leak a vendor JavaScript stack into the UI.
            var offline = ex.Message.Contains("Failed to fetch", StringComparison.OrdinalIgnoreCase)
                || ex.Message.Contains("NetworkError", StringComparison.OrdinalIgnoreCase)
                || ex is HttpRequestException;
            _error = offline
                ? "Stellar network is unavailable. The last loaded records remain visible; encrypted local drafts are still available under Drafts."
                : "Stellar records could not be refreshed. Try again when the network is available.";
        }
        finally { _busy = false; }
    }
    private async Task ReconnectAsync()
    {
        // The access screen cannot accept a new mnemonic while the local session
        // remains unlocked. End the session, never clear IndexedDB.
        Workflow.Lock();
        try { await Ledger.DisconnectAsync(); }
        catch { /* Disconnect must not prevent opening the access screen. */ }
        Nav.NavigateTo("/", replace: true);
    }
    private async Task LockAsync() {
        Workflow.Lock(); await Ledger.DisconnectAsync(); Nav.NavigateTo("/");
    }
}