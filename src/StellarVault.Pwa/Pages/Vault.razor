@page "/vault"
@using StellarVault.Core.Services
@using System.Text.Json
@using System.Security.Cryptography
@using System.IO.Pipelines
@using StellarVault.Pwa.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Web
@inject IStellarLedgerRecords Ledger
@inject IStellarSecretKeyLedger SecretLedger
@inject VaultLinkedQueueKeySession LinkedQueueKeys
@inject IVaultNativeFileAccess NativeFiles
@inject VaultSessionManager Sessions
@inject VaultSessionWorkflow Workflow
@inject VaultDeviceRetentionGate Retention
@inject VaultPendingMutationQueue PendingQueue
@inject VaultManualSyncCoordinator ManualSync
@inject VaultHybridSyncReviewService HybridReview
@inject VaultUnrecordedSubmissionDiagnostic UnknownHashInvestigation
@inject VaultNetworkSelection Networks
@inject NavigationManager Nav

<AdaptiveShell PlatformName="WEB PWA" Subtitle="YOUR VAULT">
@if (ActiveMode == VaultWorkspaceMode.Locked)
{
    <section class="terminal-panel centered-message">
        <h1>Vault locked</h1>
        <a class="pixel-button primary" href="/">Unlock vault</a>
        <details class="sv-access-learn" style="margin-top:1.25rem;text-align:left">
            <summary>Recover independent encrypted S-key drafts offline</summary>
            <p>Device-only encrypted drafts can be unlocked with their independent local passphrase without reconnecting a Stellar signer. This does not enable publication.</p>
            <VaultLinkedLocalQueuePanel />
        </details>
    </section>
}
else if (ActiveMode == VaultWorkspaceMode.ConflictingSessions)
{
    <section class="terminal-panel centered-message" role="alert">
        <h1>Conflicting vault sessions</h1>
        <p>Independent mnemonic and Secret Key vault sessions are both active. Lock both sessions before reopening a vault. No transaction was sent.</p>
        <button type="button" class="pixel-button primary" @onclick="LockConflictingSessionsAsync">Lock both vault sessions</button>
        @if (_conflictLockError is not null)
        {
            <p class="terminal-alert warning" role="alert">@_conflictLockError</p>
        }
    </section>
}
else if (ActiveMode == VaultWorkspaceMode.StellarSecretKey)
{
    <VaultLinkedWorkspaceShell />
}
else if (Ledger.IsConnected && _registryReady == false)
{
    <section class="terminal-panel centered-message">
        <h1>Finish setup</h1>
        <p>One step remains before your records are available.</p>
        <a class="pixel-button primary" href="/initialize">Continue setup</a>
    </section>
}
else
{
    <div class="sv-pwa-app" aria-label="StellarVault application">
        <nav class="sv-pwa-rail" aria-label="Vault navigation">
            <div class="sv-pwa-rail-heading"><span class="sv-pwa-rail-mark sv-rail-shield" aria-hidden="true"><svg viewBox="0 0 32 36" width="27" height="30" fill="none"><path d="M16 2 29 7v11c0 8-6.2 13.5-13 16C9.2 31.5 3 26 3 18V7L16 2Z" fill="currentColor"/><path d="m16 9 2.7 6.3L25 18l-6.3 2.7L16 27l-2.7-6.3L7 18l6.3-2.7L16 9Z" fill="#084839"/></svg></span><span><strong>StellarVault</strong></span></div>
            <button type="button" class="@(_appView == "records" ? "selected" : "")" aria-current="@(_appView == "records" ? "page" : null)"
                    @onclick='() => SelectAppView("records")'><span class="sv-nav-vault-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15.5" r="1"/></svg></span> Vault</button>
            @if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
            {
                <button type="button" class="@(_appView == "drafts" ? "selected" : "")" aria-current="@(_appView == "drafts" ? "page" : null)"
                        @onclick='() => SelectAppView("drafts")'><span aria-hidden="true">▧</span> Drafts</button>
                <button type="button" class="@(_appView == "sync" ? "selected" : "")" aria-current="@(_appView == "sync" ? "page" : null)"
                        @onclick='() => SelectAppView("sync")'><span aria-hidden="true">⇅</span> Sync</button>
            }
            <button type="button" class="@(_appView == "settings" ? "selected" : "")"
                    aria-current="@(_appView == "settings" ? "page" : null)"
                    @onclick='() => SelectAppView("settings")'><span aria-hidden="true">⚙</span> Settings</button>
            <button type="button" class="sv-rail-link sv-inline-help-nav @(_appView == "help" ? "selected" : "")" aria-current="@(_appView == "help" ? "page" : null)" @onclick='() => SelectAppView("help")'><span class="sv-rail-icon" aria-hidden="true">ⓘ</span> Documentation &amp; Help</button>
            <div class="sv-pwa-rail-divider"></div>
            <div class="sv-sidebar-network">
                <span class="sv-sidebar-network-label">Stellar network</span>
                @if (Ledger.IsConnected)
                {
                    <div class="sv-sidebar-connected"><span aria-hidden="true">●</span> Connected</div>
                    <p>Your vault is connected to the selected Stellar network.</p>
                }
                else
                {
                    <button type="button" class="sv-sidebar-connect" @onclick="ReconnectAsync"><span aria-hidden="true">◎</span> Connect Stellar</button>
                    <p>Connect your account for encrypted ledger records and recovery.</p>
                }
            </div>
            <div class="sv-rail-trust">
                <a href="https://github.com/ToorajValaee/StellarVault" target="_blank" rel="noopener noreferrer"><span aria-hidden="true">⌘</span> View source on GitHub <span aria-hidden="true">↗</span></a>

            </div>
            <div class="sv-pwa-rail-foot"><span class="sv-pwa-led @(Ledger.IsConnected ? "connected" : "")"></span>@(Ledger.IsConnected ? "Stellar connected" : "Not connected")</div>
            <div class="sv-rail-attribution">Powered by <a href="https://badje.ir/" target="_blank" rel="noopener noreferrer">badje.ir</a></div>
        </nav>
        <main class="sv-pwa-stage" id="sv-pwa-workspace" tabindex="-1" @key="_appView">
        <section class="vault-page sv-pwa-vault-page">
            <header class="sv-pwa-screen-header">
                <div>
                    <h1>@(_appView == "records" ? "Vault" : _appView == "drafts" ? "Drafts" : _appView == "settings" ? "Settings" : _appView == "help" ? "Documentation & Help" : "Sync")</h1>
                    @if (_appView == "records") { <p class="sv-vault-subtitle">Your secure records, organized and always in your control.</p> }
                    
                </div>
                <div class="sv-pwa-screen-tools">
                    @if (_appView == "records")
                    {
                        <button class="pixel-button primary sv-create-record" type="button" @onclick='() => OpenEditor("record")'><span aria-hidden="true">＋</span> New record</button>
                        <button class="pixel-button sv-create-folder" type="button" @onclick='() => OpenEditor("folder")'><span aria-hidden="true">＋</span> New folder</button>
                    }
                    @if (!Ledger.IsConnected) { <button class="pixel-button compact" type="button" @onclick="ReconnectAsync">CONNECT STELLAR</button> }
                    <button class="pixel-button compact" type="button" disabled="@(_infoLoading || !Ledger.IsConnected)" aria-label="Account information" @onclick="OpenAccountInfoAsync">ⓘ Account</button>
                    @if (_appView == "records") { <button class="pixel-button compact" type="button" @onclick="RefreshAsync" disabled="@(_busy || !Ledger.IsConnected)">↻ Refresh</button> }
                    <button class="pixel-button compact" type="button" @onclick="LockAsync">Lock</button>
                </div>
            </header>
            @if (_appView == "records" && Ledger.IsConnected)
            {
                <div class="sv-vault-overview" aria-label="Vault contents"><span>@Records.Count secure records</span><span aria-hidden="true">·</span><span>@Folders.Count folders</span><span aria-hidden="true">·</span><span>@(Ledger.IsConnected ? "Stellar connected" : "Local session")</span></div>
            }
        @if (_appView == "help")
        {
            <VaultHelpContent />
        }
        @if (_appView == "settings")
        {
            <button type="button" class="sv-settings-help-link" @onclick='() => SelectAppView("help")'><span class="sv-settings-help-icon" aria-hidden="true">ⓘ</span><span><strong>Documentation &amp; Help</strong><small>Guides, vault security and open-source information</small></span><span class="sv-settings-help-chevron" aria-hidden="true">›</span></button>
            <section class="sv-modern-settings sv-workspace-surface" aria-label="Vault settings">
                <div class="terminal-panel sv-modern-settings-section">
                    <h2>Connection</h2>
                    <div class="sv-modern-setting-row">
                        <div><strong>Network</strong><p>@(Networks.SelectedPreset == "public" ? "Stellar Mainnet" : Networks.SelectedPreset == "custom" ? "Custom Stellar network" : "Stellar Testnet")</p></div>
                        <span class="sv-modern-setting-status">@(Ledger.IsConnected ? "Connected" : "Not connected")</span>
                    </div>
                    <div class="sv-modern-setting-row">
                        <div><strong>Account details</strong><p>View the active Stellar account and ledger information.</p></div>
                        <button class="pixel-button compact" type="button" disabled="@(_infoLoading || !Ledger.IsConnected)" @onclick="OpenAccountInfoAsync">View</button>
                    </div>
                </div>
                <div class="terminal-panel sv-modern-settings-section">
                    <h2>Privacy &amp; storage</h2>
                    <div class="sv-modern-setting-row">
                        <div><strong>Local encrypted vault</strong>
                        <p>@(Retention.AllowsLocalPersistence ? "Device storage allowed" : "Stellar-only session")</p></div>
                    </div>
                    <p class="advanced-help">Offline data stays on this device until you explicitly approve synchronization. Keep your own backup.</p>
                    <button class="pixel-button compact" type="button" @onclick="LockAsync">Lock vault</button>
                </div>
            </section>
        }
        @if (_appView == "drafts" && Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
        {
            
            <div class="sv-drafts-workspace sv-workspace-surface" aria-label="Encrypted local drafts"><VaultHybridDraftEditor /></div>
        }
        @if (_appView == "sync" && Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
        {
            <div class="sv-sync-workspace sv-workspace-surface" aria-label="Synchronization workspace">
            <nav class="sv-pwa-task-tabs" aria-label="Hybrid Sync task">
                <button type="button" class="@(_syncTask == "review" ? "selected" : "")" aria-pressed="@(_syncTask == "review")"
                        @onclick='() => _syncTask = "review"'>Review sync</button>
                <button type="button" class="@(_syncTask == "stage" ? "selected" : "")" aria-pressed="@(_syncTask == "stage")"
                        @onclick='() => _syncTask = "stage"'>Edit published records</button>
            </nav>
            @if (_syncTask == "stage")
            {
                <VaultHybridRemoteChanges />
            }
            else
            {
            <section class="terminal-panel" aria-label="Encrypted local pending changes" style="padding:1rem;margin:1rem 0">
                
                <h2>Changes to sync</h2>
                <p class="advanced-help">Nothing syncs without your approval. Changes that might have been submitted remain pending until verified.</p>
                <button type="button" class="pixel-button compact" @onclick="LoadPendingAsync" disabled="@_pendingLoading">↻ Refresh</button>
                <button type="button" class="pixel-button compact" @onclick="PrepareLocalSyncReviewAsync" disabled="@_pendingLoading">Review changes</button>
                <VaultHybridSyncReview />
                @if (_pendingError is not null) { <p class="terminal-alert warning" role="status">@_pendingError</p> }
                @if (!string.IsNullOrWhiteSpace(_syncEstimateNote)) { <p class="advanced-help" role="status">@_syncEstimateNote</p> }
                @if (_pendingItems.Count > 0)
                {
                    <p role="status">PENDING: @_pendingItems.Count(x => x.State == VaultSyncState.Pending) · UNCERTAIN: @_pendingItems.Count(x => x.State is VaultSyncState.Uncertain or VaultSyncState.Submitting) · CONFLICTS: @_pendingItems.Count(x => x.State == VaultSyncState.Conflict)</p>
                    @if (_pendingItems.Any(x => x.State is VaultSyncState.Submitting or VaultSyncState.Uncertain))
                    {
                        <p class="terminal-alert warning" role="status">UNRESOLVED SUBMISSIONS: DO NOT RETRY. A transaction may already have reached Stellar. Inspect each item's hash and reconcile independently.</p>
                    }
                    @if (_recoveryInspections.Count > 0)
                    {
                        <section aria-label="Submission recovery details">
                            <strong>RECOVERY INSPECTION — READ ONLY</strong>
                            @foreach (var recovery in _recoveryInspections)
                            {
                                <p role="status">
                                    MUTATION: @recovery.MutationId · STATE: @recovery.State
                                    · HASH: @(recovery.TransactionHash ?? "NOT RECORDED")
                                    · @recovery.Guidance
                                </p>
                            }
                        </section>
                    }
                    <div class="record-list">
                        @foreach (var change in _pendingItems.Where(x => !IsHdTreePart(x)).OrderBy(x => x.CreatedUtc))
                        {
                            <button type="button" class="record-card" @onclick="() => OpenPending(change)">
                                <span class="record-card-body"><strong>@PendingTitle(change)</strong><small>@change.Kind · LOCAL @change.State · @change.CreatedUtc.ToLocalTime().ToString("g")</small><small>@(change.State is VaultSyncState.Submitting or VaultSyncState.Uncertain ? "Submission may have reached Stellar — do not retry" : change.State == VaultSyncState.Confirmed ? "Independently confirmed" : "On this device only · Not submitted to Stellar")</small></span><span class="record-chevron">›</span>
                            </button>
                        }
                    </div>
                }
                else if (_pendingError is null && !_pendingLoading) { <p class="advanced-help">No local record or folder changes are pending. Hybrid file synchronization is disabled.</p> }
            </section>
            }
            </div>
        }
        @if (_appView == "records")
        {
        @if (!Ledger.IsConnected)
        {
            <div class="terminal-alert warning" role="status">
                <strong>STELLAR SIGNING SESSION NOT RESTORED</strong>
                <span>A browser refresh ends the in-memory Stellar signing session, even if your internet connection is working. Your local vault is unlocked, but on-chain records require reconnecting with your recovery phrase. No records have been erased.</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="terminal-alert warning" role="status">@_error</div> }
        <div class="sv-mobile-collection-tabs" role="group" aria-label="Browse vault items">
            <button type="button" class="@(_mobileCollection == "all" ? "selected" : "")" aria-pressed="@(_mobileCollection == "all")" @onclick='() => _mobileCollection = "all"'><span aria-hidden="true">▱</span> All Items</button>
            <button type="button" class="@(_mobileCollection == "folders" ? "selected" : "")" aria-pressed="@(_mobileCollection == "folders")" @onclick='() => _mobileCollection = "folders"'><span aria-hidden="true">▱</span> Folders</button>
            <button type="button" class="@(_mobileCollection == "records" ? "selected" : "")" aria-pressed="@(_mobileCollection == "records")" @onclick='() => _mobileCollection = "records"'><span aria-hidden="true">◷</span> Records</button>
        </div>
        <label class="search-console sv-modern-search"><span class="search-prefix" aria-hidden="true">⌕</span><input aria-label="Search your vault" @bind="_search" @bind:event="oninput" placeholder="Search records, folders, and tags" autocomplete="off"/></label>
        @if (Folders.Count > 0 && _folder is null)
        {
            <div class="sv-mobile-folder-shortcuts">
                <div class="sv-mobile-section-heading"><h2>Folder Shortcuts</h2><button type="button" @onclick='() => _mobileCollection = "folders"'>See all <span aria-hidden="true">›</span></button></div>
                <div class="sv-mobile-shortcut-grid">
                    @foreach (var shortcut in Folders.Where(x => string.IsNullOrEmpty(x.FolderId)).Take(4))
                    {
                        <button type="button" @onclick="() => OpenFolder(shortcut.Id)">
                            <span class="sv-mobile-shortcut-icon" aria-hidden="true">📁</span>
                            <strong>@shortcut.Title</strong>
                            <small>@(Folders.Count(x => x.FolderId == shortcut.Id) + Records.Count(x => x.FolderId == shortcut.Id)) items</small>
                        </button>
                    }
                </div>
            </div>
        }
        <div class="sv-mobile-items-heading">
            @if (_folder is not null)
            {
                <button type="button" class="sv-mobile-folder-back" aria-label="Back to vault root" @onclick='() => OpenFolder("")'>‹</button>
            }
            <h2>@(_folder is not null ? (Breadcrumbs.LastOrDefault()?.Title ?? "Items") : _mobileCollection == "folders" ? "Folders" : _mobileCollection == "records" ? "Records" : "All Items")</h2>
            <div class="sv-mobile-item-controls">
                <button type="button" aria-label="Switch between list and grid" @onclick='() => _explorerLayout = _explorerLayout == "list" ? "grid" : "list"'>☷</button>
                <button type="button" aria-label="Show item filters" @onclick='() => _showMobileFilters = !_showMobileFilters'>☷</button>
            </div>
        </div>
        @if (_showMobileFilters)
        {
            <div class="sv-mobile-filter-panel">
                <label><input type="checkbox" @bind="_includeChildren" /> Include subfolders</label>
                <button type="button" @onclick='() => _showMobileFilters = false'>Done</button>
            </div>
        }
        <div class="sv-mobile-collection-content sv-mobile-collection-@_mobileCollection">
        <div class="sv-explorer-layout">
        <aside class="sv-explorer-tree terminal-panel" aria-label="Folder explorer">
            <div class="sv-explorer-tree-title">My Vault <span class="sv-explorer-tree-count">@Folders.Count folders</span></div>
            <button type="button" class="sv-tree-item @(_folder is null ? "selected" : "")"
                    aria-current="@(_folder is null ? "location" : null)"
                    @onclick='() => _folder = null'><span aria-hidden="true">▣</span> My vault</button>
            @foreach (var folder in Folders.OrderBy(f => FolderPath(f.Id), StringComparer.OrdinalIgnoreCase))
            {
                @if (IsTreeFolderVisible(folder))
                {
                    <div class="sv-tree-node" style="--sv-tree-depth:@FolderDepth(folder.Id)">
                        @if (HasTreeChildren(folder.Id))
                        {
                            <button class="sv-tree-expander" type="button" aria-label="@($"Toggle {folder.Title} children")"
                                    aria-expanded="@(!_collapsedFolders.Contains(folder.Id))" @onclick="() => ToggleTreeFolder(folder.Id)">
                                <span aria-hidden="true">@(_collapsedFolders.Contains(folder.Id) ? "▸" : "▾")</span>
                            </button>
                        }
                        else { <span class="sv-tree-expander-placeholder" aria-hidden="true"></span> }
                        <button type="button" class="sv-tree-item @(_folder == folder.Id ? "selected" : "")"
                                aria-current="@(_folder == folder.Id ? "location" : null)" @onclick="() => OpenFolder(folder.Id)">
                            <span class="sv-tree-folder-icon" aria-hidden="true">📁</span>
                            <span class="sv-tree-label">@folder.Title</span>
                        </button>
                    </div>
                }
            }
            @if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
            {
                @foreach (var draft in PendingLocalFolders)
                {
                    <button type="button" class="sv-tree-item @(_folder == draft.EntityId ? "selected" : "")"
                            @onclick="() => OpenFolder(draft.EntityId)">
                        <span aria-hidden="true">▸</span><span class="sv-tree-folder-icon" aria-hidden="true">▣</span>
                        <span class="sv-tree-label">@PendingTitle(draft) <small>local</small></span>
                    </button>
                }
            }
        </aside>
        <div class="sv-explorer-main @(_explorerLayout == "grid" ? "sv-view-grid" : "sv-view-list")" data-explorer-layout="@_explorerLayout">
        <section class="terminal-panel sv-explorer-folder-panel">
            <nav class="sv-explorer-breadcrumbs" aria-label="Folder path">

                <button class="pixel-button compact" @onclick='() => _folder = null'>My vault</button>
                @foreach (var crumb in Breadcrumbs)
                {
                    <span>/</span><button class="pixel-button compact" @onclick="() => _folder = crumb.Id">@crumb.Title</button>
                }
                @if (_folder is not null && PendingLocalFolders.Any(x => x.EntityId == _folder))
                {
                    <span>/</span><button class="pixel-button compact" @onclick="OpenLocalParentFolder">LOCAL PARENT</button>
                    <span>/</span><strong>📁 @PendingTitle(PendingLocalFolders.First(x => x.EntityId == _folder)) (LOCAL)</strong>
                }
            </nav>
            <div class="sv-current-folder">
                <span class="sv-current-folder-icon" aria-hidden="true">📁</span>
                <div class="sv-current-folder-name"><h2>@(Breadcrumbs.LastOrDefault()?.Title ?? "My vault")</h2>
                    <small>@(Folders.Count(x => x.FolderId == _folder) + Filtered.Count) items</small></div>
                <div class="sv-layout-switch" role="group" aria-label="Explorer layout">
                    <button type="button" class="@(_explorerLayout == "list" ? "selected" : "")"
                            aria-label="List view" aria-pressed="@(_explorerLayout == "list")"
                            @onclick='() => _explorerLayout = "list"'>☷</button>
                    <button type="button" class="@(_explorerLayout == "grid" ? "selected" : "")"
                            aria-label="Grid view" aria-pressed="@(_explorerLayout == "grid")"
                            @onclick='() => _explorerLayout = "grid"'>▦</button>
                </div>
            </div>
            <div class="sv-explorer-toolbar"><label><input type="checkbox" @bind="_includeChildren" aria-label="Include records from subfolders" /><span>Include subfolders</span></label><span class="sv-explorer-toolbar-count">@Filtered.Count records</span></div>
            <div class="sv-access-actions">
                <button class="pixel-button compact" type="button" @onclick='() => OpenEditor("record")'>New record</button>
                <button class="pixel-button compact" type="button" @onclick='() => OpenEditor("folder")'>New folder</button>
                <button class="pixel-button compact" type="button" @onclick='() => OpenEditor("file")'>Add file</button>
            </div>
            <div class="sv-explorer-list-head" aria-hidden="true"><span>Name</span><span>Type</span><span>Storage</span><span></span></div>
            <div class="sv-folder-grid">
            @foreach (var item in Folders.Where(f => f.FolderId == _folder))
            {
                <div class="sv-folder-tile">
                    <button class="pixel-button compact sv-folder-open" @onclick="() => OpenFolder(item.Id)"><span aria-hidden="true">📁</span><span>@item.Title</span></button>
                    <span class="sv-object-type">Folder</span><span class="sv-object-storage">Stellar</span>
                    <details class="sv-object-actions"><summary aria-label="@($"Actions for folder {item.Title}")" title="More actions">⋯</summary>
                        <div class="sv-object-menu">
                            <button type="button" @onclick="() => OpenFolder(item.Id)">Open folder</button>
                            <button type="button" @onclick='() => OpenEditor("folder", item.Id)'>Rename / move</button>
                            <button type="button" class="sv-object-delete" @onclick="() => SelectDelete(item)">Delete</button>
                        </div>
                    </details>
                </div>
            }
            @if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
            {
                @foreach (var draft in PendingLocalFolders.Where(x => PendingFolderId(x) == _folder))
                {
                    <div class="sv-folder-tile">
                        <button class="pixel-button compact sv-folder-open" type="button" @onclick="() => OpenFolder(draft.EntityId)">
                            <span aria-hidden="true">📁</span><span>@PendingTitle(draft) · Local</span>
                        </button>
                        <span class="sv-object-type">Folder</span><span class="sv-object-storage">Local</span>
                        <details class="sv-object-actions"><summary aria-label="@($"Actions for {PendingTitle(draft)}")" title="More actions">⋯</summary>
                            <div class="sv-object-menu">
                                <button type="button" @onclick="() => OpenFolder(draft.EntityId)">Open folder</button>
                                <button type="button" @onclick="() => OpenPending(draft)">Edit local draft</button>
                            </div>
                        </details>
                    </div>
                }
            }
            </div>
            @if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
            {
                @foreach (var draft in _pendingItems.Where(x => x.State == VaultSyncState.Pending &&
                    x.Kind is VaultMutationKind.CreateRecord or VaultMutationKind.UpdateRecord or VaultMutationKind.UploadFile &&
                    PendingFolderId(x) == _folder && !IsHdTreePart(x)))
                {
                    <div class="sv-object-row">
                        <button type="button" class="record-card sv-modern-record" @onclick="() => OpenPending(draft)">
                            <span class="sv-modern-record-icon" aria-hidden="true">▤</span>
                            <span class="record-card-body"><strong>@PendingTitle(draft)</strong><small>Local draft · Not on Stellar</small></span>
                        </button>
                        <details class="sv-object-actions"><summary aria-label="@($"Actions for {PendingTitle(draft)}")" title="More actions">⋯</summary>
                            <div class="sv-object-menu"><button type="button" @onclick="() => OpenPending(draft)">View or edit draft</button></div>
                        </details>
                    </div>
                }
            }

