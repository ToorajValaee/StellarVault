@page "/vault"
@using StellarVault.Core.Services
@using System.Text.Json
@using System.Security.Cryptography
@using StellarVault.Pwa.Services
@using Microsoft.JSInterop
@inject IStellarLedgerRecords Ledger
@inject VaultSessionManager Sessions
@inject VaultSessionWorkflow Workflow
@inject VaultDeviceRetentionGate Retention
@inject VaultPendingMutationQueue PendingQueue
@inject VaultManualSyncCoordinator ManualSync
@inject VaultHybridSyncReviewService HybridReview
@inject VaultUnrecordedSubmissionDiagnostic UnknownHashInvestigation
@inject VaultNetworkSelection Networks
@inject NavigationManager Nav

<AdaptiveShell PlatformName="WEB PWA" Subtitle="YOUR VAULT">
@if (!Sessions.IsUnlocked && !Ledger.IsConnected)
{
    <section class="terminal-panel centered-message"><h1>Vault locked</h1><a class="pixel-button primary" href="/">Unlock vault</a></section>
}
else if (Ledger.IsConnected && _registryReady != true)
{
    <section class="terminal-panel centered-message">
        <h1>Finish setup</h1>
        <p>One step remains before your records are available.</p>
        <a class="pixel-button primary" href="/initialize">Continue setup</a>
    </section>
}
else
{
    <div class="sv-pwa-app" aria-label="StellarVault application">
        <nav class="sv-pwa-rail" aria-label="Vault navigation">
            <div class="sv-pwa-rail-heading"><span class="sv-pwa-rail-mark" aria-hidden="true">✦</span><span><strong>STELLARVAULT</strong></span></div>
            <button type="button" class="@(_appView == "records" ? "selected" : "")" aria-current="@(_appView == "records" ? "page" : null)"
                    @onclick='() => SelectAppView("records")'><span aria-hidden="true">▤</span> Records</button>
            @if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
            {
                <button type="button" class="@(_appView == "drafts" ? "selected" : "")" aria-current="@(_appView == "drafts" ? "page" : null)"
                        @onclick='() => SelectAppView("drafts")'><span aria-hidden="true">▧</span> Drafts</button>
                <button type="button" class="@(_appView == "sync" ? "selected" : "")" aria-current="@(_appView == "sync" ? "page" : null)"
                        @onclick='() => SelectAppView("sync")'><span aria-hidden="true">⇅</span> Sync</button>
            }
            <div class="sv-pwa-rail-divider"></div>
            <a href="/add" class="sv-pwa-rail-action"><span aria-hidden="true">＋</span> New record</a>
            <a href="/add?kind=folder" class="sv-pwa-rail-action"><span aria-hidden="true">▣</span> New folder</a>
            <a href="/add?kind=file" class="sv-pwa-rail-action"><span aria-hidden="true">⇧</span> Add file</a>
            <div class="sv-pwa-rail-foot"><span class="sv-pwa-led @(Ledger.IsConnected ? "connected" : "")"></span>@(Ledger.IsConnected ? "Stellar connected" : "Not connected")</div>
        </nav>
        <main class="sv-pwa-stage" id="sv-pwa-workspace" tabindex="-1" @key="_appView">
        <section class="vault-page sv-pwa-vault-page">
            <header class="sv-pwa-screen-header">
                <div>
                    <h1>@(_appView == "records" ? "Records" : _appView == "drafts" ? "Drafts" : "Sync")</h1>
                    
                </div>
                <div class="sv-pwa-screen-tools">
                    @if (!Ledger.IsConnected) { <button class="pixel-button compact" type="button" @onclick="ReconnectAsync">CONNECT STELLAR</button> }
                    <button class="pixel-button compact" type="button" disabled="@(_infoLoading || !Ledger.IsConnected)" aria-label="Account information" @onclick="OpenAccountInfoAsync">ⓘ Account</button>
                    @if (_appView == "records") { <button class="pixel-button compact" type="button" @onclick="RefreshAsync" disabled="@(_busy || !Ledger.IsConnected)">↻ Refresh</button> }
                    <button class="pixel-button compact" type="button" @onclick="LockAsync">Lock</button>
                </div>
            </header>
            @if (_appView == "records" && Ledger.IsConnected)
            {
                <div class="stats-strip sv-pwa-summary"><div><span>Records</span><strong>@Records.Count</strong></div><div><span>Folders</span><strong>@Folders.Count</strong></div></div>
            }
        @if (_appView == "drafts" && Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
        {
            
            <VaultHybridDraftEditor />
        }
        @if (_appView == "sync" && Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
        {
            <nav class="sv-pwa-task-tabs" aria-label="Hybrid Sync task">
                <button type="button" class="@(_syncTask == "review" ? "selected" : "")" aria-pressed="@(_syncTask == "review")"
                        @onclick='() => _syncTask = "review"'>Review sync</button>
                <button type="button" class="@(_syncTask == "stage" ? "selected" : "")" aria-pressed="@(_syncTask == "stage")"
                        @onclick='() => _syncTask = "stage"'>Edit published records</button>
            </nav>
            @if (_syncTask == "stage")
            {
                <VaultHybridRemoteChanges />
            }
            else
            {
            <section class="terminal-panel" aria-label="Encrypted local pending changes" style="padding:1rem;margin:1rem 0">
                
                <h2>Changes to sync</h2>
                <p class="advanced-help">Nothing syncs without your approval. Changes that might have been submitted remain pending until verified.</p>
                <button type="button" class="pixel-button compact" @onclick="LoadPendingAsync" disabled="@_pendingLoading">↻ Refresh</button>
                <button type="button" class="pixel-button compact" @onclick="PrepareLocalSyncReviewAsync" disabled="@_pendingLoading">Review changes</button>
                <VaultHybridSyncReview />
                @if (_pendingError is not null) { <p class="terminal-alert warning" role="status">@_pendingError</p> }
                @if (_pendingItems.Count > 0)
                {
                    <p role="status">PENDING: @_pendingItems.Count(x => x.State == VaultSyncState.Pending) · UNCERTAIN: @_pendingItems.Count(x => x.State is VaultSyncState.Uncertain or VaultSyncState.Submitting) · CONFLICTS: @_pendingItems.Count(x => x.State == VaultSyncState.Conflict)</p>
                    @if (_pendingItems.Any(x => x.State is VaultSyncState.Submitting or VaultSyncState.Uncertain))
                    {
                        <p class="terminal-alert warning" role="status">UNRESOLVED SUBMISSIONS: DO NOT RETRY. A transaction may already have reached Stellar. Inspect each item's hash and reconcile independently.</p>
                    }
                    @if (_recoveryInspections.Count > 0)
                    {
                        <section aria-label="Submission recovery details">
                            <strong>RECOVERY INSPECTION — READ ONLY</strong>
                            @foreach (var recovery in _recoveryInspections)
                            {
                                <p role="status">
                                    MUTATION: @recovery.MutationId · STATE: @recovery.State
                                    · HASH: @(recovery.TransactionHash ?? "NOT RECORDED")
                                    · @recovery.Guidance
                                </p>
                            }
                        </section>
                    }
                    <div class="record-list">
                        @foreach (var change in _pendingItems.OrderBy(x => x.CreatedUtc))
                        {
                            <button type="button" class="record-card" @onclick="() => OpenPending(change)">
                                <span class="record-card-body"><strong>@PendingTitle(change)</strong><small>@change.Kind · LOCAL @change.State · @change.CreatedUtc.ToLocalTime().ToString("g")</small><small>@(change.State is VaultSyncState.Submitting or VaultSyncState.Uncertain ? "Submission may have reached Stellar — do not retry" : change.State == VaultSyncState.Confirmed ? "Independently confirmed" : "On this device only · Not submitted to Stellar")</small></span><span class="record-chevron">›</span>
                            </button>
                        }
                    </div>
                }
                else if (_pendingError is null && !_pendingLoading) { <p class="advanced-help">No local record or folder changes are pending. Hybrid file synchronization is disabled.</p> }
            </section>
            }
        }
        @if (_appView == "records")
        {
        @if (!Ledger.IsConnected)
        {
            <div class="terminal-alert warning" role="status">
                <strong>STELLAR SIGNING SESSION NOT RESTORED</strong>
                <span>A browser refresh ends the in-memory Stellar signing session, even if your internet connection is working. Your local vault is unlocked, but on-chain records require reconnecting with your recovery phrase. No records have been erased.</span>
            </div>
        }
        <label class="search-console sv-modern-search"><span class="search-prefix" aria-hidden="true">⌕</span><input aria-label="Search your vault" @bind="_search" @bind:event="oninput" placeholder="Search records, folders, and tags" autocomplete="off"/></label>
        @if (!string.IsNullOrWhiteSpace(_error)) { <div class="terminal-alert warning" role="status">@_error</div> }
        <div class="sv-explorer-layout">
        <aside class="sv-explorer-tree terminal-panel" aria-label="Folder explorer">
            <div class="sv-explorer-tree-title">Folders</div>
            <button type="button" class="sv-tree-item @(_folder is null ? "selected" : "")"
                    aria-current="@(_folder is null ? "location" : null)"
                    @onclick='() => _folder = null'><span aria-hidden="true">▣</span> My vault</button>
            @foreach (var folder in Folders.OrderBy(f => FolderPath(f.Id), StringComparer.OrdinalIgnoreCase))
            {
                <button type="button" class="sv-tree-item @(_folder == folder.Id ? "selected" : "")"
                        style="--sv-tree-depth:@FolderDepth(folder.Id)"
                        aria-current="@(_folder == folder.Id ? "location" : null)"
                        @onclick="() => OpenFolder(folder.Id)">
                    <span aria-hidden="true">▸</span><span class="sv-tree-folder-icon" aria-hidden="true">▣</span>
                    <span class="sv-tree-label">@folder.Title</span>
                </button>
            }
            @if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
            {
                @foreach (var draft in PendingLocalFolders)
                {
                    <button type="button" class="sv-tree-item @(_folder == draft.EntityId ? "selected" : "")"
                            @onclick="() => OpenFolder(draft.EntityId)">
                        <span aria-hidden="true">▸</span><span class="sv-tree-folder-icon" aria-hidden="true">▣</span>
                        <span class="sv-tree-label">@PendingTitle(draft) <small>local</small></span>
                    </button>
                }
            }
        </aside>
        <div class="sv-explorer-main">
        <section class="terminal-panel sv-explorer-folder-panel">
            <nav class="sv-explorer-breadcrumbs" aria-label="Folder path">

                <button class="pixel-button compact" @onclick='() => _folder = null'>My vault</button>
                @foreach (var crumb in Breadcrumbs)
                {
                    <span>/</span><button class="pixel-button compact" @onclick="() => _folder = crumb.Id">@crumb.Title</button>
                }
                @if (_folder is not null && PendingLocalFolders.Any(x => x.EntityId == _folder))
                {
                    <span>/</span><button class="pixel-button compact" @onclick="OpenLocalParentFolder">LOCAL PARENT</button>
                    <span>/</span><strong>📁 @PendingTitle(PendingLocalFolders.First(x => x.EntityId == _folder)) (LOCAL)</strong>
                }
            </nav>
            <label style="display:flex;gap:.65rem;align-items:center;margin:.75rem 0"><input type="checkbox" @bind="_includeChildren" aria-label="Include records from subfolders" /><span>Include subfolders</span></label>
            <div class="sv-folder-grid">
            @foreach (var item in Folders.Where(f => f.FolderId == _folder))
            {
                <div class="sv-folder-tile">
                    <button class="pixel-button compact sv-folder-open" @onclick="() => OpenFolder(item.Id)"><span aria-hidden="true">📁</span><span>@item.Title</span></button>
                    <details><summary>⋯</summary>
                        <a class="pixel-button compact" href="@($"/edit/{item.Id}")">RENAME / MOVE</a>
                        <button class="pixel-button compact" @onclick="() => SelectDelete(item)">DELETE</button>
                    </details>
                </div>
            }
                @if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
                {
                    @foreach (var draft in PendingLocalFolders.Where(x => PendingFolderId(x) == _folder))
                    {
                        <div class="sv-folder-tile">
                            <button class="pixel-button compact" type="button" @onclick="() => OpenFolder(draft.EntityId)">📁 @PendingTitle(draft) · LOCAL</button>
                            <button class="pixel-button compact" type="button" @onclick="() => OpenPending(draft)">EDIT DRAFT</button>
                        </div>
                    }
                }
            </div>
            @if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
            {
                @foreach (var draft in _pendingItems.Where(x => x.State == VaultSyncState.Pending &&
                    x.Kind is VaultMutationKind.CreateRecord or VaultMutationKind.UpdateRecord or VaultMutationKind.UploadFile &&
                    PendingFolderId(x) == _folder))
                {
                    <button type="button" class="record-card" @onclick="() => OpenPending(draft)">
                        <span class="record-card-body"><strong>@PendingTitle(draft)</strong><small>LOCAL DRAFT · @draft.Kind · NOT ON STELLAR</small></span>
                        <span class="record-chevron">›</span>
                    </button>
                }
            }
            <div class="sv-access-actions">
                <a class="pixel-button compact" href="@($"/add?folder={_folder}")">New record</a>
                <a class="pixel-button compact" href="@($"/add?folder={_folder}&kind=folder")">New folder</a>
                <a class="pixel-button compact" href="/add?kind=file">Add file</a>
            </div>
        </section>
        @if (_busy) { <div class="terminal-alert" role="status"><span class="sv-loading-spinner"></span> @_busyMessage</div> }
        <section class="record-list">
            @if (_busy) { <p role="status">SYNCING STELLAR LEDGER...</p> }
            else if (!Ledger.IsConnected) { <div class="terminal-panel empty-state"><h2>ON-CHAIN RECORDS NOT LOADED</h2><p>Reconnect with your recovery phrase to load on-chain records. This does not indicate an internet outage or an empty vault.</p></div> }
            else if (Filtered.Count == 0) { <div class="terminal-panel empty-state"><h2>NO MATCH</h2><p>No records found for this folder and search.</p></div> }
            else
            {
                @foreach (var item in Filtered)
                {
                    <button class="record-card sv-modern-record" type="button" @onclick="() => OpenRecord(item)">
                        <span class="sv-modern-record-icon" aria-hidden="true">@(IsLedgerFile(item) ? "▤" : "▦")</span>
                        <span class="record-card-body"><strong>@item.Title</strong><small>@(IsLedgerFile(item) ? "Encrypted file" : "Secure record")</small>
                        @if (item.Tags is { Length: > 0 }) { <span class="tag-row">@foreach (var tag in item.Tags.Take(3)) { <span class="pixel-tag">#@tag</span> }</span> }
                        @if (_includeChildren || !string.IsNullOrWhiteSpace(_search)) { <small>📁 @FolderPath(item.FolderId)</small> }
                        </span><span class="record-chevron">›</span>
                    </button>
                }
            }
        </section>
        </div>
        </div>
        }
        </section>
        </main>
        <nav class="sv-pwa-mobile-tabs" aria-label="Mobile vault navigation">
            <button type="button" class="@(_appView == "records" ? "selected" : "")" aria-current="@(_appView == "records" ? "page" : null)" @onclick='() => SelectAppView("records")'><span aria-hidden="true">▤</span>Records</button>
            @if (Retention.AllowsLocalPersistence && Sessions.IsUnlocked)
            {
                <button type="button" class="@(_appView == "drafts" ? "selected" : "")" aria-current="@(_appView == "drafts" ? "page" : null)" @onclick='() => SelectAppView("drafts")'><span aria-hidden="true">▧</span>Drafts</button>
                <button type="button" class="@(_appView == "sync" ? "selected" : "")" aria-current="@(_appView == "sync" ? "page" : null)" @onclick='() => SelectAppView("sync")'><span aria-hidden="true">⇅</span>Sync</button>
            }
            <a href="/add"><span aria-hidden="true">＋</span>New</a>
        </nav>
    </div>
    @if (_selectedPending is not null)
    {
        <div class="modal-backdrop" @onclick="ClosePending">
            <section class="record-modal terminal-panel" role="dialog" aria-modal="true"
                     aria-labelledby="sv-local-draft-title" @onclick:stopPropagation="true">
                <header class="modal-header">
                    <div><div class="panel-kicker">LOCAL DRAFT // NOT ON STELLAR</div><h2 id="sv-local-draft-title">@PendingTitle(_selectedPending)</h2></div>
                    <button class="icon-button close-button" @onclick="ClosePending" aria-label="Close local draft">×</button>
                </header>
                @if (_selectedPending.State == VaultSyncState.Pending &&
                    _selectedPending.Kind is VaultMutationKind.CreateRecord or VaultMutationKind.UpdateRecord or VaultMutationKind.CreateFolder or VaultMutationKind.UpdateFolder)
                {
                    <label class="terminal-label">LOCAL DRAFT TITLE</label>
                    <input class="terminal-input" @bind="_pendingEditTitle" maxlength="256" />
                    @if (_selectedPending.Kind is VaultMutationKind.CreateRecord or VaultMutationKind.UpdateRecord)
                    {
                        <label class="terminal-label">USERNAME / IDENTIFIER</label>
                        <input class="terminal-input" @bind="_pendingEditUsername" />
                        <label class="terminal-label">SECRET / CONTENT</label>
                        <textarea class="terminal-input terminal-textarea" rows="4" @bind="_pendingEditContent"></textarea>
                        <label class="terminal-label">URL</label>
                        <input class="terminal-input" @bind="_pendingEditUrl" />
                        <label class="terminal-label">NOTES</label>
                        <textarea class="terminal-input terminal-textarea" rows="3" @bind="_pendingEditNotes"></textarea>
                        <label class="terminal-label">TAGS (COMMA SEPARATED)</label>
                        <input class="terminal-input" @bind="_pendingEditTags" />
                    }
                    <label class="terminal-label">PARENT FOLDER</label>
                    <select class="terminal-input" @bind="_pendingEditFolder">
                        <option value="">My vault (ROOT)</option>
                        @foreach (var folder in Folders.Where(x => x.Id != _selectedPending.EntityId))
                        {
                            <option value="@folder.Id">STELLAR · @folder.Title</option>
                        }
                        @foreach (var folder in PendingLocalFolders.Where(x => x.EntityId != _selectedPending.EntityId))
                        {
                            <option value="@folder.EntityId">LOCAL · @PendingTitle(folder)</option>
                        }
                    </select>
                    <button class="pixel-button compact" type="button" disabled="@_pendingDeleting" @onclick="SavePendingTitleAsync">SAVE LOCAL DRAFT CHANGES</button>
                }
                @if (_selectedPending.Kind == VaultMutationKind.UploadFile)
                {
                    <div class="data-field"><span class="field-label">ENCRYPTED LOCAL FILE</span><p>This copy exists only on this device.</p>
                        <button class="pixel-button compact" type="button" @onclick="DownloadPendingFileAsync">DOWNLOAD LOCAL FILE</button>
                        @if (_pendingFileStatus is not null) { <p role="status">@_pendingFileStatus</p> }
                    </div>
                }
                <div class="data-field"><span class="field-label">OPERATION</span><code>@_selectedPending.Kind</code></div>
                <div class="data-field"><span class="field-label">LOCAL STATUS</span><code>@_selectedPending.State</code></div>
                @if (_selectedPending.State == VaultSyncState.Pending &&
                    _selectedPending.Kind is VaultMutationKind.CreateRecord or VaultMutationKind.CreateFolder &&
                    _selectedPending.EntityId.Length == 32 && Ledger.IsConnected)
                {
                    <p class="advanced-help">Legacy offline ID: migration requires a current ledger read and does not publish data.</p>
                    <button type="button" class="pixel-button compact" disabled="@_pendingDeleting" @onclick="MigrateSelectedLegacyIdAsync">MIGRATE LEGACY LOCAL ID</button>
                }
                <div class="data-field"><span class="field-label">SAVED ON DEVICE</span><code>@_selectedPending.CreatedUtc.ToLocalTime().ToString("g")</code></div>
                @if (_selectedPending.State is VaultSyncState.Submitting or VaultSyncState.Uncertain)
                {
                    <div class="terminal-alert warning" role="alert">
                        Submission was attempted or its outcome is unknown. Do not publish this change again.
                        @if (_selectedPending.TransactionHash is not null)
                        {
                            <p>Recorded transaction hash: <code>@_selectedPending.TransactionHash</code></p>
                        }
                        else
                        {
                            <p>No transaction hash was durably recorded. This does not prove that submission failed.</p>
                        }
                        <p>Independent ledger reconciliation is required before this change can be marked confirmed.</p>
                        @if (_selectedPending.TransactionHash is null &&
                            _selectedPending.Kind is VaultMutationKind.CreateRecord or VaultMutationKind.CreateFolder)
                        {
                            <div class="data-field">
                                <span class="field-label">READ-ONLY CANDIDATE TRANSACTION INVESTIGATION</span>
                                <p>This cannot identify the original submission or mark the draft confirmed. Enter a transaction hash found during independent ledger investigation and the expected HD child information.</p>
                                <label class="terminal-label" for="sv-candidate-hash">CANDIDATE TRANSACTION HASH</label>
                                <input id="sv-candidate-hash" class="terminal-input" @bind="_candidateHash" maxlength="64" spellcheck="false" autocomplete="off" />
                                <label class="terminal-label" for="sv-candidate-child">EXPECTED HD CHILD ACCOUNT</label>
                                <input id="sv-candidate-child" class="terminal-input" @bind="_candidateChildAccount" maxlength="56" spellcheck="false" autocomplete="off" />
                                <label class="terminal-label" for="sv-candidate-index">EXPECTED CHILD INDEX (1–63)</label>
                                <input id="sv-candidate-index" class="terminal-input" type="number" min="1" max="63" step="1" @bind="_candidateChildIndex" />
                                <button type="button" class="pixel-button compact" disabled="@(_pendingDeleting || !Ledger.IsConnected)" @onclick="InspectUnrecordedCandidateAsync">INSPECT CANDIDATE — READ ONLY</button>
                                @if (_candidateInvestigationStatus is not null)
                                {
                                    <p role="status" class="terminal-alert warning">@_candidateInvestigationStatus</p>
                                }
                            </div>
                        }
                        @if (_selectedPending.TransactionHash is not null)
                        {
                            <button type="button" class="pixel-button compact" disabled="@_pendingDeleting" @onclick="ReconcileSelectedAsync">CHECK LEDGER CONFIRMATION</button>
                        }
                    </div>
                }
                else if (_selectedPending.State == VaultSyncState.Confirmed)
                {
                    <p role="status">This queue entry has a confirmed state. Verify the corresponding ledger record before relying on it.</p>
                }
                else
                {
                    <div class="terminal-alert warning" role="status">This is an encrypted local queue entry. Manual synchronization, conflict resolution and fee approval remain under development.</div>
                }
                @if (_selectedPending.State == VaultSyncState.Pending)
                {
                    <button type="button" class="pixel-button compact" @onclick="DiscardSelectedPendingAsync" disabled="@_pendingDeleting">DISCARD LOCAL DRAFT</button>
                }
                @if (_pendingDeleteError is not null) { <div class="terminal-alert warning" role="alert">@_pendingDeleteError</div> }
                <button type="button" class="pixel-button compact" @onclick="ClosePending">CLOSE</button>
            </section>
        </div>
    }
    @if (_selected is not null)
    {
        <div class="modal-backdrop" @onclick="CloseRecord">
            <section class="record-modal terminal-panel" role="dialog" aria-modal="true"
                     aria-labelledby="sv-record-title" @onclick:stopPropagation="true">
                <header class="modal-header">
                    <div><div class="panel-kicker">RECORD // @_selected.Id</div><h2 id="sv-record-title">@_selected.Title</h2></div>
                    <button class="icon-button close-button" @onclick="CloseRecord" aria-label="Close record">×</button>
                </header>
                <div class="data-field"><span class="field-label">FOLDER PATH</span><div class="field-value-row"><code>@FolderPath(_selected.FolderId)</code></div></div>
                @if (IsLedgerFile(_selected))
                {
                    <div class="data-field"><span class="field-label">ENCRYPTED LEDGER FILE</span><p>Stored in encrypted Stellar ledger chunks.</p><button class="pixel-button primary" type="button" @onclick="DownloadLedgerFileAsync">DOWNLOAD DECRYPTED FILE</button>@if (!string.IsNullOrWhiteSpace(_fileDownloadStatus)) { <p role="status" class="advanced-help">@_fileDownloadStatus</p> }</div>
                }
                else
                {
                <div class="data-field"><span class="field-label">USERNAME / IDENTIFIER</span><div class="field-value-row"><code>@(_selected.UserName ?? "—")</code><button class="mini-button" @onclick='() => CopyValueAsync(_selected.UserName)'>COPY</button></div></div>
                <div class="data-field secret-field"><span class="field-label">SECRET</span><div class="field-value-row"><code class="secret-value">@(_revealed ? _selected.Content : "••••••••••••")</code><div class="inline-actions"><button class="mini-button" @onclick="() => _revealed = !_revealed">@(_revealed ? "HIDE" : "REVEAL")</button><button class="mini-button" @onclick='() => CopyValueAsync(_selected.Content)'>COPY</button></div></div></div>
                @if (!string.IsNullOrWhiteSpace(_selected.Url)) { <div class="data-field"><span class="field-label">URL</span><div class="field-value-row"><code>@_selected.Url</code><button class="mini-button" @onclick='() => CopyValueAsync(_selected.Url)'>COPY</button></div></div> }
                @if (!string.IsNullOrWhiteSpace(_selected.Notes)) { <div class="data-field"><span class="field-label">NOTES</span><p class="record-notes" style="white-space:pre-wrap">@_selected.Notes</p></div> }
                @if (_selected.Tags is { Length: > 0 }) { <div class="tag-row detail-tags">@foreach (var tag in _selected.Tags) { <span class="pixel-tag">#@tag</span> }</div> }
                }
                <div class="modal-action-row record-actions">
