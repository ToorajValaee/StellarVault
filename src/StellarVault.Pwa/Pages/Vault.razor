    private async Task QuarantineInterruptedAsync()
    {
        if (_pendingLoading || !Retention.AllowsLocalPersistence ||
            !Sessions.IsUnlocked || Sessions.ActiveAccountId is not string account) return;
        _pendingLoading = true;
        try
        {
            var network = Networks.CredentialKey(account);
            var interrupted = await PendingQueue.ReviewInterruptedAsync(account, network);
            foreach (var entry in interrupted.Where(x => x.State == VaultSyncState.Submitting))
                await PendingQueue.QuarantineInterruptedAsync(account, network, entry.Id);
            _pendingError = null;
            _syncReview = await PendingQueue.PrepareReviewAsync(account, network);
            _pendingItems = await PendingQueue.ReviewAllAsync(account, network);
            _syncEstimates = [];
            ClearSyncApproval();
            _approvalStatus = null;
        }
        catch (Exception ex) { _pendingError = "Interrupted submission review failed: " + ex.Message; }
        finally { _pendingLoading = false; }
    }

    private VaultSyncApprovalSnapshot? _reviewedQuote;
    private bool _approvalAcknowledged;
    private string? _reviewedDraftTitle;
    private void ClearSyncApproval()
    {
        _reviewedQuote = null;
        _approvalAcknowledged = false;
        _reviewedDraftTitle = null;
    }

    private string? _approvalStatus;
    private async Task ReviewApprovalAsync(VaultSyncApprovalSnapshot snapshot)
    {
        _approvalStatus = null;
        ClearSyncApproval();
        if (_pendingLoading || !Ledger.IsConnected || !Sessions.IsUnlocked ||
            Sessions.ActiveAccountId is not string account) return;
        _pendingLoading = true;
        try
        {
            var network = Networks.CredentialKey(account);
            var review = await PendingQueue.PrepareReviewAsync(account, network);
            var mutation = review.Ready.SingleOrDefault(x => x.Id == snapshot.MutationId)
                ?? throw new InvalidOperationException("Mutation is no longer ready.");
            VaultSyncApprovalGuard.RequireFresh(snapshot, mutation, account, network,
                DateTimeOffset.UtcNow, TimeSpan.FromMinutes(5));
            var draft = JsonSerializer.Deserialize<LedgerRecordDraft>(mutation.EncryptedPayload)
                ?? throw new InvalidDataException("Invalid queued record draft.");
            var fresh = await Ledger.EstimateAsync(draft);
            if (fresh.NetworkFeeXlm > snapshot.QuotedFeeXlm ||
                fresh.PeakReserveXlm > snapshot.QuotedPeakReserveXlm)
                throw new InvalidOperationException("Costs increased. Estimate again.");
            _reviewedQuote = snapshot;
            _reviewedDraftTitle = draft.Title;
            _approvalStatus = "Quote checked against current queue and costs. Review the details below. Broadcasting is disabled.";
        }
        catch (Exception ex) { _approvalStatus = "Quote rejected: " + ex.Message; }
        finally { _pendingLoading = false; }
    }

    private async Task CheckApprovedPreflightAsync()
    {
        if (!_approvalAcknowledged || _reviewedQuote is null || !Ledger.IsConnected ||
            _pendingLoading || Sessions.ActiveAccountId is not string account) return;
        _pendingLoading = true;
        _approvalStatus = null;
        try
        {
            var eligible = await ManualSync.CanPublishApprovedCreateAsync(_reviewedQuote, account);
            _approvalStatus = eligible ? "Current approval, ledger and costs pass the read-only check. Publishing stays disabled." : "Eligibility failed. Review network, draft, remote records and cost limits again.";
        }
        catch (Exception ex)
        {
            ClearSyncApproval();
            _approvalStatus = "Preflight rejected. Start a new review: " + ex.Message;
        }
        finally { _pendingLoading = false; }
    }

