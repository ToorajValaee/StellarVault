@page "/secret-vault"
@using VaultEngine.Stellar.Services
@inject IStellarSecretKeyLedger SecretLedger
@inject IStellarLedgerRecords HdLedger
@inject VaultSessionManager Sessions
@inject NavigationManager Navigation

@* Preserve old deep links without mounting a second workspace or granting
   permissions. Authenticated sessions resolve exclusively at /vault. *@
<section class="terminal-panel centered-message" role="status">
    <p>Opening the shared vault workspace…</p>
</section>

@code {
    protected override void OnInitialized()
    {
        var mode = VaultWorkspaceModeResolver.Resolve(
            Sessions.IsUnlocked, HdLedger.IsConnected, SecretLedger.IsConnected);
        Navigation.NavigateTo(mode == VaultWorkspaceMode.ConflictingSessions
            ? "/" : "/vault", replace: true);
    }
}
