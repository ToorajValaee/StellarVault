@page "/secret-vault"
@using StellarVault.Core.Services
@inject IStellarSecretKeyLedger SecretLedger
@inject NavigationManager Navigation

<AdaptiveShell PlatformName="WEB PWA" Subtitle="SECRET KEY VAULT">
    <ChildContent>
        @if (SecretLedger.IsConnected)
        {
            <main class="sv-secret-route" aria-label="StellarVault independent Secret Key workspace">
                <VaultSecretKeyWorkspace />
            </main>
        }
        else
        {
            <section class="terminal-panel" aria-label="Vault locked">
                <h2>Secret Key vault is locked</h2>
                <p>Unlock this independent account-chain vault using its original Stellar secret key. A BIP-39 mnemonic is not required.</p>
                <button type="button" class="pixel-button primary" @onclick='() => Navigation.NavigateTo("/")'>Return to unlock</button>
                <VaultLinkedLocalQueuePanel />
            </section>
        }
    </ChildContent>
</AdaptiveShell>
