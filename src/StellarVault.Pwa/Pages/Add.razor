@page "/add"
@page "/edit/{RecordId}"
@using StellarVault.Core.Services
@using Microsoft.AspNetCore.Components.Forms
@using System.Text.Json
@using System.Security.Cryptography
@implements IDisposable
@inject IStellarLedgerRecords Ledger
@inject VaultSessionManager Sessions
@inject NavigationManager Nav

<AdaptiveShell PlatformName="WEB PWA" Subtitle="WRITE OPERATION">
@if (!Sessions.IsUnlocked)
{
    <section class="terminal-panel centered-message"><h1>DATABASE LOCKED</h1><a class="pixel-button primary" href="/">OPEN ACCESS TERMINAL</a></section>
}
else
{
    <section class="form-page">
        <header class="page-command-header">
            <div><div class="panel-kicker">WRITE OPERATION // @(!string.IsNullOrWhiteSpace(RecordId) ? "EDIT" : "NEW") @(_kind == "folder" ? "FOLDER" : _kind == "file" ? "FILE" : "RECORD")</div><h1>@(!string.IsNullOrWhiteSpace(RecordId) ? "EDIT EXISTING RECORD" : _kind == "folder" ? "CREATE FOLDER" : _kind == "file" ? "ADD FILE" : "ADD RECORD")</h1><p class="page-subtitle">@(_kind == "file" ? "Publish an encrypted file to the Stellar ledger with fee approval." : "Encrypted Stellar ledger operation. Network fees and account reserves apply.")</p></div>
            <a class="pixel-button compact" href="@ReturnUrl">← CANCEL</a>
        </header>
        @if (_loading) { <div class="terminal-alert" role="status" aria-live="polite"><span class="sv-loading-spinner" aria-hidden="true"></span> LOADING RECORD AND FOLDERS...</div> }
        @if (_kind == "file")
        {
            <div class="terminal-panel credential-form">
                <div class="form-section-title"><span>01</span> FILE SELECTION</div>
                <label class="terminal-label" for="sv-ledger-file">FILE *</label>
                <div class="sv-file-picker">
                    <label class="pixel-button compact sv-file-picker-button" for="sv-ledger-file">+ CHOOSE FILE</label>
                    <span class="sv-file-picked-name">@(_fileBytes is null ? "NO FILE SELECTED" : _fileOriginalName)</span>
                    <InputFile id="sv-ledger-file" class="sv-file-native-input" OnChange="SelectLedgerFileAsync" disabled="@(_busy || _loading)" />
                </div>
                <p class="advanced-help">Encrypted Stellar ledger publishing. Initial file limit: 2 KiB. Larger-file batching is not yet implemented.</p>
                @if (_fileBytes is not null) { <p class="advanced-help">SELECTED: @_fileOriginalName (@_fileBytes.Length bytes)</p> }
                <label class="terminal-label" for="sv-ledger-file-title">FILE RECORD NAME *</label>
                <input id="sv-ledger-file-title" class="terminal-input" maxlength="256" @bind="_title" @bind:event="oninput" disabled="@(_busy || _loading)" />
                <div class="commit-preview"><span>MODE</span><strong>ENCRYPT → CHUNK → SIGN → SUBMIT</strong><span>TARGET</span><strong>STELLAR LEDGER</strong></div>
                @if (!string.IsNullOrWhiteSpace(_status)) { <div class="terminal-alert" role="status"><strong>FILE STATUS</strong><span>@_status</span></div> }
                @if (_busy) { <p role="status"><span class="sv-loading-spinner"></span> @_status</p> }
                <button class="pixel-button primary access-button" type="button" disabled="@(_busy || _loading || !Ledger.IsConnected || _fileBytes is null || string.IsNullOrWhiteSpace(_title))" @onclick="ReviewAsync">REVIEW FILE COST AND APPROVE</button>
            </div>
        }
        else
        {
            <div class="terminal-panel credential-form">
                <div class="form-section-title"><span>01</span> RECORD IDENTITY</div>
                <label class="terminal-label" for="sv-title">TITLE *</label>
                <input id="sv-title" class="terminal-input" @bind="_title" @bind:event="oninput" autocomplete="off" maxlength="256"/>
                <label class="terminal-label" for="sv-folder">FOLDER</label>
                <select id="sv-folder" class="terminal-input" @bind="_folder">
                    <option value="">Unfiled</option>
                    @foreach (var folder in AvailableFolders.OrderBy(f => FolderPath(f.Id), StringComparer.OrdinalIgnoreCase)) { <option value="@folder.Id">@FolderPath(folder.Id)</option> }
                </select>
                <p class="advanced-help">Move to any nested folder, or choose Unfiled for the vault root.</p>
                @if (_kind != "folder")
                {
                    <label class="terminal-label">USERNAME / IDENTIFIER</label>
                    <input class="terminal-input" @bind="_username" autocomplete="off"/>
                    <label class="terminal-label">URL</label>
                    <input class="terminal-input" type="url" @bind="_url" autocomplete="off"/>
                    <div class="form-section-title"><span>02</span> SECRET PAYLOAD</div>
                    <label class="terminal-label">SECRET / PASSWORD *</label>
                    <input class="terminal-input" type="@(_showSecret ? "text" : "password")" @bind="_secret" autocomplete="new-password"/>
                    <button type="button" class="pixel-button compact" @onclick="() => _showSecret = !_showSecret">@(_showSecret ? "HIDE" : "SHOW")</button>
                    <label class="terminal-label">NOTES</label>
                    <textarea class="terminal-input terminal-textarea" rows="4" @bind="_notes"></textarea>
                    <label class="terminal-label">TAGS // COMMA SEPARATED</label>
                    <input class="terminal-input" @bind="_tags" placeholder="work, infrastructure, private"/>
                }
                <div class="commit-preview"><span>MODE</span><strong>ENCRYPT → CHUNK → SIGN → SUBMIT</strong><span>TARGET</span><strong>STELLAR LEDGER</strong></div>
                @if (!string.IsNullOrWhiteSpace(_status)) { <div class="terminal-alert" role="status"><strong>COMMIT STATUS</strong><span>@_status</span></div> }
                @if (_busy) { <p role="status"><span class="sv-loading-spinner"></span> @_status</p> }
                <button class="pixel-button primary access-button" type="button" disabled="@(_busy || _loading || string.IsNullOrWhiteSpace(_title) || (_kind != "folder" && string.IsNullOrWhiteSpace(_secret)))" @onclick="ReviewAsync">REVIEW AND APPROVE</button>
            </div>
        }
    </section>
    <LedgerCostApprovalModal Open="@(_estimate is not null)" Estimate="_estimate" Title="APPROVE LEDGER WRITE" Busy="_busy" OnConfirm="CommitAsync" OnCancel="CancelReview" />
}
</AdaptiveShell>

@code {
    [Parameter] public string? RecordId { get; set; }
    [SupplyParameterFromQuery(Name = "folder")] public string? InitialFolder { get; set; }
    [SupplyParameterFromQuery(Name = "kind")] public string? Kind { get; set; }
    private string _kind => _editingFolder ? "folder" : Kind is "folder" or "file" ? Kind : "record";
    private bool _editingFolder;
    private string? _loadedId;
    private string _title = "", _secret = "", _username = "", _url = "", _notes = "", _tags = "";
    private string _folder = "";
    private bool _showSecret, _busy;
    private const long MaximumLedgerFileLength = 2048;
    private byte[]? _fileBytes;
    private string _fileOriginalName = "";
    private string _fileContentType = "application/octet-stream";
    private async Task SelectLedgerFileAsync(InputFileChangeEventArgs args)
    {
        _status = null;
        _estimate = null;
        _reviewedDraft = null;
        ClearFileBytes();
        var file = args.File;
        if (file.Size > MaximumLedgerFileLength)
        {
            _status = "On-chain upload currently supports up to 2 KiB. No transaction was submitted.";
            return;
        }
        _busy = true;
        try
        {
            await using var stream = file.OpenReadStream(MaximumLedgerFileLength);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _fileBytes = buffer.ToArray();
            _fileOriginalName = file.Name;
            _fileContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType;
            _title = file.Name.Length > 256 ? file.Name[..256] : file.Name;
        }
        catch (Exception ex)
        {
            ClearFileBytes();
            _status = "Unable to read file: " + ex.Message;
        }
        finally { _busy = false; }
    }
    private bool _loading;
    private LedgerCostPreview? _estimate;
    private LedgerRecordDraft? _reviewedDraft;
    private string? _reviewedRecordId;
    private string ReturnUrl => string.IsNullOrEmpty(_folder) ? "/vault" : "/vault?folder=" + Uri.EscapeDataString(_folder);
    private string? _status;
    private IReadOnlyList<LedgerRecordItem> _folders = [];
    private IEnumerable<LedgerRecordItem> AvailableFolders =>
        _folders.Where(f => !(_editingFolder && (f.Id == RecordId || IsDescendantOf(f.Id, RecordId))));
    private bool IsDescendantOf(string id, string? ancestorId) {
        var visited = new HashSet<string>(StringComparer.Ordinal);
        while (visited.Add(id)) {
            var current = _folders.FirstOrDefault(f => f.Id == id);
            if (current?.FolderId is null) return false;
            if (current.FolderId == ancestorId) return true;
            id = current.FolderId;
        }
        return true;
    }
    private string FolderPath(string id) {
        var names = new List<string>();
        var visited = new HashSet<string>(StringComparer.Ordinal);
        while (visited.Add(id)) {
            var folder = _folders.FirstOrDefault(f => f.Id == id);
            if (folder is null) break;
            names.Insert(0, folder.Title);
            if (folder.FolderId is null) break;
            id = folder.FolderId;
        }
        return "MY VAULT / " + string.Join(" / ", names);
    }
    protected override async Task OnParametersSetAsync() {
        if (!Sessions.IsUnlocked || !Ledger.IsConnected || _kind == "file") return;
        _loading = true;
        try {
            var all = await Ledger.ReadAsync();
            _folders = all.Where(x => x.IsFolder).ToArray();
            if (!string.IsNullOrWhiteSpace(RecordId)) {
                if (_loadedId == RecordId) return;
                var current = all.SingleOrDefault(x => x.Id == RecordId)
                    ?? throw new InvalidOperationException("Record not found on the Stellar ledger.");
                _loadedId = RecordId;
                _editingFolder = current.IsFolder;
                _title = current.Title;
                _secret = current.Content;
                _username = current.UserName ?? "";
                _url = current.Url ?? "";
                _notes = current.Notes ?? "";
                _tags = string.Join(", ", current.Tags ?? []);
                _folder = current.FolderId ?? "";
            }
            else _folder = InitialFolder ?? "";
        }
        catch (Exception ex) { _status = "Cannot load record: " + ex.Message; }
        finally { _loading = false; }
    }
    private LedgerRecordDraft Draft() {
        if (_kind == "file")
        {
            if (_fileBytes is null) throw new InvalidOperationException("Select a file first.");
            string payload = "SVFILE1:" + JsonSerializer.Serialize(new LedgerFilePayload(
                _fileOriginalName, _fileContentType, Convert.ToBase64String(_fileBytes),
                Convert.ToHexString(SHA256.HashData(_fileBytes))));
            return new LedgerRecordDraft(_title, payload,
                string.IsNullOrWhiteSpace(_folder) ? null : _folder,
                ["file", "svfile-v1"]);
        }
        var tags = _tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
        return new LedgerRecordDraft(_title, _kind == "folder" ? "folder" : _secret,
            string.IsNullOrWhiteSpace(_folder) ? null : _folder, tags, _kind == "folder", _username, _url, _notes);
    }
    private async Task ReviewAsync() {
        if (_busy || !Ledger.IsConnected || (_kind == "file" && _fileBytes is null)) return;
        _busy = true; _status = "CALCULATING LEDGER COST...";
        try { _reviewedDraft = Draft(); _reviewedRecordId = RecordId; _estimate = await Ledger.EstimateAsync(_reviewedDraft, RecordId); _status = null; }
        catch (Exception ex) { _reviewedDraft = null; _estimate = null; _status = "File cannot fit the current Stellar node allocation or cost estimation failed: " + ex.Message; }
        finally { _busy = false; }
    }
    private sealed record LedgerFilePayload(string FileName, string ContentType, string DataBase64, string Sha256Hex);
    private void ClearFileBytes() {
        if (_fileBytes is not null) CryptographicOperations.ZeroMemory(_fileBytes);
        _fileBytes = null;
    }
    public void Dispose() => ClearFileBytes();
    private static bool SameDraft(LedgerRecordDraft x, LedgerRecordDraft y) =>
        x.Title == y.Title && x.Content == y.Content && x.FolderId == y.FolderId &&
        x.IsFolder == y.IsFolder && x.UserName == y.UserName && x.Url == y.Url &&
        x.Notes == y.Notes && (x.Tags ?? []).SequenceEqual(y.Tags ?? []);
    private void CancelReview() { if (!_busy) { _estimate = null; _reviewedDraft = null; } }
    private async Task CommitAsync() {
        if (_busy || _estimate is null || !Ledger.IsConnected || _reviewedDraft is null) { _status = "Review network costs before publishing."; return; }
        if (_reviewedRecordId != RecordId || !SameDraft(_reviewedDraft, Draft())) { _estimate = null; _status = "Record changed since estimation. Review network costs again."; return; }
        _busy = true; _status = "Signing and submitting to the network...";
        try {
            var draft = Draft();
            if (!string.IsNullOrWhiteSpace(RecordId)) {
                var result = await Ledger.UpdateAsync(RecordId, draft);
                _status = "UPDATED TX: " + result.TransactionHash + " " + result.Warning;
            } else {
                var hash = await Ledger.PublishDetailedAsync(draft);
                _status = (_kind == "file" ? "FILE PUBLISHED ON STELLAR. TX: " : "COMMITTED TX: ") + hash;
            }
            ClearFileBytes();
            Nav.NavigateTo(ReturnUrl);
        } catch (Exception ex) { _status = "Ledger commit failed: " + ex.Message; }
        finally { _busy = false; }
    }
}