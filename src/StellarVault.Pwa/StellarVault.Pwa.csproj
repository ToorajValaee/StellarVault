<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StellarVault.Pwa</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0" PrivateAssets="all" />
    <ProjectReference Include="../VaultEngine.Core/VaultEngine.Core.csproj" />
    <ProjectReference Include="../VaultEngine.Stellar/VaultEngine.Stellar.csproj" />
    <ProjectReference Include="../VaultEngine.Stellar.Horizon/VaultEngine.Stellar.Horizon.csproj" />
    <ProjectReference Include="../StellarVault.UI/StellarVault.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="wwwroot/service-worker.published.js" />
  </ItemGroup>
  <Target Name="VerifyPublishedServiceWorkerAlias" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/wwwroot/service-worker.published.js"
          DestinationFiles="$(PublishDir)wwwroot/service-worker.js" />
    <Delete Files="$(PublishDir)wwwroot/service-worker.js.gz;$(PublishDir)wwwroot/service-worker.js.br" />
  </Target></Project>
