@using StellarVault.UI.Components
@using StellarVault.Core.Services
@using Microsoft.JSInterop
@inject VaultSessionManager Sessions
@inject IJSRuntime JS
@implements IAsyncDisposable

<VaultHome Platform="WEB PWA" />

@code {
    private DotNetObjectReference<App>? _callback;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _callback = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("stellarVaultV2Lifecycle.attach", _callback);
        }
        catch (JSException)
        {
            // Browser privacy restrictions or an outdated cached script may
            // disable this optional lifecycle hook. Fail closed: do not keep
            // a vault session alive without the background-lock mechanism.
            Sessions.Lock();
        }
    }

    [JSInvokable]
    public void LockForBrowserLifecycle() => Sessions.Lock();

    public async ValueTask DisposeAsync()
    {
        Sessions.Lock();
        try { await JS.InvokeVoidAsync("stellarVaultV2Lifecycle.detach"); }
        catch (JSDisconnectedException) { }
        catch (JSException) { /* The page is already locking and disposing. */ }
        _callback?.Dispose();
    }
}
